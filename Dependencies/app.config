<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="NumberGame2Section" type="Fanex.HttpModule.NG2.UM.Configurations.NumberGame2Section, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral" />
  <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /><section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" /></configSections>
  <NumberGame2Section configSource="Configurations\NumberGame2Section.config" />
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="NG2HttpModule" />
      <add name="NG2HttpModule" type="Fanex.HttpModule.NG2.UM.Web.NG2HttpModule" preCondition="integratedMode" />
    </modules>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Abstractions" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.0" newVersion="3.5.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>