<?xml version="1.0" encoding="utf-8" ?>

<UserControl>
    <Report>
      <!--Racing-->
        <add alias="Racing" name="" db="">
            <stores>
              <add alias="12Bet" name="" function="ReportRacingWinLossByLicensee" site="12Bet"></add>
              <add alias="alog" name="" function="ReportRacingWinLossByLicensee" site="alog"></add>
              <add alias="asiabet88" name="" function="ReportRacingWinLossByLicensee" site="asiabet88"></add>
              <add alias="Bezbet" name="" function="ReportRacingWinLossByLicensee" site="Bezbet"></add>
              <add alias="mansion88" name="" function="ReportRacingWinLossByLicensee" site="mansion88"></add>
              <add alias="Mayfair" name="" function="ReportRacingWinLossByLicensee" site="Mayfair"></add>
              <add alias="spondemo" name="" function="ReportRacingWinLossByLicensee" site="spondemo"></add>
				<add alias="SunGame" name="" function="ReportRacingWinLossByLicensee" site="SunGame"></add>
				<add alias="TLC" name="" function="ReportRacingWinLossByLicensee" site="TLC"></add>
              <add alias="Zzun88" name="" function="ReportRacingWinLossByLicensee" site="Zzun88"></add>              
            </stores>
        </add>
      
      <!--Licensee-->
      <add alias="Licensee" name="" db="">
        <stores>
          <add alias="12BET" name=""  function="ReportLicenseeWinLossByLicensee" site="12Bet" Level="3"></add>
          <add alias="asiabet88" name=""  function="ReportLicenseeWinLossByLicensee" site="asiabet88" Level="2"></add>
          <add alias="mansion88" name=""  function="ReportLicenseeWinLossByLicensee" site="mansion88" Level="2"></add>
          <add alias="alog" name=""  function="ReportLicenseeWinLossByLicensee" site="alog" Level="2"></add>
          <add alias="spondemo" name=""  function="ReportLicenseeWinLossByLicensee" site="spondemo" Level="2"></add>
          <add alias="TLC" name=""  function="ReportLicenseeWinLossByLicensee" site="TLC" Level="2"></add>
          <add alias="DELA" name=""  function="ReportLicenseeWinLossByLicensee" site="DELA" Level="2"></add>
          <add alias="Sungame" name=""  function="ReportLicenseeWinLossByLicensee" site="Sungame" Level="2"></add>
          <add alias="MayFair" name=""  function="ReportLicenseeWinLossByLicensee" site="MayFair" Level="2"></add>
          <add alias="Zzun88" name=""  function="ReportLicenseeWinLossByLicensee" site="Zzun88" Level="2"></add>
          <add alias="Bezbet" name=""  function="ReportLicenseeWinLossByLicensee" site="Bezbet" Level="2"></add>
		  <add alias="Haifa" name=""  function="ReportLicenseeWinLossByLicensee" site="Haifa" Level="2"></add>
			<add alias="Bodog" name=""  function="ReportLicenseeWinLossByLicensee" site="Bodog" Level="2"></add>
			<add alias="SG8" name=""  function="ReportLicenseeWinLossByLicensee" site="SG8" Level="2"></add>
			<add alias="Tycoon" name=""  function="ReportLicenseeWinLossByLicensee" site="Tycoon" Level="2"></add>
			<add alias="Vwin" name=""  function="ReportLicenseeWinLossByLicensee" site="Vwin" Level="2"></add>
			<add alias="Macaubet" name=""  function="ReportLicenseeWinLossByLicensee" site="Macaubet" Level="2"></add>
			<add alias="Ibobet" name=""  function="ReportLicenseeWinLossByLicensee" site="ibobet" Level="2"></add>
			<add alias="VCAsia" name=""  function="ReportLicenseeWinLossByLicensee" site="VCAsia" Level="2"></add>
			<add alias="Bwinning" name=""  function="ReportLicenseeWinLossByLicensee" site="Bwinning" Level="2"></add>
			<add alias="livebet365" name=""  function="ReportLicenseeWinLossByLicensee" site="livebet365" Level="2"></add>
			<add alias="Aoncash" name=""  function="ReportLicenseeWinLossByLicensee" site="Aoncash" Level="2"></add>
			<add alias="ITCBet" name=""  function="ReportLicenseeWinLossByLicensee" site="ITCBet" Level="2"></add>
			
		</stores>
      </add>
    </Report>
</UserControl>

