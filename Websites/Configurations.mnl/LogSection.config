<?xml version="1.0"?>
<LogSection>
  <LogType>
    <type id="1" name="setting" isTracking="true"></type>
    <type id="2" name="status" isTracking="true"></type>
    <type id="3" name="credit" isTracking="false"></type>
    <type id="4" name="login" isTracking="false"></type>
  </LogType>
  <TrackingTemplate>
    <tracking level="1" action="*" hasGroup="false" isDefault="true" hiddenDefault="userid,gametypeid,signupby,subaccid,v162updatepositiontaking_1101,disable163_1402,disable163_1403,disable163_1404">
      <filters>       

        <!--Virtual Sports - Soccer-->
        <action id="370"></action>
        <action id="371"></action>
        <action id="372"></action>
        <action id="430"></action>
        <action id="431"></action>
        <action id="432"></action>
        <action id="433"></action>
        <action id="434"></action>
        <action id="435"></action>
        <action id="504"></action>
        <!--/Virtual Sports - Soccer-->
      </filters>
      <formater>
        <param name="transferoption"></param>
        <param name="ip"></param>
      </formater>
    </tracking>
    <tracking level="2" action="*" hasGroup="false" isDefault="false" hiddenDefault="custid,userid,username">
      <filters>
        <action id="406"></action>
        <action id="418"></action>
        <action id="419"></action>
        <action id="420"></action>
        <action id="421"></action>
      </filters>
      <formater>
        <param name="transferoption"></param>
        <param name="ip"></param>
      </formater>
    </tracking>
    <tracking level="3" action="*" hasGroup="true" hiddenDefault="custid,userid,username,UMMBv1,UMMBv2,UMMBv3,UMMBv5,UMMBv8,UMMBv10,UMMBv11,UMMBv99,UMMBv99MP,UMMBv161,UMMBv164" groupDefault="sportbook">
      <filters>
        <!-- collection-->
        <action id="400"></action>
        <action id="401"></action>
        <action id="402"></action>
        <action id="403"></action>
        <action id="404"></action>
        <action id="410"></action>
        <action id="411"></action>
        <action id="412"></action>
        <action id="500"></action>
        <action id="501"></action>
        <action id="300"></action>
        <action id="305"></action>
        <action id="306" regx="(minb|maxb|mpm)"></action>
        <action id="301"></action>
        <action id="302"></action>
        <action id="303"></action>
        <action id="304"></action>
        <action id="2000"></action>
        <action id="407"></action>
        <action id="412"></action>
        <action id="413"></action>
        <action id="307"></action>
        <action id="313"></action>

        <!--deposit-->
        <action id="2008"></action>
        <action id="2009"></action>
        <action id="2010"></action>
        <action id="2011"></action>
        <action id="2012"></action>
        <action id="2013"></action>
        <action id="2019"></action>
        <action id="2036"></action>
        <action id="2202"></action>
        <action id="2203"></action>
        <action id="2204"></action>
        <action id="2205"></action>
        <action id="2412"></action>
        <action id="2413"></action>
        <action id="2414"></action>
        <action id="2415"></action>
        <action id="2601"></action>
        <action id="2602"></action>
        <action id="2603"></action>
        <action id="2604"></action>
        <action id="2605"></action>
        <action id="2606"></action>
        <action id="2607"></action>
        <action id="2608"></action>
        <action id="2701"></action>
        <action id="2702"></action>
        <action id="2703"></action>
        <action id="2704"></action>
        <action id="2705"></action>
        <action id="2706"></action>
        <action id="2707"></action>
        <action id="2709"></action>
        <!--/deposit-->


      </filters>
    </tracking>
  </TrackingTemplate>
  <Groups>
    <group name="sportbook">
      <sports>
        <add id="1" label="soccer"></add>
        <add id="9901" label="sabasoccer"></add>
        <add id="1999" label="soccerparlay"></add>
        <add id="2" label="basketball"></add>
        <add id="9902" label="sababasketball"></add>
        <add id="3" label="football"></add>
        <add id="5" label="tennis"></add>
        <add id="8" label="baseball"></add>
        <add id="10" label="Golf"></add>
        <add id="11" label="motorsports"></add>
        <add id="44" label="Muay Thai"></add>
        <add id="99" label="othersports"></add>
        <add id="999" label="mixsportparlay"></add>
        <add id="161" label="numbergame"></add>
        <add id="164" label="happy5"></add>
        <add id="180" label="Virtual Soccer"></add>
        <add id="181" label="Virtual Horse Racing"></add>
        <add id="182" label="Virtual Greyhounds"></add>
        <add id="183" label="Virtual Speedway"></add>
        <add id="184" label="Virtual Motorsports"></add>
        <add id="185" label="Virtual Cycling"></add>
        <add id="186" label="Virtual Tennis"></add>
        <add id="202" label="keno"></add>
      </sports>
    </group>
  </Groups>
  <LogFormater>
    <!--1: Format Transfer Option-->
    <param name="transferoption" value="1"></param>
    <!--2: Format IP-->
    <param name="ip" value="2"></param>
    <param name="signupip" value="2"></param>
    <param name="loginip" value="2"></param>
    <!--3: Format Number with 0 decimal-->
    <param name="max" value="3"></param>
    <param name="mpm" value="3"></param>
    <param name="mppm" value="3"></param>
    <param name="mpe" value="3"></param>
    <param name="mpb" value="3"></param>
    <param name="minb" value="3"></param>
    <param name="maxb" value="3"></param>
    <!--4: Get from Resources-->
    <param name="LBA" value="4"></param>
    <param name="SBT" value="4"></param>
    <!--5: Format Mark Account Type-->
    <param name="TypeId" value="5"></param>
    <!--6: Format League Group Name-->
    <param name="LeagueGroupName" value="6"></param>
    <!--7: Format Unlimited when value = 0-->
    <param name="MaxWinLimit" value="7"></param>
    <param name="MaxLossLimit" value="7"></param>
  </LogFormater>
</LogSection>
