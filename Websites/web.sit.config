  <unity>
    <typeAliases>
      <!-- Lifetime manager types -->
      <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity" />
      <typeAlias alias="external" type="Microsoft.Practices.Unity.ExternallyControlledLifetimeManager, Microsoft.Practices.Unity" />
      <!-- Custom object types -->
      <typeAlias alias="ICustomerService" type="Sunplus.Bingo.Services.ICustomerService, Sunplus.Bingo.Services" />
      <typeAlias alias="CustomerService" type="Sunplus.Bingo.Services.CustomerService, Sunplus.Bingo.Services" />
      <typeAlias alias="IReportService" type="Sunplus.Bingo.Services.IReportService, Sunplus.Bingo.Services" />
      <typeAlias alias="ReportService" type="Sunplus.Bingo.Services.ReportService, Sunplus.Bingo.Services" />
      <typeAlias alias="ICustomerDAO" type="Sunplus.Bingo.Data.ICustomerDAO, Sunplus.Bingo.Data" />
      <typeAlias alias="IReportDAO" type="Sunplus.Bingo.Data.IReportDAO, Sunplus.Bingo.Data" />
      <typeAlias alias="ILogger" type="Sunplus.Core.LoggingLib.ILogger, Sunplus.Core.LoggingLib" />
      <typeAlias alias="LinqCustomerDAO" type="Sunplus.Bingo.Data.Entlib.EntlibCustomerDAO, Sunplus.Bingo.Data.Entlib" />
      <typeAlias alias="LinqReportDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqReportDAO, Sunplus.Bingo.Data.LinqToSql" />
      <typeAlias alias="EntLibLogger" type="Sunplus.Core.LoggingLib.EntLibLogger, Sunplus.Core.LoggingLib" />
    </typeAliases>
    <containers>
      <container name="BingoContainer">
        <types>
          <type type="ICustomerService" mapTo="CustomerService" />
          <type type="IReportService" mapTo="ReportService" />
          <type type="ICustomerDAO" mapTo="LinqCustomerDAO" />
          <type type="IReportDAO" mapTo="LinqReportDAO" />
          <type type="ILogger" mapTo="EntLibLogger" />
        </types>
      </container>
    </containers>
  </unity>
  <!--Eng Bingo API-->
  <IBCAccounting>
    <Casino providerType="Sunplus.Accounting.DataAccess.APIClient.APICasinoProvider" showBetSetting="false">
    </Casino>
    <IBCCustomer providerType="Sunplus.Accounting.DataAccess.APIClient.IBCLibProvider">
    </IBCCustomer>
    <PositionTaking providerType="Sunplus.Accounting.DataAccess.IBCClient.PositionTakingProviderClient" providerTypeHR="Sunplus.Accounting.DataAccess.IBCClient.HRPositionTakingProviderClient">
    </PositionTaking>
  </IBCAccounting>

  <cachingConfiguration defaultCacheManager="Cache Manager">
    <cacheManagers>
      <add name="Cache Manager" type="Microsoft.Practices.EnterpriseLibrary.Caching.CacheManager, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0" expirationPollFrequencyInSeconds="1000" maximumElementsInCacheBeforeScavenging="500" numberToRemoveWhenScavenging="10" backingStoreName="Null Storage" />
    </cacheManagers>
    <backingStores>
      <add encryptionProviderName="" type="Microsoft.Practices.EnterpriseLibrary.Caching.BackingStoreImplementations.NullBackingStore, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0" name="Null Storage" />
    </backingStores>
  </cachingConfiguration>
  <!--entlib configuration-->
  <dataConfiguration defaultDatabase="DBLogConnectionString" />
  <!--/entlib configuration-->
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] &lt;%X{auth}&gt; - %m%n" />
      </layout>
    </appender>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="LogCS/CasinoLibrary.txt" />
      <appendToFile value="true" />
      <maximumFileSize value="100MB" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="5" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d{HH:mm:ss.fff} [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
    <appender name="RobotTrapRecorderFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="TrapLogs\" />
      <datePattern value="'trap-debug-'dd-MM-yyyy'.log'" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="100MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
      </layout>
    </appender>

    <!-- levels: DEBUG, INFO, WARN, ERROR, FATAL -->
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="ConsoleAppender"/>
      <!--<appender-ref ref="GeneralLog"/>-->
    </root>
    <logger name="RobotTrapRecorder">
      <level value="ALL" />
      <level value="INFO" />
      <appender-ref ref="RobotTrapRecorderFileAppender" />
    </logger>
  </log4net>
  <appSettings file="Web_AppSettings.config">
    <!--MVC-->
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="PreserveLoginUrl" value="true" />
    <add value="false" key="autoFormsAuthentication" />
    <!--MVC-->
    <add key="loginfailed_countdown_minute" value="5" />
    <add key="NumberWrongPassword" value="6" />
    <add key="IPService.geoipservice" value="http://www.webservicex.net/geoipservice.asmx" />
    <!--ViewLog-->
    <!--This key indicated refresh cache xslt transform object. It is neccessary for upload new xslt file-->
    <!--/ViewLog-->
    <!--AllBet-->
    <add key="Fanex.Result.Core.3rdLiveCasinoTplPath" value="/Content/Fanex.Result.3rdLiveCasino/template/public/game_result/" />
    <!--/AllBet-->
    <add key="whatnews_upload_dir" value="../../Others/ReleaseLog/images/upload/" />
    <add key="whatnews_upload_url" value="../../Others/ReleaseLog/images/upload/{0}" />
    <add key="UM" value="0" />
    <add key="cached" value="true" />
    <add key="app_mail_id" value="1" />
    <!--<add key="app_mail_address" value="net.tcp://10.19.10.61:8585/MailService"/>-->
    <add key="app_mail_address" value="net.tcp://172.16.4.107:8585/MailService" />
    <add key="MaxPT" value="0.9" />
    <add key="MinPT" value="0.9" />
    <add key="MaxComm" value="0.1" />
  </appSettings>
  <connectionStrings configSource="ConnectionStrings.sit.config">
  </connectionStrings>
  <system.web>
    <siteMap defaultProvider="SystemFunctions">
      <providers>
        <add name="SystemFunctions" type="System.Web.XmlSiteMapProvider" siteMapFile="~/App_Data/System.sitemap" />
      </providers>
    </siteMap>
    <httpHandlers>
      <add verb="*" path="*.xls" type="System.Web.StaticFileHandler" />
      <add verb="*" path="*.xlsx" type="System.Web.StaticFileHandler" />
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <customErrors mode="Off" defaultRedirect="~/ErrorPage.aspx">
    </customErrors>
    <compilation debug="false" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Management, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Configuration.Install, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Messaging, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Data.OracleClient, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Runtime.Remoting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="Microsoft.VisualBasic, Version=10.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Data.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Data.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Data.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Data.Services.Client, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <!--MVC-->
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Helpers, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.WebPages, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Razor, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="Microsoft.Web.Infrastructure, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <!--MVC-->
      </assemblies>
      <buildProviders />
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="~/SignIn.aspx" path="/" cookieless="UseCookies" defaultUrl="~/index.aspx" name="AccLoginForm" protection="All">
      </forms>
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <sessionState mode="StateServer" timeout="10" stateConnectionString="tcpip=172.16.4.107:42424" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" />
    <httpRuntime maxRequestLength="10240000" executionTimeout="18000" maxQueryStringLength="2097151" />
    <!--MVC-->
    <pages validateRequest="false" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="Fanex.Tarus.Web.Models" />
      </namespaces>
    </pages>
    <!--MVC-->
    <httpModules>
      <!--Applying SSl-->
      <!--<add name="WebPageSecurity" type="Ventaur.Web.Security.SecureWebPageModule, WebPageSecurity"/>-->
      <!--End SSL-->
      <add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
    </httpModules>
    <!--Mechine key for single sign on to CRM-->
    <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB" decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65" validation="SHA1" decryption="AES" />
  </system.web>
  <!--MVC-->
  <location path="SignIn.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
	<location path="js">
		<system.web>
			<authorization>
				<allow users="*" />
