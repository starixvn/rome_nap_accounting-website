@model Fanex.Tarus.BetList.Entities.BetList.BetDetail
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
    <link type="text/css" rel="Stylesheet"
          href="@Url.Content("~/Areas/AGCasino/Views/BetDetails/Styles/BetDetails.less")" />
    <link type="text/css" rel="Stylesheet"
          href="@Url.Content("~/Areas/AGCasino/Views/BetDetails/Styles/AGCasino.css")" />
    <title>AG Casino</title>
</head>
<body>
    <div id="betlist-details" class="freegrid display-none">
        <div class="grid-title r">
            <div style="width: 100%;">
                <div style="display: inline-block; float: left;" class="b"></div>
                <div class="grid-toolbox">
                    <input type="button" id="btnExport" class="btnExcel" title="Export to Excel" />
                </div>
            </div>
        </div>
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="width30 height34 table-cell">
                                    No
                                </div>
                            </th>
                            <th>
                                <div class="width120 height34 table-cell">
                                    Trans.Time
                                </div>
                            </th>
                            <th>
                                <div class="column-choice height34 table-cell">
                                    Choice
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Odds
                                </div>
                            </th>
                            <th>
                                <div class="width50 height34 table-cell">
                                    Stake
                                </div>
                            </th>
                            <th>
                                <div class="column-winloss height34 table-cell">
                                    Win Loss
                                </div>
                            </th>
                            <th>
                                <div class="width100 height34 table-cell">
                                    Status
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Super
                                    <br />
                                    PT/Comm
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Master
                                    <br />
                                    PT/Comm
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Agent
                                    <br />
                                    PT/Comm
                                </div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content ">
                    <thead>
                        <tr>
                            <th>
                                <div class="width30 height34 table-cell">
                                    No
                                </div>
                            </th>
                            <th>
                                <div class="width120 height34 table-cell">
                                    Trans.Time
                                </div>
                            </th>
                            <th>
                                <div class="width275 height34 table-cell">
                                    Choice
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Odds
                                </div>
                            </th>
                            <th>
                                <div class="width50 height34 table-cell">
                                    Stake
                                </div>
                            </th>
                            <th>
                                <div class="column-winloss height34 table-cell">
                                    Win Loss
                                </div>
                            </th>
                            <th>
                                <div class="width100 height34 table-cell">
                                    Status
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Super
                                    <br />
                                    PT/Comm
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Master
                                    <br />
                                    PT/Comm
                                </div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Agent
                                    <br />
                                    PT/Comm
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ Html.RenderPartial("~/Areas/AGCasino/Views/BetDetails/_Tickets.cshtml", Model); }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <iframe id="frmExportExcel" width="0" height="0" frameborder="0" style="display:none"></iframe>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/json2.js"></script>
    <script type="text/javascript" src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js"></script>
    <script type="text/javascript" src="~/js/jQuery/gridscroller.js"></script>
    <script type="text/javascript" src="~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js"></script>
    <script type="text/javascript" src="~/js/jQuery/Pager/jpager.js"></script>
    <script type="text/javascript" src="~/js/BetList.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version"></script>
    <script type="text/javascript" src="~/Areas/AGCasino/Views/BetDetails/Scripts/BetDetails.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var totalRows = @Model.TotalRows;
        var refno = @Request.QueryString["Refno"];
        var custId = @Request.QueryString["CustId"];
        var transType = @Request.QueryString["TransType"];
        var sportType = @Request.QueryString["SportType"];
        var pageSize = @Request.QueryString["PageSize"];
        $(document).ready(function () {
            agCasinoBetDetailsManager.initPage();
        });

        function viewBetListByIP(fromDate, ip) {
            var parentIndex = 1;
            parent[parentIndex].location = window.rootUrl + 'TarusBetList/BetListByIP?IsLink=true&FromDate=' + fromDate + '&IP=' + ip;

            var betListPopUp = parent.$(".ui-dialog");
            if (betListPopUp && betListPopUp.length) {
                betListPopUp.dialog('close');
                betListPopUp.remove();
            }

            var detailPopUp = parent.$("#dialog-modalAGCasinoDetails");
            detailPopUp.dialog('close');
            detailPopUp.remove();
        }
    </script>
</body>
</html>
