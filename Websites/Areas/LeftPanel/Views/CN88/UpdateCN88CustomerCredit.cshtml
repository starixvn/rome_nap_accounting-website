@using Resources;
@using Fanex.Tarus.Customer.ViewModels.CN88;
@using Sunplus.Accounting.Core.Configurations;
@model CreditRangeViewModel

<!DOCTYPE html>
<html lang="en" class="linen">
<head>
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css?v=" + WebSettings.Version)" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css?v=" + WebSettings.Version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/input.css?v=" + WebSettings.Version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/Message.css?v=" + WebSettings.Version)" />
    <style>
        .row {
            height: 32px;
            line-height: 12px;
            font-size: 13px;
        }
        .float-left{
            float: left;
        }
        .float-right {
            float: right;
        }
        .w100 {
            width: 100px;
        }
        .w260{
            width: 260px;
        }
        .w100percent{
            width: 100%;
        }
    </style>
</head>
<body id="body">
    <div id="errMsg" class="errMsg hidden"></div>
    <div id="successMsg" class="successMsg hidden">@Resources.ErrorMsg._0 </div>
    <div class="clear row">
        <span class="ui-priority-primary">@(Model.IsMember ? Language.BetCredit : Language.UsedCredit)</span>
        <span class="ui-priority-primary">@(Model.IsMember ? Model.GivenCredit.ToString("N2") : Model.UsedCredit.ToString("N2"))</span>
    </div>
    <div class="clear row">
        <div class="float-left w100">
            <label>@Language.Credits</label>
        </div>
        <div class="float-left w260">
            <input id="credit" type="text" class="w100percent R" onkeyup="return parent.AllowNumberOnly(event, 2)" />
        </div>
    </div>
    <div class="clear row">
        <div class="float-left w100">&nbsp;</div>
        <div class="float-left w260">
            <div class="float-left w100">@Language.AvailableCredit</div>
            <div class="float-right">
                @if (Model.IsSuper)
                {
                    @:>= @Model.MinCredit.ToString("N2")
                }
                else
                {
                    @Model.MaxCredit.ToString("N2")
                }
            </div>
        </div>
    </div>
    <div class="clear row R">
        <button id="submit" type="button">@Language.Save</button>
        <button id="cancel" type="button">@Language.Cancel</button>
    </div>
    @Html.HiddenFor(m => m.SearchAccountId)
    @Html.HiddenFor(m => m.RoleId)

    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/LeftPanel/Views/CN88/Scripts/UpdateCN88CustomerCredit.js?v=" + WebSettings.Version)"></script>
</body>
</html>
