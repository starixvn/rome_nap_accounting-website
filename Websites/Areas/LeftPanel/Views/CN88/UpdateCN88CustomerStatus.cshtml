@using Fanex.Tarus.Customer.ViewModels.CN88;
@using Sunplus.Accounting.Core.Configurations;
@model CN88CustomerStatusViewModel
@{
    List<SelectListItem> custStatus = new List<SelectListItem>
    {
        new SelectListItem { Text="Open", Value="1" },
        new SelectListItem { Text="Suspended", Value="2" },
        new SelectListItem { Text="Closed", Value="3" }
    };
}
<!DOCTYPE html>
<html lang="en" class="linen">
<head>
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Styles/jquery-ui.css?v=" + WebSettings.Version)" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css?v=" + WebSettings.Version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/input.css?v=" + WebSettings.Version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/Message.css?v=" + WebSettings.Version)" />
    <style>
        .row {
            height: 32px;
            line-height: 12px;
            font-size: 13px;
        }

        select {
            height: 25px !important;
            width: 100px !important;
            font-size: 13px;
        }

        .float-right {
            float: right;
        }

        .buttonPopup {
            font-size: 13px;
        }
    </style>
</head>
<body id="body">
    <div id="errMsg" class="errMsg hidden"></div>
    <div id="successMsg" class="successMsg hidden">@Resources.ErrorMsg._0 </div>
    <div class="clear row">
        Username: <span class="ui-priority-primary">@Model.UserName</span>
    </div>
    <div class="clear row">
        @Html.LabelFor(model => model.Status, "Account Status ")
        @Html.DropDownListFor(model => model.Status, custStatus)
    </div>
    <div class="clear row float-right">
        <input type="button" id="submit" class="buttonPopup" value="Submit" />
    </div>
    @Html.HiddenFor(model => model.CustId)
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/LeftPanel/Views/CN88/Scripts/UpdateCN88CustomerStatus.js?v=" + WebSettings.Version)"></script>
</body>
</html>
