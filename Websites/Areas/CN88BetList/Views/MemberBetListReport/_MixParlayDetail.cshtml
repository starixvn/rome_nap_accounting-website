@using Fanex.Tarus.BetList.ViewModel
@using Fanex.Tarus.BetList.Extensions
@model CN88MixParlayDetailViewModel
@{
    var combinationTypeComboNames = (string)ViewBag.CombinationTypeComboNames;
}
<div>
    @Html.Raw(combinationTypeComboNames)
    <div class="line"></div>
    @foreach (var ticketdetail in Model.Tickets)
    {
        <div class="ticket-list">
            <div class="group-sport-bet-types">
                <span class="sport-type">@Model.GetSportName(ticketdetail.SportTypeId)</span>
                <span class="bet-type">@Model.CN88Builder.CreateBetInfoBuilder(ticketdetail.BetTypeId).RenderBetTypeName(ticketdetail, Model.TicketHelper)</span>
            </div>
            @(new HtmlString(Model.CN88Builder.BuildChoice(ticketdetail, Model.TicketHelper, null)))
            <div class="event-date">@ticketdetail.EventDate.ToGlobalShowtime()</div>
            @Html.Raw(Model.Builder.CreateStatusBuilder(ticketdetail.BetTypeId).RenderStatusResultText(ticketdetail, null))
        </div>
        if (!ticketdetail.Equals(Model.Tickets.Last()))
        {
            <div class="line"></div>
        }
    }
</div>
