@{
    Layout = null;    
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge;chrome=1" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @RenderSection("css", false)
    @RenderSection("modeldata", false)
</head>
<body>
    <div id="mainContainer" class="main-content">
        @RenderBody()
    </div>
    @Html.Hidden("LiveCasinoRoot", Url.Content("~/"))
    @Scripts.Render("~/areasjs/livecasino/core")
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/scripts/core/fanex-live-casino-setting.js")?v=1"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/LiveCasinoSetting/views/editsetting/scripts/directives/pt-and-com-setting-directive.js")?v=1"></script>
    }
    else
    {
        @Scripts.Render("~/areasjs/livecasino/setting")
    }
    @RenderSection("scripts", false)
</body>
</html>