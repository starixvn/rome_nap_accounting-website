@using Sunplus.Accounting.Core.Configurations;
@{
    Layout = null;
    var currentLangaugeKey = Session[GoldDeluxeSettings.Settings.LanguageSessionKey] != null ?
              Session[GoldDeluxeSettings.Settings.LanguageSessionKey].ToString() : "en-US";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge;chrome=1" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @RenderSection("css", false)
    @if (GoldDeluxeSettings.Settings.System == SystemType.Accounting)
    {
        <link type="text/css" rel="Stylesheet" href="@Url.Content("~/areas/GoldDeluxeSetting/content/bootstrap.css")" />
        <link type="text/css" rel="Stylesheet" href="@Url.Content("~/areas/GoldDeluxeSetting/content/fanex-gold-deluxe-setting.css")?v=1" />
        <link type="text/css" rel="Stylesheet" href="@Url.Content("~/areas/GoldDeluxeSetting/content/fanex-gold-deluxe-setting-override.css")" />
    }
    else
    {
        @Styles.Render("~/areas/GoldDeluxeSetting/content/bundlecss")
    }
    <script type="text/javascript">
        var currentLaguageKey = '@(currentLangaugeKey)';
    </script>
    @RenderSection("modeldata", false)
</head>
<body>
    <div id="mainContainer" class="main-content">
        @RenderBody()
    </div>
    @Html.AntiForgeryToken()
    @Html.Hidden("LiveCasinoRoot", Url.Content("~/"))
    @Scripts.Render("~/areasjs/golddeluxe/core")
    @if (GoldDeluxeSettings.Settings.System == SystemType.Accounting)
    {
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/gold-deluxe-lang.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.en-US.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.ja-JP.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.ko-KR.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.th-TH.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.vi-VN.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.zh-CN.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/language/GoldDeluxeLang.zh-TW.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/scripts/core/fanex-gold-deluxe-setting.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/services/cust-setting-service.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/services/cust-win-limit-service.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/services/cust-game-setting-service.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/services/pt-and-com-setting-service.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/controllers/cust-info-controller.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/controllers/cust-setting-controller.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/controllers/cust-win-limit-controller.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/controllers/pt-and-com-setting-controller.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/controllers/cust-game-setting-controller.js?v=" + WebSettings.Version)"></script>
        <script type="text/javascript" src="@Url.Content("~/areas/GoldDeluxeSetting/views/editsetting/scripts/directives/pt-and-com-setting-directive.js?v=" + WebSettings.Version)"></script>
    }
    else
    {
        @Scripts.Render("~/areasjs/golddeluxe/setting")
    }
    @RenderSection("scripts", false)
</body>
</html>