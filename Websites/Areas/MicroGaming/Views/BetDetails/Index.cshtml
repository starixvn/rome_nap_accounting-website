@using Fanex.BetList.Accounting.Models;
@using Fanex.BetList.Core.Entities;
@using Fanex.BetList.Accounting.Core;
@using Fanex.BetList.Accounting.Extensions;
@using Fanex.BetList.Accounting.Services;
@using DNAide.Core;
@using Fanex.BetList.Core.Factories;
@using Fanex.BetList.Core.Builder;
@{
    TicketDetail betdetail = new TicketDetail();
    int numberBeginning = 0;
    string[] renderResult = Render(ref numberBeginning);
}
@functions {
    public string[] Render(ref int numberBeginning)
    {
        string[] result = new string[2];
        foreach (var ticket in Model)
        {
            result[1] += renderContent(ticket, numberBeginning);
            numberBeginning++;
        }

        return result;
    }
}
@helper renderContent(TicketDetail betdetail, int numberBeginning)
    {
    <tr class="c">
        <td>
            <div class="c width30 table-cell">
                @(numberBeginning + 1)
            </div>
        </td>
        <td class="c column-transdate">
            <div class="width120 table-cell">
                 @Html.Raw(betdetail.TransDateHtml)
            </div>
        </td>
        <td id ="td_right_@betdetail.Ticket.TransId"  class='r bl_evt'>
            <div id="choice_right_@betdetail.Ticket.TransId" class="column-choice table-cell">
                @Html.Raw(betdetail.ChoiceHtml)
                @if (betdetail.Ticket.BetTypeId == 9 ||
                    betdetail.Ticket.BetTypeId == 29)
                {
                    <div class="parlay_@betdetail.Ticket.TransId ">
                    </div>
                }
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_Odds.cshtml", betdetail)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width50 table-cell">
                @Html.Raw(betdetail.StakeHtml)
            </div>
        </td>
        <td class="r">
            <div class="column-winloss table-cell">
                @Html.Partial("~/Views/BetList/_WinLoss.cshtml", betdetail)
            </div>
        </td>
        <td class="c">
            <div id="stautus_@betdetail.Ticket.TransId" class="width100 table-cell">
                @Html.Raw(betdetail.StatusHtml)
                @{
                    var ip = @Sunplus.Accounting.Business.IpManagement.ReplaceVNIP(betdetail.Ticket.IP);
                }
                @if (ip != "-")
                {
                    <br />
                    <a href="@Url.Action("BetListByIP", "TarusBetList", new { IsLink = true, FromDate = betdetail.Ticket.WinlostDate.ToString("MM/dd/yyyy"), IP = betdetail.Ticket.IP })">@ip</a>
                }
            </div>
        </td>
    </tr> 
}
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css" />
    <link type="text/css" rel="Stylesheet" 
        href="@Url.Content("~/Areas/MicroGaming/Views/BetDetails/Styles/BetDetails.less")" />
    <link type="text/css" rel="Stylesheet"  
        href="@Url.Content("~/Areas/MicroGaming/Views/BetDetails/Styles/MicroGaming.css")" />
    <title>MicroGaming</title>
</head>
<body>
    <div id="betlist-details" class="freegrid display-none">
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="width30 height34 table-cell">
                                    No</div>
                            </th>
                            <th>
                                <div class="width120 height34 table-cell">
                                    Trans.Time</div>
                            </th>
                            <th>
                                <div class="column-choice height34 table-cell">
                                    Choice</div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Odds</div>
                            </th>
                            <th>
                                <div class="width50 height34 table-cell">
                                    Stake</div>
                            </th>
                            <th>
                                <div class="column-winloss height34 table-cell">
                                    Win Loss/Comm</div>
                            </th>
                            <th>
                                <div class="width100 height34 table-cell">
                                    Status</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content ">
                    <thead>
                        <tr>
                            <th>
                                <div class="width30 height34 table-cell">
                                    No</div>
                            </th>
                            <th>
                                <div class="width120 height34 table-cell">
                                    Trans.Time</div>
                            </th>
                            <th>
                                <div class="width275 height34 table-cell">
                                    Choice</div>
                            </th>
                            <th>
                                <div class="width60 height34 table-cell">
                                    Odds</div>
                            </th>
                            <th>
                                <div class="width50 height34 table-cell">
                                    Stake</div>
                            </th>
                            <th>
                                <div class="column-winloss height34 table-cell">
                                    Win Loss/Comm</div>
                            </th>
                            <th>
                                <div class="width100 height34 table-cell">
                                    Status</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            betdetail = Model[0];
                            @MvcHtmlString.Create(renderResult[1])
                        }
                        else
                        { 
                            <tr class="c">
                                <td colspan="7" class="r column-no-data">
                                    <div class="c b">
                                        There is no data
                                    </div>
                                </td>
                            </tr>
                            betdetail.Ticket = new Ticket { CustId = 0 };
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/json2.js"></script>
    <script type="text/javascript" src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js"></script>
    <script type="text/javascript" src="~/js/jQuery/gridscroller.js"></script>
    <script type="text/javascript" src="~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js"></script>
    <script type="text/javascript" src="~/js/BetList.js"></script>
    <script type="text/javascript" src="~/Areas/MicroGaming/Views/BetDetails/Scripts/BetDetails.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            microGamingBetDetailsManager.initPage();
        });
    </script>
</body>
</html>
