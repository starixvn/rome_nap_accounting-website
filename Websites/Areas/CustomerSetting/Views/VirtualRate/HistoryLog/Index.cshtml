@using Fanex.Tarus.Customer.Entities.VirtualRate;
@using Fanex.Tarus.Customer.Resources;
@using Newtonsoft.Json;
@using Sunplus.Accounting.Core.Configurations;
@model HistoryLogReportModel
@{
    ViewBag.Title = Customer_Labels.Virtual_Rate;
    Layout = "";
    var historyLogReport = JsonConvert.SerializeObject(Model);
}
<link rel="stylesheet" type="text/css" href="~/js/jQuery/FanexGrid/Fanex.Grid.css" />
<link rel="stylesheet" type="text/css" href="~/Areas/CustomerSetting/Views/VirtualRate/HistoryLog/Styles/HistoryLog.less" />
<div class="main">
    <div class="maincontent">
        <div id="result-message">
        </div>
        <table style="margin: 10px;">
            <tbody>
                <tr>
                    <td class="b">
                        <label for="selViewType">Log Type </label>
                    </td>
                    <td>
                        <select id="selViewType">
                            <option value="0">All</option>
                            <option value="1">Lock Status</option>
                            <option value="2">Virtual Rate</option>
                        </select>
                    </td>
                    <td>
                        <input type="button" id="btnSearch" class="btn" value="Search" />
                    </td>
                </tr>
            </tbody>
        </table>
        <span class="note-message">Note: This page is displayed in the top 50 lines of the log.</span>
        <div id="virtual-rate-log-container">
            <div id="virtual-rate-log" class="freegrid">
            </div>
        </div>
    </div>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script type="text/javascript" src="~/js/JQuery/jquery-1.8.2.js"></script>
    <script type="text/javascript" src="~/js/jQuery/json2.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.blockUI.1.33.js"></script>
    <script type="text/javascript" src="~/js/BlockUI.js"></script>
    <script type="text/javascript" src="~/js/Utils/FormatLibs/NumberFormat/numeral.js"></script>
    <script type="text/javascript" src="~/js/jQuery/FanexGrid/Fanex.Grid.js"></script>
    <script type="text/javascript" src="~/Areas/CustomerSetting/Views/VirtualRate/HistoryLog/Scripts/HistoryLogController.js?v=@WebSettings.Version"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var historyLogReport= @Html.Raw(historyLogReport);
         var viewResources = {
            System_Error: '@Customer_Labels.System_Error',
            Symbol_No:'@Customer_Labels.No',
            Date:'@Customer_Labels.Date',
            Sport:'@Customer_Labels.Sport',
            Changed_by:'@Customer_Labels.Changed_by',
            Enabled_Virtual_Rate: '@Customer_Labels.Enabled_Virtual_Rate',
            Symbol_True: '@Customer_Labels.Symbol_True',
            Symbol_False: '@Customer_Labels.Symbol_False',
            Symbol_Percent: '@Customer_Labels.Symbol_Percent',
            Live: '@Customer_Labels.Live',
            NonLive: '@Customer_Labels.Non_Live',
            There_is_no_data: '@Customer_Labels.There_is_no_data',
            Bet_Type: '@Customer_Labels.Bet_Type',
            Live_NonLive: '@Customer_Labels.Live_NonLive',
            Virtual_Rate: '@Customer_Labels.Virtual_Rate',
            Disabled: '@Customer_Labels.Disabled',
            Enabled: '@Customer_Labels.Enabled',
            VRLock: '@Customer_Labels.VRLockSoccer',
            VRLockBasketball: '@Customer_Labels.VRLockBasketball',
            VRLockOther: '@Customer_Labels.VRLockOther',
            VRPlushAccBalance: '@Customer_Labels.VRPlushAccBalance',
            UpdateVR: '@Customer_Labels.UpdateVR',
            UpdateVRDownlines: '@Customer_Labels.UpdateVRDownlines',
            Yes: '@Customer_Labels.Yes',
            No: '@Customer_Labels.No',
        };
    </script>
</div>
