        <div class="content" id="content">
        </div>
    </div>
    <script type="text/javascript" src="~/Areas/CustomerSetting/Views/VirtualRate/SportBetTypesReferences/Scripts/SportBetTypesReferences.js"></script>
    <script type="text/javascript">
        var sportBetTypesReferences =@Html.Raw(JsonConvert.DeserializeObject(sportBetTypesReferences));    
        var resources = {
