                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_enable_master_AB" data-downlines="1800" data-origin-downlines="1500" data-opposite-id="chk_disable_master_AB" checked="">
                                <label for="chk_enable_master_AB" class="btn-status btn-child btn-enable" title="Click to apply all Masters">
                                    1500
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_disable_master_AB" data-downlines="1800" data-origin-downlines="300" data-opposite-id="chk_enable_master_AB" checked="">
                                <label for="chk_disable_master_AB" class="btn-status btn-child btn-disable btn-ab-disable-child" title="Click to not apply all Masters">
                                    300
                                </label>
                            </td>
                        }
                        @if (roleId >= 3)
