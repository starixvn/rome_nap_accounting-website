@using Fanex.Tarus.Customer.Entities.VirtualRate;
@using Fanex.Tarus.Customer.Resources;
@using Newtonsoft.Json;
@using Sunplus.Accounting.Business.Security;
@using Sunplus.Accounting.Core.Common;
@using Sunplus.Accounting.Core.Configurations;
@model CustomerVirtualRateModel
@{
    ViewBag.Title = Customer_Labels.Virtual_Rate;
    Layout = "";
    var customerVirtualRateModel = JsonConvert.SerializeObject(Model);
    var maxBetTypeColumns = 6;
    var maxColumns = 9;

    var leftColumn = 2;
    var rightColumn = 2;
    var spanFirstRow = 1;
    int isManageVirtualRateAccess = Permissions.GetHostPermission(Enumerations.Functions.ExRates.VirtualRate) ? 1 : 0;
    var roleId = 0;
    if (Model.RoleName == "Super")
    {
        roleId = 4;
        rightColumn = 1 + (Model.MasterVirtualRate == null ? 0 : 2) + (Model.AgentVirtualRate == null ? 0 : 2) + (Model.MemberVirtualRate == null ? 0 : 2);
    }
    else if (Model.RoleName == "Master")
    {
        roleId = 3;
        rightColumn = 1 + (Model.AgentVirtualRate == null ? 0 : 2) + (Model.MemberVirtualRate == null ? 0 : 2);
    }
    else if (Model.RoleName == "Agent")
    {
        roleId = 2;
        rightColumn = 1 + (Model.MemberVirtualRate == null ? 0 : 2);
    }

    if (Model.MasterVirtualRate == null && Model.AgentVirtualRate == null && Model.MemberVirtualRate == null)
    {
        rightColumn = 2;
        spanFirstRow = 2;
    }

    var spanColumns = maxColumns - (leftColumn + rightColumn);
    var spanRows = 9;
}
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
<link rel="stylesheet" type="text/css" href="~/Areas/CustomerSetting/Views/VirtualRate/EditRate/Styles/VirtualRate.less?v=@WebSettings.Version" />
<link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet" type="text/css" />
<div class="main">
    <div class="maincontent">
        <div id="result-message">
        </div>
        <div id="virtual-rate-setting-container">
            <table id="virtual-rate-setting" class="tbllayout" cellspacing="1" border="0">
                <thead>
                    <tr>
                        <td colspan="@(leftColumn + rightColumn)" class="l borderless">
                            <input id="btnSubmit1" type="button" value="@Customer_Labels.Update" name="btnSubmit" class="btn" />
                        </td>
                        @if (spanColumns > 0)
                        {
                            <td class="padding-column borderless" colspan="@spanColumns" rowspan="@(spanRows + 2)"></td>
                        }
                    </tr>

                    <tr class="title">
                        <td colspan="@(leftColumn + rightColumn)">
                            @Model.RoleName: @Model.Username
                            <div class="note-info">
                                [<span class="canchange" onmouseover="virtualRateController.openNote()" onmouseout="virtualRateController.closeNote()">Note Info</span>]
                                <ul onmouseout="virtualRateController.closeNote()" onmouseover="virtualRateController.cancelCloseNote()" id="noteInfo" class="l note note-hide">
                                    <li class="infoIcon"><a href="#">Sport Bet Type References</a></li>
                                    <li><a onclick="virtualRateController.showUpdateVRFlow()">Update VR flow</a></li>
                                </ul>
                            </div>
                        </td>
                        @if (spanColumns > 0)
                        {
                            <td class="padding-column borderless" colspan="@spanColumns" rowspan="@spanRows"></td>
                        }
                    </tr>
                    <tr>
                        <td nowrap="true" class="l b p-l5" colspan="@leftColumn">
                            @Customer_Labels.Apply_Virtual_Rate
                        </td>
                        <td class="l" colspan="@rightColumn">
                            <input id="chk-enableVR" type="checkbox" checked=@(Model.EnableVirtualRate ? "checked" : null) />
                            <label for="chk-enableVR" style="vertical-align:top;word-break: break-word;">@Customer_Labels.Enabled_Virtual_Rate</label>
                        </td>
                    </tr>
                    <tr>
                        <td class="padding-column" colspan="@leftColumn"></td>
                        <td class="c b status-title status-title" colspan="@spanFirstRow">
                            @Model.RoleName
                        </td>
                        @if (roleId >= 4 && Model.MasterVirtualRate != null)
                        {
                            <td class="c b status-title" colspan="2">
                                Master
                            </td>
                        }
                        @if (roleId >= 3 && Model.AgentVirtualRate != null)
                        {
                            <td class="c b status-title" colspan="2">
                                Agent
                            </td>
                        }
                        @if (roleId >= 2 && Model.MemberVirtualRate != null)
                        {
                            <td class="c b status-title" colspan="2">
                                Member
                            </td>
                        }
                    </tr>
                    <tr>
                        <td nowrap="true" class="l b p-l5 status-title" colspan="@leftColumn" title="Apply only VR+ (Except E-Sports)">
                            @Customer_Labels.ApplyVRAccumulatedBalance
                        </td>
                        <td class="padding-column status-title" colspan="@spanFirstRow"></td>
                        @if (roleId >= 4 && Model.MasterVirtualRate != null)
                        {
                            <td class="c b status-column status-title enable-status">
                                Enable
                            </td>
                            <td class="c b status-column status-title disable-status">
                                Disable
                            </td>
                        }
                        @if (roleId >= 3 && Model.AgentVirtualRate != null)
                        {
                            <td class="c b status-column status-title enable-status">
                                Enable
                            </td>
                            <td class="c b status-column status-title disable-status">
                                Disable
                            </td>
                        }
                        @if (roleId >= 2 && Model.MemberVirtualRate != null)
                        {
                            <td class="c b status-column status-title enable-status">
                                Enable
                            </td>
                            <td class="c b status-column status-title disable-status">
                                Disable
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="padding-column" colspan="@leftColumn"></td>
                        <td class="c status-column"  colspan="@spanFirstRow">
                            <input type="checkbox" class="checkbox-hide" id="chk_enableAccumulateBalance" checked=@(Model.IsApplyVRPlushAccumulateBanlance ? "checked" : null)>
                            <label for="chk_enableAccumulateBalance" class="btn-status btn-parent @(Model.IsApplyVRPlushAccumulateBanlance ? "btn-enable" : "btn-disable")" title="Click to apply/not apply VR+" data-btn-type="ab" data-value-enable="Enabled" data-value-disable="Disabled">
                                @(Model.IsApplyVRPlushAccumulateBanlance ? "Enabled" : "Disabled")
                            </label>
                        </td>
                        @if (roleId >= 4 && Model.MasterVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_enable_master_AB" data-downlines="@(Model.MasterVirtualRate.Count)" data-origin-downlines=" @(Model.MasterVirtualRate.EnableAB)" data-opposite-id="chk_disable_master_AB" >
                                <label for="chk_enable_master_AB" class="btn-status btn-child btn-enable" title="Click to apply all Masters">
                                    @(Model.MasterVirtualRate.EnableAB)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_disable_master_AB" data-downlines="@(Model.MasterVirtualRate.Count)" data-origin-downlines="@(Model.MasterVirtualRate.DisableAB)" data-opposite-id="chk_enable_master_AB" >
                                <label for="chk_disable_master_AB" class="btn-status btn-child btn-disable btn-ab-disable-child" title="Click to not apply all Masters" data-downline-id="chk_disable_agent_AB">
                                    @(Model.MasterVirtualRate.DisableAB)
                                </label>
                            </td>
                        }
                        @if (roleId >= 3 && Model.AgentVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_enable_agent_AB" data-downlines="@(Model.AgentVirtualRate.Count)" data-origin-downlines="@(Model.AgentVirtualRate.EnableAB)" data-level="agent" data-opposite-id="chk_disable_agent_AB" >
                                <label for="chk_enable_agent_AB" class="btn-status btn-child btn-enable" title="Click to apply all Agents">
                                    @(Model.AgentVirtualRate.EnableAB)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_disable_agent_AB" data-downlines="@(Model.AgentVirtualRate.Count)" data-origin-downlines="@(Model.AgentVirtualRate.DisableAB)" data-level="agent" data-opposite-id="chk_enable_agent_AB" >
