                    </tr>
                    <tr>
                        <td colspan="@leftColumn" class="l p-l5">
                            Other Sports
                        </td>
                        <td class="c status-column" colspan="@spanFirstRow">
                            <input type="checkbox" class="checkbox-hide" id="ckb_unlockOtherSportsVR" checked=@(Model.LockVirtualRateOtherStatus ? null : "checked")>
                            <label for="ckb_unlockOtherSportsVR" class="btn-status btn-parent @(Model.LockVirtualRateOtherStatus ? "btn-disable" : "btn-enable")" title="Click lock/unlock Other Sports VR" data-btn-type="os" data-value-enable="Unlocked" data-value-disable="Locked">
                                @(Model.LockVirtualRateOtherStatus ? "Locked" : "Unlocked")
                            </label>
                        </td>
                        @if (roleId >= 4 && Model.MasterVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockOtherSportsVRMaster" data-downlines=" @(Model.MasterVirtualRate.Count)" data-origin-downlines=" @(Model.MasterVirtualRate.UnlockOS)" data-level="master" data-opposite-id="ckb_lockOtherSportsVRMaster" >
                                <label for="ckb_unlockOtherSportsVRMaster" class="btn-status btn-child btn-enable" title="Click to unlock all Masters" data-selected="Click to unlock all Masters" data-unselected="Click to revert selection">
                                    @(Model.MasterVirtualRate.UnlockOS)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockOtherSportsVRMaster" data-downlines=" @(Model.MasterVirtualRate.Count)" data-origin-downlines=" @(Model.MasterVirtualRate.LockOS)" data-level="master" data-opposite-id="ckb_unlockOtherSportsVRMaster" >
                                <label for="ckb_lockOtherSportsVRMaster" class="btn-status btn-child btn-disable btn-os-disable-child" title="Click to lock all Masters" data-selected="Click to lock all Masters" data-unselected="Click to revert selection" data-downline-id="ckb_lockOtherSportsVRAgent">
                                    @(Model.MasterVirtualRate.LockOS)
                                </label>
                            </td>
                        }
                        @if (roleId >= 3 && Model.AgentVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockOtherSportsVRAgent" data-downlines=" @(Model.AgentVirtualRate.Count)" data-origin-downlines=" @(Model.AgentVirtualRate.UnlockBB)" data-level="agent" data-opposite-id="ckb_lockOtherSportsVRAgent" >
                                <label for="ckb_unlockOtherSportsVRAgent" class="btn-status btn-child btn-enable" title="Click to unlock all Agents" data-selected="Click to unlock all Agents" data-unselected="Click to revert selection">
