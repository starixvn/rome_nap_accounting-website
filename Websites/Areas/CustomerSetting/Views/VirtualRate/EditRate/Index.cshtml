                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVRMember" data-downlines="2000" data-origin-downlines="600" data-level="member" data-opposite-id="ckb_lockBasketballVRMember" checked="">
                                <label class="btn-status btn-child btn-enable" title="Click to unlock all Members" data-selected="Click to unlock all Members" data-unselected="Click to revert selection">
                                    600
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockBasketballVRMember" data-downlines="2000" data-origin-downlines="1400" data-level="member" data-opposite-id="ckb_unlockBasketballVRMember" checked="">
