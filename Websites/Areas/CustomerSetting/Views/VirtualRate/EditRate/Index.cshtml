                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockSoccerVRAgent" data-downlines="2000" data-origin-downlines="600" data-level="agent" data-opposite-id="ckb_lockSoccerVRAgent" checked="">
                                <label for="ckb_unlockSoccerVRAgent" class="btn-status btn-child btn-enable" title="Click to unlock all Agents" data-selected="Click to unlock all Agents" data-unselected="Click to revert selection">
                                    600
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockSoccerVRAgent" data-downlines="2000" data-origin-downlines="1400" data-level="agent" data-opposite-id="ckb_unlockSoccerVRAgent" checked="">
