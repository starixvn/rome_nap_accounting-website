                                <input type="checkbox" class="checkbox-hide" id="ckb_lockOtherSportsVRAgent" data-downlines=" @(Model.AgentVirtualRate.Count)" data-origin-downlines=" @(Model.AgentVirtualRate.LockOS)" data-level="agent" data-opposite-id="ckb_unlockOtherSportsVRAgent" >
                                <label for="ckb_lockOtherSportsVRAgent" class="btn-status btn-child btn-disable btn-os-disable-child" title="Click to lock all Agents" data-selected="Click to lock all Agents" data-unselected="Click to revert selection" data-downline-id="ckb_lockOtherSportsVRMember">
