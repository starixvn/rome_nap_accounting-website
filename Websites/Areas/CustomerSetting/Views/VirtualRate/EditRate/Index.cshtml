                    </tr>
                    <tr class="padding-row">
                        <td class="borderless" colspan="@maxColumns">
                            &nbsp;
                        </td>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <div class="update-warning">@Customer_Labels.VirtualRate_UpdateWarning</div>
            <input id="btnSubmit" type="button" value="@Customer_Labels.Update" name="btnSubmit" class="btn" />
        </div>
