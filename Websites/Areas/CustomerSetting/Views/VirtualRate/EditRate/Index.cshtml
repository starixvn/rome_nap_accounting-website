                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_disable_member_AB" data-downlines="1800" data-origin-downlines="300" data-level="member" data-opposite-id="chk_enable_member_AB" checked="">
                                <label for="chk_disable_member_AB" class="btn-status btn-child btn-disable btn-ab-disable-child" title="Click to not apply all Members">
                                    300
                                </label>
                            </td>
