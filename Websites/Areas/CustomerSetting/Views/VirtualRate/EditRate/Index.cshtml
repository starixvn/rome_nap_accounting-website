                                @(Model.LockVirtualRateStatus ? "Locked" : "Unlocked")
                            </label>
                        </td>
                        @if (roleId >= 4 && Model.MasterVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockSoccerVRMaster" data-downlines="@(Model.MasterVirtualRate.Count)" data-origin-downlines="@(Model.MasterVirtualRate.UnlockSC)" data-level="master" data-opposite-id="ckb_lockSoccerVRMaster" >
                                <label for="ckb_unlockSoccerVRMaster" class="btn-status btn-child btn-enable" title="Click to unlock all Masters" data-selected="Click to unlock all Masters" data-unselected="Click to revert selection">
                                    @(Model.MasterVirtualRate.UnlockSC)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockSoccerVRMaster" data-downlines="@(Model.MasterVirtualRate.Count)" data-origin-downlines="@(Model.MasterVirtualRate.LockSC)" data-level="master" data-opposite-id="ckb_unlockSoccerVRMaster" >
                                <label for="ckb_lockSoccerVRMaster" class="btn-status btn-child btn-disable btn-soccer-disable-child" title="Click to lock all Masters" data-selected="Click to lock all Masters" data-unselected="Click to revert selection" data-downline-id="ckb_lockSoccerVRAgent">
                                    @(Model.MasterVirtualRate.LockSC)
                                </label>
                            </td>
                        }
                        @if (roleId >= 3 && Model.AgentVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockSoccerVRAgent" data-downlines="@(Model.AgentVirtualRate.Count)" data-origin-downlines="@(Model.AgentVirtualRate.UnlockSC)" data-level="agent" data-opposite-id="ckb_lockSoccerVRAgent" >
                                <label for="ckb_unlockSoccerVRAgent" class="btn-status btn-child btn-enable" title="Click to unlock all Agents" data-selected="Click to unlock all Agents" data-unselected="Click to revert selection">
                                    @(Model.AgentVirtualRate.UnlockSC)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockSoccerVRAgent" data-downlines="@(Model.AgentVirtualRate.Count)" data-origin-downlines="@(Model.AgentVirtualRate.LockSC)" data-level="agent" data-opposite-id="ckb_unlockSoccerVRAgent" >
                                <label for="ckb_lockSoccerVRAgent" class="btn-status btn-child btn-disable btn-soccer-disable-child" title="Click to lock all Agents" data-selected="Click to lock all Agents" data-unselected="Click to revert selection" data-downline-id="ckb_lockSoccerVRMember">
                                    @(Model.AgentVirtualRate.LockSC)
                                </label>
                            </td>
                        }
                        @if (roleId >= 2 && Model.MemberVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockSoccerVRMember" data-downlines="@(Model.MemberVirtualRate.Count)" data-origin-downlines="@(Model.MemberVirtualRate.UnlockSC)" data-level="member" data-opposite-id="ckb_lockSoccerVRMember" >
                                <label for="ckb_unlockSoccerVRMember" class="btn-status btn-child btn-enable" title="Click to unlock all Members" data-selected="Click to unlock all Members" data-unselected="Click to revert selection">
                                    @(Model.MemberVirtualRate.UnlockSC)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockSoccerVRMember" data-downlines="@(Model.MemberVirtualRate.Count)" data-origin-downlines="@(Model.MemberVirtualRate.LockSC)" data-level="member" data-opposite-id="ckb_unlockSoccerVRMember" >
                                <label for="ckb_lockSoccerVRMember" class="btn-status btn-child btn-disable btn-soccer-disable-child" title="Click to lock all Members" data-selected="Click to lock all Members" data-unselected="Click to revert selection">
                                    @(Model.MemberVirtualRate.LockSC)
                                </label>
                            </td>
                        }
                    </tr>
                    <tr>
                        <td colspan="@leftColumn" class="l p-l5">
                            Basketball
                        </td>
                        <td class="c status-column" colspan="@spanFirstRow">
                            <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVR" @(Model.LockVirtualRateBasketballStatus ? "" : "checked")>
                            <label for="ckb_unlockBasketballVR" class="btn-status btn-parent @(Model.LockVirtualRateBasketballStatus ? "btn-disable" : "btn-enable")" title="Click lock/unlock Basketball VR" data-btn-type="basketball" data-value-enable="Unlocked" data-value-disable="Locked">
                                @(Model.LockVirtualRateBasketballStatus ? "Locked" : "Unlocked")
                            </label>
                        </td>
                        @if (roleId >= 4 && Model.MasterVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVRMaster" data-downlines="@(Model.MasterVirtualRate.Count)" data-origin-downlines="@(Model.MasterVirtualRate.UnlockBB)" data-level="master" data-opposite-id="ckb_lockBasketballVRMaster" >
                                <label for="ckb_unlockBasketballVRMaster" class="btn-status btn-child btn-enable" title="Click to unlock all Masters" data-selected="Click to unlock all Masters" data-unselected="Click to revert selection">
                                    @(Model.MasterVirtualRate.UnlockBB)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockBasketballVRMaster" data-downlines="@(Model.MasterVirtualRate.Count)" data-origin-downlines="@(Model.MasterVirtualRate.LockBB)" data-level="master" data-opposite-id="ckb_unlockBasketballVRMaster" >
                                <label for="ckb_lockBasketballVRMaster" class="btn-status btn-child btn-disable btn-basketball-disable-child" title="Click to lock all Masters" data-selected="Click to lock all Masters" data-unselected="Click to revert selection" data-downline-id="ckb_lockBasketballVRAgent">
                                    @(Model.MasterVirtualRate.LockBB)
                                </label>
                            </td>
                        }
                        @if (roleId >= 3 && Model.AgentVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVRAgent" data-downlines="@(Model.AgentVirtualRate.Count)" data-origin-downlines="@(Model.AgentVirtualRate.UnlockBB)" data-level="agent" data-opposite-id="ckb_lockBasketballVRAgent" >
                                <label for="ckb_unlockBasketballVRAgent" class="btn-status btn-child btn-enable" title="Click to unlock all Agents" data-selected="Click to unlock all Agents" data-unselected="Click to revert selection">
                                    @(Model.AgentVirtualRate.UnlockBB)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockBasketballVRAgent" data-downlines="@(Model.AgentVirtualRate.Count)" data-origin-downlines="@(Model.AgentVirtualRate.LockBB)" data-level="agent" data-opposite-id="ckb_unlockBasketballVRAgent" >
