                            Soccer
                        </td>
                        <td class="c status-column">
                            <input type="checkbox" class="checkbox-hide" id="ckb_unlockSoccerVR" checked=@(Model.LockVirtualRateStatus ? null : "checked")>
                            <label for="ckb_unlockSoccerVR" class="btn-status btn-parent @(Model.LockVirtualRateStatus ? "btn-disable" : "btn-enable")" title="Click lock/unlock Soccer VR" data-btn-type="soccer" data-value-enable="Unlocked" data-value-disable="Locked">
