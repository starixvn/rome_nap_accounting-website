                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockSoccerVRMember" data-downlines="2000" data-origin-downlines="1400" data-level="member" data-opposite-id="ckb_unlockSoccerVRMember" checked="">
                                <label for="ckb_lockSoccerVRMember" class="btn-status btn-child btn-disable btn-soccer-disable-child" title="Click to lock all Members" data-selected="Click to lock all Members" data-unselected="Click to revert selection">
                                    1400
                                </label>
                            </td>
