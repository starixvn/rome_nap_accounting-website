                    </tr>
                    <tr>
                        <td colspan="@leftColumn" class="l p-l5">
                            Basketball
                        </td>
                        <td class="c status-column">
                            <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVR" @(Model.LockVirtualRateBasketballStatus ? "" : "checked")>
                            <label for="ckb_unlockBasketballVR" class="btn-status btn-parent @(Model.LockVirtualRateBasketballStatus ? "btn-disable" : "btn-enable")" title="Click lock/unlock Basketball VR" data-btn-type="basketball" data-value-enable="Unlocked" data-value-disable="Locked">
                                @(Model.LockVirtualRateBasketballStatus ? "Locked" : "Unlocked")
                            </label>
                        </td>
                        @if (roleId >= 4)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVRMaster" data-downlines="2000" data-origin-downlines="600" data-level="master" data-opposite-id="ckb_lockBasketballVRMaster" checked="">
                                <label for="ckb_unlockBasketballVRMaster" class="btn-status btn-child btn-enable" title="Click to unlock all Masters" data-selected="Click to unlock all Masters" data-unselected="Click to revert selection">
                                    600
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockBasketballVRMaster" data-downlines="2000" data-origin-downlines="1400" data-level="master" data-opposite-id="ckb_unlockBasketballVRMaster" checked="">
                                <label for="ckb_lockBasketballVRMaster" class="btn-status btn-child btn-disable btn-basketball-disable-child" title="Click to lock all Masters" data-selected="Click to lock all Masters" data-unselected="Click to revert selection">
                                    1400
                                </label>
                            </td>
                        }
                        @if (roleId >= 3)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVRAgent" data-downlines="2000" data-origin-downlines="600" data-level="agent" data-opposite-id="ckb_lockBasketballVRAgent" checked="">
                                <label for="ckb_unlockBasketballVRAgent" class="btn-status btn-child btn-enable" title="Click to unlock all Agents" data-selected="Click to unlock all Agents" data-unselected="Click to revert selection">
                                    600
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockBasketballVRAgent" data-downlines="2000" data-origin-downlines="1400" data-level="agent" data-opposite-id="ckb_unlockBasketballVRAgent" checked="">
                                <label for="ckb_lockBasketballVRAgent" class="btn-status btn-child btn-disable btn-basketball-disable-child" title="Click to lock all Agents" data-selected="Click to lock all Agents" data-unselected="Click to revert selection">
                                    1400
                                </label>
                            </td>
                        }
                        @if (roleId >= 2)
                        {
