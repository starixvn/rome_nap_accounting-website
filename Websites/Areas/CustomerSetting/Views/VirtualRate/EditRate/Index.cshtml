                                    @(Model.AgentVirtualRate.LockBB)
                                </label>
                            </td>
                        }
                        @if (roleId >= 2 && Model.MemberVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_unlockBasketballVRMember" data-downlines="@(Model.MemberVirtualRate.Count)" data-origin-downlines="@(Model.MemberVirtualRate.UnlockBB)" data-level="member" data-opposite-id="ckb_lockBasketballVRMember" >
                                <label class="btn-status btn-child btn-enable" title="Click to unlock all Members" data-selected="Click to unlock all Members" data-unselected="Click to revert selection">
                                    @(Model.MemberVirtualRate.UnlockBB)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="ckb_lockBasketballVRMember" data-downlines="@(Model.MemberVirtualRate.Count)" data-origin-downlines="@(Model.MemberVirtualRate.LockBB)" data-level="member" data-opposite-id="ckb_unlockBasketballVRMember" >
                                <label for="ckb_lockBasketballVRMember" class="btn-status btn-child btn-disable btn-basketball-disable-child" title="Click to lock all Members" data-selected="Click to lock all Members" data-unselected="Click to revert selection">
                                    @(Model.MemberVirtualRate.LockBB)
                                </label>
