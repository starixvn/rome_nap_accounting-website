                                    @(Model.AgentVirtualRate.DisableAB)
                                </label>
                            </td>
                        }
                        @if (roleId >= 2 && Model.MemberVirtualRate != null)
                        {
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_enable_member_AB" data-downlines="@(Model.MemberVirtualRate.Count)" data-origin-downlines="@(Model.MemberVirtualRate.EnableAB)" data-level="member" data-opposite-id="chk_disable_member_AB" >
                                <label for="chk_enable_member_AB" class="btn-status btn-child btn-enable" title="Click to apply all Members">
                                    @(Model.MemberVirtualRate.EnableAB)
                                </label>
                            </td>
                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_disable_member_AB" data-downlines="@(Model.MemberVirtualRate.Count)" data-origin-downlines="@(Model.MemberVirtualRate.DisableAB)" data-level="member" data-opposite-id="chk_enable_member_AB" >
                                <label for="chk_disable_member_AB" class="btn-status btn-child btn-disable btn-ab-disable-child" title="Click to not apply all Members">
                                    @(Model.MemberVirtualRate.DisableAB)
                                </label>
                            </td>
                        }
                    </tr>

                    <tr>
                        <td nowrap="true" class="l b p-l5 status-title" colspan="@leftColumn">
                            @Customer_Labels.VirtualRate_LockVRLabel
                        </td>
                        <td class="padding-column status-title" colspan="@spanFirstRow"></td>
