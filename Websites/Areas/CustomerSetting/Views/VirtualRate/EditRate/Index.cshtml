                            <td class="c status-column">
                                <input type="checkbox" class="checkbox-hide" id="chk_enable_agent_AB" data-downlines="1800" data-origin-downlines="1500" data-level="agent" data-opposite-id="chk_disable_agent_AB" checked="">
