                            <input type="checkbox" class="checkbox-hide" id="ckb_unlockOtherSportsVR" checked=@(Model.LockVirtualRateOtherStatus ? null : "checked")>
                            <label for="ckb_unlockOtherSportsVR" class="btn-status btn-parent @(Model.LockVirtualRateOtherStatus ? "btn-disable" : "btn-enable")" title="Click lock/unlock Other Sports VR" data-btn-type="os" data-value-enable="Unlocked" data-value-disable="Locked">
