@using Fanex.Tarus.Customer.Entities.VirtualRate;
@using Fanex.Tarus.Customer.Resources;
@using Newtonsoft.Json;
@using Sunplus.Accounting.Business.Security;
@using Sunplus.Accounting.Core.Common;
@using Sunplus.Accounting.Core.Configurations;
@model CustomerVirtualRateModel
@{
    ViewBag.Title = Customer_Labels.Virtual_Rate;
    Layout = "";
    var customerVirtualRateModel = JsonConvert.SerializeObject(Model);
    var maxBetTypeColumn = 6;
    var tableColumnCount = maxBetTypeColumn + 2;

    var leftColumn = 4;
    var rightColumn = 4;
    int isManageVirtualRateAccess = Permissions.GetHostPermission(Enumerations.Functions.ExRates.VirtualRate) ? 1 : 0;
    var roleId = 0;
    if (Model.RoleName == "Super")
    {
        roleId = 4;
    }
    else if (Model.RoleName == "Master")
    {
        roleId = 3;
    }
    else if (Model.RoleName == "Agent")
    {
        roleId = 2;
    }
}
<style>
    .additionalaction {
        width: 180px;
        margin-left: 12px;
        font-size: 14px;
        line-height: 32px;
    }
    .additionalaction:after {
        margin-left:12px;
        content: "\276F";
    }
    .additionalexpanded:after {
        transform: rotate(90deg);
        content: "\276F";
        display: inline-block;
    }

    #additionalaction {
        display: none;
    }
    .vroptions {
        padding: 2px;
        margin: 2px;
    }
    ul.vroptions > li {
        list-style-type: none;
        display: inline-block;
        /* You can also add some margins here to make it look prettier */
        padding: 2px;
        width: 100px;
        *display: inline;
        /* this fix is needed for IE7- */
    }
    
</style>
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
<link rel="stylesheet" type="text/css" href="~/Areas/CustomerSetting/Views/VirtualRate/EditRate/Styles/VirtualRate.less" />
<link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet" type="text/css" />
<div class="main">
    <div class="maincontent">
        <div id="result-message">
        </div>
        <div id="virtual-rate-setting-container">
            <table id="virtual-rate-setting" class="tbllayout" cellspacing="1" border="0">
                <thead>
                    <tr class="title">
                        <td colspan="@tableColumnCount">
                            @Model.RoleName: @Model.Username
                            <a class="infoIcon" title="@Customer_Labels.VirtualRate_ViewSetting_Title" target="_blank">
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="r" colspan="@leftColumn">
                            @Customer_Labels.Actual_Exchange_Rate
                        </td>
                        <td nowrap="true" class="b l" colspan="@rightColumn">
                            @Model.ActualExchangeRate
                        </td>
                    </tr>
                    <tr>
                        <td nowrap="true" class="r" colspan="@leftColumn">
                            @Customer_Labels.Apply_Virtual_Rate
                        </td>
                        <td nowrap="true" class="l" colspan="@rightColumn">
                            <input id="chk-enable" type="checkbox" value="false" />
                            <label style="vertical-align:top;">@Customer_Labels.Apply_Virtual_Rate_Notes</label>
                        </td>
                    </tr>
                    <tr>
                        <td nowrap="true" class="r" colspan="@leftColumn">
                            @Customer_Labels.VirtualRate_LockVRLabel
                        </td>
                        <td nowrap="true" class="l" colspan="@rightColumn">
                            <input id="chk-lockVR" type="checkbox" value="false" /><lable>Soccer</lable>
                            <input id="chk-lockVRBasketball" type="checkbox" value="false" /><lable>Basketball</lable><br />
                            <input id="chk-lockVROther" type="checkbox" value="false" /><label>Other Sports (Except E-Sports)</label><br />
                            <label style="vertical-align:top;">@Customer_Labels.VirtualRate_LockVRNotes</label>
                        </td>
                    </tr>
                    @if (roleId > 1)
                    {
                        <tr>
                            <td class="l" colspan="@tableColumnCount"><a href="javascript:void(0);" class="additionalaction">Additional actions</a></td>
                        </tr>
                        <tr id="additionalaction">
                            <td class="l" colspan="@tableColumnCount">
                                <ul class="l vroptions">
                                    <li>Unlock VR for:</li>
                                    @if (roleId > 3)
                                    {
                                        <li><input id="chk-lockVRMaster" type="checkbox" value="false" /><lable>All Masters</lable></li>
                                    }
                                    @if (roleId > 2)
                                    {
                                        <li><input id="chk-lockVRAgent" type="checkbox" value="false" /><lable>All Agents</lable></li>
                                    }
                                    <li><input id="chk-lockVRMember" type="checkbox" value="false" /><lable>All Members</lable></li>

                                </ul>
                                <ul class="l vroptions">
                                    <li>Enable VR for:</li>
                                    @if (roleId > 3)
                                    {
                                        <li><input id="chk-enableVRMaster" type="checkbox" value="false" /><lable>All Masters</lable></li>
                                    }
                                    @if (roleId > 2)
                                    {
                                        <li><input id="chk-enableVRAgent" type="checkbox" value="false" /><lable>All Agents</lable></li>
                                    }
                                    <li><input id="chk-enableVRMember" type="checkbox" value="false" /><lable>All Members</lable></li>
                                </ul>
                            </td>
                        </tr>
                    }
                    <tr class="padding-row">
                        <td colspan="@tableColumnCount">
                            &nbsp;
                        </td>
                    </tr>
                    <tr>
                        <td colspan="@tableColumnCount">
                            <input id="btnSubmit1" type="button" value="@Customer_Labels.Update" name="btnSubmit" class="btn" />
                        </td>
                    </tr>

                </thead>
                <tbody></tbody>
            </table>
            <div class="update-warning">@Customer_Labels.VirtualRate_UpdateWarning</div>
            <input id="btnSubmit" type="button" value="@Customer_Labels.Update" name="btnSubmit" class="btn" />
        </div>
    </div>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/jQuery/json2.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.blockUI.1.33.js"></script>
    <script type="text/javascript" src="~/js/BlockUI.js"></script>
    <script type="text/javascript" src="~/js/Utils/FormatLibs/NumberFormat/numeral.js"></script>
    <script src="~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js" type="text/javascript"></script>
    <script src="~/js/Popup/confirmbox.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/Areas/CustomerSetting/Views/VirtualRate/EditRate/Scripts/VirtualRateController.js?v=@WebSettings.Version"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var customerVirtualRateModel= @Html.Raw(customerVirtualRateModel);
        var oldCustomerVirtualRateModel= @Html.Raw(customerVirtualRateModel);
        var maxBetTypeColumn = @maxBetTypeColumn;
        var tableColumnCount = @tableColumnCount;
        var isManageVirtualRateAccess = @isManageVirtualRateAccess;
        var custId = @Model.CustId;
        var viewResources = {
            Live: '@Customer_Labels.Live',
            Non_Live: '@Customer_Labels.Non_Live',
            Copy: '@Customer_Labels.Copy',
            VirtualRate_CopyFromHDP: '@Customer_Labels.VirtualRate_CopyFromHDP',
            VirtualRate_CopyToAllSportTypeBettypeFromHDP: '@Customer_Labels.VirtualRate_CopyToAllSportTypeBettypeFromHDP',
            System_Error: '@Customer_Labels.System_Error',
            VirtualRate_UpdateConfirm: customerVirtualRateModel.RoleName === "Member" ?
                '@Customer_Labels.VirtualRate_UpdateConfirmMember' :
                '@Customer_Labels.VirtualRate_UpdateConfirm',
            Symbol_Percent: '@Customer_Labels.Symbol_Percent',
            NoPermission_OnFunction: '@Customer_Labels.NoPermission_OnFunction',
            VirtualRate_CopyBasketballToAllSportTypeBettypeFromHDP: '@Customer_Labels.VirtualRate_CopyBasketballToAllSportTypeBettypeFromHDP'
        };

        $('.additionalaction').click(function () {   
            $(this).toggleClass('additionalexpanded');
            $('#additionalaction').toggle();
        });


    </script>
</div>
