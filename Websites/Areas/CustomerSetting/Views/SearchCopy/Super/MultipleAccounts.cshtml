@model Fanex.CustomerSetting.Module.SearchCopy.ViewModels.MultipleAccountsViewModel
@{
    Layout = null;
    var version = Sunplus.Accounting.Core.Configurations.WebSettings.Version;
    var customer = Model.Customer;
    var isSuper = customer.RoleId == 4;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Accounting Admin System</title>
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/common.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/input.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/Message.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/table.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Styles/MultipleAccounts/Style.css?v=" + version)" />
</head>
<body>
    <div class="maincontent">
        <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
            <tr>
                <td class="maincontent_headerL"></td>
                <td class="maincontent_headerC">Copy To Multiple Accounts</td>
                <td class="maincontent_headerR"></td>
            </tr>
        </table>
        <div id="sectionMessage"></div>
        <div class="bg_table">
            <table class="tblcollapse tblSourceAccount">
                <tbody>
                    <tr>
                        <td>
                            <div class="sourceAccount">Source @(isSuper ? "Super" : "Member"): <span class="b">@Model.CustName</span></div>
                        </td>
                    </tr>
                </tbody>
            </table>
            <table class="tblcollapse tblGeneralInfo">
                <thead>
                    <tr class="title c">
                        <th colspan="4">Copied Accounts</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4">Usernames (separated by ',')</td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <textarea id="txtUsernames" cols="50" rows="5"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="w90">
                            <label for="txtPassword">Password</label>
                        </td>
                        <td>
                            <input type="password" id="txtPassword"/>
                        </td>
                        @if (isSuper)
                        {
                            <td class="w90">
                                <label for="chkInternalUser">Internal User</label>
                            </td>
                            <td>
                                <input type="checkbox" id="chkInternalUser" />
                            </td>
                        }
                        else
                        {
                            <td colspan="2"></td>
                        }
                    </tr>
                    <tr>
                        <td>
                            <label for="txtFirstName">First Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtFirstName" />
                        </td>
                        <td>
                            <label for="txtLastName">Last Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtLastName" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="txtPhone">Phone</label>
                        </td>
                        <td>
                            <input type="text" id="txtPhone" />
                        </td>
                        <td>
                            <label for="txtMobilePhone">Mobile Phone</label>
                        </td>
                        <td>
                            <input type="text" id="txtMobilePhone" />
                        </td>
                    </tr>
                    @if (isSuper)
                    {
                        <tr>
                            <td>
                                <label for="ddSite">Site</label>
                            </td>
                            <td>
                                @Html.DropDownList("ddSite", Model.Sites, new { id = "ddSite" })
                            </td>
                            <td>
                                <label for="txtFax">Fax</label>
                            </td>
                            <td>
                                <input type="text" id="txtFax" />
                            </td>
                        </tr>
                        <tr>
                            <td class="w90">
                                <label for="txtCredit">Max Credit</label>
                            </td>
                            <td>
                                <input type="text" id="txtCredit" maxlength="18" />
                            </td>
                            <td>
                                <label>Currency</label>
                            </td>
                            <td>
                                <label>@customer.Currency</label>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td class="w90">
                                <label for="txtCredit">Given Credit</label>
                            </td>
                            <td>
                                <input type="text" id="txtCredit" maxlength="18" />
                                <span><=@int.Parse(customer.CreditMax).ToString("N0")</span>
                            </td>
                            <td>
                                <label for="txtFax">Fax</label>
                            </td>
                            <td>
                                <input type="text" id="txtFax" />
                            </td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="warning">
                            <div>Warning: After submit, Please do not close this browser tab or the creation process will be aborted.</div>
                            <div>You can leave this tab open and continue your work on other tabs.</div>
                            <div>If you accidentally close the tab, you must create the "Not created" account(s) again.</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" class="c">
                            <button id="btnSubmit" class="btn">&nbsp;&nbsp;Submit&nbsp;&nbsp;</button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <table class="tblcollapse hide" id="tblProgress">
                <thead>
                    <tr class="title c">
                        <th colspan="3">Progress</th>
                    </tr>
                    <tr class="title_1 c">
                        <th class="w35">#</th>
                        <th class="w250">Copied Account</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript">
        var viewModel = {
            rootUrl: "@ViewBag.RootUrl",
            maxInputUsernames: @Model.DefaultMaxInputUsername,
            maxGivenCredit: "@customer.CreditMax",
            code: "@Fanex.Tarus.Security.Services.Encryptor.Code",
            currencyId: @customer.CurrencyId,
            existingCustId: @Model.CustId,
            isSyncCasino: @Convert.ToBoolean(customer.IsSyncCasino).ToString().ToLowerInvariant(),
            disableCasino: @customer.DisableCasino.ToString().ToLowerInvariant(),
            custLevel: @customer.RoleId,
            uplineId: @Model.ParentId,
            isSyncNG2: @Convert.ToBoolean(customer.IsSyncNG2).ToString().ToLowerInvariant(),
            disableNG2: @Convert.ToBoolean(customer.DisableNG2).ToString().ToLowerInvariant()
        };
    </script>
    <script type="text/javascript" src="@Url.Content("~/js/encode.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/BlockUI.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Scripts/MultipleAccounts.js?v=" + version)"></script>
</body>
</html>