@{
    Layout = null;
    var version = Sunplus.Accounting.Core.Configurations.WebSettings.Version;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Accounting Admin System</title>
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/common.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/input.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/Message.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/table.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Styles/MultipleAccounts/Style.css?v=" + version)" />
</head>
<body>
    <div class="maincontent">
        <div id="sectionMessage"></div>
        <div class="bg_table">
            <div style="display: none" id="tableNote">
                <table class="tblcollapse tblSourceAccount">
                    <tbody>
                        <tr>
                            <td>
                                <div id="headlineBelongSite"></div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="notAllowedSuperPrefixes_multiple"></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>  
            <div style="margin-top: 8px">
                <span>Source Account</span>
                <input id="existedUserName" type="text"
                       required />
                <span id="checkExisted" class="success" style="display: none"></span>
            </div>
            <table class="tblcollapse tblGeneralInfo">
                <thead>
                    <tr class="title c">
                        <th colspan="4">Copied Accounts</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4">Usernames (separated by ',')</td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <textarea id="txtUsernames" cols="50" rows="5"></textarea>
                        </td>
                    </tr>
                    <tr id="passwordRow">
                        <td class="w90">
                            <label for="txtPassword">Password</label>
                        </td>
                        <td>
                            <input type="password" id="txtPassword" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label for="txtFirstName">First Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtFirstName" />
                        </td>
                        <td>
                            <label for="txtLastName">Last Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtLastName" />
                        </td>
                    </tr>
                    <tr id="phoneRow">
                        <td>
                            <label for="txtPhone">Phone</label>
                        </td>
                        <td>
                            <input type="text" id="txtPhone" />
                        </td>
                        <td>
                            <label for="txtMobilePhone">Mobile Phone</label>
                        </td>
                        <td>
                            <input type="text" id="txtMobilePhone" />
                        </td>
                    </tr>
                    <tr style="display: none" id="siteRow"></tr>
                    <tr style="display: none" id="superCreditRow"></tr>
                    <tr style="display: none" id="memberCreditRow"></tr>
                    <tr>
                        <td colspan="4" class="warning">
                            <div>Warning: After submit, Please do not close this browser tab or the creation process will be aborted.</div>
                            <div>You can leave this tab open and continue your work on other tabs.</div>
                            <div>If you accidentally close the tab, you must create the "Not created" account(s) again.</div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" class="c">
                            <button id="btnSubmit" class="btn">&nbsp;&nbsp;Submit&nbsp;&nbsp;</button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <table class="tblcollapse hide" id="tblProgress">
                <thead>
                    <tr class="title c">
                        <th colspan="3">Progress</th>
                    </tr>
                    <tr class="title_1 c">
                        <th class="w35">#</th>
                        <th class="w250">Copied Account</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript">
        function toUrl(relativeUrl) {
            return '@Url.Content("~/CustomerSetting/SearchCopy/")' + relativeUrl;
        };
        var viewModel = {
            rootUrl: "@ViewBag.RootUrl",
            code: "@Fanex.Tarus.Security.Services.Encryptor.Code",
            getSuperPrefixesUrl: "@Url.Content("~/AddNewSuper/GetSuperPrefixes")",
            getHeadlineBelongSiteUrl: "@Url.Content("~/AddNewSuper/GetHeadlineBelongSite")"
        };
    </script>
    <script type="text/javascript" src="@Url.Content("~/js/encode.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/BlockUI.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Scripts/Libs/formatNumberExtension.js?v=20140109_1")"></script>
    <script type="text/javascript" src="@Url.Content("~/Areas/CustomerSetting/Views/SearchCopy/Scripts/MultipleAccounts.js?v=" + version)"></script>
</body>
</html>