@using Fanex.PTEngine.BusinessObjects
@using Fanex.CustomerSetting.Module.Core
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@model IBettingLimit<BettingLimitItem>
@{
    var bettingLimit = JsonConvert.SerializeObject(Model, Formatting.None , new JsonSerializerSettings
    {
        ContractResolver = new CamelCasePropertyNamesContractResolver(),
        NullValueHandling = NullValueHandling.Ignore
    });

    var id = Utils.ToInt32(Request.RequestContext.RouteData.Values["id"]);
    var uplineId = Utils.ToInt32(Request.RequestContext.RouteData.Values["uplineId"]);
    var userId = Utils.ToInt32(Request.RequestContext.RouteData.Values["userId"]);
}
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Styles/Validators.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Sportsbook/Styles/Sportsbook.css")" rel="stylesheet" type="text/css" />
<div id="ng-app" ng-app="sportsBookApp" ng-controller="SportsbookController" ng-init="Init()" style="width: 815px">
    <div id="errMsg" style="display: none" class="errMsg">
    </div>
    <table class="tableInfo" border="1" cellpadding="0" cellspacing="0">
        <tr>
            <td class="title titleWidth"></td>
            <td class="title bold C betWidth">Min Bet</td>
            <td class="title bold C betWidth">Max Bet</td>
            <td class="title bold C betWidth">Max Per Match</td>
        </tr>
        <tr ng-model="betting.bgClass" class="{{betting.bgClass}}" id="{{betting.resourceKey}}" ng-hide="betting.isNumberGame" ng-init="betting.bgClass = ''; betting.isNumberGame = betting.resourceKey == 'numbergame'; betting.className = betting.id == 1 || betting.id == 2" ng-repeat="betting in bettingLimits">
            <td title="{{betting.title}}" id="_{{betting.resourceKey}}" class="title {{betting.className}} {{betting.bgClass}}" ng-click="Copy(this)">{{betting.name}}</td>
            <td>
                <input id="txt{{betting.resourceKey}}Min" ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber(); betting.preValMinBet = betting.minBetFormated" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.minBetFormated" ng-change="betting.minBet = betting.minBetFormated" />
                <span ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
            </td>
            <td>
                <input id="txt{{betting.resourceKey}}Max" ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber(); betting.preValMaxBet = betting.maxBetFormated" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.maxBetFormated" ng-change="betting.maxBet = betting.maxBetFormated" />
                <span ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
            </td>
            <td>
                <input id="txt{{betting.resourceKey}}MaxPerMatch" ng-readonly="betting.bgClass == 'inactive'" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber(); betting.preValMaxPerMatch = betting.maxPerMatchFormated" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.maxPerMatchFormated" ng-change="betting.maxPerMatch = betting.maxPerMatchFormated" />
                <span ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
            </td>
        </tr>
        <tr ng-init="betting = bettingLimits[bettingLimits.length - 1]">
            <td colspan="4">
                <table cellpadding="0" cellspacing="0" class="tableInfo">
                    <tr>
                        <td rowspan="2" class="title titleWidth noneBorderTop noneBorderLeft noneBorderBottom">{{betting.name}}</td>
                        <td class="title bold C numberGameWidth noneBorderTop">Min Bet</td>
                        <td class="title bold C numberGameWidth noneBorderTop">Max Bet</td>
                        <td class="title bold C numberGameWidth noneBorderTop">Max Per Match</td>
                        <td class="title bold C numberGameWidth noneBorderTop noneBorderRight">Max Per Ball</td>
                    </tr>
                    <tr>                        
                        <td class="noneBorderBottom">
                            <input id="txt{{betting.resourceKey}}Min1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showminBetMax = betting.minBetMax > 0; betting.minBetFormated = betting.minBet.formatNumber()" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.minBetFormated" ng-change="betting.minBet = betting.minBetFormated" />
                            <span ng-show="betting.showminBetMax">>={{betting.minBetMax.formatNumber()}}</span>
                        </td>
                        <td class="noneBorderBottom">
                            <input id="txt{{betting.resourceKey}}Max1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showmaxBetMin = betting.maxBetMin > 0; betting.maxBetFormated = betting.maxBet.formatNumber()" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.maxBetFormated" ng-change="betting.maxBet = betting.maxBetFormated" />
                            <span ng-show="betting.showmaxBetMin"><={{betting.maxBetMin.formatNumber()}}</span>
                        </td>
                        <td class="noneBorderBottom">
                            <input id="txt{{betting.resourceKey}}MaxPerMatch1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showmaxPerMatchMax = betting.maxPerMatchMax > 0; betting.maxPerMatchFormated = betting.maxPerMatch.formatNumber()" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.maxPerMatchFormated" ng-change="betting.maxPerMatch = betting.maxPerMatchFormated" />
                            <span ng-show="betting.showmaxPerMatchMax"><={{betting.maxPerMatchMax.formatNumber()}}</span>
                        </td>
                        <td class="noneBorderBottom noneBorderRight">
                            <input id="txt{{betting.resourceKey}}MaxPerBall1" class="BettingLimitTextBox9" oncut="return false;" onpaste="return false;" onkeypress="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this)" maxlength="13" ng-init="betting.showmaxPerBallMax = betting.maxPerBallMax > 0; betting.maxPerBallFormated = betting.maxPerBall.formatNumber()" type="text" maxlength="14" class="BettingLimitTextBox" ng-model="betting.maxPerBallFormated" ng-change="betting.maxPerBall = betting.maxPerBallFormated" />
                            <span ng-show="betting.showmaxPerBallMax"><={{betting.maxPerBallMax.formatNumber()}}</span>
                        </td>
                    </tr>
                </table>
            </td>            
        </tr>
    </table>
    <div style="text-align: right" >
        <input class="buttonPopup" type="button" value="Submit" />
    </div>
</div>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/angular.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Validators.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Areas/CustomerSetting/Views/BetSetting/Sportsbook/Scripts/SportsbookController.js")" type="text/javascript"></script>
<script type="text/javascript">
    var model = JSON.parse(Fanex.CustomerSetting.Core.DecodeHtml('@bettingLimit'));
    var custId = parseInt('@id');
    var uplineId = parseInt('@uplineId');
    var userId = parseInt('@userId');

    function toUrl(relativeUrl) {
        return '@Url.Content("~/CustomerSetting/BetSetting/")' + relativeUrl;
    }

    $(document).ready(function () {
        $('.buttonPopup').bind('click', function () {
            Update(function (data) {
                console.log(data);
            });
        });
    });
</script>