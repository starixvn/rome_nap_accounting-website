@using Fanex.Tarus.Customer.Resources;
@{
    ViewBag.Title = Customer_Labels.Index;
}
@model string
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/CustomerSetting/Views/MicroGaming/UpdateStatus/Styles/UpdateStatus.css" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <div id="result-message">
                Loading....</div>
            <div id="setting-container" class="display-none">
                <table class="tblcollapse content-width" id="table-settings">
                    <thead>
                        <tr class="title1">
                            <td id="customer-info-title" colspan="2">
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="l">
                            <td class="column-currentrole">
                                <input type="checkbox" id="chkSetting" />
                                <label class="label-for-checkbox" for="chkSetting">@Customer_Labels.Enable_Microgaming
                                </label>
                            </td>
                            <td class="column-downline">
                                <input type="checkbox" id="chkDownlineSetting" disabled="disabled" />
                                <label id="lblDownlineSetting" class="label-for-checkbox" for="chkDownlineSetting"
                                    disabled="disabled">@Customer_Labels.Enable_Downlines
                                </label>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table cellspacing="0" cellpadding="0" border="0">
                    <tr id="button-update">
                        <td class="custBtn1" disabled="disabled">
                        </td>
                        <td class="custBtn2 hand" disabled="disabled">
                            @Customer_Labels.Update
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        var rootUrl = '@Url.Content("~")'; 
        var hasHostPermission = @ViewBag.HasHostPermission;
        var model = @Html.Raw(Model);
        var viewResources = 
        {
            Invalid_Customer: '@Customer_Labels.Invalid_Customer',
            Super: '@Customer_Labels.Super',
            Master: '@Customer_Labels.Master',
            Agent: '@Customer_Labels.Agent',
            Member: '@Customer_Labels.Member'
        };
    </script>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script type="text/javascript" src="~/Areas/CustomerSetting/Views/MicroGaming/UpdateStatus/Scripts/UpdateStatusManager.js"></script>
</body>
</html>
