@model bool
@{ 
    var _checked = Model ? "checked='checked'" : string.Empty;
}
<!DOCTYPE html>
<html>
    <head>
        <title></title>
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/common.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/table.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/input.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/Message.css")" />
    </head>
    <body>
        <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
            <tbody>
                <tr>
                    <td class="maincontent_headerL"></td>
                    <td class="maincontent_headerC fixfont">
                        ON/OFF IMBC Restriction
                    </td>
                    <td class="maincontent_headerR"></td>
                </tr>
            </tbody>
        </table>
        <div id="divShowInfo" class="maincontent_box" style="width: 400px;">
            <div id="errMsg" class="error-message">
            </div>
            <div>
                <label>
                    <div>
                        <input @_checked id="chkAllowedPTChargeComm" type="checkbox" />Allow Master/Agent to Edit PT/Charge Commission Setting&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input onclick="IMBC.UpdateRestriction();" class="btn" type="button" value="Submit" />
                    </div>
                </label>
            </div>
        </div>
        <script type="text/javascript">
            function resolveClientUrl(relativePath){
                return '@Url.Content("~/")' + relativePath;
            }
        </script>
        <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")" type="text/javascript"></script>        
        <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/js/common.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Areas/CustomerSetting/Views/IMBCRestriction/Scripts/IMBCRestriction.js")"></script>  
    </body>
</html>
