            <tr>
                <th class='col-level' rowspan='2'></th>
                @if (Model.RoleId <= RoleIdConstants.Super)
                {
                    <th colspan="4">@CN88Resources.Role_4</th>
                }
                @if (Model.RoleId <= RoleIdConstants.Master)
                {
                    <th colspan="4">@CN88Resources.Role_3</th>
                }
                @if (Model.RoleId <= RoleIdConstants.Agent)
                {
                    <th colspan="4">@CN88Resources.Role_2</th>
                }
                @if (Model.RoleId <= RoleIdConstants.Member)
                {
                    <th>@CN88Resources.Role_1</th>
                }
            </tr>
            <tr>
                @if (Model.RoleId <= RoleIdConstants.Super)
                {
                    <th class="col-comm">A</th>
                    <th class="col-comm">B</th>
                    <th class="col-comm">C</th>
                    <th class="col-comm">D</th>
