@using Fanex.Tarus.CN88.Models.PositionTaking
@using Fanex.Tarus.CN88.Constants
@using Fanex.Tarus.CN88.Resources
@model LineCommModel
@{
    Layout = null;
    var numberOfColumns = 0;
    switch (Model.RoleId)
    {
        case 4:
            numberOfColumns = 5;
            break;
        case 3:
            numberOfColumns = 9;
            break;
        case 2:
            numberOfColumns = 13;
            break;
        case 1:
            numberOfColumns = 14;
            break;
    }
}
@if (Model.RoleId >= 1)
