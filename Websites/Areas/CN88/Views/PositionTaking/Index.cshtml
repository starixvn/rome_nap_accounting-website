@using Sunplus.Accounting.Core.Configurations
@using Fanex.Tarus.CN88.Resources
@using Fanex.Tarus.CN88.Models
@model CustInfoModel
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>View PT/Comm - CN88</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/PT.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/CN88/Views/PositionTaking/Styles/ViewPT.css" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="maincontent_headerL"></td>
                    <td class="maincontent_headerC">@CN88Resources.ViewPTCommCN88</td>
                    <td class="maincontent_headerR"></td>
                </tr>
            </table>
            <div class="maincontent_box">
                <table cellpadding="2">
                    <tr>
                        <td class="b">Username</td>
                        <td><input id="txt-username" type="text" class="txt txt-username" disabled="disabled" value="@Model.Username" /></td>
                        <td><input id="btn-submit" type="button" value="Submit" class="btn" disabled="disabled" /></td>
                    </tr>
                </table>
            </div>
            <div id="div-result" class="bg_table display-none">
                <div id="div-error-message"></div>
                <div id="result-tbls" class="result-tbls display-none">
                    <div class="div-line-info">
                        <table id="tbl-line-info" class="tbl-line-info"><tbody></tbody></table>
                    </div>
                    <div id="div-pt" class="div-pt">
                        <div class="b">@CN88Resources.PTByPercent</div>
                        <table id="tbl-pt" class="layout_table c tbl-pt">
                            <thead>
                                <tr>
                                    <th class="col-level"></th>
                                    <th class="col-sportsbook-current">@(CN88Resources.Sportsbook + " (" + @CN88Resources.Current + ")")</th>
                                    <th class="col-nonsports-current">@(CN88Resources.Nonsport + " (" + @CN88Resources.Current + ")")</th>
                                    <th class="col-sportsbook-new">@(CN88Resources.Sportsbook + " (" + @CN88Resources.New + ")")</th>
                                    <th class="col-nonsports-new">@(CN88Resources.Nonsport + " (" + @CN88Resources.New + ")")</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div id="div-comm" class="div-comm">
                        <div class="b">@CN88Resources.CommByPercent</div>
                        <table id="tbl-comm" class="layout_table tbl-comm">
                            <thead></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.json-2.2.min.js"></script>
    <script type="text/javascript" src="~/js/jQuery/jquery.blockUI.1.33.js"></script>
    <script type="text/javascript" src="~/js/BlockUI.js"></script>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script type="text/javascript" src="~/Areas/CN88/Views/PositionTaking/Scripts/ViewPT.js"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var resources = {
            Min: '@CN88Resources.Min',
            Max:'@CN88Resources.Max',
            Customer: '@CN88Resources.Customer',
            DontHavePermission: '@Resources.Language.DontHavePermission'
        };
    </script>
</body>
</html>
