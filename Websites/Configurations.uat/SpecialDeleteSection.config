      <stores>
        <add alias="12eu" name="username" to="" cc="" bcc=""></add>
        <add alias="testing" name="username" to="" cc="" bcc=""></add>
      </stores>
    </add>
    <add alias="MHC" name="MHC" IsAllowOptionDelete="1" DeleteoOtionDefault="0"></add>
  </DeleteBet>

  <RecoverBet>
