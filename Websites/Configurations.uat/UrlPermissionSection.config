<?xml version="1.0" encoding="utf-8" ?>
<!--
  [A]: Check Special Site permission
  [B]: Check Credit/Deposit permission
-->
<UrlPermissionSection defaultParams="custid,customerid,username,custname">
  <Functions>
    <!--Top panel» Customer» New Customer-->
    <add url="/CustomerSetting/SearchCopy/Super/SearchExistingSuper" filters="[A],[B]" />
    <add url="/CustomerSetting/SearchCopy/Super/CopyExistingSuper" params="ExistingCustId" policy="3" filters="[A],[B]" />
    <add url="/CustomerSetting/SearchCopy/Super/MultipleAccounts" filters="[A],[B]" />

    <!--Top panel» Customer» Move Customer-->
    <add url="/Handlers/UpdateMoveCust.ashx" params="upline" filters="[A]" />
    
    <!--Top panel» Customer» Move Site-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/GetCustomerInfoMoveSite" filters="[A]" />
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/UpdateCustomerSite" filters="[A]" />

    <!--Top panel» Customer» View PT/View Comm-->
    <add url="/Customer/PT/ViewPT/ViewPT.aspx" filters="[A],[B]" />
    <add url="/Services/WCF/PT/ViewPT/ViewPTService.svc/ViewPositionTaking" filters="[A],[B]" />
    <add url="/Services/WCF/PT/ViewPT/ViewPTService.svc/ViewCommission" filters="[A],[B]" />
    
    <!--Top panel» Customer» View Log-->
    <add url="/LogDisplay/Setting/Display.aspx" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogSetting" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogStatus" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogCredit" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogLogin" filters="[A],[B]" />

    <!--Top panel» Admin» Manage External Accounts-->
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/AddSuperToGroup" filters="[A]" />
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/RemoveSuperFromGroup" filters="[A]" />
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/ChangePrimaryGroup" filters="[A]" />

    <!--Top panel» Admin» Configure Max New Members-->
    <add url="/Matrix/LimitNewMember/SearchSuper" params="super" filters="[B]" />
    <add url="/Matrix/LimitNewMember/UpdateLimitNewMember" params="super" policy="3" filters="[B]" />

    <!--Left Panel» Search-->
    <add url="/CustInfo.aspx" filters="[B]" />
    
    <!--Left Panel» {Customer}» Internal login Alpha-->
    <add url="/InternalView.aspx" filters="[B]" />

    <!--Left Panel» {Customer}» Customer List-->
    <add url="/CustomerList/MasterAgentList" params="superid" filters="[A],[B]" />
    <add url="/CustomerList/AgentList" params="masterid" filters="[A],[B]" />
    <add url="/CustomerList/MemberList" params="agentid" filters="[A],[B]" />
    
    <!--Left Panel» {Member}» Bet List-->
    <add url="/TarusBetList/BetListByCustInfo" filters="[A],[B]" />
    <add url="/TarusBetList/GetBetListByCustInfo_DateRange" filters="[A],[B]" />
    <add url="/BetList/GetBetListByCustInfo_Refno" filters="[A],[B]" />
    <add url="/ExchangeBetList/GetData" filters="[A]" />
    <add url="/ExchangeBetList/GetDetails" filters="[A]" />
    <add url="/BetList/GetBetListByIP_Soccer" filters="[A],[B]" />

    <!--Left Panel» {Customer}» Statement-->
    <add url="/Statement/CustomerStatement.aspx" filters="[A],[B]" />
    <add url="/NapStatement/StatementReport/GetCustomerInfo" params="username" filters="[A],[B]" />
    <add url="/Statement/GetData.ashx" filters="[A],[B]" />
