  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <staticContent>
      <remove fileExtension=".less" />
      <mimeMap fileExtension=".less" mimeType="text/css" />
    </staticContent>
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="CustomerAuthorizationHttpModule" />
      <!--<remove name="OTPHttpModule" />-->
      <add name="CustomerAuthorizationHttpModule" type="Fanex.Tarus.Security.HttpModules.CustomerAuthorizationHttpModule" preCondition="integratedMode" />
      <!--<add name="OTPHttpModule" type="Fanex.Tarus.OTP.HttpModules.OTPHttpModule" preCondition="integratedMode" />-->
    </modules>
  </system.webServer>
