  <!--entlib configuration-->
  <dataConfiguration defaultDatabase="DBLogConnectionString" />
  <!--/entlib configuration-->
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] &lt;%X{auth}&gt; - %m%n" />
      </layout>
    </appender>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="LogCS/CasinoLibrary.txt" />
      <appendToFile value="true" />
      <maximumFileSize value="100MB" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="5" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d{HH:mm:ss.fff} [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
    <appender name="RobotTrapRecorderFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="TrapLogs\" />
      <datePattern value="'trap-debug-'dd-MM-yyyy'.log'" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="100MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
      </layout>
    </appender>
    <!-- levels: DEBUG, INFO, WARN, ERROR, FATAL -->
    <root>
      <level value="DEBUG" />
      <appender-ref ref="ConsoleAppender" />
      <appender-ref ref="GeneralLog" />
    </root>
    <logger name="RobotTrapRecorder">
      <level value="ALL" />
      <level value="INFO" />
      <appender-ref ref="RobotTrapRecorderFileAppender" />
    </logger>
  </log4net>
