@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Utils
@using Fanex.Tarus.BetList.Helper
@helper Render(ITicket ticket)
{
    var isInvalid = CN88BetListHelpers.IsInvalidTicket(ticket);
    switch (ticket.Status.ToLower())
    {
        case "running":
        case "waiting":
        case "pending":
            {
                <td class="width80 r">0.00</td>
            }
            break;
        case "void":
            {
                <td class="width80 r col-winloss">@(ticket.BetTypeId.Equals(500) ? "(NW) 0.00" : "-")</td>
            }
            break;
        case "reject":
            if (ticket.RefCode != 0 &&
            (ticket.WalletType == 0 || ticket.WalletType == 1 || ticket.WalletType == 2))
            {
                <td class="width80 r col-winloss">(NW) @(new HtmlString(ConvertByBetType.Winloss((ticket.Winlost + ticket.PlayerComm))))</td>
            }
            else
            {
                <td class="width80 r col-winloss">-</td>
            }
            break;
        default:
            if (isInvalid)
            {
                <td class="width80 r col-winloss">-</td>
            }
            else
            {
                <td class="width80 r">@(new HtmlString(ConvertByBetType.Winloss((ticket.Winlost + ticket.PlayerComm))))</td>
            }
            break;
    }

}
