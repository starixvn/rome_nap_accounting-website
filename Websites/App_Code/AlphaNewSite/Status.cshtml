@using Fanex.Tarus.BetList.Models.CN88
@using Fanex.BetList.Core.Builder
@using Fanex.BetList.Core.Entities

@helper Render(TicketDto ticket, IBetListHTMLBuilder builder, ITicketHelper helper, IEnumerable<ITicketData> ticketData, bool isShowVNIP)
{
