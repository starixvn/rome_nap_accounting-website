@using Fanex.Tarus.BetList.Models.CN88
@using CN88.BetList.Core.Builders
@using Fanex.BetList.Core.Entities

@helper Render(TicketDto ticket, IBetListCN88HtmlBuilder builder, ITicketHelper helper, IEnumerable<ITicketData> ticketData)
{
    <td class="width300 table-cell">
        @(new HtmlString(builder.BuildChoice(ticket, helper, ticketData.ToList())))
    </td>
}
