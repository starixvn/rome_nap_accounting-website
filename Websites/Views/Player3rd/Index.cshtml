@using Sunplus.Accounting.Core.Configurations;
@{
    Page.Title = "Title goes here";
    //Layout = "Your Layout Page goes here";
}
@section Styles{
    <link href="@Url.Content("~/App_Themes/Public/commonIOM.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/js/TokenInput/token-input-facebook.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Player3rd/Styles/Index.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
}
@section Scripts{
    <script type="text/javascript" src="@Url.Content("~/js/TokenInput/jquery.tokeninput.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Player3rd/Scripts/Index.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript">
        var lang = {
            AccessDenied: '@Resources.Error.AccessDenied'
        };
    </script>
}
<div class="main">
    <div id="divMainHeader" class="">
        <div id="left_tab1">
            <ul>
                <li class="lefticon"></li>
                <li class="current"><span>@Resources.Language.MemberInformation</span></li>
            </ul>
        </div>
    </div>
    <div class="maincontent">
        <div class="filterBox">
            <div class="filterContent">
                <div id="errMsg" class="errMsg"></div>
                    <table border="0">
                        <tr>
                            <td rowspan="2">
                                <label for="cmbProduct" class="b">Product </label>
                            </td>
                            <td rowspan="2">
                                <select id="cmbProduct">
                                    <option value="33">Poker Games</option>
                                </select>
                            </td>
                            <td>
                                <input id="searchByIDs" type="radio" name="optSearchType" value="0" checked /><span class="b">PlayerID (3rd)</span><span id="searchByIdSample"> (Ex: 168657,875634,875434)</span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <input id="searchByUsername" type="radio" name="optSearchType" value="1" /><span class="b">Username</span><span id="searchByUsernameSample" class="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(Ex: Member1,Member2,Member3)</span>
                            </td>
                        </tr>
                        <tr id="trListPlayer">
                            <td colspan="3">
                                <div id="listPlayer"></div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3">
                                <input type="button" class="btn" id="btnSubmit" value="Submit" />
                            </td>
                        </tr>
                    </table>
                </div>
        </div>
    </div>
    <div style="clear: both"></div>
    <div id="gridContainer" class="grid-container">
        <div id="gridId" class="freegrid"></div>
    </div>
</div>