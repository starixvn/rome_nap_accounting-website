@using Sunplus.Accounting.Core.Common;
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="@Url.Content("~/App_Themes/Public-ver2/common.css?v=" + AccCommon.Version())" rel="stylesheet" type="text/css" />
    
    @RenderSection("Styles", false)
    <script src="@Url.Content("~/Js/head.load.min.js?v=" + AccCommon.Version())" type="text/javascript"></script>
    <script src="@Url.Content("~/js/jQuery/jquery-1.8.2.js?v=" + AccCommon.Version())" type="text/javascript"></script>
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        top.resolveClientUrl = resolveClientUrl;
    </script>
    @RenderSection("Scripts", false)
</head>
<body>
    @RenderBody()
</body>
</html>