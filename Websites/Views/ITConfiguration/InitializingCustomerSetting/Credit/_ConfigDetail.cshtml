            else if (setting.SettingName == "Loss Limit")
            {
                <!-- Loss Limit -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-row" rowspan="4">@setting.Id</td>
                    <td class="setting-col col-item td-sport" rowspan="4">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item td-sport" rowspan="4">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item td-copy" rowspan="2">
                        <div class="div-ckb">
