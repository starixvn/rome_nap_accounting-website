                            <span>Default</span>
                        </div>
                    </td>
                    <td class="setting-col col-item td-setting">Maximum Loss</td>
                    <td class="setting-col col-item" rowspan="2" td-setting>
                        <div class="div-daily">
                            <input id="@("ckbAutoReset" + setting.SettingId)" class="@("edit-input ckb ckb-auto-reset input-default-" + setting.SettingId)" type="checkbox" @setting.CheckBoxAutoReset data-pos=@setting.SettingId @setting.DisableDefault />
                            <span>Daily auto reset limit (at 12 noon GMT+8)</span>
                        </div>
                    </td>
                    <td class="setting-col col-item td-setting"></td>
                    <td class="setting-col col-item td-setting"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-setting">Apply Global Setting</td>
                    <td class="setting-col col-item td-setting"></td>
                    <td class="setting-col col-item td-setting"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-copy" rowspan="2">
                        <div class="div-ckb">
                            <input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />
                            <span>Copy From</span>
                        </div>
                    </td>
                    <td class="setting-col col-item td-setting">Sport Type</td>
                    <td class="setting-col col-item td-setting">Bet Type</td>
                    <td class="setting-col col-item td-setting"></td>
                    <td class="setting-col col-item td-setting"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-setting">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item td-setting">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item td-setting"></td>
                    <td class="setting-col col-item td-setting"></td>
                </tr>
            }
            else if (setting.SettingName == "Position Taking")
            {
