@using Fanex.Tarus.Customer.ViewModels.InitializingCustomerSetting
@using System.Data.Linq
@using Fanex.Tarus.Infrastructure.Caching
@using Fanex.Tarus.Customer.Resources

@model ConfigCustomerSettingViewModel
@{
    const string StatusEnable = "<p class=\"setting-status status-enable input-status-{0} input-status-default-{1} {2}\" id=\"status-{0}-{1}\" data-pos=\"{1}\" data-master=\"status-master-{1}\" data-agent=\"status-agent-{1}\" data-member=\"status-member-{1}\">Enable</p>";
    const string StatusDisable = "<p class=\"setting-status status-disable input-status-{0} input-status-default-{1} {2}\" id=\"status-{0}-{1}\" data-pos=\"{1}\" data-master=\"status-master-{1}\" data-agent=\"status-agent-{1}\" data-member=\"status-member-{1}\">Disable</p>";
}

<table class="setting-table">
    <tr class="setting-row row-header">
        <td class="setting-col col-header text-center" colspan="8">General Information</td>
    </tr>
    <tr class="setting-row row-item">
        <td class="setting-col col-item" colspan="8">
            <div class="edit-general-info floatLeft">
                <label class="edit-label label-filter w60" for="EditSiteSelect">Site<span style="color: red;">*</span>:</label>
                <select id="EditSiteSelect" class="edit-input setting-edit"></select>
            </div>
            <div class="edit-general-info floatLeft">
                <label class="edit-label label-filter w60" for="EditCurrencySelect">Currency<span style="color: red;">*</span>:</label>
                <select id="EditCurrencySelect" class="edit-input setting-edit"></select>
            </div>
            <div class="edit-general-info floatLeft">
                <label class="edit-label label-filter w120" for="EditStartTime">Start Time(GMT-4)<span style="color: red;">*</span>:</label>
                <input class="edit-input setting-calendar" id="EditStartTime" readonly type="text" title="Start Time (GMT-4)" />
                <input class="edit-input img-date-selector" onclick="return false;" alt="" id="EditStartTime_Trigger" title="Date selector"
                       width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
            </div>
            <div class="edit-general-info floatLeft">
                <input id="ckbEditIsTest" type="checkbox" class="edit-input" /><span>Is Test</span>
            </div>
            <div class="clear"></div>
            <div class="edit-general-info floatLeft">
                <label class="edit-label label-filter w60" for="EditRemark">Remark:</label>
                <textarea id="EditRemark" class="edit-input" cols="120" maxlength="1000"></textarea>
            </div>
        </td>
    </tr>
    @foreach (var groups in Model.GroupSettings)
    {
        <tr class="setting-row row-header">
            <td class="setting-col col-header text-center" colspan="8">@groups.FirstOrDefault().SettingName - @groups.Key</td>
        </tr>
        foreach (var setting in groups)
        {

            <!-- Product Status -->
            if (setting.SettingName == "Product Status")
            {
                var disableStatusClass = "";
                if (!setting.IsDefault)
                {
                    disableStatusClass = "input-status-disable";
                }
                var statussuper = setting.DefaultValueSuper != "" && (int)Convert.ToDouble(setting.DefaultValueSuper) == 1 ? string.Format(StatusEnable, "super", setting.SettingId, disableStatusClass) : string.Format(StatusDisable, "super", setting.SettingId, disableStatusClass);
                var statusmaster = setting.DefaultValueMaster != "" && (int)Convert.ToDouble(setting.DefaultValueMaster) == 1 ? string.Format(StatusEnable, "master", setting.SettingId, disableStatusClass) : string.Format(StatusDisable, "master", setting.SettingId, disableStatusClass);
                var statusagent = setting.DefaultValueAgent != "" && (int)Convert.ToDouble(setting.DefaultValueAgent) == 1 ? string.Format(StatusEnable, "agent", setting.SettingId, disableStatusClass) : string.Format(StatusDisable, "agent", setting.SettingId, disableStatusClass);
                var statusmember = setting.DefaultValueMember != "" && (int)Convert.ToDouble(setting.DefaultValueMember) == 1 ? string.Format(StatusEnable, "member", setting.SettingId, disableStatusClass) : string.Format(StatusDisable, "member", setting.SettingId, disableStatusClass);
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-row" rowspan="6">@setting.Id</td>
                    <td class="setting-col col-item td-sport" rowspan="6">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item td-sport" rowspan="6">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item td-copy" rowspan="2">
                        <div class="div-ckb">
                            <input id="@("ckbDefault" + setting.SettingId)" class="edit-input ckb ckb-default" type="checkbox" @setting.CheckBoxDefault data-pos=@setting.SettingId />
                            <span>Default</span>
                        </div>
                    </td>
                    <td class="setting-col col-item td-setting">Super</td>
                    <td class="setting-col col-item td-setting">Master</td>
                    <td class="setting-col col-item td-setting">Agent</td>
                    <td class="setting-col col-item td-setting">Member</td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-setting">@Html.Raw(statussuper)</td>
                    <td class="setting-col col-item td-setting">@Html.Raw(statusmaster)</td>
                    <td class="setting-col col-item td-setting">@Html.Raw(statusagent)</td>
                    <td class="setting-col col-item td-setting">@Html.Raw(statusmember)</td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-copy" rowspan="2">
                        <div class="div-ckb">
                            <input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />
                            <span>Copy From</span>
                        </div>
                    </td>
                    <td class="setting-col col-item td-setting">Sport Type</td>
                    <td class="setting-col col-item td-setting">Bet Type</td>
                    <td class="setting-col col-item td-setting"></td>
                    <td class="setting-col col-item td-setting"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item td-setting">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item td-setting">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item td-setting"></td>
                    <td class="setting-col col-item td-setting"></td>
                </tr>
                <tr class="setting-row row-item">
                    <td class="setting-col col-item text-center" rowspan="2">Disable by default</td>
                    <td class="setting-col col-item" colspan="4">Headline (separated by commas ',')</td>
                </tr>
                <tr class="setting-row row-item">
                    <td class="setting-col col-item" colspan="4"><textarea class="edit-input input-headline" cols="75" data-pos=@setting.SettingId>@setting.SpecialRequirement</textarea></td>
                </tr>
            }
