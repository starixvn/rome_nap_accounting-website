@using Fanex.BetDetails.BetBuilder.ViewModels;

@model BetBuilderDetailViewModel
@if (Model.Details.Any())
{
    <div class="betbuilder">
        @foreach (var detail in Model.Details)
        {
        <div>
            @detail.SelectionName
            @if (Model.IsSettled)
            {
                if (!string.IsNullOrEmpty(detail.Result))
                {
                    <span class="sport">@( " - " + detail.Result)</span>
                }
            }
        </div>
        }
    </div>
}
