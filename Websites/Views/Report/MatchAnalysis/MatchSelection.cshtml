@{
    if (Request["IsExport"] != null && Request["IsExport"] == "1")
    {
        var param = new Fanex.Tarus.Entities.Report.MatchAnalysisParam();
        param.EventDate = CastAide.AsString(Request["EventDate"]);
        param.MatchId = CastAide.AsInt32(Request["MatchId"]);
        param.MatchCode = CastAide.AsString(Request["MatchCode"]);
        param.Liveindicator = CastAide.AsInt32(Request["Liveindicator"]);
        param.Bettypes = CastAide.AsString(Request["Bettypes"]);
        param.MoveBetsDay = CastAide.AsString(Request["MoveBetsDay"]);
        param.BalanceUpDay = CastAide.AsString(Request["BalanceUpDay"]);
        param.StatusId = CastAide.AsInt32(Request["StatusId"]);
        param.ReportType = CastAide.AsInt32(Request["ReportType"]);
        param.LeagueId = CastAide.AsInt32(Request["LeagueId"]);
        param.HomeId = CastAide.AsInt32(Request["HomeId"]);
        param.AwayId = CastAide.AsInt32(Request["AwayId"]);
        param.SportTypeId = CastAide.AsInt32(Request["SportTypeId"]);
        param.ShowTime = CastAide.AsString(Request["ShowTime"]);
        param.CustId = CastAide.AsInt32(Request["CustId"]);
        new Fanex.Tarus.Web.Controllers.Report.MatchAnalysisController().ExportReportToExcel(param);

    }
}
@{int isAllowRead = Sunplus.Accounting.Business.Security.Permissions.HasPermission(Sunplus.Accounting.Core.Common.Enumerations.Functions.Reports.SpecialMatchAnalysis) ? 1 : 0;}
@{int isAllowHost = Sunplus.Accounting.Business.Security.Permissions.HasHostPermission(Sunplus.Accounting.Core.Common.Enumerations.Functions.Reports.SpecialMatchAnalysis) ? 1 : 0;}
@{int numberGameSportId = Sunplus.Accounting.Core.Common.Constants.Sport.NumberGame;}
@{int liveCasinoSportId = Sunplus.Accounting.Core.Common.Constants.Sport.LiveCasino;}
@{string numberGamePrefix = Sunplus.Accounting.Core.Configurations.SpecialMatchAnalysisSection.Instance.DisplayText["NumberGamePrefix"].Value;}
@{string liveCasinoPrefix = Sunplus.Accounting.Core.Configurations.SpecialMatchAnalysisSection.Instance.DisplayText["LiveCasinoPrefix"].Value;}
<script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var today = '@DateTime.Now';
        var currentDate =  '@DateTime.Now.Day';
        var currentMonth =  '@DateTime.Now.Month';
        var currentYear =  '@DateTime.Now.Year';

        var moveBetDay = '@ReportUtils.BalanceUp.MoveBetsDay.ToShortDateString()';
        var balanceUpDay = '@ReportUtils.BalanceUp.BalanceUpDay.ToShortDateString()';

        var isAllowRead = @CastAide.AsInt32(@isAllowRead);
        var isAllowHost = @CastAide.AsInt32(isAllowHost);

        var numberGameSportId = @CastAide.AsInt32(numberGameSportId);
        var liveCasinoSportId = @CastAide.AsInt32(liveCasinoSportId);

        var numberGamePrefix = '@CastAide.AsString(numberGamePrefix)';
        var liveCasinoPrefix = '@CastAide.AsString(liveCasinoPrefix)';
</script>
