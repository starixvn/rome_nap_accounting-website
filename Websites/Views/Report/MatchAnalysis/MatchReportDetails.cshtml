@using DNAide.Core
@using Sunplus.Accounting.DataAccess.Report
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/Pager/pagination.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/js/MultipleSelect/jquery.multiselect.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/MatchAnalysis/Styles/MatchAnalysis.css" rel="stylesheet"
        type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.1.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
    <script src="~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/gridscroller.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/BlockUI.js" type="text/javascript"></script>
    <script src="~/Views/Report/MatchAnalysis/Scripts/MatchAnalysis.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchAnalysis/Scripts/MatchSelection.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchAnalysis/Scripts/MatchReportDetails.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script src="~/js/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script type="text/javascript">    
    </script>
</head>
<body style="width: 900px;">
    <div class="main" style="">
        <div class="maincontent">
            <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL">
                    </td>
                    <td class="maincontent_headerC">
                        Special Match Analysis (Base on RM)
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </table>
            <div id class="maincontent_box" style="width: 940px;">
                <div id="header_matchReportDetails">
                    <table>
                        <tr>
                            <td colspan="4" style="padding-left: 2px; width: 890px; text-align: left; overflow: hidden;">
                                <b id="matchReportDetailsHeader"></b>
                            </td>
                            <td style="float: right; width: 50px;">
                                <input type="button" onclick="MatchReportManager.exportToExcel();" value="" name="btnExport"
                                    id="btnExport" class="btnExcel" title="Export to Excel" style="padding-left: 2px;
                                    width: 20px;" />
                                <input id="btnBack" name="btnBack" type="button" value="" class="btn" style="width: 20px;
                                    height: 16px; background-image: url('../App_Themes/Images/back.png'); background-size: 100%;
                                    border: none; padding-left: 2px;" onclick="MatchAnalysisManager.backMatchSelection()" />
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-left: 2px; padding-top: 3px; width: 150px; text-align: left;">
                                <div id="ddlFilterBy" class="ui-multiselect ui-multiselect-widget ui-multiselect-state-default ui-multiselect-state-hover ui-multiselect-state-active"
                                    style="width: 150px;">
                                    <input readonly="readonly" type="text" class="ui-multiselect-state-default" value="Filter by" />
                                    <span class="ui-multiselect-icon ui-multiselect-icon-triangle-1-s" style="margin-top: 0px;">
                                    </span>
                                </div>
                            </td>
                            <td style="padding-left: 10px; padding-top: 3px; width: 250px; text-align: left;">
                                <div id="ddlBetType" class="ui-multiselect ui-multiselect-widget ui-multiselect-state-default ui-multiselect-state-hover ui-multiselect-state-active"
                                    style="width: 240px;">
                                    <input readonly="readonly" type="text" class="ui-multiselect-state-default" value="Bet type"
                                        style="float: left; width: 220px;" />
                                    <span class="ui-multiselect-icon ui-multiselect-icon-triangle-1-s" style="float: right;
                                        margin-top: 0px;"></span>
                                </div>
                            </td>
                            <td style="padding-left: 2px; width: 65px;">
                                <input id="btnViewReport" name="btnViewReport" type="button" value="Submit" class="btn"
                                    style="width: 60px; height: 19px;" onclick="MatchReportManager.viewMatchReport()" />
                            </td>
                            <td style="width: 495px;">
                            </td>
                            <td style="float: right; width: 50px;">
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div>
                <div id="InformationMssg_MatchRprt" style="display: none; width: 946px; word-wrap: break-word;">
                </div>
            </div>
            <div style="margin-top: 6px;">
                <div id="matchAnalysis" class="content-warper hidden" style="width: 904px;">
                    <div class="grid-title hidden">
                        <div class="grid-title-lable" id="matchAnalysisTitle">
                            Title</div>
                        <div class="grid-toolbox">
                        </div>
                    </div>
                    <div class="content-header clearfix">
                        <div class="header-scroll">
                            <table class="tbl-header-scroll" id="tblHeader">
                                <tr>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col160 c" id="ttlreportType">
                                        </div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col120 c">
                                            Member Turnover</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col100 c">
                                            Member Winloss</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col100 c">
                                            Bet Count</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col100 c">
                                            House Turnover</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col100 c">
                                            House Winloss</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col100 c">
                                            SMA Turnover</div>
                                    </td>
                                    <td style="border-bottom: none 0px;">
                                        <div class="col100 c">
                                            SMA Winloss</div>
                                    </td>
                                    <td style="border-bottom: none 0px;" id="colCurrency" class="hidden">
                                        <div class="col80 c">
                                            Currency</div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="content-body clearfix">
                        <div class="body-scroll">
                            <table id="tblContent" class="tbl-body-scroll">
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="content-footer clearfix" id="reportFooter">
                        <div class="footer-scroll">
                            <table class="tbl-footer-scroll" id="tblFooter">
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
            <div id="filterByPopup" style="left: 10px; top: 80px; position: absolute; width: 150px;
                height: 317px; background-color: #EEEEEE; display: none;" class="ui-multiselect-options RadTreeView RadTreeView_Office2010Silver ui-multiselect-shadow ui-multiselect-widget ui-multiselect-widget-content ui-multiselect-corner-all">
                <div style="padding-left: 2px;">
                    <div style="width: 60px; padding-left: 5px;">
                        <font color="#206FB8">Filter by</font> <span class="ui-multiselect-icon ui-multiselect-icon-triangle-1-s"
                            style="float: right; margin-top: 2px;"></span>
                    </div>
                    <div>
                        <div id="reportByHeader" style="background-color: #CCCCCC; font-weight: bold; padding-left: 5px;"
                            class="ui-div-corner-all">
                            Report by
                        </div>
                        <div id="Currency" class="divCheckbox" onclick="filterManagement.changReportBySelection(this)">
                            <div style="text-align: left; margin-left: 20px;">
                                Currency
                            </div>
                        </div>
                        <div id="BetType" class="divCheckbox" onclick="filterManagement.changReportBySelection(this)">
                            <div style="text-align: left; margin-left: 20px;">
                                Bet type
                            </div>
                        </div>
                        <div id="Super" class="divCheckbox" onclick="filterManagement.changReportBySelection(this)">
                            <div style="text-align: left; margin-left: 20px;">
                                Super
                            </div>
                        </div>
                        <div id="Member" class="divCheckbox" onclick="filterManagement.changReportBySelection(this)">
                            <div style="text-align: left; margin-left: 20px;">
                                Member
                            </div>
                        </div>
                        <div id="Country" class="divCheckbox" onclick="filterManagement.changReportBySelection(this)">
                            <div style="text-align: left; margin-left: 20px;">
                                Country
                            </div>
                        </div>
                    </div>
                    <div>
                        <div id="statusHeader" style="background-color: #CCCCCC; font-weight: bold; padding-left: 5px;"
                            class="ui-div-corner-all">
                            Status
                        </div>
                        <div id="StatusAll" class="divCheckbox" onclick="filterManagement.allStatusCheck()">
                            <div style="text-align: left; margin-left: 20px;">
                                All
                            </div>
                        </div>
                        <div id="StatusWin" class="divCheckbox" onclick="filterManagement.winStatusCheck()">
                            <div id="" style="text-align: left; margin-left: 20px;">
                                Won
                            </div>
                        </div>
                        <div id="StatusLose" class="divCheckbox" onclick="filterManagement.loseStatusCheck()">
                            <div id="" style="text-align: left; margin-left: 20px;">
                                Lose
                            </div>
                        </div>
                        <div id="StatusDraw" class="divCheckbox" onclick="filterManagement.drawStatusCheck()">
                            <div id="" style="text-align: left; margin-left: 20px;">
                                Draw
                            </div>
                        </div>
                    </div>
                    <div>
                        <div id="liveStatusHeader" style="background-color: #CCCCCC; font-weight: bold; padding-left: 5px;"
                            class="ui-div-corner-all">
                            Live Status
                        </div>
                        <div id="LiveStatusAll" class="divCheckbox" onclick="filterManagement.changLiveStatusBySelection(this)">
                            <div style="text-align: left; margin-left: 20px;">
                                All
                            </div>
                        </div>
                        <div id="LiveStatusLive" class="divCheckbox" onclick="filterManagement.changLiveStatusBySelection(this)">
                            <div id="" style="text-align: left; margin-left: 20px;">
                                Live
                            </div>
                        </div>
                        <div id="LiveStatusNoneLive" class="divCheckbox" onclick="filterManagement.changLiveStatusBySelection(this)">
                            <div id="" style="text-align: left; margin-left: 20px;">
                                Non-live
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="betTypesPopup" style="left: 176px; top: 80px; position: absolute; width: 420px;
                background-color: #EEEEEE; display: none;" class="ui-multiselect-options RadTreeView RadTreeView_Office2010Silver ui-multiselect-shadow ui-multiselect-widget ui-multiselect-widget-content ui-multiselect-corner-all">
                <div style="padding-left: 2px;">
                    <div style="width: 80px;">
                        <div style="width: 60px; padding-left: 5px;">
                            <font color="#206FB8">Bet type</font>
                        </div>
                        <span class="ui-multiselect-icon ui-multiselect-icon-triangle-1-s" style="float: right;
                            margin-top: -16px;"></span>
                    </div>
                    <table>
                        <tr>
                            <td colspan="2">
                                <div>
                                    <input type="checkbox" value="All bet types" id="cbAllBetType" checked="true" class="betTypeCkb" />
                                    <label for="cbAllBetType" style="margin-top: -6px;">
                                        All bet types</label>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <table id="tblBetTypeDetail">
                    </table>
                </div>
            </div>
        </div>
    </div>
    @{int isAllowRead = Sunplus.Accounting.Business.Security.Permissions.HasPermission(Sunplus.Accounting.Core.Common.Enumerations.Functions.Reports.SpecialMatchAnalysis) ? 1 : 0;}
    @{int isAllowHost = Sunplus.Accounting.Business.Security.Permissions.HasHostPermission(Sunplus.Accounting.Core.Common.Enumerations.Functions.Reports.SpecialMatchAnalysis) ? 1 : 0;}
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var today = '@DateTime.Today';
        var moveBetDay = '@ReportUtils.BalanceUp.MoveBetsDay.ToShortDateString()';
        var balanceUpDay = '@ReportUtils.BalanceUp.BalanceUpDay.ToShortDateString()';

        var isAllowRead = @isAllowRead;
        var isAllowHost = @isAllowHost;
    </script>
</body>
</html>
