<div class="main">
    <div class="maincontent">
        <table cellspacing="0px" cellpadding="0px" border="0" class="maincontent_header">
            <tbody>
                <tr>
                    <td class="maincontent_headerL">
                    </td>
                    <td class="maincontent_headerC">
                        Number of Active Members for Racing
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="maincontent_box" style="width: 373px;">
            <table>
                <tbody>
                    <tr>
                        <td style="padding-left: 4px">
                            From:
                        </td>
                        <td>
                            <input id="txtfromdate" class="txtdate" readonly="readonly" style="width: 80px;" />
                        </td>
                        <td style="padding-left: 4px">
                            To:
                        </td>
                        <td>
                            <input id="txttodate" class="txtdate" readonly="readonly" style="width: 80px;" />
                        </td>
                        <td>
                            <input type="button" id="btnReport" name="btnReport" value="REPORT" class="btn" onclick="racing.selActiveMembers()" />
                        </td>
                        <td>
                            <input type="button" onclick="racing.exportExcel()" value="  " id="btnExportExcel" class="btnExcel hand" title="Export to Excel" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="mainreport" style="padding-top: 2px">
            <div class="">
                <div id="divMainActiveMembers" style="" class="activemememer-mainform">
                                      
                </div>
            </div>
        </div>
    </div>
</div>



 <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
  @{
      if (Request["IsExport"] != null && Request["IsExport"] == "1")
       {
           string fromdate = Request["fromdate"].ToString();
           string todate = Request["todate"].ToString();
           new Fanex.Tarus.Reports.Controllers.Racing.RacingController().ExportExcelActiveMembers(fromdate, todate);
       }
    }
