<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="head1">
    <title>@Reports.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/App_Themes/Report/Report.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/spliter/style.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/DailyWinLoss2hOtherSports/Css/DailyWinLoss2hOtherSports.css?version=@WebSettings.Version" rel="stylesheet"
        type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">
    </script>
    <script src="~/js/jQuery/gridscroller.js" type="text/javascript"></script>
    <script src="~/js/Utils/jquery.stringformat.js" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hOtherSports/Scripts/StringFormatter.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hOtherSports/Scripts/DailyWinLoss2hOtherSports.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hOtherSports/Scripts/WL2hShowHideDivManager.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hOtherSports/Scripts/OtherSportsReportManager.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/js/common.js" type="text/javascript"></script>
    <script type="text/javascript">     
    </script>
</head>
<body style="" id="pageBody">
    <div id="dailyWLReportDiv" style="">
        <div class="main" style="">
            <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
                <tr>
                    <td>
                        <div id="divMainHeader" class="">
                            <div id="left_tab1">
                                <ul>
                                    <li class="lefticon"></li>
                                    <li class="current"><span>Daily Win Loss (2h) Other Sports</span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="maincontent" style="">
                            <div class="filterBox">
                                <div class="filterContent">
                                    @Html.Partial("Default/Report/DateTimeSinglePath_2h")
                                    <div>
                                        <div id="InformationMssg" style="display: none; word-wrap: break-word;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="contentBox" style="">
                                @Html.Partial("~/Views/Report/DailyWinLoss2hOtherSports/MainReport_DWL2h.cshtml")
                                @Html.Partial("~/Views/Report/DailyWinLoss2hOtherSports/OtherSportsReport.cshtml")
                                <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    @{  
        string btnExport = Request["ExportType"];
        DailyWinLoss2hParam param = new DailyWinLoss2hParam();
        param.EmptyReportMessage = "There is no information available.";
        var bettypeName = "";
        switch (btnExport)
        {
            case "MainReport": // MainReport
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.ReportFileName = "DailyWL_Sporttype_OtherSports_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.ReportTitle = "DAILY WIN/LOSS OTHER SPORTS REPORT";
                param.DefaultSheetName = "Main";

                new DailyWinLoss2hOtherSportsController().ExportToExcel(param);
                break;
            case "OtherSportsMain": //OtherSportsMain  
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.ReportFileName = "DailyWinLoss_OtherSports_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Daily WinLoss Other Sports";
                param.ReportTitle = "Daily WinLoss Other Sports";

                new DailyWinLoss2hOtherSportsController().ExportToExcel_OtherSportsMain(param);
                break;
            case "OtherSportsMain_NoneLive": //OtherSportsMain_NoneLive  
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.ReportFileName = "DailyWinLoss_OtherSports_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Daily WinLoss Other Sports";
                param.ReportTitle = "Daily WinLoss Other Sports";

                new DailyWinLoss2hOtherSportsController().ExportToExcel_OtherSportsMain_NoneLive(param);
                break;
            case "OtherSportsMain_Live": //OtherSportsMain_NoneLive  
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.ReportFileName = "DailyWinLoss_OtherSports_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Daily WinLoss Other Sports";
                param.ReportTitle = "Daily WinLoss Other Sports";
                new DailyWinLoss2hOtherSportsController().ExportToExcel_OtherSportsMain_Live(param);
                break;

            case "OtherSportsBySport": //OtherSportBySport  
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.SportType = CastAide.AsInt32(Request["SportType"]);
                param.SportTypeName = CacheRef.GetSportName(param.SportType);

                param.ReportFileName = "DailyWinLoss_OtherSports_" + param.SportTypeName.Replace(" ", "") + "_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Daily WinLoss Other Sports - " + param.SportTypeName.Replace("/", "_");
                param.ReportTitle = "Daily WinLoss Other Sports - " + param.SportTypeName;
                new DailyWinLoss2hOtherSportsController().ExportToExcel_OtherSportsBySport(param);
                break;

            case "OtherSportsBySport_NoneLive": //OtherSportBySport_NoneLive  
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.SportType = CastAide.AsInt32(Request["SportType"]);
                param.SportTypeName = CacheRef.GetSportName(param.SportType);

                param.ReportFileName = "DailyWinLoss_OtherSports_" + param.SportTypeName.Replace(" ", "") + "_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Daily WinLoss Other Sports - " + param.SportTypeName.Replace("/", "_");
                param.ReportTitle = "Daily WinLoss Other Sports - " + param.SportTypeName;
                new DailyWinLoss2hOtherSportsController().ExportToExcel_OtherSportsBySport_NoneLive(param);
                break;
            case "OtherSportsBySport_Live": //OtherSportBySport_Live  
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.SportType = CastAide.AsInt32(Request["SportType"]);
                param.SportTypeName = CacheRef.GetSportName(param.SportType);

                param.ReportFileName = "DailyWinLoss_OtherSports_" + param.SportTypeName.Replace(" ", "") + "_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Daily WinLoss Other Sports - " + param.SportTypeName.Replace("/", "_");
                param.ReportTitle = "Daily WinLoss Other Sports - " + param.SportTypeName;

                new DailyWinLoss2hOtherSportsController().ExportToExcel_OtherSportsBySport_Live(param);
                break;
            case "OtherSportsBySportBettypeDetails": //OtherSportsBySportBettypeDetails        
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.SportType = CastAide.AsInt32(Request["SportType"]);
                param.BetType = CastAide.AsInt32(Request["BetType"]);
                bettypeName = CastAide.AsString(Request["BetTypeName"]);
                param.IsLive = CastAide.AsInt32(Request["IsLive"]);
                param.IsHedge = CastAide.AsBoolean(Request["IsHedge"]);
                param.SportTypeName = CacheRef.GetSportName(param.SportType);
                //if (param.BetType == 1333)
                //{
                //    bettypeName = "Set X Game Y & Y+1 Winner";
                //}
                //else if (param.BetType == 1334)
                //{
                //    bettypeName = "Set X Game Y & Y+1 Points";
                //}
                param.ReportFileName = "Main_OtherSports_" + param.SportTypeName.Replace(" ", "") + "_" + bettypeName.Replace(" ", "") + "_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Main - Other Sports - " + param.SportTypeName.Replace("/", "_") + " - " + bettypeName.Replace("/", "_");
                param.ReportTitle = "Main>OtherSports|" + param.SportTypeName + ">" + bettypeName.Replace(" ", "");
                new DailyWinLoss2hOtherSportsController().ExportToExcel_DailyWLDirectDetails(param);

                break;

        }
       
    }
    @{int isAllowRead = Permissions.HasPermission(Enumerations.Functions.Reports.Report2hOtherSports) ? 1 : 0;}
    @{
        RMReportUtils utilsBARM = new RMReportUtils(RMReportUtils.ReportName.Report2h, RMReportUtils.RMType.BARM);
        RMReportUtils utilsEightRM = new RMReportUtils(RMReportUtils.ReportName.Report2h, RMReportUtils.RMType.EightRM);

        string eightRmStr = utilsEightRM.DisplayName;
        string isEightRMActive = utilsEightRM.IsActive.ToString().ToLower();

        string barmStr = utilsBARM.DisplayName;
        string isBARMActive = utilsBARM.IsActive.ToString().ToLower();
    }
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var today = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now)';
        var yesterday = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now.AddDays(-1))';
        var fdate = '@Request["reportDate"]';
        if (fdate == undefined || fdate == "") {
            fdate = '@DateTime.Now.ToShortDateString()';
        }

        var dailyWLMP_WebSettings = '@CastAide.AsDateTime(WebSettings.getDateDailyWLMP)';
        var frmDate = new Date(fdate);
        var isAllowRead = @CastAide.AsInt32(@isAllowRead);

        var eightRmStr =  '@CastAide.AsString(@eightRmStr)';
        var isEightRMActive =  '@CastAide.AsString(@isEightRMActive)';
        var barmStr =  '@CastAide.AsString(@barmStr)';
        var isBARMActive =  '@CastAide.AsString(@isBARMActive)';     
        var isAllowReadOtherSportsReport = @CastAide.AsInt32(@isAllowRead);
    </script>
</body>
</html>
