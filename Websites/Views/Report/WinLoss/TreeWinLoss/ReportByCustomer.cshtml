@model Fanex.Tarus.Reports.Entities.WinLoss.TreeWinLoss.TreeWinLoss
@using DNAide.Utils
@if (Model != null && Model.WinLoss != null && Model.WinLoss.Count > 0)
{
	@functions{
		public string numberColor(double number)
		{
			double tmpNumber = Math.Round(number, 2);
			return tmpNumber > 0 ? "red" : string.Empty;
		}
	}
    <div id="mainreportgrid" class="freegrid">
        <div class="grid-title">
            <div class="grid-title-lable" id="reporttile">
                Title</div>
            <div class="grid-toolbox">
                <input type="button" value="" id="btnBack" class="btnBack" title="Go Back" />
                <input type="button" id="btnExport" value=" " class="btnExcel" title="Export to Excel" />
            </div>
        </div>
        <div class="free-cell free-top-left">
            <table class="grid-fixed-table free-cell-top-left">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell" style="width: 30px; height: 61px">
                                No</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 100px; height: 61px">
                                Username</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 61px">
                                Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 61px">
                                Win Loss</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 80px; height: 61px">
                                Comm</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 61px">
                                Total</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="row_header_wrapper">
            <div class="row_header row-headers-background">
                <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell" style="width: 30px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 100px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 30px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 100px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 80px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th colspan="12">
                                <div style="height: 17px">
                                    Base RM</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 80px; height: 61px">
                                    Virtual Rate (%)</div>
                            </th>
                        </tr>
                        <tr>
                             <th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMTurnover" onclick="treeWinLossByCustomerLevel.sorting(this, 'BaseRMTurnover')">Turnover</div>
                            </th>
                             <th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px" id="divBaseRMTotal" onclick="treeWinLossByCustomerLevel.sorting(this, 'BaseRMVirtualTurnover')">Virtual <br/> Turnover</div>
                            </th>
                             <th colspan="3">
                                <div class="table-cell" style="width: 335px; height: 17px">Turnover Variance</div>
                            </th>
                             <th colspan="3">
                                <div class="table-cell" style="width: 330px; height: 17px" id="divBaseRMVariance">Winlost Variance</div>
                            </th>
							<th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMVarianceMargin" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMVarianceMargin')">Variance<br/>Margin (%)</div></th>
                            <th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMTotal" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMTotal')">Total</div></th>
                            <th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMVirtualTotal" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMVirtualTotal')">Virtual Total</div></th>
                            <th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="divMargin" onclick="treeWinLossByCustomerLevel.sorting(this,'Margin')">Margin (%)</div></th>
                        </tr>
                        <tr>
                            <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMTOVariancePlus" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMTOVariancePlus')">+</div></th>
                            <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMTOVarianceMinus" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMTOVarianceMinus')">-</div></th>
							<th> <div class="table-cell sorter" style="width: 115px; height: 17px" id="dvBaseRMTOVarianceAbsoluteTotal" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMTOVarianceAbsoluteTotal')">Absolute Total</div></th>
                            <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMWLVariancePlus" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMWLVariancePlus')">+</div></th>
                            <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMWLVarianceMinus" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMWLVarianceMinus')">-</div></th>
							<th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMWLVarianceTotal" onclick="treeWinLossByCustomerLevel.sorting(this,'BaseRMWLVarianceTotal')">Total</div></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 30px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 100px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 80px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 120px; height: 61px">
                                    &nbsp;</div>
                            </th>
                            <th colspan="12">
                                <div style="height: 17px">
                                    Base RM</div>
                            </th>
                            <th rowspan="3">
                                <div class="table-cell" style="width: 80px; height: 61px">
                                    Virtual Rate (%)</div>
                            </th>
                        </tr>
                        <tr>
                            <th rowspan="2">
                            <div class="table-cell" style="width: 110px; height: 39px">
                                Turnover</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px">
                                    Virtual Total</div>
                            </th>
                            <th colspan="3">
                                <div class="table-cell" style="width: 335px; height: 39px">
                                    Turnover Variance</div>
                            </th>
                            <th colspan="3">
                                <div class="table-cell sorter" style="width: 330px; height: 39px">
                                    Winlost Variance</div>
                            </th>
							<th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px">Variance<br/>Margin (%)</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px">Total</div>
                            </th>
                            <th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px">Virtual Total</div>
                            </th>
                             <th rowspan="2">
                                <div class="table-cell sorter" style="width: 110px; height: 39px">
                                    Margin (%)</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row_footer row-footer-background z999">
            <table class="grid-fixed-table row_footer_content">
                <thead>
                    <tr>
                        <th>
                            <div class="r" style="width: 595px; height: 17px">
                                Total</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="col_footer row-footer-background scroll-y">
            <div class="footer-container">
                <table class="col_footer_content grid-fixed-table">
                    <thead>
                        <tr>
                         @{
                    string turnoverTotal = string.Empty;
                    string turnoverTotalVirtual = string.Empty;
                    string marginTotal = string.Empty;
					string baseRMVarianceMargin = string.Empty;

                    if (ViewBag.isShowSB == true ||
                    ViewBag.isShowNG == true ||
                    ViewBag.isShowRB == true ||
                    ViewBag.isShowLCS == true ||
                    ViewBag.isShowVS == true)
                    {
                        turnoverTotal = NumberFormat.DoubleFormat(Model.Total.BaseRMTurnover, 2);
                        turnoverTotalVirtual = NumberFormat.DoubleFormat(Model.Total.BaseRMVirtualTurnover, 2);
                    }
                    else
                    {
                        turnoverTotal = "N/A";
                        turnoverTotalVirtual = "N/A";
                    }
					
					baseRMVarianceMargin = Model.Total.BaseRMTOVarianceAbsoluteTotal == 0
						? "N/A" : NumberFormat.DoubleFormat(Model.Total.BaseRMVarianceMargin, 2);

                    if (turnoverTotalVirtual == "N/A" || turnoverTotalVirtual == "0.00")
                    {
                        marginTotal = "N/A";
                    }
                    else
                    {
                        marginTotal = NumberFormat.DoubleFormat(Model.Total.Margin, 2);
                    }
                    
                    }
                            <th>
                                <div class="r" style="width: 30px; height: 17px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="r" style="width: 100px; height: 17px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="r" style="width: 120px; height: 17px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="r" style="width: 120px; height: 17px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="r" style="width: 80px; height: 17px">
                                    &nbsp;</div>
                            </th>
                            <th>
                                <div class="r" style="width: 120px; height: 17px">
                                    &nbsp;</div>
                            </th>
                            
                            <th><div class="r" style="width: 110px; height: 17px">@turnoverTotal</div></th>
                            <th><div class="r" style="width: 110px; height: 17px">@turnoverTotalVirtual</div></th>
                            <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTOVariancePlus, 2)</div></th>
                            <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTOVarianceMinus, 2)</div></th>
							<th><div class="r" style="width: 115px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTOVarianceAbsoluteTotal, 2)</div></th>
                            <th><div class="r @numberColor(Model.Total.BaseRMWLVariancePlus)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMWLVariancePlus, 2)</div></th>
                            <th><div class="r @numberColor(Model.Total.BaseRMWLVarianceMinus)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMWLVarianceMinus, 2)</div></th>
							<th><div class="r @numberColor(Model.Total.BaseRMWLVarianceTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMWLVarianceTotal, 2)</div></th>
							<th><div class="r @numberColor(Model.Total.BaseRMVarianceMargin)" style="width: 110px; height: 17px">@baseRMVarianceMargin</div></th>
                            <th><div class="r @numberColor(Model.Total.BaseRMTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTotal, 2)</div></th>
                            <th><div class="r @numberColor(Model.Total.BaseRMVirtualTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMVirtualTotal, 2)</div></th>
                            <th><div class="r @numberColor(Model.Total.Margin)" style="width: 110px; height: 17px">@marginTotal</div></th>

                            <th>
                                <div class="r" style="width: 80px; height: 17px">
                                    &nbsp;</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
        
    <div class="hidden" id="dialog-modal">
    </div>
    
    <script type="text/javascript">
        var wl = '@Json.Encode(Model)';
        wl = wl.replace(/&quot;/g, '"');
        var wlJson = jQuery.parseJSON(wl);
        var wlDetail = wlJson.WinLoss;
        var headerText = '@ViewData["title"]';

        $(function () {
            var gridOpts = {
                tblContentId: 'tblContent',
                isShowPager: true,
                manualCopyHeader: true,
                fullWidth: true,
                fullHeight: true,
                gridWidth: 1260, //=totalColumnWidth + totalColumn*4 +totalColumn
                gridHeight: 100,
                freezeWidth: 595,
                numberFreezeCol: 6,
                startPerPage: 100,
                maxTtemsPerPage: 500,
                item_per_page_arr: [100, 200, 300, 400, 500]
            };
            $('#mainreportgrid').initGrid(gridOpts);
            $('#btnExport').on('click', function () { treeWinLoss.exportExcel(); });
            treeWinLossByCustomerLevel.renderWlReport();
            $('#btnBack').on('click', function () { treeWinLoss.goBackUpLine(); });
            treeWinLoss.reportTitle = headerText;
        });
    </script>
    
}
else
{
    <script type="text/javascript">
        $('#mainreportgrid').addClass('hidden');
        $('#err').show();
        $('#err .alertboxerr div').html('There is no data.');
        $('#btnExport').addClass('hidden');
    </script>
}