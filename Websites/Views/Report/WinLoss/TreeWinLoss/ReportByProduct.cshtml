            return numberColor;
        }*/
    }
<div id="mainreportgrid" class="freegrid">       
    <div class="grid-title">
        <div class="grid-title-lable" id="reporttile">Summary Win Loss</div>
        <div class="grid-toolbox">                            
            <input type="button" id="btnExport" value=" " class="btnExcel" title="Export to Excel" />
        </div>
    </div>                       
    <div class="free-cell free-top-left">
        <table class="grid-fixed-table free-cell-top-left">
            <thead>
                <tr>
                    <th>
                        <div class="table-cell" style="width: 80px; height: 61px">Currency</div>
                    </th>
                    <th>
                        <div class="table-cell" style="width: 120px; height: 61px">Turnover</div>
                    </th>
                    <th>
                        <div class="table-cell" style="width: 120px; height: 61px">Win Loss</div>
                    </th>
                    <th>
                        <div class="table-cell" style="width: 80px; height: 61px">Comm</div>
                    </th>
                    <th>
                        <div class="table-cell" style="width: 120px; height: 61px">Total</div>
                    </th>                                                
                </tr>
            </thead>
        </table>
    </div>
    <div class="row_header_wrapper">
        <div class="row_header row-headers-background">
            <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell" style="width: 80px; height: 61px">&nbsp;</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 80px; height: 61px">&nbsp;</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>                                                
                    </tr>
                </thead>
                <tbody>
					@{ int index = 0; }
                    @foreach (var winlossDetail in Model.WinLoss)
                    {
                        <tr class="row@(++index)">
                            <td>
                                <div class="c" style="width: 80px; height: 17px">
                                    <a href="javascript:;" onclick="treeWinLoss.goToDownLine(@winlossDetail.Id, '@winlossDetail.Title')">@winlossDetail.Title</a>
                                </div>
                            </td>
                            <td><div class="r" style="width: 120px; height: 17px">@NumberFormat.DoubleFormat(winlossDetail.Turnover, 2)</div></td>
                            <td><div class="r @numberColor(winlossDetail.WinLoss)" style="width: 120px; height: 17px">@NumberFormat.DoubleFormat(winlossDetail.WinLoss, 2)</div></td>
                            <td><div class="r @(winlossDetail.Comm != 0 ? "red" : "")" style="width: 80px; height: 17px">@NumberFormat.DoubleFormat(winlossDetail.Comm, 2)</div></td>
                            <td><div class="r @numberColor(winlossDetail.Total)" style="width: 120px; height: 17px">@NumberFormat.DoubleFormat(winlossDetail.Total, 2)</div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 80px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 80px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th colspan="12">
                            <div style="height: 17px">Base RM</div>
                        </th>
                    </tr>
                    <tr>
                        <th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMTurnover" onclick="treeWinLossByProduct.sorting(this, 'BaseRMTurnover')">
                                Turnover</div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px" id="divBaseRMVirtualTO" onclick="treeWinLossByProduct.sorting(this, 'BaseRMVirtualTurnover')">
                                Virtual <br/> Turnover</div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell" style="width: 335px; height: 17px">
                                Turnover Variance</div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell" style="width: 330px; height: 17px" id="divBaseRMVariance" onclick="treeWinLossByProduct.sorting(this,'BaseRMVariance')">
                                Winlost Variance</div>
                        </th>
						<th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMVarianceMargin" onclick="treeWinLossByProduct.sorting(this,'BaseRMVarianceMargin')">Variance<br/>Margin (%)</div></th>
                        <th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMTotal" onclick="treeWinLossByProduct.sorting(this,'BaseRMTotal')">Total</div></th>
                        <th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="dvBaseRMVirtualTotal" onclick="treeWinLossByProduct.sorting(this,'BaseRMVirtualTotal')">Virtual Total</div></th>
                        <th rowspan="2"><div class="table-cell sorter" style="width: 110px; height: 39px" id="divMargin" onclick="treeWinLossByProduct.sorting(this,'Margin')">Margin (%)</div>
                        </th>                        
                    </tr>
                    <tr>
                        <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMTOVariancePlus" onclick="treeWinLossByProduct.sorting(this,'BaseRMTOVariancePlus')">+</div></th>
                        <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMTOVarianceMinus" onclick="treeWinLossByProduct.sorting(this,'BaseRMTOVarianceMinus')">-</div></th>
						<th> <div class="table-cell sorter" style="width: 115px; height: 17px" id="dvBaseRMTOVarianceAbsoluteTotal" onclick="treeWinLossByProduct.sorting(this,'BaseRMTOVarianceAbsoluteTotal')">Absolute Total</div></th>
                        <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="dvBaseRMWLVariancePlus" onclick="treeWinLossByProduct.sorting(this,'BaseRMWLVariancePlus')">+</div></th>
                        <th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="BaseRMWLVarianceMinus" onclick="treeWinLossByProduct.sorting(this,'BaseRMWLVarianceMinus')">-</div></th>
						<th> <div class="table-cell sorter" style="width: 110px; height: 17px" id="BaseRMWLVarianceTotal" onclick="treeWinLossByProduct.sorting(this,'BaseRMWLVarianceTotal')">Total</div></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 80px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 80px; height: 61px">&nbsp;</div>
                        </th>
                        <th rowspan="3">
                            <div class="table-cell" style="width: 120px; height: 61px">&nbsp;</div>
                        </th>
                        <th colspan="12">
                            <div style="height: 17px">Base RM</div>
                        </th>
                    </tr>
                    <tr>
                        <th rowspan="2">
                            <div class="table-cell" style="width: 110px; height: 39px">
                                Turnover</div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px">
                                Virtual Total</div>
                        </th>
                        <th colspan="3">
                            <div class="table-cell" style="width: 110px; height: 39px">
                                Turnover Variance</div>
                        </th>
                        <th colspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px">
                                Winlost Variance</div>
                        </th>
						<th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px">Variance<br/>Margin (%)</div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px">Total</div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px">Virtual Total</div>
                        </th>
                         <th rowspan="2">
                            <div class="table-cell sorter" style="width: 110px; height: 39px">
                                Margin (%)</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
					@{ index = 0; }
                    @foreach (var winlossDetail in Model.WinLoss)
                    {
                        string turnover = string.Empty;
                        string virtualTO = string.Empty;
                        string margin = string.Empty;
                        string baseRMTOVariancePlus = NumberFormat.DoubleFormat(winlossDetail.BaseRMTOVariancePlus, 2);
                        string baseRMTOVarianceMinus = NumberFormat.DoubleFormat(winlossDetail.BaseRMTOVarianceMinus, 2);
						string baseRMTOVarianceAbsoluteTotal = NumberFormat.DoubleFormat(winlossDetail.BaseRMTOVarianceAbsoluteTotal, 2);
                        string baseRMWLVariancePlus = NumberFormat.DoubleFormat(winlossDetail.BaseRMWLVariancePlus, 2);
                        string baseRMWLVarianceMinus = NumberFormat.DoubleFormat(winlossDetail.BaseRMWLVarianceMinus, 2);
						string baseRMWLVarianceTotal = NumberFormat.DoubleFormat(winlossDetail.BaseRMWLVarianceTotal, 2);
						string baseRMVarianceMargin = winlossDetail.BaseRMTOVarianceAbsoluteTotal == 0
							? "N/A" : NumberFormat.DoubleFormat(winlossDetail.BaseRMVarianceMargin, 2);
                        string total = NumberFormat.DoubleFormat(winlossDetail.BaseRMTotal, 2);
                        string virtualtotal = NumberFormat.DoubleFormat(winlossDetail.BaseRMVirtualTotal, 2);
                        
                        if (ViewBag.isShowSB == true ||
                        ViewBag.isShowNG == true ||
                        ViewBag.isShowRB == true ||
                        ViewBag.isShowLCS == true ||
                        ViewBag.isShowVS == true)
                        {
                            turnover = NumberFormat.DoubleFormat(winlossDetail.BaseRMTurnover, 2);
                            virtualTO = NumberFormat.DoubleFormat(winlossDetail.BaseRMVirtualTurnover, 2);
                        }
                        else
                        {
                            turnover = "N/A";
                            virtualTO = "N/A";
                        }

                        if (turnover == "N/A" || turnover == "0.00")
                        {
                            margin = "N/A";
                        }
                        else
                        {
                            margin = NumberFormat.DoubleFormat(winlossDetail.Margin, 2);
                        }
                        <tr class="row@(++index)">
                            <td><div class="r" style="width: 80px; height: 17px">&nbsp;</div></td>
                            <td><div class="r" style="width: 120px; height: 17px">&nbsp;</div></td>
                            <td><div class="r" style="width: 120px; height: 17px">&nbsp;</div></td>
                            <td><div class="r" style="width: 80px; height: 17px">&nbsp;</div></td>
                            <td><div class="r" style="width: 120px; height: 17px">&nbsp;</div></td>
                            <td><div class="r" style="width: 110px; height: 17px">@turnover</div></td>
                            <td><div class="r" style="width: 110px; height: 17px">@virtualTO</div></td>
                            <td><div class="r" style="width: 110px; height: 17px">@baseRMTOVariancePlus</div></td>
                            <td><div class="r" style="width: 110px; height: 17px">@baseRMTOVarianceMinus</div></td>
							<td><div class="r" style="width: 115px; height: 17px">@baseRMTOVarianceAbsoluteTotal</div></td>
                            <td><div class="r @numberColor(winlossDetail.BaseRMWLVariancePlus)" style="width: 110px; height: 17px">@baseRMWLVariancePlus</div></td>
                            <td><div class="r @numberColor(winlossDetail.BaseRMWLVarianceMinus)" style="width: 110px; height: 17px">@baseRMWLVarianceMinus</div></td>
							<td><div class="r @numberColor(winlossDetail.BaseRMWLVarianceTotal)" style="width: 110px; height: 17px">@baseRMWLVarianceTotal</div></td>
                            <td><div class="r @numberColor(winlossDetail.BaseRMVarianceMargin)" style="width: 110px; height: 17px">@baseRMVarianceMargin</div></td>
							<td><div class="r @numberColor(winlossDetail.BaseRMTotal)" style="width: 110px; height: 17px">@total</div></td>
                            <td><div class="r @numberColor(winlossDetail.BaseRMVirtualTotal)" style="width: 110px; height: 17px">@virtualtotal</div></td>
                            <td><div class="r @numberColor(winlossDetail.Margin)" style="width: 110px; height: 17px">@margin</div></td>
                        </tr>
                    }
                
                </tbody>
            </table>
        </div>
    </div>
    <div class="row_footer row-footer-background z999">
        <table class="grid-fixed-table row_footer_content">
            <thead>
                <tr>
                    <th><div class="r" style="width: 540px; height: 17px">&nbsp;</div></th>
                </tr>
                <tr class="bgWhite">
                    <th><div class="r" style="width: 540px; height: 17px">8RM</div></th>
                </tr>
                <tr class="bgWhite">
                    <th><div class="r" style="width: 540px; height: 17px">BARM</div></th>
                </tr>
                <tr class="bgWhite">
                    <th><div class="r" style="width: 540px; height: 17px">Total</div></th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="col_footer row-footer-background scroll-y">
        <div class="footer-container">
            <table class="col_footer_content grid-fixed-table">
                <thead>
                @{
                    string turnoverTotal = string.Empty;
                    string turnoverVirtualTotal = string.Empty;
					string baseRMVarianceMarginTotal = string.Empty;
                    string marginTotal = string.Empty;

                    string turnover8RM = string.Empty;
					string baseRMVarianceMargin8RM = string.Empty;
                    string margin8RM = string.Empty;

                    string turnoverBARM = string.Empty;
					string baseRMVarianceMarginBARM = string.Empty;
                    string marginBARM = string.Empty;

                    string turnoverGrandTotal = string.Empty;
                    string turnoverVirtualGrandTotal = string.Empty;
					string baseRMVarianceMarginGrandTotal = string.Empty;
                    string marginGrandTotal = string.Empty;
                    
                    if (ViewBag.isShowSB == true ||
                    ViewBag.isShowNG == true ||
                    ViewBag.isShowRB == true ||
                    ViewBag.isShowLCS == true ||
                    ViewBag.isShowVS == true)
                    {
                        turnoverTotal = NumberFormat.DoubleFormat(Model.Total.BaseRMTurnover, 2);
                        turnoverVirtualTotal = NumberFormat.DoubleFormat(Model.Total.BaseRMVirtualTurnover, 2);
                        turnover8RM = NumberFormat.DoubleFormat(Model.Total8RM.BaseRMTurnover, 2);
                        turnoverBARM = NumberFormat.DoubleFormat(Model.TotalBARM.BaseRMTurnover, 2);
                        turnoverGrandTotal = NumberFormat.DoubleFormat(Model.GrandTotal.BaseRMTurnover, 2);
                        turnoverVirtualGrandTotal = NumberFormat.DoubleFormat(Model.GrandTotal.BaseRMVirtualTurnover, 2);
                    }
                    else
                    {
                        turnoverTotal = "N/A";
                        turnoverVirtualTotal = "N/A";                        
                        turnover8RM = "N/A";
                        turnoverBARM = "N/A";
                        turnoverGrandTotal = "N/A";
                        turnoverVirtualGrandTotal = "N/A";                        
                    }

					baseRMVarianceMarginTotal = Model.Total.BaseRMTOVarianceAbsoluteTotal == 0
						? "N/A" : NumberFormat.DoubleFormat(Model.Total.BaseRMVarianceMargin, 2);

                    if (turnoverVirtualTotal == "N/A" || turnoverVirtualTotal == "0.00")
                    {
                        marginTotal = "N/A";
                    }
                    else
                    {
                        marginTotal = NumberFormat.DoubleFormat(Model.Total.Margin, 2);
                    }
					
					baseRMVarianceMargin8RM = Model.Total8RM.BaseRMTOVarianceAbsoluteTotal == 0
						? "N/A" : NumberFormat.DoubleFormat(Model.Total8RM.BaseRMVarianceMargin, 2);

                    if (turnover8RM == "N/A" || turnover8RM == "0.00")
                    {
                        margin8RM = "N/A";
                    }
                    else
                    {
                        margin8RM = NumberFormat.DoubleFormat(Model.Total8RM.Margin, 2);
                    }

					baseRMVarianceMarginBARM = Model.TotalBARM.BaseRMTOVarianceAbsoluteTotal == 0
						? "N/A" : NumberFormat.DoubleFormat(Model.TotalBARM.BaseRMVarianceMargin, 2);
					
                    if (turnoverBARM == "N/A" || turnoverBARM == "0.00")
                    {
                        marginBARM = "N/A";
                    }
                    else
                    {
                        marginBARM = NumberFormat.DoubleFormat(Model.TotalBARM.Margin, 2);
                    }
					
					baseRMVarianceMarginGrandTotal = Model.GrandTotal.BaseRMTOVarianceAbsoluteTotal == 0
						? "N/A" : NumberFormat.DoubleFormat(Model.GrandTotal.BaseRMVarianceMargin, 2);

                    if (turnoverVirtualGrandTotal == "N/A" || turnoverVirtualGrandTotal == "0.00")
                    {
                        marginGrandTotal = "N/A";
                    }
                    else
                    {
                        marginGrandTotal = NumberFormat.DoubleFormat(Model.GrandTotal.Margin, 2);
                    }
                    
                    }
                    <tr>
                        <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@turnoverTotal</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@turnoverVirtualTotal</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTOVariancePlus, 2)</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTOVarianceMinus, 2)</div></th>
						<th><div class="r" style="width: 115px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTOVarianceAbsoluteTotal, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total.BaseRMWLVariancePlus)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMWLVariancePlus, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total.BaseRMWLVarianceMinus)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMWLVarianceMinus, 2)</div></th>
						<th><div class="r @numberColor(Model.Total.BaseRMWLVarianceTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMWLVarianceTotal, 2)</div></th>
						<th><div class="r @numberColor(Model.Total.BaseRMVarianceMargin)" style="width: 110px; height: 17px">@baseRMVarianceMarginTotal</div></th>
                        <th><div class="r @numberColor(Model.Total.BaseRMTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMTotal, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total.BaseRMVirtualTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total.BaseRMVirtualTotal, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total.Margin)" style="width: 110px; height: 17px">@marginTotal</div></th>
                    </tr>
                    <tr class="bgWhite">
                        <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">8RM</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@turnover8RM</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@turnover8RM</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMTOVariancePlus,2)</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMTOVarianceMinus,2)</div></th>
						<th><div class="r" style="width: 115px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMTOVarianceAbsoluteTotal, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total8RM.BaseRMWLVariancePlus)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMWLVariancePlus,2)</div></th>
                        <th><div class="r @numberColor(Model.Total8RM.BaseRMWLVarianceMinus)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMWLVarianceMinus, 2)</div></th>
						<th><div class="r @numberColor(Model.Total8RM.BaseRMWLVarianceTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMWLVarianceTotal, 2)</div></th>
						<th><div class="r @numberColor(Model.Total8RM.BaseRMVarianceMargin)" style="width: 110px; height: 17px">@baseRMVarianceMargin8RM</div></th>
                        <th><div class="r @numberColor(Model.Total8RM.BaseRMTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMTotal, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total8RM.BaseRMVirtualTotal)" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.Total8RM.BaseRMVirtualTotal, 2)</div></th>
                        <th><div class="r @numberColor(Model.Total8RM.Margin)" style="width: 110px; height: 17px">@margin8RM</div></th>
                    </tr>
                    <tr class="bgWhite">
                        <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">BARM</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@turnoverBARM</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@turnoverBARM</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.TotalBARM.BaseRMTOVariancePlus,2)</div></th>
                        <th><div class="r" style="width: 110px; height: 17px">@NumberFormat.DoubleFormat(Model.TotalBARM.BaseRMTOVarianceMinus,2)</div></th>
						<th><div class="r" style="width: 115px; height: 17px">@NumberFormat.DoubleFormat(Model.TotalBARM.BaseRMTOVarianceAbsoluteTotal, 2)</div></th>
