@using DNAide.Core
@using Fanex.Tarus.Reports.DataAccess.DailyWinLoss2h
@using Fanex.Tarus.Reports.Entities.DailyWinLoss2h
@using Fanex.Tarus.Reports.Controllers
@using Sunplus.Accounting.Business.Report
@using Sunplus.Accounting.Core.Configurations
@using Sunplus.Accounting.Business.Security
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Core.Cache;
@using Sunplus.Accounting.Business.Report.Common;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="head1">
    <title>@Reports.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/App_Themes/Report/Report.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/spliter/style.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/DailyWinLoss2hSoccer/Css/DailyWinLoss2hSoccer.css?version=@WebSettings.Version" rel="stylesheet"
        type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">
    </script>
    <script src="~/js/jQuery/gridscroller.js" type="text/javascript"></script>
    <script src="~/js/Utils/jquery.stringformat.js" type="text/javascript"></script>
    <script src="~/js/dialogbox.js" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hSoccer/Scripts/StringFormatter.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hSoccer/Scripts/DailyWinLoss2hSoccer.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hSoccer/Scripts/WL2hShowHideDivManager.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/DailyWinLoss2hSoccer/Scripts/SoccerReportManager.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/js/common.js" type="text/javascript"></script>
    <script type="text/javascript">     
    </script>
</head>
<body id="pageBody">
    <div id="dailyWLReportDiv">
        <div class="main">
            <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
                <tr>
                    <td>
                        <div id="divMainHeader">
                            <div id="left_tab1">
                                <ul>
                                    <li class="lefticon"></li>
                                    <li class="current"><span>Daily Win Loss (2h) Soccer</span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="maincontent">
                            <div class="filterBox">
                                <div class="filterContent">
                                    @Html.Partial("Default/Report/DateTimeSinglePath_2h")
                                    <div>
                                        <div id="InformationMssg" style="display: none; word-wrap: break-word;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="contentBox">
                                @Html.Partial("~/Views/Report/DailyWinLoss2hSoccer/MainReport_DWL2hSoccer.cshtml")
                                @Html.Partial("~/Views/Report/DailyWinLoss2hSoccer/SoccerReport_DWL2hSoccer.cshtml")
                                @Html.Partial("~/Views/BetList/ScoreInformation/ScoreInformation.cshtml")
                                <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    @{  
        string btnExport = Request["ExportType"];
        DailyWinLoss2hParam param = new DailyWinLoss2hParam();
        param.EmptyReportMessage = "There is no information available.";
        var bettypeName = "";
        switch (btnExport)
        {
            case "MainReport": // MainReport
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.ReportFileName = "DailyWL_Sporttype_Soccer_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.ReportTitle = "DAILY WIN/LOSS SOCCER REPORT";
                param.DefaultSheetName = "Main";

                new DailyWinLoss2hSoccerController().ExportToExcel(param);
                break;
            case "SoccerMain": //MainSoccerReport
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.ReportFileName = "Main_Soccer_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Main-Soccer";

                new DailyWinLoss2hSoccerController().ExportToExcel_SoccerMain(param);
                break;
            case "SoccerDetails": //DetailsSoccerReport
                param.ReportDate = CastAide.AsDateTime(Request["ReportDate"]);
                param.SportType = CastAide.AsInt32(Request["SportType"]);
                param.BetType = CastAide.AsInt32(Request["BetType"]);
                bettypeName = CastAide.AsString(Request["BetTypeName"]);
                param.IsLive = CastAide.AsInt32(Request["IsLive"]);
                param.IsHedge = CastAide.AsBoolean(Request["IsHedge"]);

                param.ReportFileName = "Main_Soccer_" + bettypeName.Replace(" ", "") + "_" + param.ReportDate.ToString("MM/dd/yyyy").Replace("/", "_");
                param.DefaultSheetName = "Main-Soccer-" + bettypeName.Replace("/", "_");
                param.ReportTitle = "Main>Soccer>" + bettypeName.Replace(" ", "");
                new DailyWinLoss2hSoccerController().ExportToExcel_DailyWLDirectDetails(param);

                break;
        }
       
    }
    @{int isAllowRead = Permissions.HasPermission(Enumerations.Functions.Reports.Report2hSoccer) ? 1 : 0;}
    @{
        RMReportUtils utilsBARM = new RMReportUtils(RMReportUtils.ReportName.Report2h, RMReportUtils.RMType.BARM);
        RMReportUtils utilsEightRM = new RMReportUtils(RMReportUtils.ReportName.Report2h, RMReportUtils.RMType.EightRM);

        string eightRmStr = utilsEightRM.DisplayName;
        string isEightRMActive = utilsEightRM.IsActive.ToString().ToLower();
        string barmStr = utilsBARM.DisplayName;
        string isBARMActive = utilsBARM.IsActive.ToString().ToLower();
    }
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var today = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now)';
        var yesterday = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now.AddDays(-1))';
        var fdate = '@Request["reportDate"]';
        if (fdate == undefined || fdate == "") {
            fdate = '@DateTime.Now.ToShortDateString()';
        }

        var dailyWLMP_WebSettings = '@CastAide.AsDateTime(WebSettings.getDateDailyWLMP)';
        var frmDate = new Date(fdate);
        var isAllowRead = @CastAide.AsInt32(@isAllowRead);

        var eightRmStr =  '@CastAide.AsString(@eightRmStr)';
        var isEightRMActive =  '@CastAide.AsString(@isEightRMActive)';
        var barmStr =  '@CastAide.AsString(@barmStr)';
        var isBARMActive =  '@CastAide.AsString(@isBARMActive)';
        var isAllowReadSoccerReport = @CastAide.AsInt32(@isAllowRead);
    </script>
</body>
</html>
