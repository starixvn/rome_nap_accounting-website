            </table>
            <div class="maincontent_box" style="width: 900px;">
                <div id="header">
                    <div id="dvSearchBy">
                        <span id="spSearchBy">Search by</span> <span style="padding-left: 30px;">
                            <input onclick="punter.setSearchBy(0)" type="radio" id="rdUser" name="rdSearchBy" /></span>
                        <span id="spUser" class="pright30">User</span> <span>
                            <input onclick="punter.setSearchBy(1)" type="radio" id="rdLeague" name="rdSearchBy" /></span>
                        <span id="spLeague" class="pright30">League</span>
                    </div>
                    <div id="dvTopRows" class="space10">
                        <span>Top rows</span> <span style="padding-left: 40px">
                            <input type="text" onblur="punter.setDefaultTopRows();" onkeypress="return CheckDecNumber(event);"
                                id="txtTopRows" value="10" maxlength="4" style="width: 30px" />
                        </span>
                    </div>
                    <div id="dvUserName" class="space10">
                        <span>UserName</span> <span style="padding-left: 35px">
                            <input type="text" value="All" id="txtUserName" maxlength="50" style="width: 120px"
                                onclick="punter.onclickUserName()" onblur="punter.onblurUserName()" />
                        </span>
                    </div>
                    <div id="dvSport" class="space10">
                        <span>Sport type</span> <span style="padding-left: 33px;"><span id="ddlSportUser"></span>
                        </span>
                    </div>
                    <div id="dvOrderby" class="space10">
                        <span>Order by</span> <span style="padding-left: 41px">
                            <select id="ddlOrderby" style="width: 80px">
                                <option value="1">Winlost</option>
                                <option value="2">Turnover</option>
                                <option value="3">Margin</option>
                            </select>
                        </span><span>
                            <select id="ddlOrderType">
                                <option value="1">Descending</option>
                                <option value="0">Ascending</option>
                            </select>
                        </span>
                    </div>
                    <div id="dvPeriodType" class="space10">
                        <span>Period type</span> <span style="padding-left: 23px">
                            <input onclick="punter.setPeriodType(0);" type="radio" id="rdMonthly" name="rdPeriodType"
                                checked="checked" /></span><span class="pright30">Monthly</span> <span>
                                    <input onclick="punter.setPeriodType(1);" type="radio" id="rdAnnual" name="rdPeriodType" /></span><span
                                        class="pright30">Annual</span> <span>
                                            <input onclick="punter.setPeriodType(2);" type="radio" id="rdLongRange" name="rdPeriodType" /></span><span
                                                class="pright30">Long Range</span>
                    </div>
                    <div id="dvMonthly" class="space10">
                        <span id="spPeriodType"></span><span id="spReport1">
                            <input type="button" id="btnReport1" name="btnReport" value="REPORT" class="btn"
                                onclick="punter.generateReport();" /></span>
                    </div>
                    <div id="dvSportByLeague" class="space10">
                        <span>Sport</span> <span style="padding-left: 58px;"><span id="ddlSportLeague"></span>
                        </span><span>League</span> <span>
                            <select id="ddlLeagues">
                                <option value="0">There is no information available.</option>
                            </select></span> <span id="spReport2">
                                <input type="button" id="btnReport2" name="btnReport" value="REPORT" class="btn"
                                    onclick="punter.generateReport();" /></span>
                    </div>
