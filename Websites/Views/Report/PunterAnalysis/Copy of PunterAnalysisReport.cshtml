    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    @{  
        string exportType = Request["ExportType"];
        PunterAnalysisParam param = new PunterAnalysisParam();
        if (!string.IsNullOrEmpty(exportType))
        {
            switch (exportType)
            {
                case "TopPunterSummary":
                    param.FromDate = CastAide.AsString(Request["FromDate"]);
                    param.ToDate = CastAide.AsString(Request["ToDate"]);
                    param.SportId = CastAide.AsString(Request["SportId"]);
                    param.SportName = CastAide.AsString(Request["SportName"]);
                    param.UserName = CastAide.AsString(Request["UserName"]);
                    param.OrderBy = CastAide.AsString(Request["OrderBy"]);
                    param.OrderType = CastAide.AsString(Request["OrderType"]);
                    param.TopRow = CastAide.AsString(Request["TopRow"]);
                    param.LeagueId = CastAide.AsString(Request["LeagueId"]);
                    param.ReportFileName = "TopPunterSummary";
                    param.DefaultSheetName = "TopPunterSummary";
                    param.OrderByName = CastAide.AsString(Request["OrderByName"]);
                    param.OrderTypeName = CastAide.AsString(Request["OrderTypeName"]);
                    param.LeagueName = CastAide.AsString(Request["LeagueName"]);

                    new PunterAnalysisController().ExportExcelTopPunterSummary(param);
                    break;
                case "TopPunterSummaryByLeague":
                    param.FromDate = CastAide.AsString(Request["FromDate"]);
                    param.ToDate = CastAide.AsString(Request["ToDate"]);
                    param.SportId = CastAide.AsString(Request["SportId"]);
                    param.SportName = CastAide.AsString(Request["SportName"]);
                    param.UserName = CastAide.AsString(Request["UserName"]);
                    param.OrderBy = CastAide.AsString(Request["OrderBy"]);
                    param.OrderType = CastAide.AsString(Request["OrderType"]);
                    param.TopRow = CastAide.AsString(Request["TopRow"]);
                    param.LeagueId = CastAide.AsString(Request["LeagueId"]);
                    param.ReportFileName = "TopPunterSummary";
                    param.DefaultSheetName = "TopPunterSummary";
                    param.OrderByName = CastAide.AsString(Request["OrderByName"]);
                    param.OrderTypeName = CastAide.AsString(Request["OrderTypeName"]);
                    param.LeagueName = CastAide.AsString(Request["LeagueName"]);

                    new PunterAnalysisController().ExportExcelTopPunterSummaryByLeague(param);
                    break;
                case "TopPunterByCustID":
                    param.FromDate = CastAide.AsString(Request["FromDate"]);
                    param.ToDate = CastAide.AsString(Request["ToDate"]);
                    param.OrderBy = CastAide.AsString(Request["OrderBy"]);
                    param.OrderType = CastAide.AsString(Request["OrderType"]);
                    param.OrderByName = CastAide.AsString(Request["OrderByName"]);
                    param.OrderTypeName = CastAide.AsString(Request["OrderTypeName"]);
                    param.CustId = CastAide.AsString(Request["CustId"]);
                    param.CustName = CastAide.AsString(Request["CustName"]);
                    param.ReportFileName = "TopPunterSummary";
                    param.DefaultSheetName = "TopPunterSummary";

                    new PunterAnalysisController().ExportExcelTopPunterByCustID(param);
                    break;
                case "TopPunterByLeagueCustID":
                    param.FromDate = CastAide.AsString(Request["FromDate"]);
                    param.ToDate = CastAide.AsString(Request["ToDate"]);
                    param.OrderBy = CastAide.AsString(Request["OrderBy"]);
                    param.OrderType = CastAide.AsString(Request["OrderType"]);
                    param.OrderByName = CastAide.AsString(Request["OrderByName"]);
                    param.OrderTypeName = CastAide.AsString(Request["OrderTypeName"]);
                    param.CustId = CastAide.AsString(Request["CustId"]);
                    param.CustName = CastAide.AsString(Request["CustName"]);
                    param.LeagueId = CastAide.AsString(Request["LeagueId"]);
                    param.LeagueName = CastAide.AsString(Request["LeagueName"]);
                    param.ReportFileName = "TopPunterSummary";
                    param.DefaultSheetName = "TopPunterSummary";

                    new PunterAnalysisController().ExportExcelTopPunterByLeagueCustID(param);
                    break;
                case "TopPunterBySporttype":
                    param.FromDate = CastAide.AsString(Request["FromDate"]);
                    param.ToDate = CastAide.AsString(Request["ToDate"]);
                    param.OrderBy = CastAide.AsString(Request["OrderBy"]);
                    param.OrderType = CastAide.AsString(Request["OrderType"]);
                    param.OrderByName = CastAide.AsString(Request["OrderByName"]);
                    param.OrderTypeName = CastAide.AsString(Request["OrderTypeName"]);
                    param.CustId = CastAide.AsString(Request["CustId"]);
                    param.CustName = CastAide.AsString(Request["CustName"]);
                    param.LeagueId = CastAide.AsString(Request["LeagueIdBySport"]);
                    param.LeagueName = CastAide.AsString(Request["LeagueNameBySport"]);
                    param.SportId = CastAide.AsString(Request["SportTypeId"]);
                    param.SportName = CastAide.AsString(Request["SportTypeName"]);
                    param.ReportFileName = "TopPunterSummary";
                    param.DefaultSheetName = "TopPunterSummary";

                    new PunterAnalysisController().ExportExcelTopPunterBySporttype(param);
                    break;
            }
        }
    }
