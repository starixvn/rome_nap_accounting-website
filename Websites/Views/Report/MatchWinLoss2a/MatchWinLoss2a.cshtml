@using DNAide.Core;
@using Sunplus.Accounting.Core.Configurations;
@using Sunplus.Accounting.Business.Report;
@using Sunplus.Accounting.Business.Report.Common;
@using Fanex.Tarus.Reports.Controllers.MatchWinLoss;
@using Fanex.Tarus.Reports.Entities.MatchWinLoss;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Reports.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link href="~/App_Themes/Report/Report.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/spliter/style.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/MatchWinLoss2a/Styles/MatchWinLoss2a.css?version=@WebSettings.Version" rel="stylesheet"
        type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">    
    </script>
    <script src="~/js/Utils/jquery.calendar.js" type="text/javascript"></script>
    <script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?version=2" type="text/javascript"></script>
    <script src="~/js/dialogbox.js" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/StringFormatter.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/WLSummaryByBetType.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/MatchWinLossDetail.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/MatchWinLoss2a.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/MatchWinLoss2aUtils.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script type="text/javascript">     
    </script>
</head>
<body style="">
    <div id="matchWinLoss2aReportDiv" style="">
        <div class="main" style="">
            <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
                <tr>
                    <td>
                        <div id="divMainHeader" class="">
                            <div id="left_tab1">
                                <ul>
                                    <li class="lefticon"></li>
                                    <li class="current"><span>Match Win Loss (2a)</span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="maincontent" style="">
                            <div class="filterBox">
                                <div class="filterContent">
                                    <table class="table">
                                        <tr class="c b">
                                            <td class="padright">
                                                Date:
                                            </td>
                                            <td>
                                                <input type="text" id="txtFromDate" readonly="readonly" class="txtdate" style="width: 100px;
                                                    background-color: white;" />
                                            </td>
                                            <td style="padding-left: 5px;">
                                                <input id="btnReport" name="btnReport" type="button" value="REPORT" class="btn" />
                                                <span id="spMoreElement"></span>
                                            </td>
                                            <td>
                                                <input id="btnExport" name="btnExport" type='button' value='' class='btnExcel' title="Export to Excel" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div>
                                    <div id="ErrorMEssage" style="display: none; word-wrap: break-word;">
                                    </div>
                                </div>
                            </div>
                            <div id="contentBox" style="">
                                @Html.Partial("~/Views/Report/MatchWinLoss2a/WLSummaryByBetTypeReport.cshtml")
                                @Html.Partial("~/Views/Report/MatchWinLoss2a/WLSummaryBySportTypeReport.cshtml")
                                <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    @{
        string beginSupportMPDate = WebSettings.getDateDailyWLMP;
        RMReportUtils utilsBARM = new RMReportUtils(RMReportUtils.ReportName.Report2a, RMReportUtils.RMType.BARM);
        RMReportUtils utilsEightRM = new RMReportUtils(RMReportUtils.ReportName.Report2a, RMReportUtils.RMType.EightRM);

        string eightRmStr = utilsEightRM.DisplayName;
        string isEightRMActive = utilsEightRM.IsActive.ToString().ToLower();

        string barmStr = utilsBARM.DisplayName;
        string isBARMActive = utilsBARM.IsActive.ToString().ToLower();
    }
    @{  
        if (Request["ExportType"] != null)
        {
            string exportType = Request["ExportType"];
            DateTime reportDate;
            string reportName = string.Empty;
            switch (exportType)
            {
                case "WLSummaryByBetTypeReport":
                    reportDate = CastAide.AsDateTime(Request["ReportDate"]);
                    reportName = string.Format("MatchWinLoss2aByBetType_{0:MM_dd_yyyy}", reportDate);
                    new WLSummaryByBetTypeController().ExportWLSummaryByBetTypeReport(reportDate, reportName);
                    break;
                case "WLSummaryBySportTypeReport":
                    reportDate = CastAide.AsDateTime(Request["ReportDate"]);
                    reportName = string.Format("MatchWinLoss2aSummaryBySportType_{0:MM_dd_yyyy}", reportDate);
                    new MatchWinLossController().ExportWLSummaryBySportTypeReport(reportDate, reportName);
                    break;
                case "WLAllDetails":
                    reportDate = CastAide.AsDateTime(Request["ReportDate"]);
                    reportName = string.Format("MatchWinLoss2aAllDetails_{0:MM_dd_yyyy}", reportDate);
                    new MatchWinLossController().ExportWLAllDetails(reportDate, reportName);
                    break;
                case "AllMainReports":
                    reportDate = CastAide.AsDateTime(Request["ReportDate"]);
                    reportName = string.Format("MatchWinLoss2aAllReports_{0:MM_dd_yyyy}", reportDate);
                    new MatchWinLossController().ExportWLSummaryMainReports(reportDate, reportName);
                    break;
            }
        }
    }
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var toDay = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now)';
        var yesterday = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now.AddDays(-1))';
        var beginSupportMPDate = '@beginSupportMPDate';
        var fDate = '@Request["reportDate"]';
        if (fDate == undefined || fDate == "") {
            fDate = toDay;
        }
        var minDate = '@string.Format("{0:MM/dd/yyyy}", new DateTime(2006, 01, 01))';
        var maxDate = '@string.Format("{0:MM/dd/yyyy}", DateTime.Now.AddDays(7))';

        matchWinLoss2a.isBARMActive = '@CastAide.AsString(@isBARMActive)';
        matchWinLoss2a.displayNameBARM = '@CastAide.AsString(@barmStr)';
        matchWinLoss2a.isEightRMActive = '@CastAide.AsString(@isBARMActive)';
        matchWinLoss2a.displayNameEightRM = '@CastAide.AsString(@barmStr)';
    </script>
</body>
</html>
