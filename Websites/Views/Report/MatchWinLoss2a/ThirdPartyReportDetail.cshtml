@using DNAide.Core;
@using Sunplus.Accounting.Business.Report
@using Sunplus.Accounting.Core.Configurations;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Reports.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/App_Themes/Report/Report.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/spliter/style.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/MatchWinLoss2a/Styles/MatchWinLoss2a.css?version=@WebSettings.Version" rel="stylesheet"
        type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">    
    </script>
    <script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?version=2" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/StringFormatter.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MatchWinLoss2a/Scripts/ThirdPartyReportDetail.js?version=@WebSettings.Version" type="text/javascript"></script>
</head>
<body>
    <div id="thirdPartyReportPopup" style="">
        <div id="thirdPartyReport" class="freegrid hidden" style="margin-top: 6px; margin-left: 0px;
            margin-bottom: 10px;">
            <div class="grid-title">
                <div id="thirdPartyReport_Title" class="grid-title-lable">
                    Casino Daily Report</div>
                @* <div class="grid-toolbox">
                    <input id="thirdPartyReport_ExportExcel" class="btnExcel" type="button" title="Export to Excel"
                        value=" "/>
                </div>*@
            </div>
            <div class="free-cell free-top-left">
                <table class="grid-fixed-table free-cell-top-left">
                    <thead>
                        <tr style="">
                            <th>
                                <div class="col120 c table-cell" style="height: 34px;">
                                    Bettype</div>
                            </th>
                            <th>
                                <div class="col100 c table-cell" style="height: 34px;">
                                    Currency</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="row_header_wrapper">
                <div class="row_header row-headers-background" id="thirdPartyReport_RowHeader">
                    <table class="grid-fixed-table row_header_content">
                        <thead>
                            <tr style="">
                                <th>
                                    <div class="col120 c table-cell" style="height: 34px;">
                                        Bettype</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Currency</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col_header row-headers-background scroll-y">
                <div class="header-container">
                    <table class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div class="col120 c" style="height: 34px;">
                                        Bettype</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Currency</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Turnover</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        WinLoss</div>
                                </th>
                                <th>
                                    <div class="col90 c table-cell" style="height: 34px;">
                                        Position</div>
                                </th>
                                <th>
                                    <div class="col80 c table-cell" style="height: 34px;">
                                        Comm</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Line Total</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Margin%</div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="grid-container container">
                <div class="content-container">
                    <table id="thirdPartyReport_Container" class="grid-fixed-table col_header_content">
                        <thead>
                            <tr>
                                <th>
                                    <div class="col120 c" style="height: 34px;">
                                        Bettype</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Currency</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Turnover</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        WinLoss</div>
                                </th>
                                <th>
                                    <div class="col90 c table-cell" style="height: 34px;">
                                        Position</div>
                                </th>
                                <th>
                                    <div class="col80 c table-cell" style="height: 34px;">
                                        Comm</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Line Total</div>
                                </th>
                                <th>
                                    <div class="col100 c table-cell" style="height: 34px;">
                                        Margin%</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row_footer row-footer-background z999">
                <table class="grid-fixed-table row_footer_content">
                    <thead>
                    </thead>
                </table>
            </div>
            <div class="col_footer row-footer-background scroll-y">
                <div class="footer-container">
                    <table class="col_footer_content grid-fixed-table">
                        <thead>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    @{     
        DateTime reportDate = DateTime.Today;
        string betType = string.Empty;
        if (Request["ExportType"] != null)
        {
            string exportType = Request["ExportType"];
            string reportName = string.Empty;
            switch (exportType)
            {
                case "Casino":
                    break;
            }
        }
        else
        {
            if (Request["ReportDate"] != null)
            {
                reportDate = CastAide.AsDateTime(Request["ReportDate"]);
            }

            if (Request["BetType"] != null)
            {
                betType = CastAide.AsString(Request["BetType"]);
            }
        }
    }
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';

        var reportDate = '@reportDate';
        var betType = '@betType';
    </script>
</body>
</html>
