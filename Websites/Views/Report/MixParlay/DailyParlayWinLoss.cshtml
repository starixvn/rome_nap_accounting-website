@{
    DateTime fromDate = DateTime.Today;
    DateTime toDate = DateTime.Today;
    int betTypeId = 0;
    string betType = string.Empty;
    bool isRedirect = false;
    if (Request["IsExport"] != null && Request["IsExport"] == "1")
    {
        fromDate = DNAide.Core.CastAide.AsDateTime(Request["fromDate"]);
        toDate = DNAide.Core.CastAide.AsDateTime(Request["toDate"]);
        bool isViewDW = DNAide.Core.CastAide.AsBoolean(Request["isViewDW"]);
        string reportType = Request["reportType"].ToString();

        switch (reportType)
        {
            case "dailyParlayWinLoss":
                new Fanex.Tarus.Reports.Controllers.MixParlay.MixParlayController().ExportExcelDailyParlayWinLoss(fromDate, toDate, isViewDW);
                break;
            case "advanceParlayWinLoss":
                new Fanex.Tarus.Reports.Controllers.MixParlay.MixParlayController().ExportExcelAdvanceParlayWinLoss(fromDate, toDate, isViewDW);
                break;
        }

    }
    else
    {
        if (Request["IsRedirect"] != null)
        {
            isRedirect = DNAide.Core.CastAide.AsBoolean(Request["IsRedirect"]);
        }
        if (Request["reportDate"] != null)
        {
            fromDate = DNAide.Core.CastAide.AsDateTime(Request["reportDate"]);
            toDate = DNAide.Core.CastAide.AsDateTime(Request["reportDate"]);
        }
        if (Request["BetTypeId"] != null)
        {
            betTypeId = DNAide.Core.CastAide.AsInt32(Request["BetTypeId"]);
        }
        if (Request["BetType"] != null)
        {
            betType = DNAide.Core.CastAide.AsString(Request["BetType"]);
        }
        if (!isRedirect)
        {
            fromDate = DateTime.Today;
            toDate = DateTime.Today;
        }
    }
        //var fromdate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToShortDateString();
}
<script type="text/javascript">
    var movebetday = '@DNAide.Core.CastAide.AsDateTime(Fanex.Tarus.Reports.DataAccess.BaseDataAccess.BalanceUp.MoveBetDay).AddDays(1).ToShortDateString()';
    var fromdate = '@fromDate.ToShortDateString()';
    var today = '@toDate.ToShortDateString()';
    var currentDay = '@DateTime.Today.ToShortDateString()';
    var yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
    var beforeyesterday = '@DateTime.Today.AddDays(-2).ToShortDateString()';
    var isredirect = '@isRedirect';
    var bettype = '@betType';
    var bettypeId = '@betTypeId';
</script>
