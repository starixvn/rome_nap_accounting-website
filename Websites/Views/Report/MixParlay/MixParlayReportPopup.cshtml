@using DNAide.Core;
@using Sunplus.Accounting.Business.Report
@using Sunplus.Accounting.Core.Configurations;
@using Fanex.Tarus.Reports.Controllers.MixParlay;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Reports.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/App_Themes/Report/Report.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/spliter/style.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/MixParlay/Styles/MixParlayReport.css?version=@WebSettings.Version" rel="stylesheet"
        type="text/css" />       
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">    
    </script> 
    <script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?version=2" type="text/javascript"></script>
    <script src="~/Views/Report/MixParlay/Scripts/StringFormatter.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MixParlay/Scripts/AdvanceMixParlayReport.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MixParlay/Scripts/NormalMixParlayReport.js?version=@WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/Report/MixParlay/Scripts/MixParlayReport.js?version=@WebSettings.Version" type="text/javascript"></script>
</head>
<body>
    <div id="mixParlayReportPopup" style="">
        @Html.Partial("~/Views/Report/MixParlay/AdvanceMixParlayReport.cshtml")
        @Html.Partial("~/Views/Report/MixParlay/NormalMixParlayReport.cshtml")
    </div>
    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
</body>
@{     
    DateTime reportDate = DateTime.Today;
  
    int betTypeId = 0;
    string betType = string.Empty;
    string beginSupportMPDate = string.Empty;
    if (Request["ExportType"] != null)
    {
        string exportType = Request["ExportType"];
        string reportName = string.Empty;
        switch (exportType)
        {
            case "AdvanceReport":
                reportDate = CastAide.AsDateTime(Request["reportDate"]);
                betTypeId = CastAide.AsInt32(Request["BetTypeId"]);
                new MixParlayController().Export2Excel_MixParlayAdvanceMain(reportDate, reportDate, betTypeId);
                break;
            case "NormalReport":
                 reportDate = CastAide.AsDateTime(Request["reportDate"]);
                betTypeId = CastAide.AsInt32(Request["BetTypeId"]);
                new MixParlayController().ExportToExcel_DirectMixParlay(reportDate, betTypeId);
                break;
        }
    }
    else
    {
        beginSupportMPDate = WebSettings.getDateDailyWLMP;
        if (Request["reportDate"] != null )
        {
            reportDate = CastAide.AsDateTime(Request["reportDate"]);
            
        }
        else
        {
            reportDate = DateTime.Today;
        }

        if (Request["BetTypeId"] != null)
        {
            betTypeId = CastAide.AsInt32(Request["BetTypeId"]);
        }
        if (Request["BetType"] != null)
        {
            betType = CastAide.AsString(Request["BetType"]);
        }
    }
}
</html>
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    var movebetday = '@DNAide.Core.CastAide.AsDateTime(Fanex.Tarus.Reports.DataAccess.BaseDataAccess.BalanceUp.MoveBetDay).AddDays(1).ToShortDateString()';
    var beginSupportMPDate = '@beginSupportMPDate';
    var reportDate = '@reportDate';
    var betType = '@betType';
    var betTypeId = '@betTypeId';
</script>
