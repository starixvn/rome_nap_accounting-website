@{
    if(Request["isexport"]!=null && DNAide.Core.CastAide.AsBoolean(Request["isexport"])){
        var wlDate = DNAide.Core.CastAide.AsString(Request["date"]);
        var currencies = DNAide.Core.CastAide.AsString(Request["currencies"]);
        var companies = DNAide.Core.CastAide.AsString(Request["companies"]);
        var liveStatus = DNAide.Core.CastAide.AsInt32(Request["liveStatus"]);
        var title = DNAide.Core.CastAide.AsString(Request["title"]);
        Fanex.Tarus.Reports.Business.NumberGameWinLoss.NumberGameWinLossByBettype.INumberGameWinLossByBettypeService numberGameService = new Fanex.Tarus.Reports.Business.NumberGameWinLoss.NumberGameWinLossByBettype.NumberGameWinLossByBettypeService();
        if (DNAide.Core.CastAide.AsInt32(Request["type"]) == 1)
        {
            numberGameService.ExportExcelNumberGameWinLossByBettype(wlDate, currencies, companies, liveStatus, title);
        }
        else if (DNAide.Core.CastAide.AsInt32(Request["type"]) == 2){
            var bettypeName = DNAide.Core.CastAide.AsString(Request["bettypename"]);   
            var bettype = DNAide.Core.CastAide.AsInt32(Request["bettype"]);
            numberGameService.ExportExcelNumberGameWinLossByBettypeDetail(wlDate, liveStatus, bettype, bettypeName, companies, currencies, title);
        }
    }
}
