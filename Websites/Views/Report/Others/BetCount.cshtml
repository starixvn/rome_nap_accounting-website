<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
<link href="~/js/MultipleSelect/jquery.multiselect.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/monthPicker/monPickr-0.0.1.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" type="text/css" href="~/Views/Report/Others/Styles/BetCount.css?ver=2" />
<div class="main">
    <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
        <tr>
            <td>
                <div id="divMainHeader" class="">
                    <div id="left_tab1">
                        <ul>
                            <li class="lefticon"></li>
                            <li class="current"><span>Bet Count</span></li>
                        </ul>
                    </div>
                </div>
                <div class="maincontent" style="margin-bottom: 10px;">
                    <div class="filterBox" style="width: 1022px;">
                        <div class="filterContent">
                            <table>
                                <tbody>
                                    <tr>
                                        <td class="w20">
                                            <label class="normalfillter">
                                                Date:</label>
                                            <label class="historyfillter hidden">
                                                Month:</label>
                                        </td>
                                        <td class="w130">
                                            <select id="ddlRangeDate" class="normalfillter w120">
                                                <option value="0">Yesterday</option>
                                                <option value="1">Current Week</option>
                                                <option value="2">Last Week</option>
                                                <option value="3">Current Month</option>
                                                <option value="4">Last Month</option>
                                                <option value="5">Since Last Month</option>
                                                <option value="6">Specific Date</option>
                                            </select>
                                            <div id="ddlRangeOldDate" class="w120 historyfillter hidden">
                                            </div>
                                        </td>
                                        <td class="w20">
                                            From:
                                        </td>
                                        <td class="w90">
                                            <input type="text" id="txtFromDate" readonly="readonly" class="txtdate normalfillter"
                                                style="width: 90px;" />
                                            <div id="spFrom" class="w40 historyfillter hidden">
                                            </div>
                                        </td>
                                        <td class="w20">
                                            To:
                                        </td>
                                        <td class="w90">
                                            <input type="text" id="txtToDate" readonly="readonly" class="txtdate normalfillter"
                                                style="width: 90px;" />
                                            <div id="spTo" class="w40 historyfillter hidden">
                                            </div>
                                        </td>
                                        <td class="w40">
                                            Products:
                                        </td>
                                        <td class="w150">
                                            <div id="ddlProduct" class="multiselect" multiple="multiple" style="padding-top: 2px;">
                                            </div>
                                        </td>
                                        <td class="w50">
                                            <input type="button" id="btnReport" name="btnReport" value="Report" class="btn" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <table>
                                <tr>
                                    <td style="width: 800px">
                                        <div class="warning l" id="dvMsg">
                                            <ul>
                                                <li><span id="spMsgNormal" class="normalfillter"><span>Data is only available from last
                                                    3 months up to yesterday (after 11AM GMT-4). For more historical data, please click
                                                    to</span> <span id="btnviewhistory" class="canchange">View History Report</span>
                                                </span><span id="spMsgOld" class="w120 historyfillter hidden"><span>Data is only available
                                                    up to yesterday (after 11AM GMT-4).</span> <span id="btnviewnormal" class="canchange">
                                                        Back to Current Report</span> </span></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <div id="err" style="display: none">
                                <div class="alertboxerr">
                                    <div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="mainreport" class="contentBox" style="display: none;">
                        <div id="betCountReport" class="freegrid hidden">
                            <div class="grid-title">
                                <div class="grid-toolbox">
                                    <input type="button" value="" id="btnExport" class="btnExcel" title="Export to Excel" />
                                </div>
                            </div>
                            <div class="free-cell free-top-left">
                                <table class="grid-fixed-table free-cell-top-left">
                                    <thead>
                                        <tr>
                                            <th>
                                                <div class="table-cell" style="width: 80px; height: 39px">
                                                    Site</div>
                                            </th>
                                            <th>
                                                <div class="table-cell" style="width: 90px; height: 39px">
                                                    Bet Count</div>
                                            </th>
                                            <th>
                                                <div id="divSortingTurnover" class="table-cell sorter" style="width: 130px; height: 39px">
                                                    Total Turnover</div>
                                            </th>
                                            <th>
                                                <div id="divSortingMemberWL" class="table-cell sorter" style="width: 130px; height: 39px">
                                                    Member Winloss</div>
                                            </th>
                                            <th>
                                                <div id="divSortingMargin" class="table-cell sorter" style="width: 90px; height: 39px">
                                                    Margin %</div>
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="row_header_wrapper">
                                <div class="row_header row-headers-background">
                                    <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <div class="table-cell" style="width: 80px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 90px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 130px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 130px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 90px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col_header row-headers-background scroll-y">
                                <div class="header-container">
                                    <table class="grid-fixed-table col_header_content">
                                        <thead>
                                            <tr>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 80px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 90px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 130px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 130px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 90px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th colspan="3">
                                                    <div style="height: 17px">
                                                        SMA Winloss</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div id="divSortingCompany" class="table-cell sorter" style="width: 110px; height: 39px">
                                                        Company</div>
                                                </th>
                                            </tr>
                                            <tr>
                                                <th>
                                                    <div id="divSortingAgentWL" class="table-cell sorter" style="width: 110px; height: 17px">
                                                        Agent</div>
                                                </th>
                                                <th>
                                                    <div id="divSortingMasterWL" class="table-cell sorter" style="width: 110px; height: 17px">
                                                        Master</div>
                                                </th>
                                                <th>
                                                    <div id="divSortingSuperWL" class="table-cell sorter" style="width: 110px; height: 17px">
                                                        Super</div>
                                                </th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                            <div class="grid-container container">
                                <div class="content-container">
                                    <table id="tblContent" class="grid-fixed-table col_header_content">
                                        <thead>
                                            <tr>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 80px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 90px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 130px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 130px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 90px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                                <th colspan="3">
                                                    <div class="table-cell" style="height: 17px">
                                                        &nbsp;</div>
                                                </th>
                                                <th rowspan="2">
                                                    <div class="table-cell" style="width: 110px; height: 39px">
                                                        &nbsp;</div>
                                                </th>
                                            </tr>
                                            <tr>
                                                <th>
                                                    <div class="table-cell" style="width: 110px; height: 17px">
                                                        &nbsp;</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 110px; height: 17px">
                                                        &nbsp;</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 110px; height: 17px">
                                                        &nbsp;</div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row_footer row-footer-background z999">
                                <table class="grid-fixed-table row_footer_content">
                                    <thead>
                                    </thead>
                                </table>
                            </div>
                            <div class="col_footer row-footer-background scroll-y">
                                <div class="footer-container">
                                    <table class="col_footer_content grid-fixed-table">
                                        <thead>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</div>
<iframe id="frameExportExcel" style="display: none"></iframe>
<script type="text/javascript" src="~/js/jQuery/jquery-1.7.2.min.js"></script>
<script type="text/javascript" src="~/js/jQuery/jquery.blockUI.1.33.js"></script>
<script type="text/javascript" src="~/js/common.js"></script>
<script type="text/javascript" src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js"></script>
<script type="text/javascript" src="~/js/BlockUI.js?version=2"></script>
<script src="~/js/jQuery/monthPicker/monPickr-0.0.1.js" type="text/javascript"></script>
<script src="~/js/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
<script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=1" type="text/javascript"></script>
<script type="text/javascript" src="~/Views/Report/Others/js/BetCount.js?ver=1"></script>
<script type="text/javascript">
    var mindate = new Date('@DateTime.Now.AddMonths(-2).ToString()');

    var defaultDate = new Date('@DateTime.Now.AddDays(-1).ToString()');
    var linkExportExcel = '@Url.Action("ExportBetCountToExcelFile", "BetCount")';
</script>
