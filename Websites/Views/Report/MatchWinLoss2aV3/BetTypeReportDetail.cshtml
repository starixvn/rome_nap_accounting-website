@{     
    DateTime reportDate = DateTime.Today;
    string sportName = string.Empty;
    int betType = 0;
    string betTypeName = string.Empty;
    int liveType = 0;
    if (Request["ExportType"] != null)
    {
        string exportType = Request["ExportType"];
        string reportName = string.Empty;
        switch (exportType)
        {
            case "BetTypeReportDetail":
                reportDate = CastAide.AsDateTime(Request["ReportDate"]);
                reportName = string.Format("MatchWinLoss2aDetailByBetType_{0:MM_dd_yyyy}", reportDate);
                sportName = CastAide.AsString(Request["SportName"]);
                betType = CastAide.AsInt32(Request["BetType"]);
                betTypeName = CastAide.AsString(Request["BetTypeName"]);
                liveType = CastAide.AsInt32(Request["LiveType"]);
                new MatchWinLoss2aV3Controller().ExportBetTypeReportDetail(reportDate, reportName,
                    sportName, betType, betTypeName, liveType);
                break;
        }
    }
    else
    {
        if (Request["ReportDate"] != null)
        {
            reportDate = CastAide.AsDateTime(Request["ReportDate"]);
        }

        if (Request["SportName"] != null)
        {
            sportName = CastAide.AsString(Request["SportName"]);
        }

        if (Request["BetType"] != null)
        {
            betType = CastAide.AsInt32(Request["BetType"]);
        }
        if (Request["BetTypeName"] != null)
        {
            betTypeName = CastAide.AsString(Request["BetTypeName"]);
        }
        if (Request["LiveType"] != null)
        {
            liveType = CastAide.AsInt32(Request["LiveType"]);
        }
    }
}
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    var reportDate = '@reportDate';
    var sportName = '@sportName';
    var betType = '@betType';
    var betTypeName = '@betTypeName'.replace(/\&amp;/g, '&');
    var liveType = '@liveType';
</script>
