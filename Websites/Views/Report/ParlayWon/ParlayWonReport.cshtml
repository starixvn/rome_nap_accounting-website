@{
    if (Request["IsExport"] != null && DNAide.Core.CastAide.AsBoolean(Request["IsExport"]))
    {
        string winlostDate = Request["winlostDate"].ToString();
        int betType = DNAide.Core.CastAide.AsInt32(Request["betType"]);
        bool isSoccer = DNAide.Core.CastAide.AsBoolean(Request["isSoccer"]);
        string moveBetsDay = DNAide.Core.CastAide.AsString(Request["moveBetsDay"]);
        string balanceUpDay = DNAide.Core.CastAide.AsString(Request["balanceUpdate"]);
        bool fromCache = DNAide.Core.CastAide.AsBoolean(Request["fromCache"]);

        Fanex.Tarus.Reports.Business.ParlayWon.IParlayWonService exportData = new Fanex.Tarus.Reports.Business.ParlayWon.ParlayWonService();
        exportData.ExportExcelParlayWon(winlostDate, betType, isSoccer, moveBetsDay, balanceUpDay, fromCache);

    }
}
