@using DNAide.Core;
@using Sunplus.Accounting.Core.Configurations;
@using Sunplus.Accounting.Business.Report;
@using Sunplus.Accounting.Business.Report.Common;
@using Fanex.Tarus.Infrastructure.Resource;
@using Fanex.Tarus.Infrastructure.Configurations;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@Reports.Title</title>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link href="~/App_Themes/Report/Report.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
        type="text/css" />
    <link href="~/js/jQuery/spliter/style.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Report/Gaming/NumberGameMonthlyWinLossReport/Styles/NumberGameMonthlyWinLossReport.css?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" rel="stylesheet" type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript">    
    </script>
    <script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?version=2" type="text/javascript"></script>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script src="~/js/Utils/jquery.stringformat.js" type="text/javascript"></script>
    <script src="~/js/Utils/FormatLibs/NumberFormat/numeral.js" type="text/javascript"></script>
    <script src="~/js/Utils/FormatLibs/DateTimeFormat/moment.js" type="text/javascript"></script>
    <script src="~/Views/Report/Gaming/NumberGameMonthlyWinLossReport/Scripts/ReportManager.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
</head>
<body>
    <div id="matchWinLoss2aReportDiv" style="">
        <div class="main" style="">
            <table style="width: 100%" border="0" cellpadding="0px" cellspacing="0px">
                <tr>
                    <td>
                        <div id="divMainHeader" class="">
                            <div id="left_tab1">
                                <ul>
                                    <li class="lefticon"></li>
                                    <li class="current"><span>@Labels.Number_Game_Monthly_Win_Loss_Report</span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="maincontent" style="">
                            <div class="filterBox">
                                <div class="filterContent">
                                    <table class="table">
                                        <tr>
                                            <td>
                                                @Labels.From
                                            </td>
                                            <td class="colFromDate">
                                                <input id="txtFromDate" class="txtdate" readonly="readonly" />
                                            </td>
                                            <td>
                                                @Labels.To
                                            </td>
                                            <td class="colTodate">
                                                <input id="txtTodate" class="txtdate" readonly="readonly" />
                                            </td>
                                            <td>
                                                <input id="btnReport" name="btnReport" type="button" value="@Labels.Report" class="btn btnReport" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="10">
                                                <div id="reportNote" class="warning l">
                                                    <ul>
                                                        <li>* Data is only available up to yesterday (after 5AM GMT-4)</li>
                                                        <li>* For data accuracy, generate the billing report 5 days after month-end</li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div>
                                    <div id="ErrorMessage" class="hidden">
                                    </div>
                                </div>
                            </div>
                            <div id="contentBox">
                                <div id="numberGameMonthlyWinLossReport" class="freegrid hidden">
                                    <div class="grid-title">
                                        <div id="numberGameMonthlyWinLossReport_Title" class="grid-title-lable">
                                            @Labels.Number_Game_Monthly_Win_Loss_Report</div>
                                        <div class="grid-toolbox">
                                            <input id="numberGameMonthlyWinLossReport_ExportExcel" class="btnExcel" type="button"
                                                title="Export to Excel" value=" " />
                                        </div>
                                    </div>
                                    <div class="free-cell free-top-left">
                                        <table class="grid-fixed-table free-cell-top-left">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <div class="col100 c table-cell">
                                                            @Labels.Month</div>
                                                    </th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="row_header_wrapper">
                                        <div class="row_header row-headers-background">
                                            <table id="numberGameMonthlyWinLossReport_RowHeader" class="grid-fixed-table row_header_content">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Month</div>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col_header row-headers-background">
                                        <div class="header-container">
                                            <table class="grid-fixed-table col_header_content">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Month</div>
                                                        </th>
                                                        <th>
                                                            <div class="col120 c table-cell">
                                                                @Labels.Member_Win_Loss</div>
                                                        </th>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Position</div>
                                                        </th>
                                                        <th>
                                                            <div class="col80 c table-cell">
                                                                @Labels.Commission</div>
                                                        </th>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Line_Total</div>
                                                        </th>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Turnover</div>
                                                        </th>
                                                        <th>
                                                            <div class="col80 c table-cell">
                                                                @Labels.Margin</div>
                                                        </th>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="grid-container container">
                                        <div class="content-container">
                                            <table id="numberGameMonthlyWinLossReport_Content" class="grid-fixed-table col_body_content">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Month</div>
                                                        </th>
                                                        <th>
                                                            <div class="col120 c table-cell">
                                                                @Labels.Member_Win_Loss</div>
                                                        </th>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Position</div>
                                                        </th>
                                                        <th>
                                                            <div class="col80 c table-cell">
                                                                @Labels.Commission</div>
                                                        </th>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Line_Total</div>
                                                        </th>
                                                        <th>
                                                            <div class="col100 c table-cell">
                                                                @Labels.Turnover</div>
                                                        </th>
                                                        <th>
                                                            <div class="col80 c table-cell">
                                                                @Labels.Margin</div>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="row_footer row-footer-background z999">
                                        <table class="grid-fixed-table row_footer_content">
                                            <thead>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="col_footer row-footer-background scroll-y">
                                        <div class="footer-container">
                                            <table class="col_footer_content grid-fixed-table">
                                                <thead>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <iframe id="frm" width="0" height="0" frameborder="0" class="hidden"></iframe>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    @{    
        var fromdate = new DateTime(DateTime.Today.Year, DateTime.Today.Month - 1, 1);
        var toDate = fromdate.AddMonths(1).AddDays(-1);        
    }
    <script language="javascript" type="text/javascript">
        var fromDate = '@fromdate.ToShortDateString()';
        var toDate = '@toDate.ToShortDateString()';
        var today = '@DateTime.Now.ToShortDateString()';
        var minDate = '@(new DateTime(2012, 1, 1).ToShortDateString())';
        window.rootUrl = '@Url.Content("~")';   
    </script>
</body>
</html>
