    </div>
</div>
<iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
 @{  
        if (Request["ExportType"] != null)
        {
            string exportType = Request["ExportType"];
            string reportName = string.Empty;
            switch (exportType)
            {
                case "MainReport":
                    var fromDate = DNAide.Core.CastAide.AsDateTime(Request["FromDate"]);
                    var toDate = DNAide.Core.CastAide.AsDateTime(Request["ToDate"]);
                    var isViewWH = DNAide.Core.CastAide.AsBoolean(Request["isViewWH"]);
                    new Fanex.Tarus.Reports.Controllers.Gaming.PokerWinlossController().PokerWinlossExportExcel(fromDate, toDate, isViewWH);
                    break;
                case "CurrencyByDate":
                    var reportDate = DNAide.Core.CastAide.AsDateTime(Request["ReportDate"]);
                    var currency = DNAide.Core.CastAide.AsInt32(Request["Currency"]);
                    var isViewWHDetail = DNAide.Core.CastAide.AsBoolean(Request["isViewWH"]);
                    new Fanex.Tarus.Reports.Controllers.Gaming.PokerWinlossController().PokerWinlossDetailExportExcel(reportDate, currency, isViewWHDetail);
                    break;
            }
        }
    }
<script language="javascript" type="text/javascript">
    var balanceupDay = '@Fanex.Tarus.Reports.DataAccess.Gaming.PokerWinloss.PokerWinlossAccess.BalanceUpDay()'
    var currDay = '@DNAide.Core.CastAide.AsDateTime(DateTime.Now.ToShortDateString())';
    var fromdate_opts = { minDate: balanceupDay, maxDate: currDay };
    var beforeyesterday = '@DNAide.Core.CastAide.AsDateTime(DateTime.Now.AddDays(-2).ToShortDateString())';
    var yesterday = '@DNAide.Core.CastAide.AsDateTime(DateTime.Now.AddDays(-1).ToShortDateString())';
    Helper.renderCalendarFromTo("#txtfromdate, #txttodate", fromdate_opts);
    
</script>