@model Fanex.Tarus.Reports.Entities.Gaming.NumberGame.NumberGameMonthlyWinLoss
@if (Model != null && Model.WinLossByDate != null && Model.WinLossByDate.Count > 0)
{   @functions{
        public string negativeNumberColor(string number)
        {
            if (DNAide.Core.CastAide.AsDouble(number) < 0)
            {
                return "red";
            }
            return string.Empty;
        }        
    }
    <div id="mainreportgrid" class="freegrid">   
        <div class="grid-title">
            <div class="grid-title-lable" id="reporttile">&nbsp;</div>
            <div class="grid-toolbox">                                
                <input type="button" id="btnExport" value=" " class="btnExcel" title="Export to Excel" />
            </div>
        </div>                         
        <div class="free-cell free-top-left">
            <table class="grid-fixed-table free-cell-top-left">
                <thead>
                    <tr>
                        <th>
                            <div class="table-cell" style="width: 140px; height: 39px">Date</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 80px; height: 39px">No. Players</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 80px; height: 39px">No. Games</div>
                        </th>
                        <th>
                            <div class="table-cell" style="width: 120px; height: 39px">Total Bets</div>
                        </th>                                              
                    </tr>
                </thead>
            </table>
        </div>
        <div class="row_header_wrapper">
            <div class="row_header row-headers-background">
                <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell" style="width: 140px; height: 39px">Date</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">No. Players</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">No. Games</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Total Bets</div>
                            </th>                                               
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell" style="width: 140px; height: 39px">Date</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">No. Players</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">No. Games</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Total Bets</div>
                            </th> 
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Total Wins</div>
                            </th> 
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Game Income</div>
                            </th> 
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">Payout</div>
                            </th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="tblContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th>
                                <div class="table-cell" style="width: 140px; height: 39px">Date</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">No. Players</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">No. Games</div>
                            </th>
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Total Bets</div>
                            </th> 
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Total Wins</div>
                            </th> 
                            <th>
                                <div class="table-cell" style="width: 120px; height: 39px">Game Income</div>
                            </th> 
                            <th>
                                <div class="table-cell" style="width: 80px; height: 39px">Payout</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>                    
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row_footer row-footer-background z999">
            <table class="grid-fixed-table row_footer_content">
                <thead>
                    <tr>
                        <th><div class="l" style="width: 140px; height: 17px">Grand Total</div></th>
                        <th><div class="r" style="width: 80px; height: 17px">@Model.GrandTotal.NoPlayers</div></th>
                        <th><div class="r" style="width: 80px; height: 17px">@Model.GrandTotal.NoGames</div></th>
                        <th><div class="r" style="width: 120px; height: 17px">@Model.GrandTotal.TotalBets</div></th>                   
                    </tr>                    
                </thead>
            </table>
        </div>
        <div class="col_footer row-footer-background scroll-y">
            <div class="footer-container">
                <table class="col_footer_content grid-fixed-table">
                    <thead>
                        <tr>
                            <th><div class="l" style="width: 140px; height: 17px">&nbsp;</div></th>
                            <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                            <th><div class="r" style="width: 80px; height: 17px">&nbsp;</div></th>
                            <th><div class="r" style="width: 120px; height: 17px">&nbsp;</div></th>
                            <th><div class="r" style="width: 120px; height: 17px">@Model.GrandTotal.TotalWins</div></th>
                            <th><div class="r @negativeNumberColor(Model.GrandTotal.GameIncome)" style="width: 120px; height: 17px">@Model.GrandTotal.GameIncome</div></th>
                            <th><div class="r @negativeNumberColor(Model.GrandTotal.GameIncome)" style="width: 80px; height: 17px">@Model.GrandTotal.Payout%</div></th>                            
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    
    <script type="text/javascript">
        var wl = '@Json.Encode(Model)';
        wl = wl.replace(/&quot;/g, '"');
        var wlJson = jQuery.parseJSON(wl);
        var wlDetail = wlJson.WinLossByDate;

        $(function () {
            $('#mainreportgrid').initGrid(numbergameMonthlyWinloss.gridOpts);
            numbergameMonthlyWinloss.renderWinLossReport();

            $('#btnExport').on('click', function () {
                numbergameMonthlyWinloss.exportExcel();
            });
        });    
    </script>
}
else
{
    <script type="text/javascript">
        $('#mainreportgrid').addClass('hidden');
        $('#err').show();
        $('#err .alertboxerr div').html('There is no data.');
    </script>
}