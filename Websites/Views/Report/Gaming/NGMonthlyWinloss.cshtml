<script src="~/Views/Report/Gaming/js/NGMonthlyWinLoss.js" type="text/javascript"></script>
<div class="main">
    <div class="maincontent">
        <table cellspacing="0px" cellpadding="0px" border="0" class="maincontent_header">
            <tbody>
                <tr>
                    <td class="maincontent_headerL">
                    </td>
                    <td class="maincontent_headerC">
                        Number Game Monthly Winloss
                    </td>
                    <td class="maincontent_headerR">
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="maincontent_box" style="width: 631px;">
            <table>
                <tbody>
                     <tr>
                        <td style="padding-left: 4px">
                            From:
                        </td>
                        <td>
                            <input id="txtfromdate" class="txtdate" readonly="readonly" style="width: 80px;" />
                        </td>
                        <td style="padding-left: 4px">
                            To:
                        </td>
                        <td>
                            <input id="txttodate" class="txtdate" readonly="readonly" style="width: 80px;" />
                        </td>
                        <td>
                            <input type="button" id="btnReport" name="btnReport" value="REPORT" class="btn" onclick="report.SelNumGameWL()" />
                        </td>                        
                    </tr>
                </tbody>
            </table>
        </div>
        
            <div id="mainreport" class="freegrid hidden" style="margin-top: 2px">
                <div class="grid-title">
                    <div class="grid-title-lable" id="gridtitle">
                        Title</div>
                    <div class="grid-toolbox">
                        <input type="button" onclick="report.exportExcel()"
                            value="  " id="btnExportExcelTopPunterSummary" class="btnExcel" title="Export to Excel" />
                    </div>
                </div>
                <div class="free-cell free-top-left">
                    <table class="grid-fixed-table free-cell-top-left">
                    </table>
                </div>
                <div class="row_header_wrapper">
                    <div class="row_header row-headers-background">
                        <table id="grid_1st_Column" class="grid-fixed-table row_header_content">
                        </table>
                    </div>
                </div>
                <div class="grid-container col_header row-headers-background scroll-y">
                    <div class="header-container">
                        <table class="grid-fixed-table col_header_content">
                        </table>
                    </div>
                </div>
                <div class="grid-container container">
                    <div class="content-container">
                        <table id="grid1" class="grid-fixed-table">
                            <thead>
                                <tr>
                                    <th>
                                        <div style="height: 30px; width: 150px;" class="table-cell">
                                            Bettype</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Winlost</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Position</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Commission</div>
                                    </th>
                                    <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Line Total</div>
                                    </th>
                                     <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Turnover</div>
                                    </th>
                                     <th>
                                        <div style="height: 30px; width: 120px;" class="table-cell">
                                            Margin</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row_footer row-footer-background z999">
                    <table class="grid-fixed-table row_footer_content">
                        <thead>
                        </thead>
                    </table>
                </div>
                <div class="col_footer row-footer-background scroll-y">
                    <div class="footer-container">
                        <table class="col_footer_content grid-fixed-table">
                            <thead>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        
    </div>
</div>

<div id="dvHidden"></div>
 <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
 @{
       if(Request["IsExport"] != null && Request["IsExport"] == "1")
       {
            string _fromdate = Request["fromdate"].ToString();
            string _todate = Request["todate"].ToString();
            new Fanex.Tarus.Reports.Controllers.Gaming.GamingController().ExportExcelNumberGameWL(_fromdate, _todate);
       }
       var fromdate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToShortDateString();
    }
<script type="text/javascript">
    var fromdate = '@fromdate';
    var todate = '@DateTime.Today.ToShortDateString()';    
</script>
