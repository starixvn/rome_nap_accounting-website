    <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
    @{
        if (DNAide.Core.CastAide.AsBoolean(Request["IsExport"]))
        {
            var normalLicensees = DNAide.Core.CastAide.AsString(Request["normallicensee"]);
            var operators = DNAide.Core.CastAide.AsString(Request["operators"]);
            var fromDate = DNAide.Core.CastAide.AsString(Request["fdate"]);
            var toDate = DNAide.Core.CastAide.AsString(Request["tdate"]);
            var sportList = DNAide.Core.CastAide.AsString(Request["sportlist"]);
            var reportTitle = DNAide.Core.CastAide.AsString(Request["reporttile"]);

            Fanex.Tarus.Reports.Business.Licensee.VirtualSportWinLoss.IVirtualSportWinlossByLicenseeService virtualSportService = new Fanex.Tarus.Reports.Business.Licensee.VirtualSportWinLoss.VirtualSportWinlossByLicenseeService();
            virtualSportService.ExportExcelVirtualSportsWinLossReport(normalLicensees, operators, fromDate, toDate, sportList, reportTitle);
        }
    }

    <script language="javascript" type="text/javascript">
        var _today = '@DateTime.Today.ToShortDateString()';
        var _yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        lastDay = '@DateTime.DaysInMonth(DateTime.Now.AddMonths(-1).Year,DateTime.Now.AddMonths(-1).Month)';
        lastMonth = '@DateTime.Now.AddMonths(-1).Month';
        lastYear = '@DateTime.Now.AddMonths(-1).Year';
        window.rootUrl = '@Url.Content("~")';   
    </script>
