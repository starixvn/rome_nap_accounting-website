@using Resources;
@using Sunplus.Accounting.Core.Configurations;
@{
    Page.Title = "Title goes here";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css?v=" + WebSettings.Version)" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.css?v=" + WebSettings.Version)" rel="stylesheet" />
    <link href="@Url.Content("~/Views/Customer/ViewPeriodCN88/Styles/Index.css?v=" + WebSettings.Version)" rel="stylesheet" />
}
@section Scripts{
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/numeral.js?v=" + WebSettings.Version)"></script>
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js?v=" + WebSettings.Version)"></script>
    <script src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.js?v=" + WebSettings.Version)"></script>
    <script src="@Url.Content("~/Views/Customer/ViewPeriodCN88/Scripts/Index.js?v=" + WebSettings.Version)"></script>
    <script>
        var resources = {
            ConfirmCheckViewAllPeriods: 'Are you sure you want to check "View all Periods" for Headline {0} ?',
            ConfirmUncheckViewAllPeriods:'Are you sure you want to uncheck "View all Periods" for Headline {0} ?'
        };
    </script>
}
    <div class="maincontent">
        <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
            <tr>
                <td class="maincontent_headerL"></td>
                <td class="maincontent_headerC">@Language.ViewPeriodsCN88</td>
                <td class="maincontent_headerR"></td>
            </tr>
        </table>
        <div id="sectionMessage" class="hide">
        </div>
        <div class="bg_table mT5">
            <table border="0" class="filter_table">
                <tr>
                    <td class="b">@Language.HeadlineUsername</td>
                    <td class="w120">
                        @Html.TextBox("headlineUsername", null, new { @class = "fullwidth" })
                    </td>
                    <td>
                        <button type="submit" class="btn" id="btnSearch">@Language.Submit</button>
                    </td>
                </tr>
            </table>
        </div>
        <div style="clear: both"></div>
        <div class="noteMsg hide">
            Check on "View all Periods": Allow Headline to view all Periods except current period and current period - 1 on Old Report.
            <br />
            Uncheck on "View all Periods":  Headline view only data last period - 1 and last period - 2 on Old Report.
        </div>
        <div style="clear: both"></div>
        <div id="gridContainer" class="grid-container hide">
            <div id="main-grid" class="freegrid"></div>
        </div>
    </div>