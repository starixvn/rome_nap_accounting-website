<div id="errMsg"></div>
<div id="errSupers"></div>
<div class="bg_table">
    <div>
        <div class="inputSuper">
            <label for="sourcesuper">
                Source Super<span style="color: red;">*</span>
            </label>
            <br />
            <input type="text" style="margin-top: 5px;" id="sourcesuper" maxlength="30" />
        </div>
        <div class="inputSuper">
            <label for="superlist">
                Copy setting to Supers<span style="color: red;">*</span> (Maximum 500 supers, separated by comma ',')
            </label>
            <br />
            <textarea type="text" style="margin-top: 5px;" id="superlist" rows="15" cols="100"></textarea>
        </div>
        <input type="button" id="btnCheckSupers" value="Select" class="btn inputSuper" onclick="CheckSuper()" />
    </div>
</div>
<div id="superSetting" class="setting-actions hidden">
    <div id="gridBettypeContainer" class="grid-container">
        <div id="settings" class="freegrid"></div>
    </div>
    <div class="setting-actions">
        <input type="button" value="Submit" class="btn" onclick="ApplySetting()" />
        <input type="button" value="Reset" class="btn" onclick="ResetSelect()" />
    </div>
</div>