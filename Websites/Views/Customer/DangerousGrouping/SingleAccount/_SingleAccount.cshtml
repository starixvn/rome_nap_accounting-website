@model IList<Fanex.Tarus.Customer.DangerousGrouping.Models.DangerDetail>
<div style="display:inline-block; width: 420px">
    <div class="bg_table">
        <form id="getUserDanger" class="formUsername" autocomplete="off">
            <div class="dangerSingleUsername">
                <div>
                    <label for="username" style="margin:auto;">Username (<span style="color: red;">*</span>):</label>
                    <input id="username" type="text" maxlength="255" required style="height: 20px; width: 200px;">
                </div>
                <div>
                    <input class="btn" style="margin: auto;" type="submit" onclick="" value="Submit" />
                    <span style="margin: auto 5px;" id="singleNoteMessageInfo" class="note-info-message" title=""></span>
                </div>
            </div>
            <table>
                <tr>
                    <td class="dangerdiv">
                        <label>Original: </label>
                        <div id="customerOriginDanger" class="customer-danger-cell dangerous-cell">
                        </div>
                    </td>
                    <td class="dangerdiv">
                        <label>ABI: </label>
                        <div id="customerABIDanger" class="customer-danger-cell dangerous-cell">
                        </div>
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td class="dangerdiv">
                        <label>Basketball: </label>
                        <div id="customerBasketballDanger" class="customer-danger-cell dangerous-cell">
                        </div>
                    </td>
                    <td class="dangerdiv">
                        <label>E-Sports: </label>
                        <div id="customerESportsDanger" class="customer-danger-cell dangerous-cell">
                        </div>
                    </td>
                    <td class="dangerdiv">
                        <label>Other Sports: </label>
                        <div id="customerOtherDanger" class="customer-danger-cell dangerous-cell">
                        </div>
                    </td>
                </tr>
            </table>
        </form>
    </div>
    <div class="updateContent bg_table">
        <form>
            <div style="margin:10px;display: flex;align-items: center;">
                <label for="singleDangerousType">Dangerous Type: </label>
                <select id="singleDangerousType" class="dangerSelect">
                    <option selected disabled hidden>Choose type to update dangerous</option>
                    <option value="Origin">Original</option>
                    <option value="ABI">ABI</option>
                    <option value="Basketball">Basketball</option>
                    <option value="ESports">E-Sports</option>
                    <option value="OtherSports">Other Sports</option>
                </select>
                <div id="selectedSingleLevelContent" style="margin-left: 30px; display:none; align-items:center;">
                    <label>Selected DangerLevel: </label>
                    <div id="selectedSingleDangerLevel" class="dangerous-cell" style="color: white; background-color: red; margin-left: 5px; display: grid;">
                        <p style="margin: auto;">None</p>
                    </div>
                </div>
            </div>
        </form>
        <div id="singleLevelSelectContent" class="hide">
            <p id="single-api-note" class="danger-api-note hidden">*Note: System will automatically update to Basketball - Danger 15/ Basketball - Danger 49 if you choose ABI - Danger 11/ ABI Danger 16 for accounts.</p>
            <div id="div-hasdownline" class="hide downline-content">
                <input type="checkbox" id="isSingleApplyAllDownlines" />
                <label for="isSingleApplyAllDownlines" style="margin: auto;">Apply for all downlines</label>
            </div>
            @Html.Partial("~/Views/Customer/DangerousGrouping/_DangerousList.cshtml", Model)
            <table cellpadding="0" cellspacing="0" border="0" style="margin-left: 10px; margin-bottom: 10px;">
                <tbody>
                    <tr>
                        <td id="btn1UpdateSingle" class="custBtn1" disabled="disabled"></td>
                        <td id="btnUpdateSingle" class="custBtn2 hand" disabled="disabled" onclick="UpdateSingleAccountDanger()">Update</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>