@using Fanex.Tarus.Customer.Resources
@using Fanex.Tarus.Customer.ViewModels.LicenseeDcsSetting;
@{
    Layout = null;
    var version = Sunplus.Accounting.Core.Configurations.WebSettings.Version;
}
@model FilterViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/common.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/input.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/Message.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/table.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/js/select2/select2.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/js/MultipleSelect/jquery.multiselect.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Styles/LicenseeDcsSetting.css?v=" + version)">
</head>
<body>
    <div class="maincontent">
        <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
            <tr>
                <td class="maincontent_headerL"></td>
                <td class="maincontent_headerC">@LicenseeDcsSettingLabels.LicenseeDCSSetting_PageTitle</td>
                <td class="maincontent_headerR"></td>
            </tr>
        </table>
        <div id="sectionMessage" class="hide"></div>
        <div class="bg_table mT5">
            <table border="0" class="filter_table">
                <tr>
                    <td class="b">@LicenseeDcsSettingLabels.Site</td>
                    <td class="w120">
                        @Html.DropDownList("siteDropDown", Model.Sites, new { @class = "fullwidth" })
                    </td>
                    <td class="b">@LicenseeDcsSettingLabels.SuperUserName</td>
                    <td class="w160">
                        @Html.DropDownList("superDropDown", Model.Supers, new { @class = "fullwidth" })
                    </td>
                    <td class="b">@LicenseeDcsSettingLabels.SelectAgentList</td>
                    <td class="w100">
                        <div id="agentDropDown" class="multiselect" multiple="multiple"></div>
                    </td>
                    <td><label><input type="checkbox" id="agentOnlyCheckbox" />@LicenseeDcsSettingLabels.AgentOnly</label></td>
                </tr>
                <tr>
                    <td class="b">@LicenseeDcsSettingLabels.SelectProduct</td>
                    <td class="w120">
                        @Html.DropDownList("productDropDown", Model.Products, new { @class = "fullwidth" })
                    </td>
                    <td class="b">@LicenseeDcsSettingLabels.SelectFunction</td>
                    <td class="w160">
                        @Html.DropDownList("functionDropDown", Model.Functions, new { @class = "fullwidth" })
                    </td>
                </tr>
                <tr>
                    <td>&nbsp;</td>
                    <td>
                        <button type="button" class="btn" id="selectButton">&nbsp;&nbsp;&nbsp;@LicenseeDcsSettingLabels.Select&nbsp;&nbsp;&nbsp;</button>
                    </td>
                </tr>
            </table>
        </div>
        <div class="bg_table mT10" id="boxContent"></div>
    </div>
    <script type="text/javascript">
        var rootUrl = "@Url.Content("~")";
        var productJSON = @Html.Raw(Model.ProductJSON);
        var agentJSON = @Html.Raw(Model.AgentJSON);
    </script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/select2/select2.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/MultipleSelect/jquery.multiselect.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/Common.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/PT.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/BetSetting.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/Status.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/GlobalStakeLevel.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/StakeLevel.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/StakeLevelGroup.js?v=" + version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/LicenseeDcsSetting/Scripts/LicenseeDcsSetting.js?v=" + version)"></script>
</body>
</html>
