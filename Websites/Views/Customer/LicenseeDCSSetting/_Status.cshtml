@using Fanex.Tarus.Customer.Resources
@using Fanex.Tarus.Customer.ViewModels.LicenseeDcsSetting;
@model StatusViewModel
@{
    Layout = null;
    var status = Model.Status;
}
<table class="tblcollapse status_table">
    <tbody>
        <tr class="title">
            <td colspan="2">@LicenseeDcsSettingLabels.ProductStatus <span>(@Model.ShowSuperOrAgentNames())</span></td>
        </tr>
        <tr>
            <td class="halfwidth">@Model.ProductName</td>
            <td>
                <div class="">
                    <div class="checkbox_div w80">
                        <input type="checkbox"
                               id="disabledCheckbox"
                               @(!status.IsDisabled ? "checked=checked" : string.Empty)
                               @(status.IsDisabledUpline ? "disabled=disabled" : string.Empty) />
                        <label for="disabledCheckbox">@LicenseeDcsSettingLabels.Enable</label>
                    </div>
                    @if (status.HasDownline)
                    {
                        <div class="checkbox_div w120">
                            <input type="checkbox"
                                   id="disabledDownlineCheckbox"
                                   @(!status.IsDisabledDownline ? "checked=checked" : string.Empty)
                                   @(status.IsDisabledUpline || !status.IsDisabled && !status.IsDisabledDownline || status.IsDisabled && status.IsDisabledDownline ? "disabled=disabled" : string.Empty) />
                            <label for="disabledDownlineCheckbox">@LicenseeDcsSettingLabels.EnableDownline</label>
                        </div>
                    }
                </div>
            </td>
        </tr>
    </tbody>
</table>
<input type="hidden" id="hiddenSportType" value="@status.SportType" />
<input type="hidden" id="hiddenBetType" value="@status.BetType" />
<input type="hidden" id="hiddenBitmapOrder" value="@status.BitmapOrder" />
<button type="button" class="update-setting-button mT5" id="btnUpdateStatus" disabled="disabled">@LicenseeDcsSettingLabels.Update</button>