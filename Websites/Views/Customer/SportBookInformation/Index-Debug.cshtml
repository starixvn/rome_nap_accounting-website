}
<html xmlns="http://www.w3.org/1999/xhtml" style="height: 100%">
<head>
    <link href="~/App_Themes/LeftPanel/left_panel.css" rel="stylesheet" type="text/css"/>
    <link rel="stylesheet" href="http://localhost:4201/src/styles.scss"/>
    <script src="~/Views/Customer/SportBookInformation/Scripts/TabsNavigator.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>


    @* <script type="module"> *@
    @*     import RefreshRuntime from "http://localhost:4200/@@react-refresh"; *@
    @*     RefreshRuntime.injectIntoGlobalHook(window); *@
    @*     window.$RefreshReg$ = () => { }; *@
