<body style="height: 100%">

<div class="maincontent" style="height: 100%">
    <div id="divMainHeader" style="background-color:#fff; position:fixed; width:100%; margin-top:-5px; padding-top:10px;">
        <div class="box_header" style="width: 100%;">
            <div id="left_tab1" class="left_tab" style="width: 100%">
                <ul>
                    <li id="left_tab1_1" class="current">
                        <a href="javascript:;">
                            <span>Bet Setting</span>
                        </a>
                    </li>
                    <li id="left_tab1_2" style="position: relative">
                        <a href="javascript:;">
                            <span>Max payout setting</span>
                        </a>
                    </li>
                    <li id="left_tab1_3" style="position: relative">
                        <a href="javascript:;">
                            <span>PT setting</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div id="left_tab1_1_content" style="margin-top:35px; height: 100%">
        @Html.Raw(Model.TabBetSettingContent)
        @Html.Raw(Resources.Language.MemberUnlimitedBetSettingWarningMessage)
    </div>
    <div id="left_tab1_2_content" style="display: none;margin-top:35px; height: 100%">
        <iframe src="@Url.Action("Index", "ViewMaxPayoutSettingInformation" )" id="frm" width="100%" height="100%" frameborder="0"></iframe>

    </div>
    <div id="left_tab1_3_content" style="display: none;margin-top:35px; height: 100%">
        <iframe src="@Url.Action("GetBettypesReference", "ViewPT", new { custId = 0 })" id="frm" width="100%" height="100%" frameborder="0"></iframe>
    </div>
