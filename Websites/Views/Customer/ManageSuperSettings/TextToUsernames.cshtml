@{
    var noteText = "Support to remove delimiters: Hyphen (-), Comma (,), and Semicolon (;)\nMaximum length is 200 characters.";
}
<div id="tab-ttu-errMsg"></div>
<div class="bg_table">
    <div>
        <div class="inputSuper">
            <label for="tab-ttu-text">
                Text<span style="color: red;">*</span>
            </label>
            <input type="text" style="margin-top: 5px;" id="tab-ttu-text" maxlength="200" value="" />
            <input type="button" id="tab-ttu-btnSubmit" value="Get Usernames" class="btn" />
        </div>
        <div class="bold">@noteText</div>
    </div>
</div>
<div id="tab-ttu-usernames" class="hidden">
    <table class="tbl-valid-usernames">
        <thead>
            <tr>
                <th>Valid Usernames</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="row-usernames"></td>
                <td style="text-align: center;">
                    <span class="icon-copy" id="copy-valids" title="Copy" data-placement="right"></span>
                    <span id="copy-tipsy" title="Copied" original-title="Copied"></span>
                </td>
            </tr>
        </tbody>
    </table>
    <table class="tbl-invalid-usernames">
        <thead>
            <tr>
                <th>Invalid Usernames</th>
                <th>Reason</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
