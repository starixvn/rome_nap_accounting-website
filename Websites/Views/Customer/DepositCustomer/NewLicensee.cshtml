@helper GetSites()
    {
        var depositCustomerService = new Fanex.Tarus.Business.Implement.Customer.DepositCustomerService();
        var listLicensee = depositCustomerService.SelAllLicensee();

        var isFirst = true;
        foreach (var licensee in listLicensee)
        {
            if (isFirst)
            {
    @:<option selected="selected" value="@licensee.Id">@licensee.Name</option>";
            isFirst = false;
            }
            else
            {
    @:<option value="@licensee.Id">@licensee.Name</option>";
        }
        }
}
@helper GetCurrency()
    {     
        var newLicenseeController = new NewLicenseeController();
        var currencyList = newLicenseeController.GetCurrenciesBySystem();
        if (currencyList == null)
        {
            return;
        }

        var isFirst = true;
        foreach (var currency in currencyList)
        {
            var currencyOptionText = string.Empty;
            if (!string.IsNullOrEmpty(currency.Code))
            {
                currencyOptionText += currency.Value + " (" + currency.Code + ")";
            }
            else
            {
                currencyOptionText = currency.Value;
            }

            if (isFirst)
            {
    @:<option selected="selected" value="@currency.Id" data-currencyname="@currency.Value">@currencyOptionText</option>";
                isFirst = false;
            }
            else
            {
    @:<option value="@currency.Id" data-currencyname="@currency.Value">@currencyOptionText</option>";
        }
        }
}
@helper GenerateBetSettingSportsbook()
    {
        var sports = Sunplus.Accounting.Core.Configurations.SportsSection.Instance.Sports;
        foreach (Sunplus.Accounting.Core.Configurations.SportsElement sport in sports)
        {
            if (!sport.Active || sport.Id == "161")
            {
                continue;
            }

            var flat = "";
            flat = sport.Id == "1" ? "soccer='true'" : "remainsport='true'";

            var minBetv = "minbetv" + @sport.Id.ToLower();
            var maxBetv = "maxbetv" + @sport.Id.ToLower();
            var maxPerMatchv = "maxpermatchv" + @sport.Id.ToLower();
        
        
    <tr>
        <td align="left" style="padding-left: 4px">
            <span>@sport.Name</span>
        </td>
        <td>
            <input id="@minBetv" minbet="true" type="text" @flat style="width: 128px; text-align: right" value="@sport.Minbet" />
        </td>
        <td>
            <input id="@maxBetv" maxbet="true" type="text" @flat style="width: 128px; text-align: right" value="@sport.Maxbet" />
        </td>
        <td>
            <input id="@maxPerMatchv" maxpermatch="true" type="text" @flat style="width: 128px; text-align: right" value="@sport.Maxpermatch" />
        </td>
    </tr>
        }
}
@{
    var sports = Sunplus.Accounting.Core.Configurations.SportsSection.Instance.Sports;
}
<script type="text/javascript">
    var arrNumberGameBettypes = [];
    @{
        foreach (Sunplus.Accounting.Core.Configurations.SportsElement sport in sports)
        {
            if (sport.Id.Trim() == "161")
            {
                if (sport.Bettype != null && sport.Bettype != "NA" && sport.Bettype != string.Empty)
                {
                    if (!string.IsNullOrWhiteSpace(sport.Bettype.Trim()))
                    {
                        var bettypes = sport.Bettype.Split(new char[] { ',' });
                        foreach (var bettype in bettypes)
                        {
                           @:window.arrNumberGameBettypes.push(@bettype);
                        }
                    }
                }
                break;
            }
        }
    }
</script>
<script type="text/javascript">
    var sports = [];
    (function () {
    @{
        @:var sport;
        foreach (Sunplus.Accounting.Core.Configurations.SportsElement sport in sports)
        {
            if (!sport.Active || sport.Id == "161")
            {
                continue;
            }
            @:sport = {Id: '@sport.Id.ToLower()', Bettype: []};
            if (sport.Bettype != null && sport.Bettype != "NA" && sport.Bettype != string.Empty)
            {
                if (!string.IsNullOrWhiteSpace(sport.Bettype.Trim()))
                {
                    var bettypes = sport.Bettype.Split(new char[] { ',' });
                    foreach (var bettype in bettypes)
                    {
                       @:sport.Bettype.push(@bettype);
                    }
                }
            }
            @:window.sports.push(sport);
        }
    }
    })();
</script>
