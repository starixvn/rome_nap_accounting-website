@using Sunplus.Accounting.Core.Configurations;
@using Fanex.Tarus.Infrastructure.Constants;
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/Views/Customer/DepositCustomer/EditLicensee/Styles/EditLicenseeStyles.css" />
<script type="text/javascript" src="~/js/common.js"></script>
<script type="text/javascript" src="~/js/jQuery/jquery-latest.js"></script>
<script type="text/javascript" src="~/js/jQuery/Number/jquery.caret.1.02.js"></script>
<script type="text/javascript" src="~/js/jQuery/jquery.json-1.3.js"></script>
<script type="text/javascript" src="~/js/json2.js"></script>
<script type="text/javascript" src="~/js/jQuery/Number/jquery.formattyping.js"></script>
<script type="text/javascript" src="~/js/jQuery/Number/jquery.setcaretposition.js"></script>
<script type="text/javascript">
    var viewResources = {
        ThereIsNoData: "There is no data!"
    };

    var sportsbookSports = [];
   (function () { 
       @{
            @:var sport;
            var sports = SportsSection.Instance.Sports;
            foreach (SportsElement sportElement in sports)
            {
                if (!sportElement.Active ||
                    string.Equals(sportElement.Id, Sports.NumberGame.ToString()))
                {
                    continue;
                }

                @:sport = { Id: '@sportElement.Id.ToLower()', BetTypes: []};
                if (!string.IsNullOrWhiteSpace(sportElement.Bettype.Trim()) &&
                    sportElement.Bettype != "NA")
                {
                    var betTypes = sportElement.Bettype.Split(new char[] { ',' });
                    foreach (var betType in betTypes)
                    {
                        @:sport.BetTypes.push(@betType);
                    }
                }
                
                @:window.sportsbookSports.push(sport);
            }
        }
   })();  
   

   var numberGameBetTypes = [];
   (function () { 
    @{
        sports = SportsSection.Instance.Sports;
        foreach (SportsElement sportsElement in sports)
        {
            if (!string.Equals(sportsElement.Id.Trim(), Sports.NumberGame.ToString()) ||
                string.IsNullOrWhiteSpace(sportsElement.Bettype) ||
                sportsElement.Bettype == "NA")
            {
                continue;
            }

            var betTypes = sportsElement.Bettype.Split(new char[] { ',' });
            foreach (var betType in betTypes)
            {
                @:window.numberGameBetTypes.push(@betType);
            }
        }
    }

   })();
</script>
<script type="text/javascript" src="~/Views/Customer/DepositCustomer/EditLicensee/Scripts/PositionTakingRenderManager.js?version=@WebSettings.Version"></script>
<script type="text/javascript" src="~/Views/Customer/DepositCustomer/EditLicensee/Scripts/EditLicenseeManager.js"></script>
@helper GenerateSportsbook_NumberGameSettings()
    {
        var sports = SportsSection.Instance.Sports;
        foreach (SportsElement sport in sports)
        {
            if (!sport.Active ||
                string.Equals(sport.Id, Sports.NumberGame.ToString()))
            {
                continue;
            }

            var attributeIsSoccer = "";
            attributeIsSoccer = string.Equals(sport.Id, Sports.Soccer.ToString()) ?
                "soccer='true'" :
                "remainsport='true'";

            var minBetv = "minbetv" + @sport.Id.ToLower();
            var maxBetv = "maxbetv" + @sport.Id.ToLower();
            var maxPerMatchv = "maxpermatchv" + @sport.Id.ToLower();       
            
    <tr>
        <td class="column-sportname">
            <span>@sport.Name</span>
        </td>
        <td>
            <input id="@minBetv" minbet="true" type="text" @attributeIsSoccer class="setting-input" value="@sport.Minbet" />
        </td>
        <td>
            <input id="@maxBetv" maxbet="true" type="text" @attributeIsSoccer class="setting-input" value="@sport.Maxbet" />
        </td>
        <td>
            <input id="@maxPerMatchv" maxpermatch="true" type="text" @attributeIsSoccer class="setting-input" value="@sport.Maxpermatch" />
        </td>
    </tr>
        }
}

