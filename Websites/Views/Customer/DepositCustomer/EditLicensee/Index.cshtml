                                            </td>
                                            <td>
                                                <input id="maxbetv161" numbergame="true" maxbet="true" type="text" class="numbergame-setting-input"
                                                    value="0" />
                                            </td>
                                            <td>
                                                <input id="maxpermatchv161" numbergame="true" maxpermatch="true" type="text" class="numbergame-setting-input"
                                                    value="0" />
                                            </td>
                                            <td>
                                                <input id="maxperballv161" numbergame="true" maxperball="true" type="text" class="numbergame-setting-input"
                                                    value="0" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
