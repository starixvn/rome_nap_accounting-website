@using Sunplus.Accounting.Core.Configurations;
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<html>
<head>
    <link href="@Url.Content("~/Views/Customer/ManageSuperSettings/Styles/manage-super-settings.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <div id="divMainHeader" style="position: sticky;top: 0;padding-top: 10px; background: #fff;z-index: 100;margin-bottom: 11px;">
                <div class="box_header" style="width: 100%;">
                    <div class="left_tab" style="width: 100%">
                        <ul id="tabs" class="tabs">
                            <li class="current" id="tab_1"><a><span>Text to Super Usernames</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div id="tab_1_content" class="tab_content">
                <div id="tab-ttu-errMsg"></div>
                <div class="bg_table">
                    <div>
                        <div class="inputSuper">
                            <label for="tab-ttu-text">
                                Text<span style="color: red;">*</span>
                            </label>
                            <div class="form-control-short">
                                <div class="form-inline form-inline-clear">
                                    <input type="text" id="tab-ttu-text" maxlength="200" value="" />
                                    <span class="icon-close" title="clear text"></span>
                                </div>
                                <input type="button" id="tab-ttu-btnSubmit" value="Get Usernames" class="btn-submit" />
                            </div>
                        </div>
                        <label class="small-label">@Html.Raw(Resources.Language.TextToUsernames_Note)</label>
                    </div>
                    <span class="icon-collapse-expand icon-down" title="toggle"></span>
                </div>
            </div>
            <div id="tab-ttu-usernames" class="hidden">
                <table class="tb tbl-valid-usernames">
                    <thead>
                        <tr>
                            <th>Valid Usernames</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="row-usernames"></td>
                            <td style="text-align: center;">
                                <span class="icon-copy" id="copy-valids" title="Copy" data-placement="right"></span>
                                <span id="copy-tipsy" title="Copied" original-title="Copied"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table class="tb tbl-invalid-usernames">
                    <thead>
                        <tr>
                            <th>Invalid Usernames</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-ui-1.9.1.min.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/common.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/ToolTip/Tipsy-Tooltip/jquery.tipsy.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/TextToUsernames/Scripts/Index.js?v=95" + WebSettings.Version)"></script>
</body>
</html>
