@using Fanex.ProductStatus.Setting.Models
@using Fanex.Tarus.Customer.Resources
@using Fanex.Tarus.Customer.ViewModels.ProductStatus
@{
    Layout = null;
    var version = Sunplus.Accounting.Core.Configurations.WebSettings.Version;
    var isMultipleBetTypes = Model.ProductStatuses.Count() > 1;
}
@model ProductStatusViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="@Url.Content("~/App_Themes/Public/Message.css?v=" + version)" />
    <link rel="stylesheet" href="@Url.Content("~/Views/Customer/ProductStatusSetting/Styles/productstatussetting.css?v=" + version)" />
</head>
<body>
    <div id="sectionMessage" class="hide"></div>
    <table class="tbl-product margin-top10" id="tbl-product">
        <thead>
            <tr>
                <th class="title" colspan="@Model.TotalColumns">@(Model.GetRoleNameById(Model.CustRoleId) + ": " + Model.CustName)</th>
            </tr>
            <tr>
                <th rowspan="2"></th>
                <th rowspan="2">
                    @if (isMultipleBetTypes)
                    {
                        <div class="current-role">@Model.GetRoleNameById(Model.CustRoleId)</div>
                        <div class="all-status">
                            <span class="enabled" data-roleid="@Model.CustRoleId">@Common.Enable</span>
                            <span class="disabled" data-roleid="@Model.CustRoleId">@Common.Disable</span>
                        </div>
                    }
                    else
                    {
                        @Model.GetRoleNameById(Model.CustRoleId)
                    }
                </th>
                @{ var roleId = Model.CustRoleId; }
                @while (--roleId > 0)
                {
                    <th colspan="2">
                        @Model.GetRoleNameById(roleId)
                    </th>
                }
            </tr>
            <tr>
                @if (!Model.IsMember(Model.CustRoleId))
                {
                    roleId = Model.CustRoleId;
                    while (--roleId > 0)
                    {
                        if (isMultipleBetTypes)
                        {
                            <th>
                                <span class="enabled" data-roleid="@roleId">@Common.Enable</span>
                            </th>
                            <th>
                                <span class="disabled" data-roleid="@roleId">@Common.Disable</span>
                            </th>
                        }
                        else
                        {
                            <th>@Common.Enable</th>
                            <th>@Common.Disable</th>
                        }
                    }
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ProductStatuses)
            {
                <tr>
                    <td class="bettype-name">@item.BetTypeName</td>
                    <td>@renderStatus(item.SportType, item.BetType, item.IsDisabled, item.IsDisabledUpline, Model.CustRoleId)</td>
                    @{
                        roleId = Model.CustRoleId;
                        int totalEnabled, totalDisabled;
                    }
                    @while (--roleId > 0)
                    {
                        if (Model.IsMaster(roleId))
                        {
                            totalEnabled = item.TotalEnabledMasters;
                            totalDisabled = item.TotalDisabledMasters;
                        }
                        else if (Model.IsAgent(roleId))
                        {
                            totalEnabled = item.TotalEnabledAgents;
                            totalDisabled = item.TotalDisabledAgents;
                        }
                        else if (Model.IsMember(roleId))
                        {
                            totalEnabled = item.TotalEnabledMembers;
                            totalDisabled = item.TotalDisabledMembers;
                        }
                        else
                        {
                            totalEnabled = 0;
                            totalDisabled = 0;
                        }
                        <td>
                            @renderEnabledStatus(item.SportType, item.BetType, item.IsDisabled, roleId, totalEnabled)
                        </td>
                        <td>
                            @renderDisabledStatus(item.SportType, item.BetType, item.IsDisabled, roleId, totalDisabled)
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <div class="margin-top10 align-right">
        <button type="button" class="btn btn-reset" id="btnReset">@Common.Reset</button>
        <button type="button" class="margin-left5 btn" id="btnSubmit">@Common.Submit</button>
    </div>
    <script type="text/javascript">
        var rootUrl = "@Url.Content("~")";
        var appResources = {
            "enabled": "@Common.Enabled",
            "disabled": "@Common.Disabled"
        };
    </script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/ProductStatusSetting/Scripts/ProductStatusSetting.js?v=" + version)"></script>
</body>
</html>

@helper renderStatus(int sportType, int betType, bool isDisabled, bool isDisabledUpline, byte roleId) {
    var labelText = isDisabled ? Common.Disabled : Common.Enabled;
    var labelClass = isDisabledUpline ? "gray" : labelText.ToLowerInvariant();
    var id = string.Format("{0}_{1}_{2}", labelClass, roleId, betType);
    <input type="checkbox" class="checkbox-hide" id="@id"
           data-roleid="@roleId"
           data-sporttype="@sportType"
           data-bettype="@betType"
           @(isDisabledUpline ? "disabled=disabled" : string.Empty)
           @(isDisabled ? string.Empty : "checked=checked")/>
    <label for="@id" class="@labelClass">@labelText</label>
}

@helper renderEnabledStatus(int sportType, int betType, bool isDisabled, byte roleId, int totalEnabled) {
    var spanClass = "enabled" + (isDisabled ? " gray" : string.Empty);
    var id = string.Format("enabled_{0}_{1}", roleId, betType);
    @*<input type="radio" id="@id" name="@(roleId + "_" + betType)" />*@
    <span id="@id" class="@spanClass"
          data-roleid="@roleId"
          data-sporttype="@sportType"
          data-bettype="@betType">@totalEnabled.ToString("N0")</span>
}

@helper renderDisabledStatus(int sportType, int betType, bool isDisabled, byte roleId, int totalDisabled) {
var spanClass = "disabled" + (isDisabled ? " gray" : string.Empty);
var id = string.Format("disabled_{0}_{1}", roleId, betType);
    @*<input type="radio" id="@id" name="@(roleId + "_" + betType)" />*@
    <span id="@id" class="@spanClass"
          data-roleid="@roleId"
          data-sporttype="@sportType"
          data-bettype="@betType">@totalDisabled.ToString("N0")</span>
}