@model Fanex.Tarus.Customer.ViewModels.Customer.CreateCustomerViewModel
@{
    var version = Sunplus.Accounting.Core.Configurations.WebSettings.Version;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Create Super</title>
    <base href="/" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="@(Model.CdnUri)create-customer/index.css?version=@(Model.AssetsVersion)" />
</head>
<body>
    @Html.AntiForgeryToken()
    <input type="hidden" name="SecretKey" id="SecretKey" value="@Model.SecretKey" />
    <div id="root"></div>
    <script>
        const appConfig = @Html.Raw(Model.AppConfig);
        const params = @Html.Raw(Model.Params);
        window.getRedirectUrl = (response) => {
            const custId = response.custId;
            return appConfig.applicationPath + "Customer/V2/UpdatePT.aspx?custid=" + custId + "&insert=" + "true" + "&roleid=" + (params.uplineRoleId - 1) + "&uplineid=" + params.uplineRoleId;
        };
    </script>
    <script type="text/javascript" src="@Url.Content("~/js/encode.js?v=" + version)"></script>
    <script type="module" src="@(Model.CdnUri)create-customer/index.js?version=@(Model.AssetsVersion)"></script>
</body>
</html>