<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
<link href="~/App_Themes/LeftPanel/left_panel.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet"
    type="text/css" />
<link href="~/js/jQuery/monthPicker/monPickr-0.0.1.css" rel="stylesheet" type="text/css"/>
<link href="~/js/jQuery/GridScroller/gridscroller.css?ver=2" rel="stylesheet" type="text/css" />
<link href="~/Views/Customer/CustomerSetting/SMATurnover/Style/SMATurnover.css" rel="stylesheet" type="text/css" />

<script src="~/js/jQuery/jquery-1.7.js" type="text/javascript"></script>
<script src="~/js/jQuery/json2.js" type="text/javascript"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
<script src="~/js/BlockUI.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
<script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript"></script>
<script src="~/js/jQuery/monthPicker/monPickr-0.0.1.js?ver=1" type="text/javascript"></script>
<script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=1" type="text/javascript"></script>

<style>
	body{
		line-height:auto !important;
	}
</style>
<div class="main">
    <div class="maincontent">
        <div style="border: 1px solid #7C98A4; width:800px; padding: 0px" class="maincontent_box">
            <div class="box_header" style="width: 100%; margin: 0px">
                <div id="SMATab" class="left_tab" style="width: 100%">
                    <ul>
                        <li id="ListSMATab" class="current"><a href="javascript:;"><span>SMA Turnover List</span></a></li>
                        <li id="AddSMATab" style="position: relative"><a href="javascript:;"><span style="padding-right: 22px">Add SMA Turnover</span></a></li>
                    </ul>
                </div>
            </div>
            <div style="padding-bottom: 10px; margin-left:10px">
                <div id="ListSMAContent" class="marginTurnover">
                    <div>
                        <div id="msgError" class="errMsg" style="display: none">
                        </div>
                        <table>
                            <tr>
                                <td style="width: 60px; text-align: right; padding-left:8px">
                                    <b>From Date</b>
                                </td>
                                <td>
                                    <input type="text" id="txtfromdate"  class="txtdate" style="width: 100px;"  />
                                </td>
                                <td style="width: 50px; text-align: right;  padding-left:20px">
                                    <b>To Date</b>
                                </td>
                                <td>
                                    <input type="text" id="txttodate" readonly="readonly" class="txtdate" style="width: 100px;" onkeyup="SMATurnover.ChangeSport()" />
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left:8px; text-align:right">
                                    <div>
                                        <b>Sport</b></div>
                                </td>
                                <td>
                                    <select id="ddlSport" style="width: 105px" onchange="SMATurnover.ChangeSport()" >
                                    </select>
                                </td>
                                <td>
                                    <div style="padding-left: 20px;  text-align:right">
                                        <b>League</b></div>
                                </td>
                                <td>
                                    <select id="ddlLeague" style="width: 300px">
                                    </select>
                                </td>
                                <td style="padding-left:8px">
                                    <input type="button" id="btnSubmit" value="Submit" class="btn" onclick="SMATurnover.GetSMATurnoverList()" />
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="contentBox">
                        <div id="SMATurnover" class="freegrid hidden">
                            <div class="col_header row-headers-background scroll-y">
                                <div class="header-container">
                                    <table class="grid-fixed-table col_header_content">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <div class="table-cell" style="width: 200px; height: 34px">
                                                       SMA Name
                                                    </div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 100px; height: 34px">
                                                        Currency</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 160px; height: 34px">
                                                        Member Turnover</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 160px; height: 34px">
                                                        Max Turnover</div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 60px; height: 34px">
                                                        Edit</div>
                                                </th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                            <div class="grid-container container">
                                <div class="content-container">
                                    <table id="tblSMATurnover" class="grid-fixed-table col_header_content">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <div class="table-cell" style="width: 200px; height: 34px">
                                                    </div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 100px; height: 34px">
                                                    </div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 160px; height: 34px">
                                                    </div>
                                                </th>
                                                <th>
                                                    <div class="table-cell " style="width: 160px; height: 34px">
                                                    </div>
                                                </th>
                                                <th>
                                                    <div class="table-cell" style="width: 60px; height: 34px">
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="AddSMAContent" class="marginTurnover" style="display:none">
                   <div id="msgErrorAdd" class="errMsg" style="display: none">
                   </div>
                    <table>
                        <tr>
                            <td class="firstCol">
                                <div>Match ID</div>
                            </td>
                            <td>
                                <div><input type="text" id="txtMatchId" style="width:200px"  onkeyup="Helper.onKeyEnter(event)"; onkeypress="" />
                                <input type="button" id="btnGetInfo"  value="Get Info" class="btn" onclick="SMATurnover.GetInfoByMatch()"/></div>
                            </td> 
                        </tr>
                        <tr>
                           <td class="firstCol">
                                <div>League</div>
                           </td> 
                           <td>
                                <div><input type="text" id="txtLeague" readonly="readonly" style="width:265px;  background-color:#D9D9D9" /></div>
                           </td>
                        </tr>
                        <tr>
                           <td class="firstCol">
                                <div>Event Date</div>
                           </td> 
                           <td>
                                <div><input type="text" id="txtEventDate" readonly="readonly" style="width:265px;  background-color:#D9D9D9"/></div>
                           </td>
                        </tr>
                        <tr>
                           <td class="firstCol">
                                <div>Team</div>
                           </td> 
                           <td>
                                <div><input type="text" id="txtTeam" readonly="readonly" style="width:265px;  background-color:#D9D9D9" /></div>
                           </td>
                        </tr>
                        <tr>
                           <td class="firstCol">
                                <div>SMA Name</div>
                           </td> 
                           <td>
                                <div><input type="text" id="txtSuperName"  style="width:265px"/></div>
                           </td>
                        </tr>
                        <tr>
                           <td class="firstCol">
                                <div>Max Turnover</div>
                           </td> 
                           <td>
                                <div><input type="text" id="txtTurnover" style="width:265px" onkeyup="SMATurnover.InputMaxTurnover()" onkeypress="return CheckIntNumber(event)" maxlength="15" /></div>
                           </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div style="padding-left:78px"><input  type="button" id="btnAdd" value="Add" class="btn" style="width: 60px" onclick ="SMATurnover.AddSMATurnoverProccess()" /></div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Views/Customer/CustomerSetting/SMATurnover/Scripts/SMATurnover.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>  
<script src="~/Views/Customer/CustomerSetting/SMATurnover/Scripts/Helper.js?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>  
<script language="javascript" type="text/javascript">
    var currDay = '@DNAide.Core.CastAide.AsDateTime(DateTime.Now.ToShortDateString())';
    var balanceUpDay = '@Fanex.Tarus.Customer.DataAccess.SettingCustomer.SMATurnover.SMATurnoverAccess.BalanceUpDay()';
    $(document).ready(function () {
        SMATurnover.InitPage();
    });
</script>
