<div class="filter">
    <div id="msgErrorAdd" class="errMsg hidden">
    </div>
    <table class="selectMatchFilterBox" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th colspan="4" class="title showHideBox l" title="Hide Choose league box">
                    <div class="title-icon expand">
                        &nbsp;
                    </div>
                    <div class="title-label">
                        1.Choose League</div>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="row-selectMatchFilter">
                    <table class="selectMatchFilter">
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td>
                                <div class="b">
                                    From Date</div>
                            </td>
                            <td>
                                <input id="txtfromdate_AddSMAList" type="text" class="txtdate" />
                            </td>
                            <td class="box-padding-left">
                            </td>
                            <td>
                                <div class="b">
                                    To Date</div>
                            </td>
                            <td>
                                <input id="txttodate_AddSMAList" type="text" class="txtdate" />
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td>
                                <div class="b">
                                    Sport Game</div>
                            </td>
                            <td>
                                <select id="ddlSport_AddSMAList">
                                </select>
                            </td>
                            <td class="box-padding-left">
                            </td>
                            <td>
                                <div class="b">
                                    League</div>
                            </td>
                            <td>
                                <select id="ddlLeague_AddSMAList">
                                </select>
                            </td>
                            <td>
                                <input id="btnSearch_AddSMAList" class="btn" type="submit" value="Search" />
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
    <table class="selectMatchInfoBox hidden" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th colspan="4" class="title showHideBox l" title="Hide Choose match(es) and upload file box">
                    <div class="title-icon expand">
                        &nbsp;
                    </div>
                    <div class="title-label">
                        2.Choose Match(es) and upload file</div>
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <table class="matchInfoContainer">
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td>
                                <div>
                                    <table>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <input id="chbxCheckAllMatch_AddSMAList" type="checkbox" value="Check All Matches"
                                                        disabled="disabled" />
                                                    <label for="chbxCheckAllMatch_AddSMAList" class="lblCheckAllMatch_AddSMAList">
                                                        Select All
                                                    </label>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td>
                                <div class="matchInfo_TableContainer hidden">
                                    <table class="matchInfo_Table" cellpadding="0" cellspacing="0">
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <table class="uploadFileContainer" cellspacing="0" cellpadding="0">
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td class="b l">
                                File Size limit 1MB
                            </td>
                        </tr>
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td class="l">
                                @*<input id="fileUpload" type="file" />*@ @*<input id="btnUploadFile" class="btn" type="submit" value="Go" disabled="disabled" />*@
                                <form id="file_upload_form" method="post" enctype="multipart/form-data" action="../Views/Customer/CustomerSetting/SMATurnover/UploadSMAListHandler.ashx"
                                target="upload_iframe">
                                <input id="file_UploadFile" name="file_UploadFile" size="20" type="file" />
                                <input id="btnUploadFile" class="btn" type="btn" name="action" value="Go" disabled="disabled" />
                                <input id="AccId_UploadFile" name="AccId" type="hidden" />
                                <input id="SportId_UploadFile" name="SportId" type="hidden" />
                                <input id="LeagueId_UploadFile" name="LeagueId" type="hidden" />
                                <input id="FromDate_UploadFile" name="FromDate" type="hidden" />
                                <input id="ToDate_UploadFile" name="ToDate" type="hidden" />
                                <input id="SportName_UploadFile" name="SportName" type="hidden" />
                                <input id="LeagueName_UploadFile" name="LeagueName" type="hidden" />
                                <input id="MatchIds_UploadFile" name="MatchIds" type="hidden" />
                                <iframe id="upload_target" name="upload_iframe" src="" style="width: 0; height: 0;
                                    border: 0px solid #fff;"></iframe>
                                </form>
                            </td>
                        </tr>
                        <tr>
                            <td class="box-padding-left">
                            </td>
                            <td class="b l">
                                <a class="lnkDownloadTemplate_AddSMAList">Click here to download template</a>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="failedRecordsTableContainer hidden">
    <table class="failedRecordsTable tbllayout hidden">
        <thead>
            <tr>
                <th colspan="3" class="l b color-red error-title">
                    <div class="error-icon">
                    </div>
                    <div class="error-label">
                        Failed records, please check!</div>
                </th>
            </tr>
            <tr class="title">
                <th class="col200">
                    SMA Name
                </th>
                <th class="col160">
                    Max Turnover
                </th>
                <th>
                    Reason
                </th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<div class="succeededRecordsTableContainer hidden">
    <table class="succeededRecordsTable tbllayout hidden">
        <thead>
            <tr>
                <th colspan="3" class="l b success-title">
                    Please review valid records below and click Submit button to save data.
                </th>
            </tr>
            <tr class="title">
                <th class="col200">
                    SMA Name
                </th>
                <th style="width: 635px;">
                    Max Turnover
                </th>
                <th class="col80">
                    Remove
                </th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<input id="btnSubmit_AddSMAList" class="btn" type="submit" value="Submit" disabled="disabled" />
