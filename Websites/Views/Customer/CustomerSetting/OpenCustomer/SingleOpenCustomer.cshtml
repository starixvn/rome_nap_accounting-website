@using Fanex.Tarus.Customer.ViewModels.CustomerSetting.OpenCustomer;
@using Sunplus.Accounting.Core.Configurations;

@model SingleOpenCustomerViewModel

@{
    Layout = null;
    var affectedDownlines = Model.AffectedDownlines();
}

<html>
<head>
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Views/Customer/CustomerSetting/OpenCustomer/Styles/SingleOpenCustomer.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css">
    <link href="@Url.Content("~/Areas/CustomerSetting/Styles/Common.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css">
    <link href="@Url.Content("~/Views/Customer/CreditCustomer/Styles/CustomerSettingCommon.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css">
</head>
<body>
    <div id="successMsg" class="hidden successMsg"></div>
    <div id="errMsg" class="hidden errMsg"></div>
    <div id="tab-main">
        <div>
            <span id="main-header-title" class="header-title">@string.Format(Resources.Language.OpenedMainTitle, Model.UserName)</span>
            <div class="floatRight"><span id="information-box" class="ml10 infoIcon"></span></div>
        </div>
        <table class="tableInfo" cellpadding="2" cellspacing="0" border="1">
            <thead>
                <tr>
                    <th class="bgTitle left">Level</th>
                    <th class="bgTitle">Affected Downlines</th>
                    <th class="bgTitle">Remain Unchanges Downlines</th>
                </tr>
            </thead>
            <tbody>
                @if (affectedDownlines == null || affectedDownlines.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="red center">@Resources.Language.thereisnodata</td>
                    </tr>
                }
                else
                {
                    foreach (var row in affectedDownlines)
                    {
                        <tr>
                            <td>@row.LevelName</td>
                            <td class="right">
                                <span class="@(row.AffectedDownlines > 0 ? "canchange": string.Empty)"
                                      onclick="@(row.AffectedDownlines > 0 ? ("return GetDownlinesDetailInfo(" + Model.CustId + ", true, " + @row.Level + " , 50, 0);") : string.Empty)">
                                    @row.AffectedDownlines
                                </span>
                            </td>
                            <td class="right">
                                <span class="@(row.RemainUnchangedDownlines > 0 ? "canchange": string.Empty)"
                                      onclick="@(row.RemainUnchangedDownlines > 0 ? ("return GetDownlinesDetailInfo(" + Model.CustId + ", false, " + @row.Level + " , 50, 0);") : string.Empty)">
                                    @row.RemainUnchangedDownlines
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <input id="custId" type="hidden" value="@Model.CustId" />
        <div style="text-align: right">
            <input id="btnOpen" type="button" class="buttonPopup" value="Open" />
        </div>
    </div>
    <div id="tab-detail" class="hidden" style="width: 600px; height: 300px;">
        <div>
            <span id="detail-header-title" class="header-title"></span>
        </div>
        <div style="clear:both;"></div>
        <div id="gridContainer" class="grid-container">
            <div id="gridId" class="freegrid"></div>
        </div>
        <div style="text-align: right">
            <input id="btnBack" type="button" class="buttonPopup" value="Back" />
        </div>
    </div>
    <script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery-1.8.2.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Customer/CustomerSetting/OpenCustomer/Scripts/SingleOpenCustomer.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript">
        var cachedDownlinesDetailInfoData = {
            custId: 0,
            isAffected: false,
            downlineRoleId: 0,
        };

        var LanguageResources = {
            UpdateCloseSuccess: '@Resources.ErrorMsg.UpdateCloseSuccess',
            OpenInfoMessage: '@Html.Raw(Resources.Language.OpenInfoMessage)',
            OpenSingleConfirmMesssage: '@Resources.Language.OpenSingleConfirmMesssage',
            OpenedAffectedDownlinesTitle: '@string.Format(Resources.Language.OpenedAffectedDownlinesTitle, Model.UserName)',
            OpenedRemainUnchangedDownlinesTitle: '@string.Format(Resources.Language.OpenedRemainUnchangedDownlinesTitle, Model.UserName)'
        };
    </script>
</body>
</html>