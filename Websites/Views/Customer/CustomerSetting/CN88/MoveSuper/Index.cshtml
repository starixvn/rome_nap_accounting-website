@using Resources;
@using Sunplus.Accounting.Core.Configurations;
@{
    Page.Title = "Move CN88 Super";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var extraPTSelectListItems = new List<SelectListItem>() {
        new SelectListItem() { Text = "0%", Value = "0" },
        new SelectListItem() { Text = "1%", Value = "1" },
        new SelectListItem() { Text = "2%", Value = "2" },
        new SelectListItem() { Text = "3%", Value = "3" },
        new SelectListItem() { Text = "4%", Value = "4" },
        new SelectListItem() { Text = "5%", Value = "5" } };
}

@section Styles
{
    <link href="@Url.Content("~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/js/jQuery/autocomplete/styles.css?v=" + WebSettings.Version)" rel="Stylesheet" type="text/css" />
    <link href="@Url.Content("~/App_Themes/Public/common.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/App_Themes/Public/table.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
}
@section Scripts
{
    <script src="@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js?v=" + WebSettings.Version)"></script>
    <script src="@Url.Content("~/js/jQuery/autocomplete/jquery.autocomplete.js?v=" + WebSettings.Version)"></script>
    <script src="@Url.Content("~/js/encode.js?v=" + WebSettings.Version)"></script>
    <script src="@Url.Content("~/Views/Customer/CustomerSetting/CN88/MoveSuper/Scripts/Index.js?v=" + WebSettings.Version)"></script>
    <script>
        var languages = {
            MoveSuperSuccess: '@Resources.Language.MoveSuperSuccess',
            InvalidSuper: '@Resources.Language.InvalidSuper',
            InvalidHeadline: '@Resources.Language.InvalidHeadline',
            ConfirmSubmit: '@Resources.Language.CN88_MoveSuper_ConfirmSubmit'
        };
    </script>
}

<div class="main">
    <div class="maincontent">
        <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
            <tbody>
                <tr>
                    <td class="maincontent_headerL"></td>
                    <td class="maincontent_headerC">@Page.Title</td>
                    <td class="maincontent_headerR"></td>
                </tr>
            </tbody>
        </table>
        <div class="noteMsg">
            Once we submit the new headline here, super will no longer appear under existing headline. It's recommended to submit the change one day prior to effective date.
        </div>
        <div id="errorMsg" class="errorMsg display-none"></div>
        <div id="successMsg" class="successMsg display-none">@Resources.ErrorMsg._0 </div>
        <div class="clear row">
            <table cellspacing="0" cellpadding="5" class="tbl-collapse-no-border">
                <tr>
                    <td>Super Username</td>
                    <td>
                        <input id="txtSearchSuperUserName" type="text" />
                        <input id="hidSuperId" type="hidden" />
                    </td>
                    <td class="r"><button id="btnSearch" class="buttonPopup" type="button">@Language.search</button></td>
                </tr>
                <tr>
                    <td></td>
                    <td>Current Value</td>
                    <td>New Value</td>
                </tr>
                <tr>
                    <td>Headline Username: </td>
                    <td><span id="lblOldHeadLineName" class="b"></span></td>
                    <td><input id="txtNewHeadLineName" type="text" /></td>
                </tr>
                <tr>
                    <td>Sportsbook's Headline Possess</td>
                    <td id="lblOldSportsbookPossess" class="b"></td>
                    <td>@Html.DropDownList("SportsbookPossess", extraPTSelectListItems, new { id = "ddlNewSportsbookPossess", @style = "width: 100%;" })</td>
                </tr>
                <tr>
                    <td>Non-Sports's Headline Possess</td>
                    <td id="lblOldNonSportPossess" class="b"></td>
                    <td>@Html.DropDownList("NonSportPossess", extraPTSelectListItems, new { id = "ddlNewNonSportPossess", @style = "width: 100%;" })</td>
                </tr>
                <tr>
                    <td>Effective Date (from 0:00 AM GMT-4)</td>
                    <td class="b"></td>
                    <td id="lblEffectiveDate"></td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td class="r"><button id="btnSubmit" class="buttonPopup" type="button">@Language.Submit</button></td>
                </tr>
            </table>
        </div>
    </div>
</div>