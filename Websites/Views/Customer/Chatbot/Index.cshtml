@using Fanex.Tarus.Customer.ViewModels.Chatbot
@model ChatbotViewModel
@{
    Page.Title = "Chatbot";
    //Layout = "Your Layout Page goes here";
}
<!DOCTYPE html>
<html>
<head>
    <title></title>
    <link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Report/reportgrid.css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/Pager/pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
    <link href="~/js/MultipleSelect/jquery.multiselect.css" rel="stylesheet" type="text/css" />
    <link href="~/js/ToolTip/Tipsy-Tooltip/tipsy.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Customer/Chatbot/Styles/Chatbot.css" rel="stylesheet" />
</head>
<body>
    @if (!Model.AlreadyLinked)
    {
        <div id="err">
            <div class='alertboxerr'><div>No linked account found.</div></div>
        </div>
    }
    else
    {
        <div id="err">
        </div>
        <div class="main">
            <div class="maincontent">
                <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
                    <tr>
                        <td class="maincontent_headerL"></td>
                        <td class="maincontent_headerC">
                            Chatbot
                        </td>
                        <td class="maincontent_headerR"></td>
                    </tr>
                </table>
                <div class="maincontent_box" style="width: 760px;">
                    <table>
                        <tr>
                            <td>
                                Username:
                            </td>
                            <td style="width: 80px">
                                <strong>@Model.UserName</strong>
                            </td>
                            <td style="width: 40px"></td>
                            <td>
                                Letstalk ID:
                            </td>
                            <td style="width: 120px">
                                <strong>@Model.LetstalkAccount.Username</strong>
                                <input type="button" class="btn" onclick="" value="Unlink"
                                       name="btnUnlink" id="btnUnlink" />
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>
                                Language
                            </td>
                            <td style="width: 80px">
                                @Html.DropDownList("ddlLanguage", Model.OfferLanguages, new { style = "width:80px" })
                            </td>
                            <td align="left">
                                <div class="divSave">
                                    <img id="btnSaveLanguage" alt="Save" title="Save" border="0" src="../App_Themes/Images/save1.jpg" style="cursor: pointer;" />
                                </div>
                            </td>
                            <td>
                                Function
                            </td>
                            <td style="width: 120px">
                                <div id="ddlFeature" class="multiselect" multiple="multiple" style="padding-top: 2px;">
                                </div>
                            </td>
                            <td align="left">
                                <div class="divSave">
                                    <img id="btnSaveFeature" alt="Save" title="Save" border="0" src="../App_Themes/Images/save1.jpg" style="cursor: pointer;" />
                                </div>
                            </td>
                        </tr>
                    </table>
                    <table class="tbllayout" cellpadding="1">
                        <tr class="title">
                            <td>Chat History</td>
                        </tr>
                    </table>
                    <table class="filter-table">
                        <tr>
                            <td>From</td>
                            <td style="width: 140px">
                                <input type="text" id="txtfromdate" readonly="readonly" class="txtdate" style="width: 100px;" />
                            </td>
                            <td>To</td>
                            <td style="width: 140px">
                                <input type="text" id="txttodate" readonly="readonly" class="txtdate" style="width: 100px;" />
                            </td>
                            <td>Function</td>
                            <td style="width: 260px">
                                @Html.DropDownList("ddlFeatureFilter", Model.FeatureFilterItems, new { style = "width:260px" })
                            </td>
                            <td style="width: 130px" align="right">
                                <input type="button" class="btn" onclick="" value="Submit"
                                       name="btnSubmit" id="btnSubmit" />
                            </td>
                        </tr>
                    </table>
                    <div id="chatHistory" class="history-content content-warper hidden">
                        <div class="content-header clearfix">
                            <div class="header-scroll">
                                <table class="tbllayout tbl-header-scroll">
                                    <tbody>
                                        <tr class="title">
                                            <td style="border-bottom: none 0px;">
                                                <div class="col100 c">Letstalk ID</div>
                                            </td>
                                            <td style="border-bottom: none 0px; ">
                                                <div style="width:513px;">Message Content</div>
                                            </td>
                                            <td style="border-bottom: none 0px;">
                                                <div class="col120 c">Date (GMT -4)</div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="content-body clearfix">
                            <div class="body-scroll">
                                <table class="tbl-body-scroll">
                                    <tbody id="chatHistoryContentBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @Html.Hidden("UserId", Model.UserId)
        @Html.Hidden("CustId", Model.CustId)
        @Html.Hidden("LetstalkId", Model.LetstalkAccount.Username)
        <script type="text/javascript">
            window.rootUrl = '@Url.Content("~")';
            var today = '@DateTime.Now.ToShortDateString()';
            var mindate = '@DateTime.Now.AddDays(-90).ToShortDateString()';
            var jsonFeatures=@Html.Raw(Json.Encode(Model.Functions));
        </script>
    }
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/json2.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Jlinq/jlinq.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/gridscroller.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Pager/jpager.js" type="text/javascript"></script>
    <script src="~/js/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
    <script src="~/js/ToolTip/Tipsy-Tooltip/jquery.tipsy.js?ver=2" type="text/javascript"></script>
    <script src="~/js/common.js" type="text/javascript"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/moment.js?v=" + Sunplus.Accounting.Core.Configurations.WebSettings.Version)"></script>
    <script src="~/Views/Customer/Chatbot/Scripts/Chatbot.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
</body>
</html>