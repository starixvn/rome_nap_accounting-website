                    <span id="disallow_@superItem.ChildID" class="disallow-button" onclick="SuperList.confirmUpdateDComm(false,'@idAllow',true);" onmouseout="" onmouseover="">
                    </span>
                </div>
            }
            <div class="table-cell c" style="width: 20px; height: 18px;">
