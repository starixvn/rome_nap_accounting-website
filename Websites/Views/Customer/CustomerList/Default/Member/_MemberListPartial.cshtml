@{

    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;

    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;

    int colspan = 4;
    int colspanCom = 6;
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }  
    
    Hashtable hash = new Hashtable();

    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var memberItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(memberItem, hash);
            result[1] += renderContent(memberItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem)
    {
        var bg = (memberItem.No % 2 == 0) ? "even" : "";
        var status = memberItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = memberItem.ClosedReason.ClassName;
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}
@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem, Hashtable hash)
{
    var bg = rowCSS(memberItem);
   <tr name="tr_@memberItem.ChildID" class="@bg" style="height: 20px;">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @memberItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                @memberItem.Status
            </div>
        </td>
        <td>
            <div id="tooltip_@memberItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span>@memberItem.UserName</span>
            </div>
        </td>
    </tr>
}
@helper renderContent(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem, Hashtable hash)
