@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using System.Collections
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Business.Security
@using Fanex.CustomerSetting.Module.Keno.KenoSetting.Configurations
@{

    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;


    var EnableVirtualSports = WebSettings.EnableVirtualSports;

    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;

    int IsShowCustomerSettingRenovation = 0;
    if (IsPost)
    {
        IsShowCustomerSettingRenovation = WebSettings.IsShowCustomerSettingRenovation;
    }

    int colspan = 4;
    int colspanCom = 6;
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }
    bool isParentMyanmarOdds = false;

    foreach (var memberItem in Model.ListChildren)
    {
        if (memberItem.IsMyanmarOdds)
        {
            isParentMyanmarOdds = true;
            break;
        }
    }

    if (isParentMyanmarOdds)
    {
        colspanCom++;
    }
    Hashtable hash = new Hashtable();

    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    hash.Add("EnableVirtualSports", EnableVirtualSports);
    hash.Add("allowKeno", KenoSection.Instance.ShowSetting);
    hash.Add("isParentMyanmarOdds", isParentMyanmarOdds);
    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var memberItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(memberItem, hash);
            result[1] += renderContent(memberItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem)
    {
        var bg = (memberItem.No % 2 == 0) ? "even" : "";
        var status = memberItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = memberItem.ClosedReason.ClassName;
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}
@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList memberItem, Hashtable hash)
{
var bg = rowCSS(memberItem);
var idAllow = memberItem.ChildID.ToString() + '_' + memberItem.UserName;
string siteName = memberItem.IsMyanmarOdds ? "76666B" : string.Empty;
    <tr name="tr_@memberItem.ChildID" class="@bg" style="height: 20px;">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @memberItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                <a onclick="EditSportsBookSetting(1, '@memberItem.ChildID', '@Model.ParentId', '@memberItem.UserName', '@siteName');">@memberItem.Status</a>
                <span onclick="EditSportsBookSetting(1, '@memberItem.ChildID', '@Model.ParentId', '@memberItem.UserName', '@siteName');" class="status-button">
                    &nbsp;&nbsp;&nbsp
                </span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 30px; height: 18px;">
                <span title="Edit" onmouseout="CustomerList.HideEditBox()" onclick="CustomerList.ShowMenuEdit('div_@memberItem.ChildID')" class="edit-button">
                </span>
                <ul id="div_@memberItem.ChildID" style="display:none;">
                    <li class="canchange" onclick="OpenChangePwd('@memberItem.ChildID','@memberItem.UserName');">
                        Password
                    </li>
                    @if (!memberItem.IsHideVirtualSports)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@memberItem.ChildID', 5, 'Virtual Sports');">
                            Virtual Sports
                        </li>
                    }
                    @if (CastAide.AsBoolean(hash["allowKeno"]))
                    {
                        <li class="canchange" onclick="MemberList.kenoSetting('@memberItem.ChildID');">
                            RNG Keno
                        </li>
                    }
                    @if (!memberItem.IsHideSportsbook2)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@memberItem.ChildID', 16, 'Sportsbook 2');">
                            Sportsbook 2
                        </li>
                    }
                    @if (!memberItem.IsHideLiveCasino)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@memberItem.ChildID', 41, 'Live Casino');">
                            Live Casino
                        </li>
                    }
                    @if (!memberItem.IsHideVoidbridge)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@memberItem.ChildID', 22, 'Macau Games');">
                            Macau Games
                        </li>
                    }
                    @if (!memberItem.IsHideFishingWorld)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@memberItem.ChildID', 24, 'Fishing World');">
                            Fishing World
                        </li>
                    }
                    @if (!memberItem.IsHideVirtualGames)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@memberItem.ChildID', 38, 'Virtual Games');">
                            Virtual Games
                        </li>
                    }
                </ul>
            </div>
        </td>
        <td>
            @if (!Model.ParentDoubleComm && Model.ParentId != 0)
            {
                <div class="table-cell" style="width: 45px; height: 18px;">
                    <span class="off-button"></span>
                </div>
                <div class="table-cell c" style="width: 10px; height: 18px;">
                    <input type="checkbox" disabled="disabled" />
                </div>
            }
            else
            {
                if (memberItem.isDoubleComm)
                {
                    <div class="table-cell" style="width: 45px; height: 18px;">
                        <span id="allow_@memberItem.ChildID" class="on-button" onclick="MemberList.confirmUpdateSingle(false,'@idAllow',false);" onmouseout="" onmouseover="">
                        </span>
                    </div>
                }
                else
                {
                    <div class="table-cell" style="width: 45px; height: 18px;">
                        <span id="disallow_@memberItem.ChildID" class="off-button" onclick="MemberList.confirmUpdateSingle(false,'@idAllow',true);" onmouseout="" onmouseover="">
                        </span>
                    </div>
                }
                <div class="table-cell c" style="width: 10px; height: 18px;">
                    <input id="chk_@idAllow" onclick="CustomerList.selectID()" type="checkbox" />
                </div>
            }
        </td>
        <td>
            <div id="tooltip_@memberItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span>@memberItem.UserName</span>
            </div>
        </td>
    </tr>
}
