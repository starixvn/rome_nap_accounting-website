@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using System.Collections
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Business.Security
@{

    var IsVisibleMaxExposure = Functions.Customer.IsVisibleMaxExposure;
    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;

    var EnableVirtualSports = WebSettings.EnableVirtualSports;

    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;
   
    int colspan = 3;
    int colspanCom = 6;
    if (IsVisibleMaxExposure)
    {
        colspan++;
    }
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }

    Hashtable hash = new Hashtable();
    hash.Add("IsVisibleMaxExposure", IsVisibleMaxExposure);
    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
 
    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var masterItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(masterItem, hash);
            result[1] += renderContent(masterItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList masterItem)
    {
        var bg = (masterItem.No % 2 == 0) ? "even" : "";
        var status = masterItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = masterItem.ClosedReason.ClassName;
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}
@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList masterItem, Hashtable hash)
{
    var bg = rowCSS(masterItem);
    var idAllow = masterItem.ChildID.ToString() + '_' + masterItem.UserName;

    <tr name="tr_@masterItem.ChildID" class="@bg" style="height: 20px;">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @masterItem.No
            </div>
        </td>
        <td>
	        <div class="table-cell c" style="width: 65px; height: 18px;">
		        @masterItem.Status
	        </div>
        </td>
        <td>
            <div id="tooltip_@masterItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span><a href="AgentList?masterId=@masterItem.ChildID">@masterItem.UserName</a></span>
            </div>
        </td>
    </tr>
}
@helper renderContent(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList masterItem, Hashtable hash)
{
    var bg = rowCSS(masterItem);
    <tr name="tr_@masterItem.ChildID" class="@bg" style="height: 20px;">
        <td>
            <div class="table-cell c" style="width: 40px; height: 18px;">
                &nbsp;
            </div>
        </td>
        <td>
            <div class="table-cell " style="width: 65px; height: 18px;">
                &nbsp;
            </div>
        </td>
        <td>
            <div class="table-cell" style="width: 30px; height: 18px;">
                &nbsp;
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 120px; height: 18px;">
                @masterItem.NickName
            </div>
        </td>
        @if (CastAide.AsBoolean(hash["IsVisibleMaxExposure"]))
        {
            <td>
                <div class="table-cell c" style="width: 80px; height: 18px;">
                    <a onclick="OpenEditMaxEx('@masterItem.ChildID','@masterItem.UserName',@masterItem.MaxExposure,'Master',true,'@Model.ParentId')">@masterItem.MaxExposure</a>
                </div>
            </td>
        }
        @if (CastAide.AsBoolean(hash["IsVisibleVirtualRate"]))
        {
            <td>
                <div class="table-cell c" style="width: 60px; height: 18px;">
                    <span title="Edit" onclick="OpenEditVirtualExRate('@masterItem.ChildID','@masterItem.UserName','Master',true,'@Model.ParentId')" class="edit-button edit-virtualrate">
                    </span>
                </div>
            </td>
        }
        <td>
            <div id="tooltip_@masterItem.FirstName" class="table-cell c display" style="width: 140px;height: 18px;text-overflow:ellipsis;">
                <span>@masterItem.FirstName</span>
            </div>
        </td>
        <td>
            <div id="tooltip_@masterItem.LastName" class="table-cell c display" style="width: 140px; height: 18px;text-overflow:ellipsis;">
                <span>@masterItem.LastName</span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @masterItem.GroupA
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @masterItem.GroupB
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @masterItem.GroupC
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @masterItem.GroupD
            </div>
            </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @masterItem._1x2
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @masterItem.Others
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 90px; height: 18px;">
                <a onclick="ViewIP('@masterItem.LastLoginIP')">@masterItem.LastLoginIP</a>
            </div>
        </td>
    </tr>
}
