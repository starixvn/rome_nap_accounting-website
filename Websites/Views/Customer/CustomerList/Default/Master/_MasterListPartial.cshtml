@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using System.Collections
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Business.Security
@using Fanex.CustomerSetting.Module.Keno.KenoSetting.Configurations
@{

    var IsVisibleMaxExposure = Functions.Customer.IsVisibleMaxExposure;
    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;
    var enableNumberGame = true;

    var EnableVirtualSports = WebSettings.EnableVirtualSports;

    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;
    bool allowCS = false;
    int IsShowCustomerSettingRenovation = 0;
    bool directMaster = (Model.ParentId == 0 ? true : false);

    if (Model.ParentId == 0)
    {
        allowCS = true;
    }
    else
    {
        var thirdPartyStatus = Permissions.SelStatus3rdParty(CastAide.AsInt32(Model.ParentId));
        allowCS = Model.ParentId == 0 ? true : thirdPartyStatus.CasinoSync;
    }
    if (IsPost)
    {
        IsShowCustomerSettingRenovation = WebSettings.IsShowCustomerSettingRenovation;
    }
    int colspan = 4;
    int colspanCom = 6;
    if (IsVisibleMaxExposure)
    {
        colspan++;
    }
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }
    if (enableNumberGame)
    {
        colspanCom++;
    }
    bool isParentMyanmarOdds = false;
    foreach (var masterItem in Model.ListChildren)
    {
        if (masterItem.IsMyanmarOdds)
        {
            isParentMyanmarOdds = true;
            break;
        }
    }
    bool isShowMyanmarOdds = directMaster || isParentMyanmarOdds;
    if (directMaster)
    {
        colspanCom++;
    }
    else if (isParentMyanmarOdds)
    {
        colspanCom = colspanCom - 2;
    }

    var parentIsIMBCCustomers = false;
    foreach (var agentItem in Model.ListChildren)
    {
        if (agentItem.IsIMBCCustomers)
        {
            parentIsIMBCCustomers = true;
            break;
        }
    }

    if (parentIsIMBCCustomers)
    {
        colspanCom++;
    }

    Hashtable hash = new Hashtable();

    hash.Add("IsVisibleMaxExposure", IsVisibleMaxExposure);
    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    hash.Add("enableNumberGame", enableNumberGame);
    hash.Add("EnableVirtualSports", EnableVirtualSports);
    hash.Add("directMaster", directMaster);
    hash.Add("allowCS", allowCS);
    hash.Add("allowKeno", KenoSection.Instance.ShowSetting);
    hash.Add("isParentMyanmarOdds", isParentMyanmarOdds);
    hash.Add("parentIsIMBCCustomers", parentIsIMBCCustomers);

    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var masterItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(masterItem, hash);
            result[1] += renderContent(masterItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList masterItem)
    {
        var bg = (masterItem.No % 2 == 0) ? "even" : "";
        var status = masterItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = masterItem.ClosedReason.ClassName;
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}
@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList masterItem, Hashtable hash)
{
var bg = rowCSS(masterItem);
var idAllow = masterItem.ChildID.ToString() + '_' + masterItem.UserName;
string siteName = masterItem.IsMyanmarOdds ? "766666" : string.Empty;

    <tr name="tr_@masterItem.ChildID" class="@bg">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @masterItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                @{
                    int parentMasterID = Model.ParentId == 0 ? masterItem.ParentMasterDirect : Model.ParentId;
                }
                <a onclick="EditSportsBookSetting(3, '@masterItem.ChildID', '@parentMasterID', '@masterItem.UserName', '@siteName');">@masterItem.Status</a>
                <span onclick="EditSportsBookSetting(3, '@masterItem.ChildID', '@parentMasterID', '@masterItem.UserName', '@siteName');" class="status-button">
                    &nbsp;&nbsp;&nbsp
                </span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 30px; height: 18px;">
                <span title="Edit" onmouseout="CustomerList.HideEditBox()" onclick="CustomerList.ShowMenuEdit('div_@masterItem.ChildID')" class="edit-button">
                </span>
                <ul id="div_@masterItem.ChildID" style="display:none;">
                    <li class="canchange" onclick="EditMinMaxPT(3, '@masterItem.ChildID', '@parentMasterID', '@masterItem.UserName');">
                        Min Max PT
                    </li>
                    <li class="canchange" onclick="OpenEditCustInfo('@masterItem.ChildID','Master');">Info</li>
                    @{
                        var IsOnclickCS = !CastAide.AsBoolean(hash["directMaster"]) ? (!string.IsNullOrEmpty(ViewBag.synccasinoUpline) ?
                        CastAide.AsBoolean(ViewBag.synccasinoUpline) : CastAide.AsBoolean(hash["allowCS"])) : masterItem.IsSynCasinoUpline;
                        var parentCustIdTmp = Model.ParentId == 0 ? masterItem.ParentMasterDirect : Model.ParentId;
                        var onclickCS = (IsOnclickCS == true ? "masterList.casino('" + masterItem.ChildID + "','" + parentCustIdTmp + "');" : "");
                    }
                    <li class="canchange" onclick="@onclickCS">Casino</li>

                    <li class="canchange" onclick="OpenEditTransferTime('@masterItem.ChildID',0);">
                        Transfer
                        Condition
                    </li>
                    <li class="canchange" onclick="OpenChangePwd('@masterItem.ChildID','@masterItem.UserName');">
                        Password
                    </li>

                    @if (!masterItem.IsHideVirtualSports)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 5, 'Virtual Sports');">
                            Virtual Sports
                        </li>
                    }
                    @if (CastAide.AsBoolean(hash["allowKeno"]))
                    {
                        <li class="canchange" onclick="masterList.kenoSetting('@masterItem.ChildID');">Keno</li>
                    }
                    @if (WebSettings.IsShowGoldDeluxeSettingForCredit)
                    {
                        <li class="canchange" onclick="masterList.goldDeluxeSetting('@masterItem.ChildID', '@Model.ParentId');">
                            Gold Deluxe
                        </li>
                    }
                    @if (!masterItem.IsHideColossusBets)
                    {
                        <li class="canchange" onclick="masterList.colossusBetSetting('@masterItem.ChildID', '@Model.ParentId');">
                            Colossus Bets
                        </li>
                    }
                    @if (!masterItem.IsHideSportsbook2)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 16, 'Sportsbook 2');">
                            Sportsbook 2
                        </li>
                    }

                    @if (!masterItem.IsHideCricket)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 20, 'Cricket');">
                            Cricket
                        </li>
                    }
                    @if (!masterItem.IsHideAllBet)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 21, 'Allbet');">
                            Allbet
                        </li>
                    }
                    @if (!masterItem.IsHideVoidbridge)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 22, 'Macau Games');">
                            Macau Games
                        </li>
                    }
                    @if (!masterItem.IsHideFishingWorld)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 24, 'Fishing World');">
                            Fishing World
                        </li>
                    }

                    @if (!masterItem.IsHidePokerGames)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@masterItem.ChildID', 33, 'Poker Games');">
                            Poker Games
                        </li>
                    }
                </ul>
            </div>
        </td>
        <td>
            @if ((Model.ParentId != 0 && !Model.ParentDoubleComm) || (Model.ParentId == 0 && !masterItem.DoubleCommLosingUpline))
            {
                <div class="table-cell" style="width: 70px; height: 18px;">
                    <span class="disallow-button"></span>
                </div>
                <div class="table-cell c" style="width: 20px; height: 18px;">
                    <input type="checkbox" disabled="disabled" />
                </div>
            }
            else
            {
                if (masterItem.isDoubleComm)
                {
                    <div class="table-cell" style="width: 70px; height: 18px;">
                        <span id="allow_@masterItem.ChildID" class="allow-button" onclick="masterList.confirmUpdateDComm(false,'@idAllow',false);" onmouseout="" onmouseover="">
                        </span>
                    </div>
                }
                else
                {
                    <div class="table-cell" style="width: 70px; height: 18px;">
                        <span id="disallow_@masterItem.ChildID" class="disallow-button" onclick="masterList.confirmUpdateDComm(false,'@idAllow',true);" onmouseout="" onmouseover="">
                        </span>
                    </div>
                }
                <div class="table-cell c" style="width: 20px; height: 18px;">
                    <input id="chk_@idAllow" onclick="CustomerList.selectID()" type="checkbox" />
                </div>
            }
        </td>
        <td>
            <div id="tooltip_@masterItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span>@masterItem.UserName</span>
            </div>
        </td>
    </tr>
}
@helper renderContent(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList masterItem, Hashtable hash)
