@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using System.Collections
@using Sunplus.Accounting.Core.Common
@{
    var IsVisibleMaxExposure = Functions.Customer.IsVisibleMaxExposure;
    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;
    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;

    int colspan = 3;
    int colspanCom = 6;
    if (IsVisibleMaxExposure)
    {
        colspan++;
    }
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }

    Hashtable hash = new Hashtable();
    hash.Add("IsVisibleMaxExposure", IsVisibleMaxExposure);
    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var agentItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(agentItem, hash);
            result[1] += renderContent(agentItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList agentItem)
    {
        var bg = (agentItem.No % 2 == 0) ? "even" : "";
        var status = agentItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = agentItem.ClosedReason.ClassName;
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}
@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList agentItem, Hashtable hash)
{
    var bg = rowCSS(agentItem); 
    <tr name="tr_@agentItem.ChildID" class="@bg">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @agentItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                @agentItem.Status
            </div>
        </td>
        <td>
            <div id="tooltip_@agentItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span><a href="MemberList?agentId=@agentItem.ChildID&doubleCommAgent=@agentItem.isDoubleComm.ToString().ToLower()">@agentItem.UserName</a></span>
            </div>
        </td>
    </tr>
}
@helper renderContent(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList agentItem, Hashtable hash)
{
    var bg = rowCSS(agentItem);
    <tr name="tr_@agentItem.ChildID" class="@bg" style="height: 20px;">
        <td>
            <div class="table-cell c" style="width: 40px; height: 18px;">
                &nbsp;
            </div>
        </td>
        <td>
            <div class="table-cell " style="width: 65px; height: 18px;">
                &nbsp;
            </div>
        </td>
        <td>
            <div class="table-cell" style="width: 120px; height: 18px;">
                &nbsp;
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 120px; height: 18px;">
                @agentItem.NickName
            </div>
        </td>
        @if (CastAide.AsBoolean(hash["IsVisibleMaxExposure"]))
        {
            <td>
                <div class="table-cell c" style="width: 80px; height: 18px;">
                    <a onclick="OpenEditMaxEx('@agentItem.ChildID','@agentItem.UserName',@agentItem.MaxExposure,'Agent',true,'@Model.ParentId')">@agentItem.MaxExposure</a>
                </div>
            </td>
        }
        @if (CastAide.AsBoolean(hash["IsVisibleVirtualRate"]))
        {
            <td>
                <div class="table-cell c" style="width: 60px; height: 18px;">
                    <span title="Edit" onclick="OpenEditVirtualExRate('@agentItem.ChildID','@agentItem.UserName','Agent',true,'@Model.ParentId')" class="edit-button edit-virtualrate">
                    </span>
                </div>
            </td>
        }
        <td>
            <div id="tooltip_@agentItem.FirstName" class="table-cell c display" style="width: 140px;height: 18px;text-overflow:ellipsis;">
                <span>@agentItem.FirstName</span>
            </div>
        </td>
        <td>
            <div id="tooltip_@agentItem.LastName" class="table-cell c display" style="width: 140px; height: 18px;text-overflow:ellipsis;">
                <span>@agentItem.LastName</span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @agentItem.GroupA
            </div>
        </td>
       <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @agentItem.GroupB
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @agentItem.GroupC
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @agentItem.GroupD
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @agentItem._1x2
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 70px; height: 18px;">
                @agentItem.Others
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 90px; height: 18px;">
                <a onclick="ViewIP('@agentItem.LastLoginIP')">@agentItem.LastLoginIP</a>
            </div>
        </td>
    </tr>
}
