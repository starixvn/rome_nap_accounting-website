@model Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel
@using DNAide.Core
@using Sunplus.Accounting.Core.Configurations
@using Sunplus.Bingo.Core
@using System.Collections
@using Sunplus.Accounting.Core.Common
@using Sunplus.Accounting.Business.Security
@using Fanex.CustomerSetting.Module.KenoStatus.Configurations
@{
    var p2pSetting = PokerSection.Instance[PokerSection.PokerCollections.CustomerSetting]["visibleP2PSetting"];
    bool visibleP2PSetting = CastAide.AsBoolean(p2pSetting.Value);
    var IsVisibleMaxExposure = Functions.Customer.IsVisibleMaxExposure;
    var IsVisibleVirtualRate = Functions.Customer.IsVisibleVirtualRate;
    var enableNumberGame = BingoSettings.NumberGame.Enabled;

    var disabledHR = WebSettings.disabledHR;
    var enableBingo = BingoSettings.BingoGame.Enabled;
    var EnableLiveCasino = WebSettings.EnableLiveCasino;
    var EnableVirtualSports = WebSettings.EnableVirtualSports;

    var adminID = AppSession.AccId;
    var adminUserName = AppSession.AccUserName;
    bool allowCS = false;
    bool allowFI = Permissions.IsAllowEditFI();
    bool allowLiveCS = false;
    int IsShowCustomerSettingRenovation = 0;
    bool directMaster = (Model.ParentId == 0 ? true : false);
    if (Model.ParentId == 0)
    {
        allowCS = true;
        allowLiveCS = true;
    }
    else
    {
        var thirdPartyStatus = Permissions.SelStatus3rdParty(CastAide.AsInt32(Model.ParentId));
        allowCS = Model.ParentId == 0 ? true : thirdPartyStatus.CasinoSync;
        allowLiveCS = Permissions.IsAllowEditLiveCasino(Model.ParentId, thirdPartyStatus.LiveCasinoSync);
    }
    if (IsPost)
    {
        IsShowCustomerSettingRenovation = WebSettings.IsShowCustomerSettingRenovation;
    }

    int colspan = 4;
    int colspanCom = 6;
    if (IsVisibleMaxExposure)
    {
        colspan++;
    }
    if (IsVisibleVirtualRate)
    {
        colspan++;
    }
    if (enableNumberGame)
    {
        colspanCom++;
    }
    bool isParentMyanmarOdds = false;
    foreach (var agentItem in Model.ListChildren)
    {
        if (agentItem.IsMyanmarOdds)
        {
            isParentMyanmarOdds = true;
            break;
        }
    }
    if (isParentMyanmarOdds)
    {
        colspanCom = colspanCom - 2;
    }

    var parentIsIMBCCustomers = false;
    foreach (var agentItem in Model.ListChildren)
    {
        if (agentItem.IsIMBCCustomers)
        {
            parentIsIMBCCustomers = true;
            break;
        }
    }

    if (parentIsIMBCCustomers)
    {
        colspanCom++;
    }

    Hashtable hash = new Hashtable();
    hash.Add("p2pSetting", p2pSetting);
    hash.Add("visibleP2PSetting", visibleP2PSetting);
    hash.Add("IsVisibleMaxExposure", IsVisibleMaxExposure);
    hash.Add("IsVisibleVirtualRate", IsVisibleVirtualRate);
    hash.Add("enableNumberGame", enableNumberGame);
    hash.Add("disabledHR", disabledHR);
    hash.Add("enableBingo", enableBingo);
    hash.Add("EnableLiveCasino", EnableLiveCasino);
    hash.Add("EnableVirtualSports", EnableVirtualSports);
    hash.Add("directMaster", directMaster);
    hash.Add("allowCS", allowCS);
    hash.Add("allowLiveCS", allowLiveCS);
    hash.Add("allowKeno", KenoSection.Instance.ShowSetting);
    hash.Add("isParentMyanmarOdds", isParentMyanmarOdds);
    hash.Add("parentIsIMBCCustomers", parentIsIMBCCustomers);

    string[] renderResult = Render(Model, hash);
}
@functions {
    public string[] Render(Fanex.Tarus.Customer.Entities.CustomerList.CustomerListModel customerListModel, Hashtable hash)
    {
        string[] result = new string[2];
        foreach (var agentItem in Model.ListChildren)
        {
            result[0] += renderRowHeader(agentItem, hash);
            result[1] += renderContent(agentItem, hash);
        }
        return result;
    }
    public string rowCSS(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList agentItem)
    {
        var bg = (agentItem.No % 2 == 0) ? "even" : "";
        var status = agentItem.Status;
        if (status == "Disabled")
        {
            bg = "disabled";
        }
        if (status == "Closed")
        {
            bg = "closed";
        }
        if (status == "Suspended")
        {
            bg = "suspended";
        }
        return bg;
    }
}
@helper renderRowHeader(Fanex.Tarus.Customer.Entities.CustomerList.CustomerList agentItem, Hashtable hash)
    {
        var bg = rowCSS(agentItem);
        var idAllow = agentItem.ChildID.ToString() + '_' + agentItem.UserName;
        string siteName = agentItem.IsMyanmarOdds ? "766666" : string.Empty;
    <tr name="tr_@agentItem.ChildID" class="@bg">
        <td>
            <div class="table-cell c " style="width: 40px; height: 18px;">
                @agentItem.No
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 65px; height: 18px;">
                <a onclick="EditSportsBookSetting(2, '@agentItem.ChildID', '@Model.ParentId', '@agentItem.UserName', '@siteName');">@agentItem.Status</a>
                <span onclick="EditSportsBookSetting(2, '@agentItem.ChildID', '@Model.ParentId', '@agentItem.UserName', '@siteName');" class="status-button">
                    &nbsp;&nbsp;&nbsp </span>
            </div>
        </td>
        <td>
            <div class="table-cell c" style="width: 30px; height: 18px;">
                <span title="Edit" onmouseout="CustomerList.HideEditBox()" onclick="CustomerList.ShowMenuEdit('div_@agentItem.ChildID')" class="edit-button">
                </span>
                <ul id="div_@agentItem.ChildID" style="display:none;">
                    <li class="canchange" onclick="EditMinMaxPT(2, '@agentItem.ChildID', '@Model.ParentId', '@agentItem.UserName');">
                        Max PT </li>
                    <li class="canchange" onclick="OpenEditCustInfo('@agentItem.ChildID','Agent');">Info</li>
                    @if (!CastAide.AsBoolean(hash["disabledHR"]))
                    {
                        <li class="canchange" onclick="EditHorseracingSetting(2, '@agentItem.ChildID','@Model.ParentId')">
                            Racing </li>
                    }
                    @{
                        var IsOnclickCS = !CastAide.AsBoolean(hash["directMaster"]) ? (!string.IsNullOrEmpty(ViewBag.synccasinoUpline) ?
                            CastAide.AsBoolean(ViewBag.synccasinoUpline) : CastAide.AsBoolean(hash["allowCS"])) : agentItem.IsSynCasinoUpline;
                        var onclickCS = (IsOnclickCS == true ? "AgentList.casino('" + agentItem.ChildID + "','" + Model.ParentId + "');" : "");
                    }
                    <li class="canchange" onclick="@onclickCS">Casino</li>
                    @if (CastAide.AsBoolean(hash["enableBingo"]))
                    {
                        <li class="canchange" onclick="OpenEditBI('@agentItem.ChildID', '@Model.ParentId', '2')">
                            Bingo </li>
                    }
                    <li class="canchange" onclick="OpenEditTransferTime('@agentItem.ChildID',0);">Transfer
                        Condition </li>
                    <li class="canchange" onclick="OpenChangePwd('@agentItem.ChildID','@agentItem.UserName');">
                        Password </li>
                    @if (CastAide.AsBoolean(hash["visibleP2PSetting"]))
                    {
                        <li class="canchange" onclick="AgentList.editSetting('@agentItem.ChildID', '2');">Poker</li>
                    }
                    @if (!(!CastAide.AsBoolean(hash["EnableLiveCasino"]) | !CastAide.AsBoolean(hash["allowLiveCS"])))
                    {
                        <li class="canchange" onclick="AgentList.liveCasinoSetting('@agentItem.ChildID', '0', '@Model.ParentId');">
                            Live Casino </li>
                    }
                    @if (CastAide.AsBoolean(hash["EnableVirtualSports"]))
                    {
                        <li class="canchange" onclick="AgentList.virtualSportsSetting('@agentItem.ChildID', '@Model.ParentId', '2');">
                            Virtual Sports </li>
                    }
                    @if (CastAide.AsBoolean(hash["allowKeno"]))
                    {
                        <li class="canchange" onclick="AgentList.kenoSetting('@agentItem.ChildID');">Keno</li>
                    }
                    @if (WebSettings.IsShowGoldDeluxeSettingForCredit)
                    {
                        <li class="canchange" onclick="AgentList.goldDeluxeSetting('@agentItem.ChildID', '@Model.ParentId');">
                            Gold Deluxe </li>
                    }
                    @if (!agentItem.IsHideColossusBets)
                    {
                        <li class="canchange" onclick="AgentList.colossusBetSetting('@agentItem.ChildID', '@Model.ParentId');">
                            Colossus Bets </li>
                    }
                    @if (!agentItem.IsHideSportsbook2)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@agentItem.ChildID', 16, 'Sportsbook 2');">
                            Sportsbook 2 </li>
                    }
                    @if (!agentItem.IsHideCockFighting)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@agentItem.ChildID', 19,  'Cockfighting');">
                            Cockfighting</li>
                    }
                    @if (!agentItem.IsHideCricket)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@agentItem.ChildID', 20, 'Cricket');">Cricket</li>
                    }
                    @if (!agentItem.IsHideAllBet)
                    {
                        <li class="canchange" onclick="EditDCSByProduct('@agentItem.ChildID', 21, 'AllBet');">AllBet</li>
                    }
                </ul>
            </div>
        </td>
        <td>
            @if (!Model.ParentDoubleComm && Model.ParentId != 0)
            {
                <div class="table-cell" style="width: 70px; height: 18px;">
                    <span class="disallow-button"></span>
                </div>
                <div class="table-cell c" style="width: 20px; height: 18px;">
                    <input type="checkbox" disabled="disabled" />
                </div>
            }
            else
            {
                if (agentItem.isDoubleComm)
                {

                <div class="table-cell" style="width: 70px; height: 18px;">
                    <span id="allow_@agentItem.ChildID" class="allow-button" onclick="AgentList.confirmUpdateDComm(false,'@idAllow',false);" onmouseout="" onmouseover="">
                    </span>
                </div>

                }
                else
                {
                <div class="table-cell" style="width: 70px; height: 18px;">
                    <span id="disallow_@agentItem.ChildID" class="disallow-button" onclick="AgentList.confirmUpdateDComm(false,'@idAllow',true);" onmouseout="" onmouseover="">
                    </span>
                </div>
                }
                <div class="table-cell c" style="width: 20px; height: 18px;">
                    <input id="chk_@idAllow" onclick="CustomerList.selectID()" type="checkbox" />
                </div>
            }
        </td>
        <td>
            <div id="tooltip_@agentItem.UserName" class="table-cell c display" style="width: 120px; height: 18px;text-overflow:ellipsis;">
                <span>@agentItem.UserName</span>
            </div>
        </td>
    </tr>
}
