@using Sunplus.Accounting.Core.Configurations;
@{
    bool isOfferHRFixedOdds = WebSettings.OfferHorseRacingFixedOdds;
}
<table width="100%" class="noneborder" cellpadding="0" cellspacing="0">
    <tr>
        <td class="r">
            Group A
        </td>
        <td class="l">
            <select class="selectcomm" name="listGroupA" id="listGroupA">
            </select>
        </td>
        <td class="r">
            Group B
        </td>
        <td class="l">
            <select class="selectcomm" name="listGroupB" id="listGroupB">
            </select>
        </td>
        <td class="r">
            Group C
        </td>
        <td class="l">
            <select class="selectcomm" name="listGroupC" id="listGroupC">
            </select>
        </td>
        <td class="r">
            Group D
        </td>
        <td class="l">
            <select class="selectcomm" name="listGroupD" id="listGroupD">
            </select>
        </td>
    </tr>
    <tr>
        <!--none-1x2-Comm-->
        <td class="r">
            @Resources.Language.lbl1x2Comm
        </td>
        <td class="l">
            <select class="selectcomm" name="listGroup1x2" id="listGroup1x2">
            </select>
        </td>
        <!--/none-1x2-Comm-->
        <td class="r">
            @Resources.Language.OtherComm
        </td>
        <td class="l">
            <select class="selectcomm" name="listOther" id="listOther">
            </select>
        </td>
        <!--game-comm-->
        <td class="r">
            @Resources.Language.lblGameComm
        </td>
        <td class="l">
            <select class="selectcomm" name="listGameComm" id="listGameComm">
            </select>
        </td>
        <!--/game-comm-->
        @if (isOfferHRFixedOdds)
        {
            <!--hr-fixed-odds-->
            <td class="r">
                HR Fixed Odds
            </td>
            <td class="l">
                <select class="selectcomm" name="listHRFixOddsComm" id="listHRFixOddsComm">
                </select>
            </td>
            <!--/hr-fixed-odds-->
        }
    </tr>
</table>
