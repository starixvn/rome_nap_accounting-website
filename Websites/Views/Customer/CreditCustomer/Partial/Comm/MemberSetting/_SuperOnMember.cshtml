@using Fanex.Tarus.Customer.CreditCustomer.Entities;
@using Sunplus.Accounting.Core.Configurations;
@model Fanex.Tarus.Customer.CreditCustomer.Entities.CustomerSettingView
@{
    bool isOfferHRFixedOdds = WebSettings.OfferHorseRacingFixedOdds;
    bool isShowMyanmarOdds = false;
    if (Model.IsSuperSetting && Model.IsInsertPage)
    {
        isShowMyanmarOdds = true;
    }
    else
    {
        if (!string.IsNullOrEmpty(Model.SiteName))
        {
            isShowMyanmarOdds = Model.SiteName.Equals("766666");
        }
    } 
}
<table class="tblcollapse" width="100%">
    <!--header-->
    <tr class="title">
        <td>
        </td>
        <td>@Resources.Language.CommissionForMaster
        </td>
        <td>@Resources.Language.CommissionForAgent
        </td>
        <td>@Resources.Language.CommissionForMember
        </td>
    </tr>
    <!--/header-->
    <!--HDPOUOE-->
    <tr>
        <td class="r" style="width: 25%;">@Resources.Language.lblAsianHDC_OU_OE
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting2.playerDiscount"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.discount"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.playerDiscount"></span>
        </td>
    </tr>
    <!--/HDPOUOE-->
    <!--1x2-->
    <tr>
        <td class="r" style="width: 25%;">@Resources.Language.lbl1x2
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting2.playerDiscount1x2"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.discount1x2"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.playerDiscount1x2"></span>
        </td>
    </tr>
    <!--/1x2-->
    <!--other-->
    <tr>
        <td class="r" style="width: 25%;">@Resources.Language.lblOtherBettypes
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting2.playerDiscountCs"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.discountCS"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.playerDiscountCs"></span>
        </td>
    </tr>
    <!--/other-->
    <!--game-comm-->
    <tr>
        <td class="r" style="width: 25%;">
            @Resources.Language.lblGameComm
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting2.playerDiscountNumber"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.discountNumber"></span>
        </td>
        <td>
            <span data-bind="text: customer.commissionSetting.playerDiscountNumber"></span>
        </td>
    </tr>
    <!--/game-comm-->
    @if (isOfferHRFixedOdds)
    {
        <!--hr-fixed-odds-->
        <tr>
            <td class="r" style="width: 25%;">
                HR Fixed Odds
            </td>
            <td>
                <span data-bind="text: customer.commissionSetting2.playerDiscountHRFixedOdds"></span>
            </td>
            <td>
                <span data-bind="text: customer.commissionSetting.discountHRFixedOdds"></span>
            </td>
            <td>
                <span data-bind="text: customer.commissionSetting.playerDiscountHRFixedOdds"></span>
            </td>
        </tr>
        <!--/hr-fixed-odds-->
    }
    @if (Model.IsInsertPage)
    {
    }
    @if (isShowMyanmarOdds)
    {
        <!--MyanmarOdds-->
        <tr>
            <td class="r" style="width: 25%;">
                % Odds
            </td>
            <td>
                <span data-bind="text: customer.commissionSetting2.playerDiscountMyanmarOdds"></span>
            </td>
            <td>
                <span data-bind="text: customer.commissionSetting.discountMyanmarOdds"></span>
            </td>
            <td>
                <span data-bind="text: customer.commissionSetting.playerDiscountMyanmarOdds"></span>
            </td>
        </tr>
        <!--/MyanmarOdds-->
    }
</table>
