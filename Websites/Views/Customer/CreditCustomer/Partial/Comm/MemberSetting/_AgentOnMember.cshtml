@using Fanex.Tarus.Customer.CreditCustomer.Entities;
@using Sunplus.Accounting.Core.Configurations;
@model Fanex.Tarus.Customer.CreditCustomer.Entities.CustomerSettingView
@{
    bool isShowMyanmarOdds = false;
    if (Model.IsSuperSetting && Model.IsInsertPage)
    {
        isShowMyanmarOdds = true;
    }
    else
    {
        if (!string.IsNullOrEmpty(Model.SiteName))
        {
            isShowMyanmarOdds = Model.SiteName.Equals("766666");
        }
    } 
}
<table class="tblcollapse" width="100%">
    <!--header-->
    <tr class="title">
        <td>
        </td>
        <td>
            @Resources.Language.CommissionForAgent
        </td>
        <td>
            @Resources.Language.CommissionForMember
        </td>
    </tr>
    <!--/header-->
    <!--HDPOUOE-->
    <tr>
        <td class="r" style="width: 25%;">
            @Resources.Language.lblAsianHDC_OU_OE
        </td>
        <td>
            <input class="selectcomm" type="text" id="txtHDPOUOE" name="txtHDPOUOE" disabled="disabled"
                data-bind="value: customer.commissionSetting.groupA" style="text-align: right;" />
        </td>
        <td>
            <select class="selectcomm" name="listHDPOUOE" id="listHDPOUOE">
            </select>
        </td>
    </tr>
    <!--/HDPOUOE-->
    <!--1x2-->
    <tr>
        <td class="r" style="width: 25%;">
            @Resources.Language.lbl1x2
        </td>
        <td>
            <input class="selectcomm" type="text" id="txt1X2" name="txt1X2" disabled="disabled"
                data-bind="value: customer.commissionSetting.discount1x2" style="text-align: right;" />
        </td>
        <td>
            <select class="selectcomm" name="list1X2" id="list1X2">
            </select>
        </td>
    </tr>
    <!--/1x2-->
    <!--other-->
    <tr>
        <td class="r" style="width: 25%;">
            @Resources.Language.lblOtherBettypes
        </td>
        <td>
            <input class="selectcomm" type="text" id="txtOtherBettypes" name="txtOtherBettypes"
                disabled="disabled" data-bind="value: customer.commissionSetting.discountCS"
                style="text-align: right;" />
        </td>
        <td>
            <select class="selectcomm" name="listOtherBettypes" id="listOtherBettypes">
            </select>
        </td>
    </tr>
    <!--/other-->
    <!--game-comm-->
    <tr>
        <td class="r" style="width: 25%;">
            @Resources.Language.lblGameComm
        </td>
        <td>
            <input class="selectcomm" type="text" id="txtDiscountNB" name="txtDiscountNB" disabled="disabled"
                data-bind="value: customer.commissionSetting.discountNumber" style="text-align: right;" />
        </td>
        <td>
            <select class="selectcomm" name="listGameComm" id="listGameComm">
            </select>
        </td>
    </tr>
    @if (isShowMyanmarOdds)
    {
        <!--MyanmarOdds-->
        <tr>
            <td class="r" style="width: 25%;">
                % Odds
            </td>
            <td>
                <input class="selectcomm" type="text" id="txtDiscountMyanmarOdds" name="txtDiscountMyanmarOdds"
                    disabled="disabled" data-bind="value: customer.commissionSetting.discountMyanmarOdds"
                    style="text-align: right;" />
            </td>
            <td>
                <select class="selectcomm" name="listMyanmarOdds" id="listMyanmarOdds">
                </select>
            </td>
        </tr>
        <!--/MyanmarOdds-->
    }
</table>
