@model Fanex.Tarus.Customer.Entities.NG2.SyncCurrencyModel
@{ 
    var index = 0;
}
<!DOCTYPE html>
<html>
    <head>
        <title></title>
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/common.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/table.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/input.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/image.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/Message.css")" />
        <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Report/reportgrid.css")" />
    </head>
    <body>
        <div class="main">
            <div class="maincontent">
                <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
                    <tr>
                        <td class="maincontent_headerL"></td>
                        <td class="maincontent_headerC fixfont">
                            Sync Currency
                        </td>
                        <td class="maincontent_headerR"></td>
                    </tr>
                </table>
                <div class="maincontent_box" style="width: 287px">
                    <div id="ErrMsg" style="display: none">
                    </div>
                </div>
                <div class="header-scroll">
                    <table class="tbl-body-scroll">
                        <tr class="tbl-header-scroll">
                            <td class="c" style="width: 20px; border-left: 1px solid #7C98A4"><div>#</div></td>
                            <td>
                                <div class="c" style="width:80px">
                                    Currency
                                </div>
                            </td>
                            <td>
                                <div class="c" style="width:100px">
                                    Standard Code
                                </div>
                            </td>
                            <td>
                                <div class="r" style="width:80px">
                                    Base Rate
                                </div>
                            </td>
                        </tr>
                        @foreach (var item in Model.Currencies)
                        {
                            index++;
                            var rowClass = index % 2 == 0 ? string.Empty : "evenrow";
                            <tr class="@rowClass">
                                <td class="c normal" style="border-left: 1px solid #7C98A4"><div>@index</div></td>
                                <td class="c normal">
                                    <div>@item.CurrencyName</div>
                                </td>
                                <td class="c normal">
                                    <div>@item.CurrencyCode</div>
                                </td>
                                    <td class="r normal">
                                        <div>@item.BaseRate.ToString("#,###.0000")</div>
                                </td>
                            </tr>
                        }
                        </table>
                    </div>
            </div>
        </div>
        <script type="text/javascript">
            
        </script>
    </body>
</html>