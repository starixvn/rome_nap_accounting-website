<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
@using System.Configuration;
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/common.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link href="~/App_Themes/LeftPanel/left_panel.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Report/reportgrid.css" rel="stylesheet" type="text/css" />
    <link href="~/App_Themes/Public/Message.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/Pager/pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" rel="stylesheet" type="text/css" />
    <script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/js/jQuery/Template/jquery.tmpl.js" type="text/javascript"></script>
    <script src="@Url.Content("~/js/json2.js")" type="text/javascript"></script>
    <script src="~/js/common.js" type="text/javascript"></script>
    <script src="~/js/jQuery/jquery-ui-1.8.20.custom.min.js" type="text/javascript"></script>
    <script src="~/js/BlockUI.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script src="~/js/Datetime.js" type="text/javascript"></script>
    <script src="~/js/jQuery/gridscroller.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script src="~/Views/ExchangeRate/Scripts/TabsNavigator.js?version=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script type="text/javascript" src="~/js/common.js"></script>
    <script src="@Url.Content("~/js/Message/message.js")"></script>
    <title></title>
</head>
<div class="main">
    <div class="maincontent">
        <div id="divMainHeader" style="background-color:#fff; position:fixed; width:100%; margin-top:-4px; padding-top:10px;">
            <div class="box_header" style="width: 100%;">
                <div id="left_tab1" class="left_tab" style="width: 100%">
                    <ul>
                        <li id="left_tab1_1" class="current"><a href="javascript:;"><span>Fiat Currency Exchange Rate</span></a></li>
                        <li id="left_tab1_2" style="position: relative"><a href="javascript:;"><span>Crypto Currency Exchange Rate</span>
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div id="left_tab1_1_content" style="margin-top:35px;">
            @*old name: OANDA Exchange Rate*@
            @Html.Partial("~/Views/ExchangeRate/OandaExRate.cshtml")
        </div>
        <div id="left_tab1_2_content" style="display: none;margin-top:35px">
            @Html.Partial("~/Views/ExchangeRate/CryptoExRate.cshtml")
        </div>
          <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
            @{
                if (Request["isExport"] == "1" && Request["typeExport"]=="Crypto")
                {
                    new Fanex.Tarus.ExchangeRate.Controller.ExchangeRateController().ExportExcelExDailyCrypto(Request["fdate"], Request["tdate"]);
                }
                if (Request["isExport"] == "1" && Request["typeExport"]=="Oanda")
                {
                    new Fanex.Tarus.ExchangeRate.Controller.ExchangeRateController().ExportExcelExDailyOanda(Request["fdate"], Request["tdate"]);
                }
            }
        
    </div>
</div>