@using Fanex.Tarus.Customer.Resources;
<form id="addLicenseeCode" style="display: none;">
    <div id="addLicenseeCodeErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td><label for="LicenseeName">Licensee Name:</label></td>
            <td><span id="LicenseeName" /></td>
        </tr>
        <tr>
            <td><label for="LicenseeCode">Licensee Code:</label></td>
            <td><input style="width: 180px;" id="LicenseeCode" maxlength="50"></td>
        </tr>
        <tr>
            <td><label for="newCBC">Current billing cycle:</label></td>
            <td><span id="newCBC"></span></td>
        </tr>
        <tr>
            <td><label for="NewFromDate">From date:</label></td>
            <td>
                <input class="setting-calendar" id="NewFromDate" />
                <input class="hidden" id="valueNewFromDate" />
            </td>
        </tr>
        <tr>
            <td><label for="NewToDate">To date:</label></td>
            <td>
                <input class="setting-calendar" id="NewToDate" />
                <input class="hidden" id="valueNewToDate" />
            </td>
        </tr>
        <tr>
            <td><label for="LicenseeCodeStatus">Status:</label></td>
            <td><span class="code-status" id="LicenseeCodeStatus"></span></td>
        </tr>
    </table>
</form>