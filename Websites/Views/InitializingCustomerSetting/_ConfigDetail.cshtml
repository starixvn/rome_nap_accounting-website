@using Fanex.Tarus.Customer.ViewModels.InitializingCustomerSetting
@using System.Data.Linq
@using Fanex.Tarus.Infrastructure.Caching
@using Fanex.Tarus.Customer.Resources

@model ConfigSettingViewModel
@{
    const string StatusEnable = "<p class=\"setting-status status-enable input-status-{0}\" id=\"status-{0}-{1}\" data-pos=\"{1}\" data-master=\"status-master-{1}\" data-agent=\"status-agent-{1}\" data-member=\"status-member-{1}\">Enable</p>";
    const string StatusDisable = "<p class=\"setting-status status-disable input-status-{0}\" id=\"status-{0}-{1}\" data-pos=\"{1}\" data-master=\"status-master-{1}\" data-agent=\"status-agent-{1}\" data-member=\"status-member-{1}\">Disable</p>";
}

<table class="setting-table">
    <tr class="setting-row row-header">
        <td class="setting-col col-header text-center" colspan="7">General Information</td>
    </tr>
    <tr class="setting-row row-item">
        <td class="setting-col col-item" colspan="7">
            <div class="edit-general-info floatLeft w130">
                <label class="edit-label" for="EditSiteSelect">Site<span style="color: red;">*</span>:</label>
                <select id="EditSiteSelect" class="edit-input setting-edit"></select>
            </div>
            <div class="edit-general-info floatLeft w160">
                <label class="edit-label" for="EditCurrencySelect">Currency<span style="color: red;">*</span>:</label>
                <select id="EditCurrencySelect" class="edit-input setting-edit"></select>
            </div>
            <div class="edit-general-info floatLeft w300">
                <label class="edit-label" for="EditStartTime">Start Time(GMT-4)<span style="color: red;">*</span>:</label>
                <input class="edit-input setting-calendar" id="EditStartTime" readonly type="text" title="Start Time (GMT-4)" />
                <input class="edit-input img-date-selector" onclick="return false;" alt="" id="EditStartTime_Trigger" title="Date selector"
                       width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
            </div>
            <div class="edit-general-info floatLeft w80">
                <input id="ckbEditIsTest" type="checkbox" class="edit-input" /><span>Is Test</span>
            </div>
            <div class="clear"></div>
            <div class="edit-general-info floatLeft w400">
                <label class="edit-label" for="EditRemark">Remark:</label>
                <textarea id="EditRemark" class="edit-input" cols="80"></textarea>
            </div>
        </td>
    </tr>
    @foreach (var groups in Model.GroupSettings)
    {
        <tr class="setting-row row-header">
            <td class="setting-col col-header text-center" colspan="7">@groups.FirstOrDefault().SettingName - @groups.Key</td>
        </tr>
        foreach (var setting in groups)
        {

            <!-- Product Status -->
            if (setting.SettingName == "Product Status")
            {
                var statussuper = setting.DefaultValueSuper != "" && (int)Convert.ToDouble(setting.DefaultValueSuper) == 1 ? string.Format(StatusEnable, "super", setting.SettingId) : string.Format(StatusDisable, "super", setting.SettingId);
                var statusmaster = setting.DefaultValueMaster != "" && (int)Convert.ToDouble(setting.DefaultValueMaster) == 1 ? string.Format(StatusEnable, "master", setting.SettingId) : string.Format(StatusDisable, "master", setting.SettingId);
                var statusagent = setting.DefaultValueAgent != "" && (int)Convert.ToDouble(setting.DefaultValueAgent) == 1 ? string.Format(StatusEnable, "agent", setting.SettingId) : string.Format(StatusDisable, "agent", setting.SettingId);
                var statusmember = setting.DefaultValueMember != "" && (int)Convert.ToDouble(setting.DefaultValueMember) == 1 ? string.Format(StatusEnable, "member", setting.SettingId) : string.Format(StatusDisable, "member", setting.SettingId);

                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="6">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="6">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbDefault" + setting.SettingId)" class="edit-input ckb-default" type="checkbox" @setting.CheckBoxDefault data-pos=@setting.SettingId />Default</td>
                    <td class="setting-col col-item">Super</td>
                    <td class="setting-col col-item">Master</td>
                    <td class="setting-col col-item">Agent</td>
                    <td class="setting-col col-item">Member</td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item ">@Html.Raw(statussuper)</td>
                    <td class="setting-col col-item">@Html.Raw(statusmaster)</td>
                    <td class="setting-col col-item">@Html.Raw(statusagent)</td>
                    <td class="setting-col col-item">@Html.Raw(statusmember)</td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />Copy From</td>
                    <td class="setting-col col-item">Sport Type</td>
                    <td class="setting-col col-item">Bet Type</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item">
                    <td class="setting-col col-item text-center" rowspan="2">Disable by default</td>
                    <td class="setting-col col-item" colspan="4">Headline (seperate bt commas ',')</td>
                </tr>
                <tr class="setting-row row-item">
                    <td class="setting-col col-item" colspan="4"><textarea class="edit-input input-headline" cols="75" data-pos=@setting.SettingId>@setting.SpecialRequirement</textarea></td>
                </tr>
            }
            else if (setting.SettingName == "Bet Setting")
            {
                <!-- Bet Setting -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="2">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />Copy From</td>
                    <td class="setting-col col-item">Sport Type</td>
                    <td class="setting-col col-item">Bet Type</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
            }
            else if (setting.SettingName == "Commission")
            {
                <!-- Commission -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="4">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="4">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbDefault" + setting.SettingId)" class="edit-input ckb-default" type="checkbox" @setting.CheckBoxDefault data-pos=@setting.SettingId />Default</td>
                    <td class="setting-col col-item">Super</td>
                    <td class="setting-col col-item">Master</td>
                    <td class="setting-col col-item">Agent</td>
                    <td class="setting-col col-item">Member</td>
                </tr>
                <tr class="setting-row row-item">
                    <td class="setting-col col-item"><input class="@("edit-input input-com-super input-default-" + setting.SettingId)" type="text" value="@setting.DefaultValueSuper" data-pos=@setting.SettingId @setting.DisableDefault /></td>
                    <td class="setting-col col-item"><input class="@("edit-input input-com-master input-default-" + setting.SettingId)" type="text" value="@setting.DefaultValueMaster" data-pos=@setting.SettingId @setting.DisableDefault /></td>
                    <td class="setting-col col-item"><input class="@("edit-input input-com-agent input-default-" + setting.SettingId)" type="text" value="@setting.DefaultValueAgent" data-pos=@setting.SettingId @setting.DisableDefault /></td>
                    <td class="setting-col col-item"><input class="@("edit-input input-com-member input-default-" + setting.SettingId)" type="text" value="@setting.DefaultValueMember" data-pos=@setting.SettingId @setting.DisableDefault /></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />Copy From</td>
                    <td class="setting-col col-item">Sport Type</td>
                    <td class="setting-col col-item">Bet Type</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
            }
            else if (setting.SettingName == "Loss Limit")
            {
                <!-- Loss Limit -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="4">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="4">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbDefault" + setting.SettingId)" class="edit-input ckb-default" type="checkbox" @setting.CheckBoxDefault data-pos=@setting.SettingId />Default</td>
                    <td class="setting-col col-item">Maximum Loss</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbAutoReset" + setting.SettingId)" class="@("edit-input ckb-auto-reset input-default-" + setting.SettingId)" type="checkbox" @setting.CheckBoxAutoReset data-pos=@setting.SettingId @setting.DisableDefault />Daily auto reset limit (at 12 noon GMT+8)</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">Apply Global Setting</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />Copy From</td>
                    <td class="setting-col col-item">Sport Type</td>
                    <td class="setting-col col-item">Bet Type</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
            }
            else if (setting.SettingName == "Position Taking")
            {
                <!-- Position Taking -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="2">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />Copy From</td>
                    <td class="setting-col col-item">Sport Type</td>
                    <td class="setting-col col-item">Bet Type</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
            }
            else if (setting.SettingName == "Stake Level")
            {
                <!-- Stake Level -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="2">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbDefault" + setting.SettingId)" class="edit-input ckb-default" type="checkbox" @setting.CheckBoxDefault data-pos=@setting.SettingId />Default</td>
                    <td class="setting-col col-item">Super</td>
                    <td class="setting-col col-item">Master</td>
                    <td class="setting-col col-item">Agent</td>
                    <td class="setting-col col-item">Member</td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">Full Stake Levels</td>
                    <td class="setting-col col-item">Full Stake Levels</td>
                    <td class="setting-col col-item">Full Stake Levels</td>
                    <td class="setting-col col-item">Lowest Stake Levels</td>
                </tr>
            }
            else if (setting.SettingName == "Win Loss Limit")
            {
                <!-- Win Loss Limit -->
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="4">[@setting.SportType] @setting.SportName</td>
                    <td class="setting-col col-item" rowspan="4">[@setting.BetType] @setting.BetTypeName</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbDefault" + setting.SettingId)" class="edit-input ckb-default" type="checkbox" @setting.CheckBoxDefault data-pos=@setting.SettingId />Default</td>
                    <td class="setting-col col-item">Maximum Win</td>
                    <td class="setting-col col-item">Maximum Loss</td>
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbAutoReset" + setting.SettingId)" class="@("edit-input ckb-auto-reset input-default-" + setting.SettingId)" type="checkbox" @setting.CheckBoxAutoReset data-pos=@setting.SettingId @setting.DisableDefault />Daily auto reset limit (at 12 noon GMT+8)</td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        <select class="@("edit-input max-winloss input-default-" + setting.SettingId)" data-pos=@setting.SettingId @setting.DisableDefault>
                            <option value="3">3X</option>
                            <option value="5">5X</option>
                            <option value="10">10X</option>
                            <option value="0">Unlimited</option>
                        </select>
                        <span>on given credit</span>
                    </td>
                    <td class="setting-col col-item">Apply Global Setting</td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item" rowspan="2"><input id="@("ckbCopy" + setting.SettingId)" class="edit-input ckb-copy" type="checkbox" @setting.CheckBoxCopy data-pos=@setting.SettingId />Copy From</td>
                    <td class="setting-col col-item">Sport Type</td>
                    <td class="setting-col col-item">Bet Type</td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
                <tr class="setting-row row-item text-center">
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetSportType,
                            setting.SportTypeOptions,
                            new
                            {
                                @class = "edit-input sel-sport-copy input-copy-" + setting.SettingId,
                                @data_target_settingtype = setting.SettingName.Replace(" ", string.Empty).ToLowerInvariant(),
                                @data_target_bettype = setting.TargetBetType,
                                @data_pos = setting.SettingId,
                                @disabled = setting.DisableCopy
                            })
                    </td>
                    <td class="setting-col col-item">
                        @Html.DropDownList(setting.TargetBetType,
                        setting.BetTypeOptions,
                        new
                        {
                            @class = "edit-input sel-bettype-copy input-copy-" + setting.SettingId,
                            @data_pos = setting.SettingId,
                            @disabled = setting.DisableCopy
                        })
                    </td>
                    <td class="setting-col col-item"></td>
                    <td class="setting-col col-item"></td>
                </tr>
            }

        }
    }
</table>
<script>
    selectedConfig = @Html.Raw(Json.Encode(Model));
</script>