<form id="addConfig" style="display: none;">
    <div style="display: flex;">
        <div class="filterBox" style="border: solid 1px #7C98A4; float: left;">
            <div class="filterContent">
                <div class="floatLeft w200">
                    <label for="NCProduct">Product<spam class="color:red;">*</spam></label>
                    <select id="NCProduct" class="setting-edit"></select>
                </div>
                <div class="floatLeft w200">
                    <label for="NCSportType">Sport Type</label>
                    <select id="NCSportType" class="setting-edit"></select>
                </div>
                <div class="floatLeft w200">
                    <label for="NCBetType">Bet Type</label>
                    <select id="NCBetType" class="setting-edit"></select>
                </div>
                <div class="floatLeft w200">
                    <input type="checkbox" id="NCIsTest" /><span>IsTest</span>
                </div>
                <div class="clear"></div>
                <div class="floatLeft w200">
                    <label for="NCSite">Site</label>
                    <select id="NCSite" class="setting-edit"></select>
                </div>
                <div class="floatLeft w200">
                    <label for="NCCurrency">Currency</label>
                    <select id="NCCurrency" class="setting-edit"></select>
                </div>
                <div class="floatLeft w200">
                    <input class="setting-calendar" id="UMShowTime" readonly type="text" placeholder="ShowTime (GMT+8)" title="ShowTime (GMT+8)" />
                    <input class="img-date-selector" onclick="return false;" alt="" id="UMShowTime_Trigger" title="Date selector"
                           width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
                </div>
                <div class="floatLeft w200">
                    <input class="setting-calendar" id="UMBeginTime" readonly type="text" placeholder="BeginTime (GMT+8)" title="BeginTime (GMT+8)" />
                    <input class="img-date-selector" onclick="return false;" alt="" id="UMBeginTime_Trigger" title="Date selector"
                           width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
                </div>
                <div class="floatLeft w200">
                    <input class="setting-calendar" id="UMEndTime" readonly type="text" placeholder="EndTime (GMT+8)" title="EndTime (GMT+8)" />
                    <input class="img-date-selector" onclick="return false;" alt="" id="UMEndTime_Trigger" title="Date selector"
                           width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
                </div>
                <div class="floatLeft" w200>
                    <label for="UMLockAddingNew">LockAddingNew</label>
                    <input id="UMLockAddingNew" type="checkbox" />

                </div>
                <div class="clear"></div>
                <div class="floatLeft" style="box-sizing: border-box; width: 100%;"><textarea id="UMUsername" rows="2" placeholder="Username" style="width:100%;"></textarea></div>
            </div>
        </div>
        <div style="position: relative; display:flex; width: 45px">
            <img alt="Add" title="Add" class="icon-add-um" src="../App_Themes/Images/icn_add.png" onclick="AddNewUMConfig()" />
        </div>
    </div>

    <div style="clear: both"></div>
    <div id="addLicenseeCodeErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td><label for="LicenseeName">Licensee Name:</label></td>
            <td><span id="LicenseeName" /></td>
        </tr>
        <tr>
            <td><label for="LicenseeCode">Licensee Code:</label></td>
            <td><input style="width: 180px;" id="LicenseeCode" maxlength="50"></td>
        </tr>
        <tr>
            <td><label for="newCBC">Current billing cycle:</label></td>
            <td><span id="newCBC"></span></td>
        </tr>
        <tr>
            <td><label for="NewFromDate">From date:</label></td>
            <td>
                <input class="setting-calendar" id="NewFromDate" />
                <input class="hidden" id="valueNewFromDate" />
            </td>
        </tr>
        <tr>
            <td><label for="NewToDate">To date:</label></td>
            <td>
                <input class="setting-calendar" id="NewToDate" />
                <input class="hidden" id="valueNewToDate" />
            </td>
        </tr>
        <tr>
            <td><label for="LicenseeCodeStatus">Status:</label></td>
            <td><span class="code-status" id="LicenseeCodeStatus"></span></td>
        </tr>
    </table>
</form>