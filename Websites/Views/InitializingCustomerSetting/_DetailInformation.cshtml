<div id="detail-information-popup" style="display: none;">
    <div id="filterDiv" style="display: flex; width:100%;">
        <div class="filterBox" style="border: solid 1px #7C98A4; width:100%">
            <div class="filterContent">
                <div class="floatLeft w200">
                    <label for="EditProductSelect">Product:</label>
                    <select id="EditProductSelect" class="setting-edit">
                        <option value="" disabled selected>Please select</option>
                    </select>
                </div>
                <div class="floatLeft w200">
                    <label for="EditSportSelect">Sport:</label>
                    <select id="EditSportSelect" class="setting-edit">
                        <option value="" disabled selected>Please select</option>
                    </select>
                </div>
                <div class="floatLeft w200">
                    <label for="EditBettypeSelect">Bettype:</label>
                    <select id="EditBettypeSelect" class="setting-edit">
                        <option value="" disabled selected>Please select</option>
                    </select>
                </div>
            </div>
            <div class="floatLeft w100">
                <input id="btnRenderNewConfig" type="button" value="Search" class="btn btn-edit">
            </div>
        </div>
    </div>
    <div style="clear: both"></div>
    <div id="editErrMsg" style="margin-top: 20px; word-break: break-all;"></div>
    <div id="editContainer" class="grid-container">
        <div id="grid-information" class="freegrid"></div>
        <div style="text-align: center">
            <input id="btn-edit" class="btn btn-edit" type="button" value="Update" onclick="UpdateConfigModel();" />
            <input id="btn-add" class="btn btn-edit" type="button" value="Add" onclick="ValidateNewConfigModel();" />
        </div>
    </div>
</div>