                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.AgentPT
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        betdetail = Model[0];
                        @MvcHtmlString.Create(renderResult[1])
                    }
                    else
                    {
                        <tr class="c">
                            <td colspan="11">
                                <div class="c b" style="margin-left: 60px;">
                                    @Resources.NewBetList.NoInformation
                                </div>
                            </td>
                        </tr>
                        betdetail.Ticket = new Ticket { CustId = 0 };
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="@Url.Content("~/Views/BetList/Scripts/LanguageDropdownList.js?ver=" + AccCommon.Version())" type="text/javascript"></script>
<script type="text/javascript">
    var _custid = @betdetail.Ticket.CustId;
    var _accId = '@Fanex.Tarus.Infrastructure.Common.AppSession.AccId';
    var resultTitle = '@ViewBag.ResultTitle';
    $(document).ready(function () {
        BetList.LanguageDropdownList.init(BetList.BetListByRefNo.getBetList);
    });

</script>

