@using Fanex.BetList.Core.Entities
@using Fanex.Tarus.BetList.Models
@using Fanex.Tarus.BetList.Constants
@model IList<TicketDetail>
@{
    TicketDetail betdetail = new TicketDetail();
    if (Model != null && Model.Count > 0)
    {
        betdetail = Model[0];
    }

    string[] renderResult = Render();
}
@functions {
    public string[] Render()
    {
        string[] result = new string[2];
        int rowNo = 0;
        foreach (TicketDetail betdetail in Model)
        {
            result[1] += RenderContent(++rowNo, betdetail);
        }
        return result;
    }

}
@helper RenderContent(int rowNo, TicketDetail betdetail)
{
    <tr class="c">
        <td>
            <div class="c width50 table-cell">
                @rowNo
            </div>
        </td>
        <td>
            <div class="c width100 table-cell">
                @if (betdetail.Ticket.UserName.Length > 13)
                {
                    string usernameTmp = betdetail.Ticket.UserName;
                    string firstSubstring = usernameTmp.Substring(0, 13);
                    string secondSubstring = usernameTmp.Substring(13, betdetail.Ticket.UserName.Length - 13);
                    <div class="b">
                        @firstSubstring<br />@secondSubstring
                    </div>
                }
                else
                {
                    <div class="b">@betdetail.Ticket.UserName</div>
                }
                <div class="custId">@betdetail.Ticket.CustId</div>
            </div>
        </td>
        <td class="c">
            <div class="width120 table-cell refno">
                @Html.Raw(betdetail.TransDateHtml)
            </div>
        </td>
        <td class='r bl_evt'>
            <div id="choice_right_@betdetail.Ticket.TransId" class="width250  table-cell">
                @Html.Raw(betdetail.ChoiceHtml)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div id="odd" class="width50 table-cell">
                @Html.Partial("~/Views/BetList/_Odds.cshtml", betdetail)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width50 table-cell">
                @Html.Raw(betdetail.StakeHtml)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_WinLoss.cshtml", betdetail)
            </div>
        </td>
        <td class="c">
            <div id="stautus" class="width100 table-cell">
                @Html.Raw(betdetail.StatusHtml)
                @if (betdetail.Ticket.BetTypeId == BetTypeContants.BetTradeSold)
                {
                    <a onclick="ViewBettradeDetails(@betdetail.Ticket.TransId, @betdetail.Ticket.RefNo)">@Resources.BetList.details</a>
                }
                @{
                    var ip = @Sunplus.Accounting.Business.IpManagement.ReplaceVNIP(betdetail.Ticket.IP);
                }
                @if (ip != "-" && !betdetail.Ticket.BetTypeId.Equals(500))
                {
                    <br />
                    <a href="@Url.Action("BetListByIP", "TarusBetList", new {IsLink = true, FromDate = betdetail.Ticket.WinlostDate.ToString("MM/dd/yyyy"), IP = betdetail.Ticket.IP})">@ip</a>
                }
            </div>
        </td>
        <td class="r">
            <div id="comm" class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_SuperPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_MasterPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_AgentPTCom.cshtml", betdetail)
            </div>
        </td>
    </tr>
}
