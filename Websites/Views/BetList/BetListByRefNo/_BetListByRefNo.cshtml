                                @Resources.NewBetList.Username
                            </div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                @Resources.NewBetList.Date
                            </div>
                        </th>
                        <th>
                            <div class="width300 height34 table-cell">
                                @Resources.NewBetList.Choice
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Odds
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Stake
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.WinLoss
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Status
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.SuperPT
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.MasterPT
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.AgentPT
                            </div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="tblContent" class="grid-fixed-table col_header_content ">
                <thead>
                    <tr>
                        <th>
                            <div class="width50 height34 table-cell">
                                #
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Username
                            </div>
                        </th>
                        <th>
                            <div class="width120 height34 table-cell">
                                @Resources.NewBetList.Date
                            </div>
                        </th>
                        <th>
                            <div class="width300 height34 table-cell">
                                @Resources.NewBetList.Choice
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Odds
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Stake
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.WinLoss
                            </div>
                        </th>
                        <th>
                            <div class="width100 height34 table-cell">
                                @Resources.NewBetList.Status
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.SuperPT
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                @Resources.NewBetList.MasterPT
                            </div>
