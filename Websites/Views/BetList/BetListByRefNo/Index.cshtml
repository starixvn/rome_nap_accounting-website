@using Sunplus.Accounting.Business.Security;
@using Sunplus.Accounting.Core.Common;
@using Sunplus.Accounting.Core.Configurations;
@using System.Configuration;
@using Fanex.Tarus.BetList.ViewModel;
@using Fanex.Tarus.Infrastructure.Caching;

@model  BetListByRefNoViewModel
@{
    var allowedProducts = new System.Text.StringBuilder();
    allowedProducts.Append("Casino/Keno/Metricgaming/Colossus Bets/AG Casino/Macau Games/Allbet/ION/AE Sexy/IBCBet Live Casino")
        .Append("/WM")
        .Append("/BG")
        .Append("/PP Live Casino")
        .Append("/Lottery/Table Game");

    var productIdPP = Fanex.Tarus.Infrastructure.Configurations.AppSettings.ProductIdPP;
    if (productIdPP != 0)
    {
        allowedProducts.Append("/").Append(CacheRef.GetProductName(productIdPP));
    }
    var productIdCardClub = ConfigurationManager.AppSettings["ProductIdCardClub"];
    if (!string.IsNullOrEmpty(productIdCardClub))
    {
        allowedProducts.Append("/").Append(CacheRef.GetProductName(int.Parse(productIdCardClub)));
    }

    var productIdSG = ConfigurationManager.AppSettings["ProductIdSG"];
    if (!string.IsNullOrEmpty(productIdSG))
    {
        allowedProducts.Append("/").Append("SG");
    }
    var productIdVirtualGames = 38;
    if (productIdVirtualGames != 0)
    {
        allowedProducts.Append("/").Append(CacheRef.GetProductName(productIdVirtualGames));
    }

    allowedProducts.Append("/").Append(CacheRef.GetProductName(42));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(66));
    allowedProducts.Append("/Togel 4D");
    allowedProducts.Append("/").Append(CacheRef.GetProductName(50));
    allowedProducts.Append("/PG Soft");
    allowedProducts.Append("/Joker");
    allowedProducts.Append("/Happy 5 Linked Games");
    allowedProducts.Append("/MaxGame");
    allowedProducts.Append("/Sports Lottery");
    allowedProducts.Append("/Habanero");
    allowedProducts.Append("/CG");
    allowedProducts.Append("/").Append(CacheRef.GetProductName(67));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(68));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(70));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(72));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(73));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(75));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(76));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(80));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(79));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(78));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(86));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(87));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(89));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(85));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(96));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(100));
    allowedProducts.Append("/").Append(CacheRef.GetProductName(48));

    var productResultRelatedByGameId = new System.Text.StringBuilder();
    productResultRelatedByGameId.Append("Allbet/SA Gaming/AE Sexy/IBCBet Live Casino/BBIN/WM/BG/FGG/YeeBet/WE Live Casino");
    productResultRelatedByGameId.Append("/").Append(CacheRef.GetProductName(96));

}
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
    <style type="text/css">
        .filterContent table {
            line-height: 20px;
        }

            .filterContent table td {
                text-align: right;
            }

        .filterContent .label {
            font-weight: bold;
        }

        .filterContent .info-msg {
            font-weight: bold;
            color: #979797;
        }

        .filterContent input[type="text"], .filterContent select {
            box-sizing: border-box;
            width: 100% !important;
            height: 18px;
        }

        .text-left {
            text-align: left !important;
        }

        .search-by-ref input[type='text']:disabled, .search-by-product input[type="text"]:disabled, .search-by-product select:disabled {
            background-color: #D9D9D9;
        }
    </style>
</head>
<body>
    <div class="main">
        <div id="divMainHeader" class="">
            <div id="left_tab1">
                <ul>
                    <li class="lefticon"></li>
                    <li class="current"><span>Bet List</span></li>
                </ul>
            </div>
        </div>
        <div class="maincontent">
            <div class="filterBox">
                <div id="bet-list-ref-no" class="filterContent">
                    <table>
                        <colgroup>
                            @* Im not able to set min-width!!! https://bugs.chromium.org/p/chromium/issues/detail?id=50169 *@
                            <col style="width: 20px">
                            <col style="width: 100px;">
                            <col style="width: 150px">
                            <col style="width: 90px">
                            <col style="width: 150px">
                            <col style="width: 150px">
                            <col style="width: 120px">
                            <col style="width: 60px">
                            <col style="width: 150px">
                        </colgroup>
                        <tr class="search-by-ref">
                            <td>
                                <input type="radio" id="rdByRef" name="search-type" value="1" checked />
                            </td>
                            <td class="text-left">
                                <label class="label" for="rdByRef">By Ref No</label>
                            </td>
                            <td>
                                <input type="text" id="txtRefNo" />
                            </td>
                            <td><span style="float: left;" id="iNoteMessageInfo" class="note-info-message" title=""></span></td>
                        </tr>
                        <tr class="search-by-product">
                            <td>
                                <input type="radio" id="rdByProduct" name="search-type" value="2" />
                            </td>
                            <td style="min-width: 100px">
                                <label class="label" for="rdByProduct">Advance: Product </label>
                            </td>
                            <td>
                                <select id="selProduct">
                                    <option value="-1"> Please select...</option>
                                    <option value="22">Macau Games</option>
                                    <option value="21">Allbet</option>
                                    <option value="52">ION</option>
                                    <option value="39">SA Gaming</option>
                                    <option value="45">AE Sexy</option>
                                    <option value="47">BBIN</option>
                                    <option value="46">IBCBet Live Casino</option>
                                    @if (productIdPP != 0)
                                    {
                                        <option value="@productIdPP">@CacheRef.GetProductName(productIdPP)</option>
                                    }
                                    @if (!string.IsNullOrEmpty(productIdCardClub))
                                    {
                                        <option value="@productIdCardClub" data-vendor-id="33">@CacheRef.GetProductName(int.Parse(productIdCardClub))</option>
                                    }
                                    @if (!string.IsNullOrEmpty(productIdSG))
                                    {
                                        <option value="@productIdSG" data-vendor-id="36">SG</option>
                                    }
                                    @if (productIdVirtualGames != 0)
                                    {
                                        <option value="@productIdVirtualGames">@CacheRef.GetProductName(productIdVirtualGames)</option>
                                    }
                                    <option value="42">@CacheRef.GetProductName(42)</option>
                                    <option value="55">@CacheRef.GetProductName(55)</option>
                                    <option value="51">@CacheRef.GetProductName(51)</option>
                                    <option value="56">@CacheRef.GetProductName(56)</option>
                                    <option value="57">@CacheRef.GetProductName(57)</option>
                                    <option value="60">@CacheRef.GetProductName(60)</option>
                                    <option value="63">@CacheRef.GetProductName(63)</option>
                                    <option value="65">@CacheRef.GetProductName(65)</option>
                                    <option value="61">@CacheRef.GetProductName(61)</option>
                                    <option value="62">@CacheRef.GetProductName(62)</option>
                                    <option value="66">@CacheRef.GetProductName(66)</option>
                                    <option value="67">@CacheRef.GetProductName(67)</option>
                                    <option value="68">@CacheRef.GetProductName(68)</option>
                                    <option value="70">@CacheRef.GetProductName(70)</option>
                                    <option value="72">@CacheRef.GetProductName(72)</option>
                                    <option value="73">@CacheRef.GetProductName(73)</option>
                                    <option value="75">@CacheRef.GetProductName(75)</option>
                                    <option value="76">@CacheRef.GetProductName(76)</option>
                                    <option value="80">@CacheRef.GetProductName(80)</option>
                                    <option value="79">@CacheRef.GetProductName(79)</option>
                                    <option value="78">@CacheRef.GetProductName(78)</option>
                                    <option value="86">@CacheRef.GetProductName(86)</option>
                                    <option value="87">@CacheRef.GetProductName(87)</option>
                                    <option value="89">@CacheRef.GetProductName(89)</option>
                                    <option value="85">@CacheRef.GetProductName(85)</option>
                                    <option value="96">@CacheRef.GetProductName(96)</option>
                                    <option value="100">@CacheRef.GetProductName(100)</option>
                                    <option value="48">@CacheRef.GetProductName(48)</option>

                                </select>
                            </td>
                            <td style="min-width: 65px">
                                <label class="label">PlayerID</label>
                            </td>
                            <td>
                                <input type="text" id="txtPlayerId" />
                            </td>
                            <td style="min-width: 65px">
                                <label class="label">PlayerID (3rd)</label>
                            </td>
                            <td>
                                <input type="text" id="txtPlayerId3rd" />
                            </td>
                            <td style="min-width: 95px">
                                <label class="label">Username</label>
                            </td>
                            <td>
                                <input type="text" id="txtUsername" />
                            </td>
                        </tr>
                        <tr class="search-by-product">
                            <td></td>
                            <td>
                                <label class="label">GameID (3rd)</label>
                            </td>
                            <td>
                                <input type="text" id="txtGameId" />
                            </td>
                            <td>
                                <label class="label">BetID (3rd)</label>
                            </td>
                            <td>
                                <input type="text" id="txtBetId" />
                            </td>
                            <td>
                                <label class="label">Event Date From </label>
                            </td>
                            <td>
                                <input id="txtfromdate" class="txtdate" type="text" data-balance-up-day="@Model.BalanceUpDay" />
                            </td>
                            <td>
                                <label class="label">To</label>
                            </td>
                            <td>
                                <input id="txttodate" class="txtdate" type="text" />
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td class="text-left">
                                <input class="btn" type="button" id="btnReport" value="Submit" />
                            </td>
                        </tr>
                    </table>
                    <div id="errMsg" style="display: none">
                        <div class="alertboxerr">
                            <div class="msg"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="betListContent" style="margin-top: 10px;">
        </div>
    </div>
    <div id="Popup" style="display: none">
    </div>
    <form id="noteMessage" style="display:none;">
        @allowedProducts.ToString() tickets with win loss dates from @Model.BalanceUpDay.ToShortDateString() are supported.
        For @productResultRelatedByGameId.ToString(), the search result includes the related tickets with the same GameID.<br />
        For Sportsbook, the search result includes the related Bonus/Cash tickets.
    </form>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
                head.js("@Url.Content("~/js/jQuery/jquery.js")",                
                "@Url.Content("~/js/json2.js")",
                "@Url.Content("~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js?ver=1")",
                "@Url.Content("~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js")",
                "@Url.Content("~/js/IBCWnd/IBCWnd.js")",
                "@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js")",
                "@Url.Content("~/js/BlockUI.js")",
                "@Url.Content("~/js/dialogbox.js")",
                "@Url.Content("~/js/common.js")",
                "@Url.Content("~/js/BetList.js?v=")@WebSettings.Version",
                "@Url.Content("~/Areas/AGCasino/Views/BetDetails/Scripts/BetDetails.js?v=")@WebSettings.Version",
                "@Url.Content("~/Views/BetList/BetListByRefNo/Scripts/BetListByRefNo.js?ver=")@WebSettings.Version",
                "@Url.Content("~/Views/BetList/Scripts/BetlistGlobal.js?ver=")@WebSettings.Version");
    </script>
</body>
</html>