@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Accounting.Extensions;
@using Fanex.BetList.Accounting.Core;
@model IList<TicketDetail>
@{
    BetListHelper betlistHelper = new BetListHelper();
}
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css" />

    <style type="text/css">
        .filterContent table {
            line-height: 20px;
        }

            .filterContent table td {
                text-align: right;
            }

        .filterContent .label {
            font-weight: bold;
        }

        .filterContent .info-msg {
            font-weight: bold;
            color: #979797;
        }

        .filterContent input[type="text"], .filterContent select {
            box-sizing: border-box;
            width: 100% !important;
            height: 18px;
        }

        .text-left {
            text-align: left !important;
        }

        .search-by-ref input[type='text']:disabled, .search-by-product input[type="text"]:disabled, .search-by-product select:disabled {
            background-color: #D9D9D9;
        }
    </style>
    <title>Details</title>
</head>
<body>
    <div class="col_header row-headers-background freegrid">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        <th>
                            <div class="width120 height34 table-cell">
                                Date
                            </div>
                        </th>
                        <th>
                            <div class="width250 height34 table-cell">
                                Choice
                            </div>
                        </th>
                        <th>
                            <div class="width50 height34 table-cell">
                                Odds
                            </div>
                        </th>
                        <th>
                            <div class="width50 height34 table-cell">
                                Stake
                            </div>
                        </th>
                        <th>
                            <div class="width60 height34 table-cell">
                                Sold
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count <= 0)
            {
                        <tr class="c">
                            <td colspan="9">
                                <div class="c b" style="margin-left: 60px;">
                                    There is no data
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="c">
                            <td class="c">
                                <div class="width120 table-cell refno">
                                    @Html.Raw(Model[0].TransDateHtml)
                                </div>
                            </td>
                            <td class='r bl_evt'>
                                <div id="choice_right" class="width250  table-cell">
                                    @Html.Raw(Model[0].ChoiceHtml)
                                </div>
                            </td>
                            <td class='r bl_underdog'>
                                <div id="odd" class="width50 table-cell">
                                    @Html.Partial("~/Views/BetList/_Odds.cshtml", Model[0])
                                </div>
                            </td>
                            <td class='r bl_underdog'>
                                <div class="width50 table-cell">
                                    @Html.Raw(Model[0].StakeHtml)
                                </div>
                            </td>
                            <td class="r">
                                <div class="width60 table-cell">
                                    <div class="@betlistHelper.IsNegative(Model[0].Ticket.Winlost)">
                                        @Model[0].Ticket.Winlost.Format(2)
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
