@using Fanex.Tarus.BetList.Entities;
     
@{
    var isCredit = (bool)ViewBag.IsCredit;
    var ticketStatus = (IEnumerable<SelectListItem>)ViewBag.TicketStatus;
    var bookedStatus = (IEnumerable<SelectListItem>)ViewBag.BookedStatus;
    var shadowAccounts = (IEnumerable<ShadowAccountModel>)ViewBag.ShadowAccount;

}
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
    <link rel="stylesheet" type="text/css" href="~/App_Themes/Public/Message.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link href="~/js/MultipleSelect/jquery.multiselect.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css?ver=@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/BetlistByCustInfo/Style/BetListByCustInfo.css?ver=1@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <div id="boxheader">
                <div class="left_tab" style="width: 400px">
                    <ul>
                        <li class="current" id="Li1" onclick="BetListByCustInfo.viewBetListTab();">
                            <a href="javascript:;">
                                <span>Bet list</span>
                            </a>
                        </li>
                        <li class="" id="Li2" onclick="BetListByCustInfo.viewSystemParlayTab();">
                            <a href="javascript:;">
                                <span>System parlay</span>
                            </a>
                        </li>
                        @if (isCredit)
                        {
                            <li class="" id="Li3" onclick="BetListByCustInfo.viewExchangeTab();">
                                <a href="javascript:;">
                                    <span>Exchange</span>
                                </a>
                            </li>
                        }
                        <li class="" id="Li4" onclick="BetListByCustInfo.viewBookedBetTab();">
                            <a href="javascript:;">
                                <span>Booked Bet</span>
                            </a>
                        </li>
                        @if ((bool)ViewBag.showSabaCoinTab)
                        {
                            <li class="" id="Li5" onclick="BetListByCustInfo.viewSabaCoinsTab();">
                                <a href="javascript:;">
                                    <span>Saba Coins</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div id="maincontent_betlist" class="maincontent_box" style="width: 100%;">
                <div>
                    <input onclick="BetListByCustInfo.disabledFilter();" type="radio" id="rdByRef" value="-1" name="type" />
                    <label style="font-weight: bold" for="rdByRef">By Ref No:</label>
                    <input id="txtRefNo" type="text" maxlength="19" style="background-color: #fff; width: 130px;" autocomplete="off" onkeypress="return KeyPress(event);" />
                    <div id="info-msg" class="info-msg hide">
                        For Sportsbook, the search result includes the related Bonus/Cash tickets.<br />
                        For Casino products, tickets can only be found within the last 6 months.
                    </div>
                </div>
                <div>
                    <input onclick="BetListByCustInfo.disabledFilter();" type="radio" id="rdByUser" value="-2" name="type" checked="checked" />
                    <label style="font-weight: bold" for="rdByUser">Advance (Event Date):</label>
                    <span style="font-weight: bold">From </span>
                    <span style="padding-left: 5px">
                        <input id="txtfromdate" class="txtdate" readonly="readonly" />
                    </span>
                    <span class="b" style="padding-left: 5px">To</span>
                    <span style="padding-left: 5px">
                        <input id="txttodate" class="txtdate" readonly="readonly" />
                    </span>
                    <span style="padding-left: 10px">Status</span>
                    <span style="padding-left: 5px">
                        <span id="ddlStatus" class="multiselect" multiple="multiple">
                        </span>
                    </span>
                    <span id="divBettype" class="hidden" style="padding-left: 5px">
                        <span>Bettypes </span>
                        <select id="ddlBettype" name="FilterBy"></select>
                    </span>
                </div>
                <div>
                    <input class="btn" type="button" id="btnReport" value="Submit" onclick="BetListByCustInfo.getBetListByCustInfo(false);" />
                    <input class="btn" type="button" id="btnToday" value="Reset" onclick="Helper.reset_date();" />
                </div>
                <div id="err">
                </div>
            </div>
            <div class="maincontent_box hidden" id="maincontent_systemparlay">
                <table>
                    <tr>
                        <td style="font-weight: bold;">
                            By Ref No
                        </td>
                        <td>
                            <input type="text" id="txtRefNoSystemParaly" value="" />
                        </td>
                        <td>
                            <input type="button" id="btnSubmit" value="Submit" class="btn" onclick="BetListByCustInfo.getBetListSystemParlay();" />
                        </td>
                    </tr>
                </table>
                <div id="errMsg2">
                </div>
            </div>

            <div class="maincontent_box hidden" id="maincontent_exchange">
                <div>
                    <input onclick="BetListByCustInfo.disabledFilter_Exchange();" id="exType1" type="radio" value="-1" name="exType" checked="checked" />                    
                    <label style="font-weight: bold" for="exType1">Settled Tickets From </label>
                    <span style="padding-left: 5px">
                        <input id="exchange_fromdate" class="txtdate" readonly="readonly" />
                    </span>
                    <span class="b" style="padding-left: 5px">To</span>
                    <span style="padding-left: 5px">
                        <input id="exchange_todate" class="txtdate" readonly="readonly" />
                    </span>
                </div>
                <div>
                    <input onclick="BetListByCustInfo.disabledFilter_Exchange();" id="exType2" type="radio" value="-2" name="exType" />
                    <label style="font-weight: bold" for="exType2">Running Tickets </label>
                </div>
                <div style="margin: 5px">
                    <input class="btn" type="button" id="btnReport" value="Submit" onclick="ExchangeBetlist.getData();" />
                    <div id="errMsg2">
                    </div>
                </div>                
            </div>

            <div class="maincontent_box hidden" id="maincontent_booked">
                <span style="font-weight: bold">Booked Date: From </span>
                <span style="padding-left: 5px">
                    <input id="booked_fromdate" class="txtdate" readonly="readonly" />
                </span>
                <span class="b" style="padding-left: 5px">To</span>
                <span style="padding-left: 5px">
                    <input id="booked_todate" class="txtdate" readonly="readonly" />
                </span>
                <span style="padding-left: 10px">Status</span>
                <span style="padding-left: 5px">
                    <span id="ddlBookedStatus" class="multiselect" multiple="multiple">
                    </span>
                </span>
                <input class="btn" type="button" id="btnReport" value="Submit" onclick="BetListByCustInfo.getBookedBet();" />
                <div id="errMsg2">
                </div>
            </div>

            <div id="maincontent_sabacoins" class="maincontent_box hidden" style="width: 100%;">
                <div>
                    <input onclick="BetListByCustInfo.disabledFilter_saba();" type="radio" id="rdByRef" value="-1" name="type_saba" />
                    <label style="font-weight: bold" for="rdByRef">By Ref No:</label>
                    <input id="txtRefNo_saba" type="text" maxlength="19" style="background-color: #fff; width: 130px;" autocomplete="off" onkeypress="return KeyPress(event);" />
                    <div id="info-msg_saba" class="info-msg hide">
                        For Sportsbook, the search result includes the related Bonus/Cash tickets.<br />
                        For Casino products, tickets can only be found within the last 6 months.
                    </div>
                </div>
                <div>
                    <input onclick="BetListByCustInfo.disabledFilter_saba();" type="radio" id="rdByUser_saba" value="-2" name="type_saba" checked="checked" />
                    <label style="font-weight: bold" for="rdByUser">Advance (Event Date):</label>
                    <span style="font-weight: bold">From </span>
                    <span style="padding-left: 5px">
                        <input id="txtfromdate_saba" class="txtdate" readonly="readonly" />
                    </span>
                    <span class="b" style="padding-left: 5px">To</span>
                    <span style="padding-left: 5px">
                        <input id="txttodate_saba" class="txtdate" readonly="readonly" />
                    </span>
                    <span style="padding-left: 10px">Status</span>
                    <span style="padding-left: 5px">
                        <span id="ddlStatus_saba" class="multiselect" multiple="multiple">
                        </span>
                    </span>
                    <span id="divBettype_saba" class="hidden" style="padding-left: 5px">
                        <span>Bettypes </span>
                        <select id="ddlBettype_saba" name="FilterBy"></select>
                    </span>
                </div>
                <div>
                    <input class="btn" type="button" id="btnReport_saba" value="Submit" onclick="BetListByCustInfo.getBetListByCustInfo_saba(false);" />
                    <input class="btn" type="button" id="btnToday_saba" value="Reset" onclick="Helper.reset_date();" />
                </div>
                <div id="err">
                </div>
            </div>

            <div id="betlistMain">
                <div id="betListContent" style="margin-top: 10px;">
                </div>
                <div id="betListSystemParlayContent" class="hidden" style="margin-top: 10px;">
                </div>
            </div>
            <div id="bookedBetMain">
                <div id="bookedBetContent" class="hidden" style="margin-top: 10px;">
                </div>
            </div>
            <div id="betListExchangeContent" class="hidden" style="margin-top: 10px;">
            </div>

            <div id="betlistMain_saba">                
                <div id="sabaCoinList" class="hidden" style="margin-top: 10px; width:1220px">
                    Shadow Account: @Html.Raw(string.Join(", ", shadowAccounts))
                </div>
                

                <div id="betListContent_saba" class="hidden" style="margin-top: 10px;">
                </div>
            </div>

            <div id="Popup" style="display: none;">
            </div>
        </div>
    </div>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var ticketStatus = @Html.Raw(Json.Encode(ticketStatus))     
        var bookedStatus = @Html.Raw(Json.Encode(bookedStatus))
        var _today = '@DateTime.Today.ToShortDateString()';
        var _yesterday = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var _custID = '@ViewBag.CustID';
        var _shadowIds = '@string.Join(",", shadowAccounts.Select(i=>i.CustId))';
        var _fromDate = '@ViewBag.FromDate';
        var _toDate = '@ViewBag.ToDate';
        var _accId = '@Fanex.Tarus.Infrastructure.Common.AppSession.AccId';
        head.js("@Url.Content("~/js/jQuery/jquery.js")",
                "@Url.Content("~/js/json2.js")",
                "@Url.Content("~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js")",
                "@Url.Content("~/js/jQuery/gridscroller.js")",
                "@Url.Content("~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js")",
                "@Url.Content("~/js/IBCWnd/IBCWnd.js")",
                "@Url.Content("~/js/dialogbox.js")",
                "@Url.Content("~/js/jQuery/Pager/jpager.js")",
                "@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js")",
                "@Url.Content("~/js/BlockUI.js")",
                "@Url.Content("~/js/common.js")",
                "@Url.Content("~/js/MultipleSelect/jquery.multiselect.js?ver=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version",
                "@Url.Content("~/js/BetList.js?ver=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version",
                "@Url.Content("~/Areas/AGCasino/Views/BetDetails/Scripts/BetDetails.js?ver=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version",                
                "@Url.Content("~/Views/BetList/BetlistByCustInfo/Scripts/BetlistByCustInfo.js?ver=1")@Sunplus.Accounting.Core.Configurations.WebSettings.Version",
                "@Url.Content("~/Views/BetList/BetlistByCustInfo/Scripts/ExchangeBetlist.js?ver=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version",
                "@Url.Content("~/Views/BetList/Scripts/BetlistGlobal.js?ver=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version");
    </script>
</body>
</html>
