@using Fanex.BetList.Core.Entities;
@using Fanex.Tarus.BetList.Models;
@using Fanex.Tarus.BetList.Constants;
@model KeyValuePair<string, IList<TicketDetail>>
@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    TicketDetail betdetail = new TicketDetail();
    int NumberBegining = ViewBag.NumberBegining;
    bool showUserNameColumn = ViewBag.ShowUserNameColumn;
    int totalColumn = showUserNameColumn ? 13 : 12;
    long[] arrTransID = new long[Model.Value.Count];

    string[] renderResult = Render(ref NumberBegining, ref arrTransID, showUserNameColumn);
}
@functions {
    public string[] Render(ref int NumberBegining, ref long[] arrTransID, bool showUserNameColumn)
    {
        string[] result = new string[2];
        int i = 0;
        foreach (var betdetail in Model.Value)
        {
            result[1] += renderContent(betdetail, NumberBegining, showUserNameColumn);
            arrTransID[i++] = betdetail.Ticket.TransId;
            NumberBegining++;
        }
        return result;
    }
}
@if (!string.IsNullOrWhiteSpace(Model.Key))
{
    <div style="color: #f00; border: 1px solid #f00; padding: 10px; margin-bottom: 10px">@Model.Key</div>
}
@helper renderContent(TicketDetail betdetail, int NumberBegining, bool showUserNameColumn)
{
    <tr class="c">
        <td>
            <div class="c width30 table-cell">
                @NumberBegining
            </div>
        </td>
        @if (showUserNameColumn)
        {
            <td class="c">
                <div class="width120 table-cell">
                    <div class="b" style="word-break: break-word;">
                        @betdetail.Ticket.UserName
                    </div>                    
                    @betdetail.Ticket.CustId
                </div>
            </td>
        }

        <td class="c">
            <div class="width150 table-cell refno">
                @Html.Raw(betdetail.TransDateHtml)
            </div>
        </td>
        <td id="td_right_@betdetail.Ticket.TransId" class='r bl_evt'>
            <div id="choice_right_@betdetail.Ticket.TransId" class="width275 table-cell">
                @Html.Raw(betdetail.ChoiceHtml)
                @if (betdetail.Ticket.BetTypeId == 9 || betdetail.Ticket.BetTypeId == 29)
                {
                    <div class="parlay_@betdetail.Ticket.TransId ">
                    </div>
                }
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width120 table-cell">
                @Html.Partial("~/Views/BetList/_Odds.cshtml", betdetail)
            </div>
        </td>
        <td class='r bl_underdog'>
            <div class="width100 table-cell">
                @Html.Raw(betdetail.StakeHtml)
            </div>
        </td>
        <td class="r">
            <div class="width80 table-cell">
                @Html.Partial("~/Views/BetList/_WinLoss.cshtml", betdetail)
            </div>
        </td>
        <td class="c">
            <div id="stautus_@betdetail.Ticket.TransId" class="width100 table-cell">
                @Html.Raw(betdetail.StatusHtml)
                @if (betdetail.Ticket.BetTypeId == BetTypeContants.BetTradeSold)
                {
                    <a onclick="ViewBettradeDetails(@betdetail.Ticket.TransId, @betdetail.Ticket.RefNo)">@Resources.BetList.details</a>
                }
                @{
                    var ip = @Sunplus.Accounting.Business.IpManagement.ReplaceVNIP(betdetail.Ticket.IP);
                }
                @if (ip != "-" && !betdetail.Ticket.BetTypeId.Equals(500))
                {
                    <br />
                    <a class="status-col" href="@Url.RouteUrl("Default", new { controller = "TarusBetList", action = "BetListByIP", IsLink = true, FromDate = betdetail.Ticket.WinlostDate.ToString("MM/dd/yyyy"), IP = betdetail.Ticket.IP })">@ip</a>
                }
                @if (!string.IsNullOrWhiteSpace(betdetail.Country))
                {
                    <br />
                    @betdetail.Country
                }
            </div>
        </td>
        <td class="r">
            <div id="comm_@betdetail.Ticket.TransId" class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_SuperPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_MasterPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="r">
            <div class="width60 table-cell">
                @Html.Partial("~/Views/BetList/_AgentPTCom.cshtml", betdetail)
            </div>
        </td>
        <td class="c">
            <div class="width80 table-cell">
                @Html.Raw(betdetail.Platform)
            </div>
        </td>
    </tr>

}
