@using Fanex.Tarus.BetList.Models
@using System.Resources;
@{
    var betdetail = Model;
    var platform = Resources.Platforms.Platform_NA;
    if (betdetail.DeviceType != null)
    {
        var deviceInfo = Resources.Platforms.ResourceManager.GetString(string.Format("Platform_{0}", betdetail.DeviceType.ToString()));

        platform = deviceInfo ?? Resources.Platforms.Platform_Uncategorized;
    }

}
<span>@platform</span>