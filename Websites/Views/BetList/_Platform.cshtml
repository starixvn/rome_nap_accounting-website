@using Fanex.Tarus.BetList.Models
@using System.Resources;
@{
    var betdetail = Model;
    var platform = Resources.NewBetList.Platform_NA;
    if(betdetail.DeviceType != null)
    {

        switch ((int)betdetail.DeviceType)
        {
            case 0:
                platform = Resources.NewBetList.Platform_NA;
                break;
            case 1:
                platform = Resources.NewBetList.Platform_1;
                break;
            case 2:
                platform = Resources.NewBetList.Platform_2;
                break;
            case 3:
                platform = Resources.NewBetList.Platform_3;
                break;
            default:
                platform = Resources.NewBetList.Platform_99;
                break;
        }
    }

}
<span>@platform</span>