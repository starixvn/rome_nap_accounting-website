@using Fanex.Tarus.BetList.ViewModel
@model ThirdPartyResultViewModel
@{
    Layout = null;
    var classPopup = "third-party-result" + ViewBag.ProductId;
    var isResizePopUp = ViewBag.IsResizePopUp ?? false;
    if (isResizePopUp)
    {
        classPopup = "third-party-result-sport-" + ViewBag.SportTypeId;
    }
}
<!DOCTYPE html>
<html>
<head>
    <link type="text/css" rel="Stylesheet"
          href="@Url.Content("~/Views/BetList/Style/ThirdParty.css?ver=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
    <title>@Model.Title</title>
</head>
<body>
    <div class="@classPopup">
        <iframe src="@Model.Result" frameborder="0" class="handhistory-iframe"></iframe>
    </div>
</body>
</html>
