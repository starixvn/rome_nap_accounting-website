@using Fanex.BetList.Accounting.App_GlobalResources;
@using Fanex.BetList.Accounting.Models
@using Fanex.BetList.Accounting.Resources;
@using Fanex.BetList.Accounting.Extensions;
@model CashOutHistory
<html>
<head>
    <link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
    <link rel="stylesheet" type="text/css" href="~/Views/BetList/Style/BetList.css" />
    <title>Cash Out History</title>
    <style>
        .time {
            font-size: 11px;
        }

        .display-none {
            display: none;
        }
    </style>
</head>
<body>
    <p>@BetListResources.OriginalBetTicket</p>
    <div id="originalTicket" class="freegrid display-none">
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th><div class="table-cell height34 width120">@Labels.Trans_Time</div></th>
                            <th><div class="table-cell height34 width300">@Labels.Choice</div></th>
                            <th><div class="table-cell height34 width60">@Labels.Odds</div></th>
                            <th><div class="table-cell height34 width60">@Labels.Stake</div></th>
                            <th><div class="table-cell height34 width100">@Labels.Win_Loss/@BetListResources.Comm</div></th>
                            <th><div class="table-cell height34 width100">@Labels.Status</div></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="originalBetTicketContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th><div class="table-cell height34 width120">@Labels.Trans_Time</div></th>
                            <th><div class="table-cell height34 width300">@Labels.Choice</div></th>
                            <th><div class="table-cell height34 width60">@Labels.Odds</div></th>
                            <th><div class="table-cell height34 width60">@Labels.Stake</div></th>
                            <th><div class="table-cell height34 width100">@Labels.Win_Loss/@BetListResources.Comm</div></th>
                            <th><div class="table-cell height34 width100">@Labels.Status</div></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TicketDetail == null)
                        {
                            <tr>
                                <td colspan="6" class="c">@BetList.noInfo</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>
                                    <div class="table-cell c b width120">
                                        @Html.Raw(Model.TicketDetail.TransDateHtml)
                                    </div>
                                </td>
                                <td>
                                    <div class="table-cell r width300">
                                        @Html.Raw(Model.TicketDetail.ChoiceHtml)
                                    </div>
                                </td>
                                <td>
                                    <div class="table-cell r width60">
                                        @Html.Partial("~/Views/BetList/_Odds.cshtml", Model.TicketDetail)
                                    </div>
                                </td>
                                <td>
                                    <div class="table-cell r width60">
                                        @Html.Raw(Model.TicketDetail.StakeHtml)
                                    </div>
                                </td>
                                <td>
                                    <div class="table-cell r width100">
                                        @Html.Partial("~/Views/BetList/_WinLoss.cshtml", Model.TicketDetail)
                                    </div>
                                </td>
                                <td>
                                    <div class="table-cell c width100">
                                        @Html.Raw(Model.TicketDetail.StatusHtml)
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <p>@(Request["Title"] == BetListResources.CashOut ? BetListResources.CashOutTickets : BetListResources.BoughtTickets)</p>
    <div id="cashoutOrBoughtTickets" class="freegrid display-none">
        <div class="col_header row-headers-background scroll-y">
            <div class="header-container">
                <table class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th><div class="table-cell height34 width120">@Labels.Trans_Time</div></th>
                            <th><div class="table-cell height34 width300">@BetListResources.BoughtStake</div></th>
                            <th><div class="table-cell height34 width60">@BetListResources.Price</div></th>
                            <th><div class="table-cell height34 width60">@BetListResources.WinSlashLoss</div></th>
                            <th><div class="table-cell height34 width100">@Labels.Status</div></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="grid-container container">
            <div class="content-container">
                <table id="cashoutOrBoughtTicketsContent" class="grid-fixed-table col_header_content">
                    <thead>
                        <tr>
                            <th><div class="table-cell height34 width120">@Labels.Trans_Time</div></th>
                            <th><div class="table-cell height34 width300">@BetListResources.BoughtStake</div></th>
                            <th><div class="table-cell height34 width60">@BetListResources.Price</div></th>
                            <th><div class="table-cell height34 width60">@BetListResources.WinSlashLoss</div></th>
                            <th><div class="table-cell height34 width100">@Labels.Status</div></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.CashOutTickets.Any())
                        {
                            <tr>
                                <td colspan="5" class="c">@BetList.noInfo</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var ticket in Model.CashOutTickets)
                            {
                                var highlightClass = Model.TicketDetail.Ticket.TransId == ticket.RefNo ? "event" : string.Empty;
                                <tr>
                                    <td class="@highlightClass">
                                        <div class="table-cell c b width120">
                                            @BetList.refno: @ticket.TransId
                                            <div class="time">@ticket.TransDate</div>
                                        </div>
                                    </td>
                                    <td class="@highlightClass">
                                        <div class="table-cell r width300">
                                            @ticket.Stake.Format(2)
                                        </div>
                                    </td>
                                    <td class="@highlightClass">
                                        <div class="table-cell r width60">
                                            @ticket.Price.Format(2)
                                        </div>
                                    </td>
                                    <td class="@highlightClass">
                                        <div class="table-cell r width60">
                                            @ticket.WinLost.Format(2)
                                        </div>
                                    </td>
                                    <td class="@highlightClass">
                                        <div class="table-cell c width100">
                                            @Html.Raw(ticket.StatusHtml)
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="~/js/jQuery/jquery.js"></script>
    <script type="text/javascript" src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js"></script>
    <script type="text/javascript">
        function initGridOpts(contentId) {
            return {
                tblContentId: contentId,
                manualCopyHeader: true,
                fullWidth: true,
                fullHeight: true,
                gridHeight: 180,
                freezeWidth: 0,
                numberFreezeCol: 0
            };
        }
        $(function () {
            var originalGridOpts = initGridOpts("originalBetTicketContent");
            var $originalTicket = $("#originalTicket");
            $originalTicket.initGrid(originalGridOpts).removeClass("display-none").gridScroller(originalGridOpts);

            var cashoutOrBoughtGridOpts = initGridOpts("cashoutOrBoughtTicketsContent");
            var $cashoutOrBoughtTickets = $("#cashoutOrBoughtTickets");
            $cashoutOrBoughtTickets.initGrid(cashoutOrBoughtGridOpts).removeClass("display-none").gridScroller(cashoutOrBoughtGridOpts);
        });
    </script>
</body>
</html>
