@using Fanex.Tarus.Customer.Resources;
<div>
    <div class="filterBox" style="border: solid 1px #7C98A4;">
        <div class="filterContent">
            <form id="mainForm" action="Insert" method="post" enctype="multipart/form-data">
                <div id="errMsg">
                </div>
                <div class="clear"></div>
                <div class="b">&nbsp;&nbsp;&nbsp;Choose an excel file to upload (Format: *.xls, *.xlsx)</div>
                <div class="clear"></div>

                <div class="floatLeft">
                    <input id="uploadFile" name="uploadFile" type="file" style="width: 280px" />
                </div>
                <div class="floatLeft">
                    <input type="button" value="Submit" class="btn" onclick="InsertBettypes()" />
                </div>
            </form>
            <div style="clear: both"></div>
            <div>
                <span class="label-filesize-limit">
                    @Customer_Labels.Message_ExcelFileSizeLimit
                </span>
                <a class="link-download-excel-template b" href="@Url.Content("~/Views/Admin/ManageBettype/Bettype.xls")">@Customer_Labels.Message_DownloadTemplate</a>
            </div>
        </div>
    </div>

</div>