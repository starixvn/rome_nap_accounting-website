@using Fanex.Tarus.Customer.Resources;
@using Sunplus.Accounting.Core.Configurations;
<html>
<head>
    <link href="@Url.Content("~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/App_Themes/Public/input.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/App_Themes/Public/Message.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/App_Themes/Public/commonIOM.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/App_Themes/Public/common.css?v=" + WebSettings.Version)" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.css?v=" + WebSettings.Version)" rel="stylesheet" type="text/css" />
    <style type="text/css">
        .filterBox {
            float: left;
            width: 100%;
        }

        .floatLeft {
            float: left;
            margin: 10px 10px 10px 10px;
        }

        input[type="image"] {
            border: none;
        }

        .bgeven td {
            background-color: #FFFF99 !important;
        }

        .excel-img {
            background: url('~/../../App_Themes/Images/excel.gif') no-repeat;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .indent-1 {
            text-indent: 10px;
        }

        .indent-2 {
            text-indent: 20px;
        }
    </style>
</head>
<body>
    <div class="main" style="width:99%;">
        <div id="divMainHeader" class="">
            <div id="left_tab1">
                <ul>
                    <li class="lefticon"></li>
                    <li class="current"><span>Ticket to Group Headline</span></li>
                </ul>
            </div>
        </div>
        <div class="maincontent">
            <div class="filterBox">
                <div class="filterContent">
                    <form id="mainForm" action="GetData" method="post" enctype="multipart/form-data">
                        <input id="PageSize" name="PageSize" type="hidden" value="50" />
                        <input id="PageIndex" name="PageIndex" type="hidden" value="1" />
                        <div id="errMsg">
                        </div>
                        <div class="clear"></div>
                        <div class="b">&nbsp;&nbsp;&nbsp;Choose an excel file to upload (Format: *.xls, *.xlsx)</div>
                        <div class="clear"></div>

                        <div class="floatLeft">
                            <input id="uploadFile" name="uploadFile" type="file" style="width: 280px" />
                        </div>
                        <div class="floatLeft">
                            <label class="b" for="headlineType">Headline Type</label>
                        </div>
                        <div class="floatLeft">
                            <select id="headlineType" name="headlineType">
                                <option value="2">All</option>
                                <option value="1">VIP</option>
                                <option value="0">Normal</option>
                            </select>
                        </div>
                        <div class="floatLeft">
                            <label class="b" for="productId">Product</label>
                        </div>
                        <div class="floatLeft">
                            @Html.DropDownList("productId", (List<SelectListItem>)ViewBag.SupportedProducts, new { id = "productId" })
                        </div>
                        <div class="floatLeft">
                            <input type="button" value="Submit" class="btn" onclick="GetData()" />
                        </div>
                        <div class="floatLeft">
                            <input id="notifyHeadlines" type="button" value="Notify Headline" class="btn" onclick="NotifyHeadline()" disabled />
                        </div>
                        <div class="floatLeft">
                            <div id="imgExportExcel" class="excel-img display-none" onclick="GetExcelFile()"></div>
                        </div>

                    </form>
                    <div style="clear: both"></div>
                    <div>
                        <span class="label-filesize-limit">
                            @Customer_Labels.Message_ExcelFileSizeLimit
                        </span>
                        <a class="link-download-excel-template b" href="@Url.Content("~/Views/Admin/TicketToHeadline/TicketToGroupHeadlineTemplate.xls")">@Customer_Labels.Message_DownloadTemplate</a>
                        <span style="margin: auto 4px; float: none;" id="noteMessageIcon" class="note-info-message" title="" onclick="OpenNoteMessage();"></span>
                    </div>
                </div>
            </div>
            <div style="clear: both"></div>
            <div id="gridContainer" class="grid-container">
                <div id="gridId" class="freegrid"></div>
            </div>
        </div>

    </div>
    <div id="noteMessage" style="display:none;">
        <h3>Template guideline</h3>
        <p>Please follow these rules for uploading files:</p>
        <h3 class="indent-1">For Sportsbook (exclude Outright) and Virtual Sports 2 tickets</h3>
        <p class="indent-2">Must enter and existing MatchID and the entered Ticket Ref No must belong to this match</p>
        <p class="indent-2">When MessageID is provided, Actual Result and Wrong Result can be empty. System will directly use provided MessageID to notify Headlines</p>
        <p class="indent-2">When MessageID is not provided, must enter Actual Result and Wrong Result.</p>
        <h3 class="indent-1">For Sportsbook Outright tickets</h3>
        <p class="indent-2">MatchID is not required and can be empty</p>
        <p class="indent-2">Must enter an existing MessageID</p>
        <h3 class="indent-1">For Virtual Sports, Number Game (Number Game/Turbo Number Game, Happy 5) tickets</h3>
        <p class="indent-2">Must enter and existing MatchID and the entered Ticket Ref No must belong to this match</p>
        <p class="indent-2">Actual Result, Wrong Result and MessageID should be empty</p>
        <h3 class="indent-1">For Number Game (Happy 5 Linked Game)</h3>
        <p class="indent-2">MatchID is not required and can be empty</p>
        <p class="indent-2">Actual Result, Wrong Result and MessageID should be empty</p>
        <p>MatchID, Actual Result, Wrong Result and MessageID, when it's provided, should be provided in 1 row ONLY. The rest of tickets in the file will use the same information as that row.</p>
    </div>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-ui-1.9.1.min.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/moment.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/numeral.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/IBCWnd/IBCWnd.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/jQuery/jquery.blockUI.1.33.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/common.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/js/Message/message.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript" src="@Url.Content("~/Views/Admin/TicketToHeadline/Scripts/Index.js?v=" + WebSettings.Version)"></script>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
</body>
</html>
