@using Fanex.Tarus.Customer.Entities.ExtraPtGroup
@model ModifyGroupByProductViewModel
@{
    var disabled = Model.SelectedItem.EffectiveDate <= DateTime.Now ? 1 : 0;
    var displayAsterisk = disabled == 1 ? "none" : "inline-block";
    string minDate = DateTime.Today.ToString("yyyyMMdd");
}
<html>
<head>
    <title></title>
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/common.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/input.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/image.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/Message.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Report/reportgrid.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Views/Admin/ExtraPtGroup/Styles/ExtraPtGroup.css?v=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
</head>
<body>
    <table width="100%" style="line-height: 45px; margin-top: 10%;">
        <tr>
            <td colspan="2">
                <div id="errMsg" style="line-height: 18px">
                </div>
            </td>
        </tr>
        <tr>
            <td width="30%">Group</td>
            <td>
                <select id="group" class="edit-control-width" disabled>
                    @foreach (var item in Model.Groups)
                    {
                        var selected = item.GroupId == Model.SelectedItem.Group.GroupId ? "selected=\"selected\"" : string.Empty;
                        <option value="@item.GroupId" @selected>@item.GroupName</option>
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td>Product</td>
            <td>
                <select id="product" disabled>
                    @foreach (var item in Model.Products)
                    {
                        var selected = item.ProductId == Model.SelectedItem.Product.ProductId ? "selected=\"selected\"" : string.Empty;
                        <option value="@item.ProductId" @selected>@item.ProductName</option>
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td>%Extra PT <span class="asterisk" style="display: @displayAsterisk">*</span></td>
            <td><input id="extrapt" maxlength="5" onkeyup="return Fanex.CustomerSetting.Core.CheckNumber(event, this, true);" class="edit-control-width" style="text-align: right" type="text" value="@((Model.SelectedItem.ExtraPt * 100).ToString("#,###.00"))" /></td>
        </tr>
        <tr>
            <td>Effective Date <span class="asterisk" style="display: @displayAsterisk">*</span></td>
            <td>
                @Html.Raw(Sunplus.Accounting.Core.Web.Controls.Calendar.GenCalendarControl(
                minDate,
                "99991231",
                "effdate",
                "../",
                "fdateTrigger",
                Model.SelectedItem.EffectiveDate.ToString("MM/dd/yyyy"),
                false,
                false,
                string.Empty,
                string.Empty,
                string.Empty))
            </td>
        </tr>
        <tr>
            <td>End Date</td>
            <td>
                @Html.Raw(Sunplus.Accounting.Core.Web.Controls.Calendar.GenCalendarControl(
                minDate,
                "99991231",
                "enddate",
                "../",
                "tdateTrigger",
                Model.SelectedItem.EndDate.ToString("MM/dd/yyyy"),
                false,
                false,
                string.Empty,
                string.Empty,
                string.Empty))
            </td>
        </tr>
        <tr>
            <td></td>
            <td><input type="button" class="btn" value="Submit" style="cursor: pointer" onclick="Update()" /></td>
        </tr>
    </table>
    <input type="hidden" value="@Model.SelectedItem.EffectiveDate.ToString("MM/dd/yyyy")" id="oldEffdate" />
    <input type="hidden" value="@Model.SelectedItem.EndDate.ToString("MM/dd/yyyy")" id="oldEnddate" />
    <input type="hidden" value="@(Model.SelectedItem.ExtraPt * 100)" id="oldExtrapt" />
    <script src="@Url.Content("~/js/jQuery/jquery-1.7.2.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/jQuery/UI/jquery-ui-1.8.10.custom.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/Message/message.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/Popup/confirmbox.js")"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/jquery.blockUI.1.33.js")"></script>
    <script src="@Url.Content("~/Areas/CustomerSetting/Scripts/Fanex.CustomerSetting.Core.js")"></script>
    <script src="@Url.Content("~/Views/Admin/ExtraPtGroup/Scripts/ExtraPtGroup.js?v=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
    <script type="text/javascript">
        function resolveClientUrl(relativePath) {
            return '@Url.Content("~/")' + relativePath;
        }

        if (@disabled) {
            $('#fdateTrigger').attr('disabled', 'disabled');
        $('#effdate').css('background-color', '#eee');
        $('#extrapt').attr('disabled', 'disabled');
        }
    </script>
</body>
</html>