@using Fanex.Tarus.Customer.Entities.ExtraPtGroup
@model GroupByProductViewModel
<!DOCTYPE html>
<html>
<head>
    <title></title>
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/common.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/input.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/image.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/Message.css")" />
    <link href="@Url.Content("~/App_Themes/Report/reportgrid.css")" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Views/Admin/ExtraPtGroup/Styles/ExtraPtGroup.css?v=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL"></td>
                    <td class="maincontent_headerC fixfont">
                        Manage Extra PT Group
                    </td>
                    <td class="maincontent_headerR"></td>
                </tr>
            </table>
            <div class="maincontent_box" style="width: 500px">
                <div id="errMsg">
                </div>
                <div class="header-scroll" style="line-height: 2">
                    <label class="b">Product&nbsp;</label>
                    <select id="product">
                        <option value="0">All Products</option>
                        @foreach (var item in Model.Products)
                        {
                            var selected = item.ProductId == Model.CurrentProductId ? "selected=\"selected\"" : string.Empty;
                            <option value="@item.ProductId" @selected>@item.ProductName</option>
                        }
                    </select>
                    <input id="check" class="btn" type="button" value="Submit" onclick="Search()" />
                </div>
                <div style="clear: both">
                    <div style="background-color: #cddef3; height: 20px; border: 1px solid #7c98a4"><input type="button" class="btnAdd" style="float: right" title="Add"></div>
                    <table class="tbl-body-scroll" width="100%" style="border-left: 1px solid #7c98a4; line-height: 18px">
                        <thead>
                            <tr style="background-color: #cddef3">
                                <td style="width: 20px" class="c b">#</td>
                                <td style="width: 80px" class="c b">Product</td>
                                <td style="width: 50px" class="c b">%Extra PT</td>
                                <td style="width: 50px" class="c b">Effective Date</td>
                                <td style="width: 50px" class="c b">End Date</td>
                                <td style="width: 40px" class="c b">Action</td>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.GroupsByProduct.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" style="background-color: #cddef3">There is no information available.</td>
                                </tr>
                            }
                            else
                            {
                                var groups = Model.GroupsByProduct.GroupBy(p => p.Group.GroupId);
                                var count = 0;
                                foreach (var group in groups)
                                {
                                    count = 0;
                                    <tr>
                                        <td colspan="6" class="b bg" style="background-color: #cddef3">@group.FirstOrDefault().Group.GroupName</td>
                                    </tr>
                                    foreach (var item in group)
                                    {
                                        ++count;
                                        <tr>
                                            <td class="c">@count</td>
                                            <td>@item.Product.ProductName</td>
                                            <td class="r">@((item.ExtraPt * 100).ToString("#,###.00"))%</td>
                                            <td class="c">@item.EffectiveDate.ToString("MM/dd/yyyy")</td>
                                            <td class="c">@(item.EndDate.Year >= DateTime.MaxValue.Year ? "-" : item.EndDate.ToString("MM/dd/yyyy"))</td>
                                            <td class="c">
                                                @if (item.EffectiveDate <= DateTime.Now)
                                                {
                                                    <img src="@Url.Content("~/App_Themes/Images/icn_edit.png")" onclick="javascript:;" style="cursor:pointer" title="Edit">
                                                }
                                                else
                                                {
                                                    <img src="@Url.Content("~/App_Themes/Images/icn_edit.png")" onclick="javascript:;" style="cursor:pointer" title="Edit">
                                                    <img src="@Url.Content("~/App_Themes/Images/icn_del.png")" onclick="javascript:;" style="cursor:pointer" title="Remove">
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/js/jQuery/jquery-1.7.2.min.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/js/Message/message.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Views/Admin/ExtraPtGroup/Scripts/ExtraPtGroup.js?v=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version" type="text/javascript"></script>
</body>
</html>