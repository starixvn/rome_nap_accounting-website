@model Fanex.Tarus.Admin.Entities.SMAManagement.FilterGroup

<link href="~/App_Themes/Public/table.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
<link href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/Pager/pagination.css" rel="stylesheet" type="text/css" />
<link href="~/js/jQuery/GridScroller/gridscroller.css" rel="stylesheet" type="text/css" />
<link href="~/js/MultipleSelect/jquery.multiselect.css" rel="stylesheet" type="text/css" />
<link href="~/js/ToolTip/Tipsy-Tooltip/tipsy.css" rel="stylesheet" type="text/css" />
<link href="~/Views/Admin/SMAManagement/Style/StyleSheet.css" rel="stylesheet" type="text/css" />

<div class="main">
    <div id="divMainHeader">
        <div id="left_tab1">
            <ul>
                <li class="lefticon"></li>
                <li class="current"><span>SMA Management</span></li>
            </ul>
        </div>
    </div>
    
    <div class="maincontent">
        <div class="filterBox" style="width: 1022px;">
            <div class="filterContent">
                <div>
                    <table>
                        <tr>
                            <td>
                                <b>Site</b>
                            </td>
                            <td style="width: 100px">
                                <div id="ddlSites" class="multiselect" multiple="multiple" style="padding-top: 2px;">
                                </div>
                            </td>
                            <td>
                                <b>Currency</b>
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownList("ddlCurrency", Model.Currencies, new { style = "width:100px" })
                            </td>
                            <td>
                                <b>Status</b>
                            </td>
                            <td style="width: 100px">
                                <div id="ddlStatus" class="multiselect" multiple="multiple" style="padding-top: 2px;">
                                </div>
                            </td>
                            <td>
                                <b>Headline Type</b>
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownList("ddlHeadlineType", Model.HeadlineTypes, new { style = "width:100px" })
                            </td>
                            <td>
                                <input type="checkbox" id="chkExcludeTestAccounts" checked="checked"/>
                                <label for="chkExcludeTestAccounts">Exclude Test Accounts</label>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <b>Username</b>
                            </td>
                            <td>
                                <input type="text" id="txtUsername" value="All" style="width: 110px" />
                            </td>
                            <td>
                                <b>Group Headline</b>
                            </td>
                            <td>
                                <input type="text" id="txtGroupHeadline" value="All" style="width: 100px" />
                            </td>
                            <td>
                                <b>Owner Username</b>
                            </td>
                            <td>
                                <input type="text" id="txtOwner" value="All" style="width: 100px" />
                            </td>
                            <td>
                                <b>Position</b>
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownList("ddlPosition", Model.Positions, new { style = "width:100px" })
                            </td>
                            <td>
                                <input type="button" class="btn" id="btnSubmit" value="Submit" />
                                <input type="button" class="btnExcel hidden" id="btnExportExcel" value="" />
                            </td>
                        </tr>
                    </table>

                    <div id="err"></div>
                </div>
            </div>
        </div>
        <div class="contentBox">
            <div id="SMAMangementGrid" class="freegrid hidden">                
                <div class="free-cell free-top-left">
                    <table class="grid-fixed-table free-cell-top-left">
                        <thead>
                            <tr>
                                <th>
                                    <div class="table-cell" style="width: 30px; height: 35px">
                                        #</div>
                                </th>
                                <th>
                                    <div class="table-cell sorter" style="width: 150px; height: 35px" id="divSortingByGroupHeadline">
                                        Group Headline</div>
                                </th>
                                <th>
                                    <div class="table-cell" style="width: 150px; height: 35px">
                                        Headline Type</div>
                                </th>
                                <th>
                                    <div class="table-cell sorter" style="width: 150px; height: 35px" id="divSortingByOwner">
                                        Owner</div>
                                </th>
                                <th>
                                    <div class="table-cell sorter" style="width: 120px; height: 35px" id="divSortingByUsername">
                                        Username</div>
                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
                <div class="row_header_wrapper">
                    <div class="row_header row-headers-background">
                        <table class="grid-fixed-table row_header_content" id="tblContentHeader">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="table-cell" style="width: 30px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 120px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col_header row-headers-background scroll-y">
                    <div class="header-container">
                        <table class="grid-fixed-table col_header_content">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="table-cell" style="width: 30px; height: 35px">
                                            #</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            Group Headline</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            Headline Type</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            Owner</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 120px; height: 35px">
                                            Username</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 120px; height: 35px">
                                            Status</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 100px; height: 35px">
                                            Site</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 60px; height: 35px">
                                            Currency</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 80px; height: 35px">
                                            Position</div>
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                <div class="grid-container container">
                    <div class="content-container">
                        <table id="tblContent" class="grid-fixed-table col_header_content">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="table-cell" style="width: 30px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 150px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 120px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 120px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 100px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 60px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                    <th>
                                        <div class="table-cell" style="width: 80px; height: 35px">
                                            &nbsp;</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>                
            </div>
        </div>
    </div>
</div>
<iframe id="frameExportExcel" style="display: none"></iframe>
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    var linkExportExcel = '@Url.Action("ExportSMAGroupHeadlinesToExcel", "SMAManagement")';
    var hostPermission = @Json.Encode(ViewData["HasHostPermission"]);
    var jsonSites = @Html.Raw(Json.Encode(Model.Sites));
    var jsonStatuses = @Html.Raw(Json.Encode(Model.Statuses));
    var jsonHeadlineTypes = @Html.Raw(Json.Encode(Model.HeadlineTypes));
</script>

<script src="~/js/jQuery/jquery-1.7.2.min.js" type="text/javascript"></script>
<script src="~/js/jQuery/json2.js" type="text/javascript"></script>
<script src="~/js/jQuery/Jlinq/jlinq.js" type="text/javascript"></script>
<script src="~/js/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
<script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js" type="text/javascript"></script>
<script src="~/js/jQuery/Pager/jpager.js" type="text/javascript"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script src="~/js/ToolTip/Tipsy-Tooltip/jquery.tipsy.js?ver=2" type="text/javascript"></script>
<script src="~/Views/Admin/SMAManagement/Js/SMAManagement.js?ver=1" type="text/javascript"></script>
