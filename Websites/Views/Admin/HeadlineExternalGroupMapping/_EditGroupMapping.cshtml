<form id="edit-group_mapping" style="display: none;">
    <div id="editErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td class="w80"><label>Group Headline</label></td>
            <td>
                <span id="EditGroupHeadline"></span>
            </td>
        </tr>
        <tr>
            <td class="w80"><label>Site</label></td>
            <td>
                <span id="EditSite"></span>
            </td>
        </tr>
        <tr>
            <td class="w80"><label>Currency</label></td>
            <td>
                <span id="EditCurrency"></span>
            </td>
        </tr>
        <tr>
            <td class="w80"><label for="EditExternalGroupIds">External Group</label></td>
            <td colspan="3">
                <select id="EditExternalGroupIds" multiple="multiple" class="setting-edit" style="width: 360px;"></select>
            </td>
        </tr>
        <tr>
            <td class="w80"><label for="EditPrimaryGroupId">Primary Group</label></td>
            <td>
                <select id="EditPrimaryGroupId" class="setting-edit"></select>
            </td>
            <td class="w80"><label>Effective From</label></td>
            <td>
                <input class="setting-calendar" id="EditEffectiveFromId" type="text" autocomplete="off"/>
                <input class="img-date-selector" onclick="return false;" alt="" id="EditEffectiveFromId_Trigger" title="Date selector"
                       width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image"/>
            </td>
        </tr>
        <tr>
            <td colspan="5" style="text-align: center">
                <input id="btnSubmitEdit" class="btn" type="submit" value="Submit" />
            </td>
        </tr>
    </table>
</form>