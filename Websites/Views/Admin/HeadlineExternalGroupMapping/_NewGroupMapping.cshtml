@model Fanex.Tarus.Admin.Entities.HeadlineExternalGroupMapping.FilterModel

<form id="add-new-group_mapping" style="display: none;">
    <div id="addNewErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td class="w80"><label for="GroupHeadlineId">Group Headline</label></td>
            <td>
                @Html.DropDownList("GroupHeadlineId", Model.Headlines, "Please select", new { id = "GroupHeadlineId", @class = "setting-edit" })
            </td>
        </tr>
        <tr>
            <td class="w80"><label for="SiteId">Site</label></td>
            <td>
                @Html.DropDownList("SiteId", Model.Sites, "Please select", new { id = "SiteId", @class = "setting-edit" })
            </td>
        </tr>
        <tr>
            <td class="w80"><label for="CurrencyId">Currency</label></td>
            <td>
                @Html.DropDownList("CurrencyId", Model.Currencies, "Please select", new { id = "CurrencyId", @class = "setting-edit" })
            </td>
        </tr>
        <tr>
            <td class="w80"><label for="NewExternalGroupIds">External Group</label></td>
            <td colspan="3">
                <select id="NewExternalGroupIds" multiple="multiple" class="setting-edit" style="width: 360px;""></select>
            </td>
        </tr>
        <tr>
            <td class="w80"><label for="NewPrimaryGroupId">Primary Group    </label></td>
            <td>
                <select id="NewPrimaryGroupId" class="setting-edit"></select>
            </td>
            <td class="w80"><label>Effective From</label></td>
            <td>
                <input class="setting-calendar" id="NewEffectiveFromId" type="text" autocomplete="off" />
                <input class="img-date-selector" onclick="return false;" alt="" id="NewEffectiveFromId_Trigger" title="Date selector"
                       width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
            </td>
        </tr>
        <tr>
            <td colspan="5" style="text-align: center">
                <input id="btnSubmitAdd" class="btn" type="submit" value="Submit" />
            </td>
        </tr>
    </table>
</form>