@using Sunplus.Accounting.Core.Configurations;

<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/table.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/input.css" />
<link rel="stylesheet" type="text/css" href="~/App_Themes/Public/commonIOM.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/UI/css/custom-theme/jquery-ui-1.8.10.custom.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/Pager/pagination.css" />
<link rel="stylesheet" type="text/css" href="~/js/jQuery/GridScroller/gridscroller.css" />
<link rel="stylesheet" type="text/css" href="~/js/MultipleSelect/jquery.multiselect.css" />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.css?v=" + WebSettings.Version)" />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.css?v=" + WebSettings.Version)" />
<link rel="stylesheet" type="text/css" href="@Url.Content("~/Views/Admin/FinanceGroupsConfig/Styles/index.css?v=" + WebSettings.Version)" />


<div class="main">
    <div id="divMainHeader">
        <div id="left_tab1">
            <ul>
                <li class="lefticon"></li>
                <li class="current"><span>Finance Groups Config</span></li>
            </ul>
        </div>
    </div>

    <div class="maincontent">
        <div class="filterBox" style="width: 1142px;">
            <div class="filterContent">
                <div id="err-msg" style="margin-bottom: 7px;"></div>
                <div>
                    <label>Finance Groups</label>
                    <select id="ddlGroups" style="width: 100px">
                        <option>Default</option>
                    </select>
                </div>
                <table style="margin-top: 5px; margin-bottom: 5px;">
                    <tr>
                        <td>
                            <input type="radio" name="finance" id="rdoFinanceCode" value="financeCode" checked />
                        </td>
                        <td style="width: 460px;">
                            <label>Finance Code</label>
                            <input type="text" id="txtFinanceCode" class="txtFinanceCode" style="width: 362px;" />
                        </td>
                        <td style="width: 150px;">
                            <label>Level</label>
                            <select id="ddlLevel" style="width: 100px">
                                <option value="" selected>All Levels</option>
                                <option value="1">Member</option>
                                <option value="2">Agent</option>
                                <option value="3">Master</option>
                                <option value="4">Super</option>
                            </select>
                        </td>
                        <td>
                            <label>Allow Viewing</label>
                            <select id="ddlAllowViewing" style="width: 100px">
                                <option value="" selected>Both</option>
                                <option value="0">Disallow</option>
                                <option value="1">Allow</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <input type="radio" name="finance" id="rdoFinanceUsername" value="financeUsername" />
                        </td>
                        <td>
                            <label>Finance Username</label>
                            <input type="text" id="txtFinanceUsername" style="width: 338px;" />
                        </td>
                    </tr>
                </table>
                <div>
                    <input type="button" class="btn" value="Add New Finance Group" onclick="OpenAddNewGroup();" />
                    <input type="button" class="btn" value="Add Users To Group" onclick="OpenAddUsersToGroup();" />
                    <input type="button" class="btn" value="Add Codes To Group" onclick="OpenAddCodesToGroup();" />
                    <input type="button" class="btn btn-right" value="Search" onclick="Search();" />
                </div>
            </div>
        </div>
        <div class="contentBox">
            <div id="financeGroupsGrid" class="freegrid">
            </div>
        </div>
    </div>
</div>

<div id="confirm-box"></div>

@Html.Partial("~/Views/Admin/FinanceGroupsConfig/_CreateNewFinanceGroup.cshtml")
@Html.Partial("~/Views/Admin/FinanceGroupsConfig/_AddUsersToGroup.cshtml")
@Html.Partial("~/Views/Admin/FinanceGroupsConfig/_AddCodesToGroup.cshtml")
@Html.Partial("~/Views/Admin/FinanceGroupsConfig/_MessageBox.cshtml")

<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
</script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-1.8.2.min.js?v=" + WebSettings.Version)"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/jQuery/jquery-ui-1.9.1.min.js?v=" + WebSettings.Version)"></script>
<script src="~/js/jQuery/json2.js" type="text/javascript"></script>
<script src="~/js/jQuery/GridScroller/jquery.gridscroller.1.0.js" type="text/javascript"></script>
<script src="~/js/jQuery/Pager/jpager.js" type="text/javascript"></script>
<script src="~/js/jQuery/jquery.blockUI.1.33.js" type="text/javascript"></script>
<script src="~/js/jQuery/Jlinq/jlinq.js" type="text/javascript"></script>
<script src="~/js/common.js" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Grid.js?v=" + WebSettings.Version)"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/_Libs/FanexGrid/Fanex.Pagination.js?v=" + WebSettings.Version)"></script>
<script type="text/javascript" src="@Url.Content("~/js/MultipleSelect/jquery.multiselect.min.js?v=" + WebSettings.Version)"></script>
<script type="text/javascript" src="@Url.Content("~/Views/Admin/FinanceGroupsConfig/Scripts/index.js?v=" + @WebSettings.Version)"></script>