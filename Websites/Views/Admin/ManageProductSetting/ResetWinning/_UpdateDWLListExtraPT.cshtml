<form id="edit-dwllistextrapt-form" style="display: none;">
    <div id="updateDWLListExtraPTErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td><label for="DWLListExtraPTCustId">CustId</label></td>
            <td><span id="DWLListExtraPTCustId" /></td>
        </tr>
        <tr>
            <td><label for="DWLListExtraPTUsername">Username</label></td>
            <td><span id="DWLListExtraPTUsername" /></td>
        </tr>
        <tr>
            <td><label for="DWLListExtraPTGroupId">GroupId<span style="color: red;">*</span></label></td>
            <td><input class="numeric-input-int w180" id="DWLListExtraPTGroupId" /></td>
        </tr>
        <tr>
            <td><label for="DWLListExtraPTGroupName">GroupName<span style="color: red;">*</span></label></td>
            <td><input id="DWLListExtraPTGroupName" type="text" class="setting-edit w180" maxlength="50" /></td>
        </tr>
        <tr>
            <td><label for="DWLListExtraPTIsDisabled">IsDisabled</label></td>
            <td><input id="DWLListExtraPTIsDisabled" type="checkbox" value="1" /></td>
        </tr>
        <tr>
            <td colspan="5" style="text-align: center">
                <input class="btn" type="button" value="Update" id="btnDWLListExtraPTUpdate" />
            </td>
        </tr>
    </table>
</form>