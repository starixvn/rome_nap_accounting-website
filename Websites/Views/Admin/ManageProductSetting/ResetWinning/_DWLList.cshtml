<div class="filterBox" style="border: solid 1px #7C98A4; height:90px;">
    <div class="filterContent">
        <div id="errDWLListMsg"></div>
        <div class="floatLeft w80"><label for="txtDWLListCustId">CustId</label></div>
        <div class="floatLeft"><input id="txtDWLListCustId" type="text" class="numeric-input-int filter_input_txt" /></div>
        <div class="floatLeft w80"><label for="txtDWLListUsername">Username</label></div>
        <div class="floatLeft"><input id="txtDWLListUsername" type="text" class="filter_input_txt"/></div>
        <div class="clear"></div>
        <div class="floatLeft w80"><label for="txtDWLListProductId">ProductId</label></div>
        <div class="floatLeft"><input id="txtDWLListProductId" type="text" class="numeric-input-tinyint filter_input_txt" /></div>
        <div class="floatLeft w80"><label for="txtDWLListProduct">Product</label></div>
        <div class="floatLeft"><input id="txtDWLListProduct" type="text" class="filter_input_txt"/></div>
        <div class="floatLeft w80"><label for="txtDWLListIsDisabled">IsDisabled</label></div>
        <div class="floatLeft">
            <select id="txtDWLListIsDisabled" class="w80">
                <option value="">All</option>
                <option value="1">1</option>
                <option value="0" selected>0</option>
            </select>
        </div>
        <div class="floatLeft"><input type="button" value="Search" class="btn" onclick="SearchDWLList()" /></div>
        <div class="floatLeft"><input type="button" value="Import From Excel" class="btn" onclick="OpenInsertSetting()" /></div>
    </div>
</div>
<div style="clear: both"></div>
<div id="gridDWLListContainer" class="grid-container">
    <div id="gridDWLListId" class="freegrid"></div>
</div>