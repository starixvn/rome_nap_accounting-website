<form id="edit-3rd-form" style="display: none;">
    <div id="update3rdErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td><label>ProductId</label></td>
            <td><span id="UpdProduct3rdId" /></td>
            <td style="width: 40px;"></td>
            <td><label>ProductName<span style="color: red;">*</span></label></td>
            <td><input class="setting-input" id="Upd3rdName" type="text" /></td>
        </tr>
        <tr>
            <td><label for="Upd3rdDesc">Description</label></td>
            <td><textarea class="setting-input" id="Upd3rdDesc"></textarea></td>
            <td style="width: 40px;"></td>
            <td><label for="Upd3rdPrefix">ProductPrefix</label></td>
            <td><input class="setting-input" id="Upd3rdPrefix" type="text" /></td>
        </tr>
        <tr>
            <td><label for="Upd3rdOffer">OfferSingle</label></td>
            <td><input id="Upd3rdOffer" type="checkbox" value="1" /></td>
            <td style="width: 40px;"></td>
            <td><label for="Upd3rdApplyDCS">ApplyDCS</label></td>
            <td><input id="Upd3rdApplyDCS" type="checkbox" value="1" /></td>
        </tr>
        <tr>
            <td><label for="Upd3rdEnabled">Enabled</label></td>
            <td><input id="Upd3rdEnabled" type="checkbox" value="1" /></td>
            <td style="width: 40px;"></td>
            <td><label for="Upd3rdDate">EndOfSupportDate</label></td>
            <td>
                <input class="setting-calendar" id="Upd3rdDate" type="text" />
                <input class="img-date-selector" onclick="return false;" alt="" id="Upd3rdDate_Trigger" title="Date selector"
                       width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
            </td>
        </tr>
        <tr>
            <td><label for="Upd3rdSite">OfferSite</label></td>
            <td>
                <select class="setting-input" id="Upd3rdSite">
                    <option value="0">[0] All</option>
                    <option value="1">[1] Credit</option>
                    <option value="2">[2] Deposit</option>
                </select>
            </td>
            <td style="width: 40px;"></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="5" style="text-align: center">
                <input class="btn" type="button" value="Submit" id="btnUpd3rd" />
            </td>
        </tr>
    </table>
</form>