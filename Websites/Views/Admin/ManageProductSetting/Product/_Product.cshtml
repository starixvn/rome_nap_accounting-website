@using Sunplus.Accounting.Core.Configurations;

<div class="filterBox" style="border: solid 1px #7C98A4; height:40px;">
    <div class="filterContent">
        <div id="errBettypeMsg"></div>
        <div class="floatLeft"><label for="txtProductId">ProductId</label></div>
        <div class="floatLeft"><input id="txtProductId" type="text" class="numeric-input-tinyint" /></div>
        <div class="floatLeft"><label for="txtProductName">ProductName</label></div>
        <div class="floatLeft"><input id="txtProductName" type="text" /></div>
        <div class="floatLeft"><label for="txtProductPrefix">ProductPrefix</label></div>
        <div class="floatLeft"><input id="txtProductPrefix" type="text" /></div>
        <div class="floatLeft"><input type="button" value="Search" class="btn" onclick="SearchProduct(50, 1)" /></div>
        <div class="floatLeft"><input type="button" value="Import From Excel" class="btn" onclick="OpenInsertSetting()" /></div>
    </div>
</div>
<div style="clear: both"></div>
<div id="gridProductContainer" class="grid-container">
    <div id="gridProductId" class="freegrid"></div>
</div>

@Html.Partial("~/Views/Admin/ManageProductSetting/Product/_UpdateProduct.cshtml")

<script type="text/javascript" src="@Url.Content("~/Views/Admin/ManageProductSetting/Product/Scripts/Product.js?v=" + @WebSettings.Version)"></script>