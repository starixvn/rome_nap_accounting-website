<style>
    .setting-edit {
        width: 180px;
        height: 18px;
    }

    .setting-calendar {
        width: 160px;
        height: 18px;
    }

    .setting-textarea {
        width: 180px;
    }

    label {
        font-weight: bold;
        padding-right: 10px;
    }

    .hint-note {
        line-height: 10px !important;
    }
</style>
<form id="edit-product-form" style="display: none;">
    <div id="updateProductErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td><label for="ProductId">ProductID</label></td>
            <td><span id="ProductId" /></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td><label for="ProductName">ProductName</label></td>
            <td><input class="setting-edit" id="ProductName" type="text" maxlength="50" /></td>
            <td><label for="Description">Description</label></td>
            <td><textarea class="setting-textarea" id="Description" rows="2" cols="40" maxlength="100"></textarea></td>
        </tr>
        <tr>
            <td><label for="ProductPrefix">ProductPrefix</label></td>
            <td><input class="setting-edit" id="ProductPrefix" rows="2" cols="40" maxlength="10"></td>
            <td><label for="Enabled">Enabled</label></td>
            <td><input id="Enabled" type="checkbox"></td>
        </tr>
        <tr>
            <td><label for="EndOfSupportDate ">EndOfSupportDate </label></td>
            <td>
                <input class="setting-calendar" id="EndOfSupportDate" type="text" />
                <input class="img-date-selector" onclick="return false;" alt="" id="EndOfSupportDate_Trigger" title="Date selector"
                       width="18" height="17" src="../App_Themes/Images/calendar.gif" type="image" />
            </td>
            <td><label for="IsOfferPlayForFun">IsOfferPlayForFun</label></td>
            <td><input id="IsOfferPlayForFun" type="checkbox"></td>
        </tr>
        <tr>
            <td><label for="SubProductBalanceType">SubProductBalanceType</label></td>
            <td><textarea class="setting-textarea" id="SubProductBalanceType" rows="4" cols="40" maxlength="512"></textarea></td>
            <td><label for="GroupType">GroupType</label></td>
            <td>
                <select class="setting-edit" id="GroupType">
                    <option value="0">[0] All</option>
                    <option value="1">[1] Setting Only</option>
                </select>
            </td>
        </tr>
        <tr>
            <td><label for="CasinoType">CasinoType</label></td>
            <td>
                <select class="setting-edit" id="CasinoType">
                    <option value="1">[1] Casino</option>
                    <option value="2">[2] LiveCasino</option>
                    <option value="0">[0] Others</option>
                </select>
            </td>
            <td>
                <label for="BalanceType">BalanceType</label>
            </td>
            <td>
                <select class="setting-edit" id="BalanceType">
                    <option value="">N/A</option>
                    <option value="1">[1] SportsBook</option>
                    <option value="2">[2] Transfers</option>
                    <option value="3">[3] Casino</option>
                    <option value="4">[4] Others</option>
                </select>
            </td>
        </tr>
        <tr>
            <td><label for="VendorId">VendorId</label></td>
            <td><input class="setting-edit numeric-input-smallint" id="VendorId" ></td>
            <td><label for="OrderNo">OrderNo</label></td>
            <td><input class="setting-edit numeric-input-int" id="OrderNo" ></td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <input class="btn" type="button" value="Submit" onclick="UpdateProduct();" />
            </td>
        </tr>
    </table>
</form>