@using Fanex.Tarus.Admin.ManageProductSetting.ViewModel;

@model ManageProductSettingViewModel
<style>
    .setting-edit {
        width: 180px;
        height: 18px;
    }

    label {
        font-weight: bold;
        padding-right: 10px;
    }

    .hint-note {
        line-height: 10px !important;
    }
</style>
<form id="edit-sbm-form" style="display: none;">
    <div id="updateSBMErrMsg">
    </div>
    <table style="line-height: 28px; margin-top: 10px; border-collapse: collapse;">
        <tr>
            <td><label for="SBMProduct">Product</label></td>
            <td>
                @Html.DropDownList("SBMProductId", Model.Products, new { id = "SBMProductId", @class = "setting-edit" })
            </td>
            <td style="width: 40px;"></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td><label for="SBMSportType">SportType</label></td>
            <td><span id="SBMSportType"></span></td>
            <td style="width: 40px;"></td>
            <td><label for="SBMSportTypeName">SportTypeName</label></td>
            <td><span id="SBMSportTypeName"></span></td>
        </tr>
        <tr>
            <td><label for="SBMBetType">BetType</label></td>
            <td><span id="SBMBetType"></span></td>
            <td style="width: 40px;"></td>
            <td><label for="SBMBetTypeName">BetTypeName</label></td>
            <td><span id="SBMBetTypeName"></span></td>
        </tr>
        <tr>
            <td><label for="SBMIsLive">IsLive</label></td>
            <td><input id="SBMIsLive" type="checkbox" disabled /></td>
            <td style="width: 40px;"></td>
            <td><label for="SBMEnabled">Enabled</label></td>
            <td><input id="SBMEnabled" type="checkbox" /></td>
        </tr>
        <tr>
            <td><label for="SBMIsTest">IsTest</label></td>
            <td><input id="SBMIsTest" type="checkbox" /></td>
            <td style="width: 40px;"></td>
            <td><label for="SBMProduct">EventType</label></td>
            <td>
                <select id="SBMEventType" class="setting-edit">
                    <option value="0">[0] Can't join with any table</option>
                    <option value="1">[1] Match</option>
                    <option value="2">[2] Outright</option>
                    <option value="3">[3] VSOutright/VSRaceInfo</option>
                    <option value="4">[4] DW</option>
                    <option value="5">[5] Match3rd</option>
                </select>
            </td>
        </tr>
        <tr>
            <td><label for="SBMSubProduct">SubProduct</label></td>
            <td><input id="SBMSubProduct" type="text" class="setting-edit" maxlength="500" /></td>
            <td style="width: 40px;"></td>
            <td><label for="SBMRefTable">RefTable</label></td>
            <td>
                <select id="SBMRefTable" class="setting-edit">
                    <option value="0">[0] Bettrans</option>
                    <option value="1">[1] BettransRNG</option>
                    <option value="2">[2] BettransLC</option>
                    <option value="3">[3] translog</option>
                </select>
            </td>
        </tr>
        <tr>
            <td colspan="5" style="text-align: center">
                <input id="btnSBMUpdate" class="btn" type="button" value="Submit" />
            </td>
        </tr>
    </table>
</form>