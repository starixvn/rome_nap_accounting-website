@using Sunplus.Accounting.Core.Configurations;
@using Fanex.Tarus.Admin.ManageProductSetting.ViewModel;
@model ManageProductSettingViewModel

<div class="filterBox" style="border: solid 1px #7C98A4; overflow: hidden;">
    <div class="filterContent">
        <div id="errCSSportBettypeMatrixMsg"></div>
        <div class="floatLeft w50"><label for="ddlCSSBMProductId" class="">Product</label></div>
        <div class="floatLeft ">
            @Html.DropDownList("ddlCSSBMProductId", Model.Products, new { id = "ddlCSSBMProductId" })
        </div>
        <div class="floatLeft w70"><label for="txtCSSBMSportType">SportType</label></div>
        <div class="floatLeft "><input id="txtCSSBMSportType" type="text" class="w150 numeric-input-smallint" /></div>
        <div class="floatLeft w80"><label for="txtCSSBMSportTypeName">SportTypeName</label></div>
        <div class="floatLeft"><input id="txtCSSBMSportTypeName" type="text" class="w150" /></div>
        <div class="clear"></div>
        <div class="floatLeft w50"><label for="txtCSSBMBetType">BetType</label></div>
        <div class="floatLeft"><input id="txtCSSBMBetType" type="text" class="w250 numeric-input-smallint" /></div>
        <div class="floatLeft w70"><label for="txtCSSBMBetTypeName">BetTypeName</label></div>
        <div class="floatLeft"><input id="txtCSSBMBetTypeName" type="text" class="w150" /></div>
        <div class="floatLeft w80"><label for="ddlSBMEventType">EventType</label></div>
        <div class="floatLeft">
            <select id="ddlCSSBMEventType" class="w150">
                <option value="">All</option>
                <option value="0">[0] Can't join with any table</option>
                <option value="1">[1] Match</option>
                <option value="2">[2] Outright</option>
                <option value="3">[3] VSOutright/VSRaceInfo</option>
                <option value="4">[4] DW</option>
                <option value="5">[5] Match3rd</option>
            </select>
        </div>
        <div class="floatLeft w50"><label for="ddlCSSBMRefTable">RefTable</label></div>
        <div class="floatLeft">
            <select id="ddlCSSBMRefTable" class="w150">
                <option value="">All</option>
                <option value="0">[0] Bettrans</option>
                <option value="1">[1] BettransRNG</option>
                <option value="2">[2] BettransLC</option>
                <option value="3">[3] translog</option>
            </select>
        </div>
        <div class="clear middle"></div>
        <div class="floatLeft"><input type="button" value="Search" class="btn" onclick="GetGroupsAndSearchCSSBM(50, 1)" /></div>
        <div class="floatLeft"><input type="button" value="Import From Excel" class="btn" onclick="OpenInsertSetting()" /></div>
    </div>
</div>
<div style="clear: both"></div>
<div id="gridCSSBMContainer" class="grid-container">
    <div id="gridCSSBMId" class="freegrid"></div>
</div>