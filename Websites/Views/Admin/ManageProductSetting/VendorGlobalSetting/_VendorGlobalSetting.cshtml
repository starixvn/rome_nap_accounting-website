@using Fanex.Tarus.Admin.ManageProductSetting.ViewModel;
@model ManageProductSettingViewModel
<div class="filterBox" style="border: solid 1px #7C98A4; height:80px;">
    <div class="filterContent">
        <div id="errVDMsg"></div>
        <div class="floatLeft w70"><label for="txtVendorID">VendorID</label></div>
        <div class="floatLeft"><input id="txtVendorID" type="text" class="numeric-input-tinyint" /></div>
        <div class="floatLeft w70"><label for="txtVendorName">VendorName</label></div>
        <div class="floatLeft"><input id="txtVendorName" type="text" /></div>
        <div class="floatLeft w70"><label for="txtNumberValue">NumberValue</label></div>
        <div class="floatLeft"><input id="txtNumberValue" type="text" class="numeric-input-tinyint" /></div>
        <div class="clear"></div>
        <div class="floatLeft w70"><label for="txtVDSportType">SportType</label></div>
        <div class="floatLeft ">
            @Html.DropDownList("txtVDSportType", Model.SportTypes, new { id = "txtVDSportType" })
        </div>
        <div class="floatLeft w70"><label for="txtVDBetType">BetType</label></div>
        <div class="floatLeft ">
            <select id="txtVDBetType"></select>
        </div>
        <div class="floatLeft"><input type="button" value="Search" class="btn" onclick="SearchVendor(1, 50)" /></div>
        <div class="floatLeft"><input type="button" value="Import From Excel" class="btn" onclick="OpenInsertSetting()" /></div>
    </div>
</div>
<div style="clear: both"></div>
<div id="gridVDContainer" class="grid-container">
    <div id="gridVDId" class="freegrid"></div>
</div>