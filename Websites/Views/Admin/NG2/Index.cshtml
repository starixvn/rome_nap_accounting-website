<!DOCTYPE html>
<html>
<head>
    <title></title>
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/common.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/input.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/image.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/App_Themes/Public/Message.css")" />
</head>
<body>
    <div class="main">
        <div class="maincontent">
            <table border="0" cellpadding="0" cellspacing="0" class="maincontent_header">
                <tr>
                    <td class="maincontent_headerL"></td>
                    <td class="maincontent_headerC fixfont">
                        Sync Customer Profile
                    </td>
                    <td class="maincontent_headerR"></td>
                </tr>
            </table>
            <div class="maincontent_box" style="width: 350px">
                <div id="errMsg">
                </div>
                <div class="header-scroll" style="line-height: 2">
                    <label class="b">Username</label><br /> 
                    <textarea id="usernames" class="text" style="width: 280px; min-height: 60px" placeholder="Enter username separated by comma. There is no space between comma and username. Maximum is 10 usernames."></textarea>
                    <br /> <input id="check" onclick="check()" class="btn" type="button" value="Search" /><input id="sync" disabled="disabled" onclick="sync()" class="btn" type="button" value="Sync Customer" />
                </div>
                <div id="customers" class="header-scroll" style="line-height: 2; display: none">
                    <div id="no-info">There is no information available.</div>                    
                    <div id="customer-list">

                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/js/jQuery/jquery-1.7.2.min.js")"></script>
    <script src="@Url.Content("~/js/Message/message.js")"></script>
    <script src="@Url.Content("~/Views/Admin/NG2/Scripts/SyncCustomer.js?v=")@Sunplus.Accounting.Core.Configurations.WebSettings.Version"></script>
</body>
</html>