<?xml version="1.0" encoding="utf-8" ?> 
<!--
  Filter:
    [A]: Check Customer Site permission
    [B]: Credit/Deposit permission
    [C]: Check Finance Permission

  Policy:
    1: Read
    2: Host
-->
<UrlPermissionSection defaultParams="custid,customerid,username,custname">
  <Functions>
    <!--Top panel» Customer» New Customer-->
    <add url="/CustomerSetting/SearchCopy/Super/SearchExistingSuper" filters="[A],[B]" />
    <add url="/CustomerSetting/SearchCopy/Super/CopyExistingSuper" params="ExistingCustId" policy="3" filters="[A],[B]" />
    <add url="/CustomerSetting/SearchCopy/Super/MultipleAccounts" filters="[A],[B]" />

    <!--Top panel» Customer» Move Site-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/GetCustomerInfoMoveSite" filters="[A],[B]" />
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/UpdateCustomerSite" filters="[A],[B]"/>

    <!--Top panel» Customer» View PT/View Comm-->
    <add url="/Customer/PT/ViewPT/ViewPT.aspx" filters="[A],[B]" />
    <add url="/Services/WCF/PT/ViewPT/ViewPTService.svc/ViewPositionTaking" filters="[A],[B]" />
    <add url="/Services/WCF/PT/ViewPT/ViewPTService.svc/ViewCommission" filters="[A],[B]" />

    <add url="/CopySuperSetting/CheckSuper" params="SourceSuper" filters="[A],[B]" />
    <add url="/MultipleUpdateSuperStatus/GetSupersStatus" params="SuperList" filters="[A],[B]" />
    
    <!--Top panel» Customer» View Log-->
    <add url="/LogDisplay/Setting/Display.aspx" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogSetting" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogStatus" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogCredit" filters="[A],[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogLogin" filters="[A],[B]" />

    <!--Top panel» Customer» Bet Credit History-->
    <add url="/BetCreditHistory/Search" filters="[A],[B],[C]" params="member" />

    <!--Top panel» Admin» Manage External Accounts-->
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/GetSuperList" filters="[A]" />
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/AddSuperToGroup" filters="[A]" />
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/RemoveSuperFromGroup" filters="[A]" />
    <add url="/Admin/ExternalSite/Service/ExternalSiteService.svc/ChangePrimaryGroup" filters="[A]" />
    <add url="/SMAManagement/GetSMAGroupHeadlines" filters="[A]" />
    <add url="/HeadlineExternalGroupMapping/GetExternalGroupHeadlineMappingSuper" filters="[A]" />

    <!--Left Panel» Search-->
    <add url="/CustInfo.aspx" filters="[C],[B],[A]" />

    <!--Left Panel» {Customer}» Internal login Alpha-->
    <add url="/InternalView.aspx" filters="[B],[A]" />

    <!--Left Panel» {Customer}» Customer List-->
    <add url="/CustomerList/MasterAgentList" params="superid" filters="[A],[B]" />
    <add url="/CustomerList/AgentList" params="masterid" filters="[A],[B]" />
    <add url="/CustomerList/MemberList" params="agentid" filters="[A],[B]" />

    <!--Left Panel» {Member}» Bet List-->
    <add url="/TarusBetList/BetListByCustInfo" filters="[A],[B]" />
    <add url="/TarusBetList/GetBetListByCustInfo_DateRange" filters="[A],[B]" />
    <add url="/BetList/GetBetListByCustInfo_Refno" filters="[A],[B]" />
    <add url="/ExchangeBetList/GetData" filters="[A]" />
    <add url="/ExchangeBetList/GetDetails" filters="[A]" />
    <add url="/BetList/GetBetListByIP_Soccer" filters="[A],[B]" />

    <!--Left Panel» {Customer}» Statement-->
    <add url="/Statement/CustomerStatement.aspx" filters="[A],[B],[C]" />
    <add url="/NapStatement/StatementReport/GetCustomerInfo" params="username" filters="[A],[B],[C]" />
    <add url="/Statement/GetData.ashx" filters="[A],[B],[C]" />
    <add url="/NapStatement/StatementReport/SMAStatement" filters="[A],[B],[C]" />
    <add url="/NapStatement/StatementReport/MemberStatement" filters="[A],[B],[C]" />
    <add url="/NapStatement/StatementReport/ExportSMAStatement" filters="[A],[B],[C]" />
    <add url="/NapStatement/StatementReport/ExportMemberStatement" filters="[A],[B],[C]" />
    <add url="/CustomerStatement/GetFinanceStatement" filters="[C]" />
    <add url="/CustomerStatement/Index" filters="[A],[B],[C]" />

    <!--Left Panel» {Customer}» Transfer-->
    <add url="/CrossTransfer" params="fromCustName" filters="[A]" />
    <add url="/CrossTransfer/Index" params="fromCustName" filters="[A]" />

    <!--Left Panel» {Customer}» Downline tab-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/GenDownlineList" filters="[B],[A]" />

    <!--Left Panel» {Customer}» Detail tab» Sportsbook -->
    <add url="/EditSuper/EditSuperPage" filters="[A]" />
    <add url="/EditSuper/DoEditSuper" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditSuperMinPt/EditSuperMinPtPage" filters="[A]" />
    <add url="/EditSuperMinPt/DoEditSuper" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditSuperOnMember/EditSuperOnMemberPage" filters="[A]" />
    <add url="/EditSuperOnMember/DoEditMember" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditMaster/EditMasterPage" filters="[A]" />
    <add url="/EditMaster/DoEditMaster" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditMasterMinMaxPt/EditMasterMinMaxPtPage" filters="[A]" />
    <add url="/EditMasterMinMaxPt/DoEditMaster" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditMasterOnMember/EditMasterOnMemberPage" filters="[A]" />
    <add url="/EditMasterOnMember/DoEditMember" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditAgent/EditAgentPage" filters="[A]" />
    <add url="/EditAgent/DoEditAgent" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditAgentMinMaxPt/EditAgentMinMaxPtPage" filters="[A]" />
    <add url="/EditAgentMinMaxPt/DoEditAgent" params="currentContext.targetCustId" filters="[A]" />
    <add url="/EditMember/EditMemberPage" filters="[A]" />
    <add url="/EditMember/DoEditMember" params="currentContext.targetCustId" filters="[A]" />

    <!--Left Panel» {Customer}» Detail tab» Add New -->
    <add url="/AddNewMaster/AddNewMasterPage" filters="[A]" />
    <add url="/AddNewMaster/DoAddNewMaster" params="currentContext.custId" filters="[A]" />
    <add url="/AddNewAgent/AddNewAgentPage" filters="[A]" />
    <add url="/AddNewAgent/DoAddNewAgent" params="currentContext.custId" filters="[A]" />
    <add url="/AddNewMember/AddNewMemberPage" filters="[A]" />
    <add url="/AddNewMember/DoAddNewMember" params="currentContext.custId" filters="[A]" />

    <add url="/Customer/CreateCustomer" filters="[A]" />
    <add url="/Customer/Create" params="generalInfo.uplineCustId" filters="[A]" />

    <!--Left Panel» {Customer}» Online List-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/GenOnlineList" filters="[B]" />

    <!--Left Panel» Admin » Compare Balance-->
    <add url="/CompareBalance/Search" filters="[A],[B]" />
    <add url="/napsso/cts" filters="[A],[B],[C]" />
  </Functions>
</UrlPermissionSection>