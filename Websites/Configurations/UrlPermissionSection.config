<?xml version="1.0" encoding="utf-8" ?>
<!--
  [A]: Check Special Site permission
  [B]: Check Credit/Deposit permission
-->
<UrlPermissionSection defaultParams="custid,customerid,username,custname">
  <Functions>
    <!--Top panel» Customer» View PT/View Comm-->
    <add url="/Services/WCF/PT/ViewPT/ViewPTService.svc/ViewPositionTaking" filters="[B]" />
    <add url="/Services/WCF/PT/ViewPT/ViewPTService.svc/ViewCommission" filters="[B]" />
    <!--Top panel» Customer» View Log-->
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogSetting" filters="[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogStatus" filters="[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogCredit" filters="[B]" />
    <add url="/LogDisplay/Setting/Services/Setting.svc/GetLogLogin" filters="[B]" />
    <!--Top panel» Customer» Edit SB Commission-->
    <add url="/EditSportbookCommission/CheckMembers" params="ListUserName" filters="[B]" />
    <add url="/EditSportbookCommission/Update" params="ListUserName" policy="3" filters="[B]" />

    <!--Top panel» Customer» Enable Number Game-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/UpdBetSettingEnableNGCustomer" policy="3" filters="[B]" />

    <!--Top panel» Admin» Configure Max New Members-->
    <add url="/Matrix/LimitNewMember/SearchSuper" params="super" filters="[B]" />
    <add url="/Matrix/LimitNewMember/UpdateLimitNewMember" params="super" policy="3" filters="[B]" />

    <!--Left Panel» Search-->
    <add url="/CustInfo.aspx" filters="[B]" />
    
    <!--Left Panel» {Customer}» Internal login Alpha-->
    <add url="/InternalView.aspx" filters="[B]" />

    <!--Left Panel» {Customer}» Customer List-->
    <add url="/CustomerList/MasterAgentList" params="superid" filters="[B]" />
    <add url="/CustomerList/AgentList" params="masterid" filters="[B]" />
    <add url="/CustomerList/MemberList" params="agentid" filters="[B]" />
    
    <!--Left Panel» {Member}» Bet List-->
    <add url="/TarusBetList/BetListByCustInfo" filters="[B]" />
    <add url="/TarusBetList/GetBetListByCustInfo_DateRange" filters="[B]" />
    <add url="/BetList/GetBetListByCustInfo_Refno" filters="[B]" />

    <!--Left Panel» {Customer}» Statement-->
    <add url="/Statement/CustomerStatement.aspx" filters="[B]" />
    <add url="/NapStatement/StatementReport/ExportSMAStatement" filters="[B]" />

    <!--Left Panel» {Customer}» Downline tab-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/GenDownlineList" filters="[B]" />
   
    <!--Left Panel» {Customer}» Setting tab-->
    <add url="/AbnormalBet/UpdateAbnormalCustomer" policy="3" filters="[B]" />
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/UpdateDangerousCustomerSer" policy="3" filters="[B]" />
    <add url="/Handlers/UpdateCustomerStatus.ashx" policy="3" filters="[B]" />
    <add url="/AutoSuspend/GetCustomerStatus" filters="[B]" />
    <add url="/AutoSuspend/UpdateCustomerStatus" policy="3" filters="[B]" />
    <add url="/CustomerSetting/UpdateAllDayBalTransfer" policy="3" filters="[B]" />
    <add url="/CustomerSetting/UpdateDoubleComm" policy="3" filters="[B]" />
    <add url="/ThirdPartyProductStatus" filters="[B]" />
    <add url="/ThirdPartyProductStatus/Index" filters="[B]" />
    <add url="/ThirdPartyProductStatus/Update" policy="3" filters="[B]" />
    <add url="/CustomerSetting/EnableStatus/ProductStatus" filters="[B]" />
    <add url="/CustomerSetting/EnableStatus/ProductStatus/GetProductStatusNotAllowDisabledDownline" filters="[B]" />
    <add url="/CustomerSetting/EnableStatus/ProductStatus/Update" policy="3" filters="[B]" />
    <add url="/AGCasino/CustomerStatus" filters="[B]" />
    <add url="/AGCasino/UpdateCustomerStatus" policy="3" filters="[B]" />
    
    <!--Left Panel» {Customer}» Detail tab» Casino -->
    <add url="/CustomerSetting/Casino/Super/EditSuper" params="id" filters="[B]" />
    <add url="/CustomerSetting/Casino/Super/UpdateSuperPost" params="id" policy="3" filters="[B]" />
    <add url="/CustomerSetting/Casino/Master/EditMaster" params="id" filters="[B]" />
    <add url="/CustomerSetting/Casino/Master/UpdateMasterPost" params="id" policy="3" filters="[B]" />
    <add url="/CustomerSetting/Casino/Agent/EditAgent" params="id" filters="[B]" />
    <add url="/CustomerSetting/Casino/Agent/UpdateAgentPost" params="id" policy="3" filters="[B]" />
    <add url="/CustomerSetting/Casino/Member/EditMember" params="id" filters="[B]" />
    <add url="/CustomerSetting/Casino/Member/UpdateMemberPost" params="id" policy="3" filters="[B]" />

    <!--Left Panel» {Customer}» Detail tab» Keno -->
    <add url="/CustomerSetting/KenoSetting/KenoSetting/EditSuper" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/UpdateSuper" params="customerInformation.custId" policy="3" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/EditMaster" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/UpdateMaster" params="customerInformation.custId" policy="3" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/EditAgent" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/UpdateAgent" params="customerInformation.custId" policy="3" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/AgentEditMember" filters="[B]" />
    <add url="/CustomerSetting/KenoSetting/KenoSetting/UpdateAgentOnMember" params="customerInformation.custId" policy="3" filters="[B]" />
    
    <!--Left Panel» {Customer}» Detail tab» Edit» Gold Deluxe-->
    <add url="/GoldDeluxeSetting/GoldDeluxe/EditSetting" />
    <add url="/GoldDeluxeSetting/GoldDeluxe/UpdatePTAndCom" policy="3" filters="[B]" />
    <add url="/GoldDeluxeSetting/GoldDeluxe/UpdateWinLimit" policy="3" filters="[B]" />
    <add url="/GoldDeluxeSetting/GoldDeluxe/UpdateGameSetting" policy="3" filters="[B]" />
    <add url="/GoldDeluxeSetting/GoldDeluxe/UpdateSetting" policy="3" filters="[B]" />
    
    <!--Left Panel» {Customer}» Detail tab» Edit» Colossus Bet-->
    <add url="/CustomerSetting/ColossusBetSetting/ColossusBetSetting/EditSetting" filters="[B]" />
    <add url="/CustomerSetting/ColossusBetSetting/ColossusBetSetting/UpdateSetting" params="CustomerInformationPartial.CustId" policy="3" filters="[B]" />
    
    <!--Left Panel» {Customer}» Login tab-->
    <add url="/ChangePassword/ChangePassword.aspx" policy="3" filters="[B]" />
    <add url="/CustomerSecurityCode" filters="[B]" />
    <add url="/CustomerSecurityCode/Index" filters="[B]" />
    <add url="/CustomerSecurityCode/ResetSecurityCode" policy="3" filters="[B]" />
    <add url="/CustomerOTP" filters="[B]" />
    <add url="/CustomerOTP/Index" filters="[B]" />
    <add url="/CustomerOTP/RemoveOTP" policy="3" filters="[B]" />
    
    <!--Left Panel» {Customer}» Online List-->
    <add url="/Services/WCF/Customer/ServiceCustomerInfo.svc/GenOnlineList" filters="[B]" />
  </Functions>
</UrlPermissionSection>