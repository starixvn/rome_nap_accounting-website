<?xml version="1.0"?>
<behaviors>
  <endpointBehaviors>
    <behavior name="WcfService">
      <webHttp/>
    </behavior>    
  </endpointBehaviors>
  <serviceBehaviors>
    <behavior name="HelperServiceBehavior">
      <serviceMetadata httpGetEnabled="true"/>
      <serviceDebug includeExceptionDetailInFaults="false"/>
    </behavior>    
    <behavior name="ServiceHandlerBehavior">
      <serviceMetadata httpGetEnabled="true"/>
      <serviceDebug includeExceptionDetailInFaults="false"/>
    </behavior>
  </serviceBehaviors>
</behaviors>
