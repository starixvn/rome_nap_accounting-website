  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <siteMap defaultProvider="SystemFunctions">
      <providers>
        <add name="SystemFunctions" type="System.Web.XmlSiteMapProvider" siteMapFile="~/App_Data/System.sitemap" />
      </providers>
    </siteMap>
    <httpHandlers>
      <add verb="*" path="*.xls" type="System.Web.StaticFileHandler" />
      <add verb="*" path="*.xlsx" type="System.Web.StaticFileHandler" />
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <customErrors mode="Off"></customErrors>
    <compilation debug="true" targetFramework="4.6.1">
      <assemblies>
        <add assembly="System.Management, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
